+++ b/src/services/graph/auth.ts
@@ -0,0 +1,365 @@
+/**
+ * Microsoft Graph OAuth2 PKCE flow + token store.
+ *
+ * Mirrors SearchProviderStore's keychain usage for BYOK secrets. The client-id
+ * and token set are persisted in Keychain; if no client-id is configured, the
+ * layer reports 'not_configured' honestly.
+ */
+
+import * as Keychain from 'react-native-keychain';
+
+import {AUTH_ENDPOINT, TOKEN_ENDPOINT, DEFAULT_SCOPES} from './config';
+import {GraphError} from './types';
+import type {GraphTokenSet} from './types';
+
+// ─── Keychain service names ──────────────────────────────────────────────────
+
+const KEYCHAIN_SERVICE_CLIENT_ID = 'graph_client_id_service';
+const KEYCHAIN_SERVICE_TOKEN_SET = 'graph_token_set_service';
+
+// ─── Client-id configuration ─────────────────────────────────────────────────
+
+/**
+ * Read the configured client-id from Keychain. Returns null if absent.
+ * The user must register a Microsoft Entra app and supply the client-id
+ * before any Graph call can fire.
+ */
+export async function getConfiguredClientId(): Promise<string | null> {
+  try {
+    const credentials = await Keychain.getGenericPassword({
+      service: KEYCHAIN_SERVICE_CLIENT_ID,
+    });
+    if (credentials && credentials.password) {
+      return credentials.password;
+    }
+    return null;
+  } catch (error) {
+    console.error('[graph] Failed to load client-id:', error);
+    return null;
+  }
+}
+
+/**
+ * Store the client-id in Keychain. Returns true on success.
+ */
+export async function setClientId(clientId: string): Promise<boolean> {
+  try {
+    await Keychain.setGenericPassword('graph_client_id', clientId, {
+      service: KEYCHAIN_SERVICE_CLIENT_ID,
+    });
+    return true;
+  } catch (error) {
+    console.error('[graph] Failed to save client-id:', error);
+    return false;
+  }
+}
+
+/**
+ * Clear the client-id from Keychain. Returns true on success.
+ */
+export async function clearClientId(): Promise<boolean> {
+  try {
+    await Keychain.resetGenericPassword({service: KEYCHAIN_SERVICE_CLIENT_ID});
+    return true;
+  } catch (error) {
+    console.error('[graph] Failed to clear client-id:', error);
+    return false;
+  }
+}
+
+// ─── Token store ─────────────────────────────────────────────────────────────
+
+/**
+ * Read the token set from Keychain. Returns null if absent.
+ */
+export async function getTokenSet(): Promise<GraphTokenSet | null> {
+  try {
+    const credentials = await Keychain.getGenericPassword({
+      service: KEYCHAIN_SERVICE_TOKEN_SET,
+    });
+    if (credentials && credentials.password) {
+      const parsed = JSON.parse(credentials.password);
+      return parsed as GraphTokenSet;
+    }
+    return null;
+  } catch (error) {
+    console.error('[graph] Failed to load token set:', error);
+    return null;
+  }
+}
+
+/**
+ * Store the token set in Keychain. Returns true on success.
+ */
+export async function setTokenSet(tokenSet: GraphTokenSet): Promise<boolean> {
+  try {
+    await Keychain.setGenericPassword('graph_token_set', JSON.stringify(tokenSet), {
+      service: KEYCHAIN_SERVICE_TOKEN_SET,
+    });
+    return true;
+  } catch (error) {
+    console.error('[graph] Failed to save token set:', error);
+    return false;
+  }
+}
+
+/**
+ * Clear the token set from Keychain. Returns true on success.
+ */
+export async function clearTokenSet(): Promise<boolean> {
+  try {
+    await Keychain.resetGenericPassword({service: KEYCHAIN_SERVICE_TOKEN_SET});
+    return true;
+  } catch (error) {
+    console.error('[graph] Failed to clear token set:', error);
+    return false;
+  }
+}
+
+// ─── OAuth2 URL builder ──────────────────────────────────────────────────────
+
+/**
+ * Build the authorization URL for the OAuth2 PKCE flow.
+ *
+ * @param state - Opaque state value for CSRF protection
+ * @param codeChallenge - PKCE code challenge (base64url(SHA256(verifier)))
+ * @param redirectUri - Mobile/desktop redirect URI (e.g., msauth.<pkg>://auth)
+ * @returns Fully-formed authorization URL
+ */
+export function buildAuthorizationUrl(
+  state: string,
+  codeChallenge: string,
+  redirectUri: string,
+): string {
+  const params = new URLSearchParams({
+    client_id: '', // placeholder — filled by caller after reading from keychain
+    response_type: 'code',
+    redirect_uri: redirectUri,
+    scope: DEFAULT_SCOPES.join(' '),
+    state,
+    code_challenge: codeChallenge,
+    code_challenge_method: 'S256',
+    response_mode: 'query',
+  });
+
+  return `${AUTH_ENDPOINT}?${params.toString()}`;
+}
+
+/**
+ * Build the authorization URL with the client-id injected.
+ * Called after getConfiguredClientId() succeeds.
+ */
+export function buildAuthorizationUrlWithClientId(
+  clientId: string,
+  state: string,
+  codeChallenge: string,
+  redirectUri: string,
+): string {
+  const params = new URLSearchParams({
+    client_id: clientId,
+    response_type: 'code',
+    redirect_uri: redirectUri,
+    scope: DEFAULT_SCOPES.join(' '),
+    state,
+    code_challenge: codeChallenge,
+    code_challenge_method: 'S256',
+    response_mode: 'query',
+  });
+
+  return `${AUTH_ENDPOINT}?${params.toString()}`;
+}
+
+// ─── Token exchange ──────────────────────────────────────────────────────────
+
+/**
+ * Exchange the authorization code for tokens.
+ *
+ * @param code - Authorization code from the redirect
+ * @param verifier - PKCE code verifier (the original, not the challenge)
+ * @param redirectUri - Must match the redirect URI used in the authorization request
+ * @returns Token set (access_token, refresh_token, expires_at, scopes)
+ */
+export async function exchangeCodeForTokens(
+  code: string,
+  verifier: string,
+  redirectUri: string,
+): Promise<GraphTokenSet> {
+  const clientId = await getConfiguredClientId();
+  if (!clientId) {
+    throw new GraphError(
+      'not_configured',
+      'No client-id configured. See src/services/graph/README.md.',
+    );
+  }
+
+  const body = new URLSearchParams({
+    client_id: clientId,
+    grant_type: 'authorization_code',
+    code,
+    redirect_uri: redirectUri,
+    code_verifier: verifier,
+  });
+
+  try {
+    const response = await fetch(TOKEN_ENDPOINT, {
+      method: 'POST',
+      headers: {'Content-Type': 'application/x-www-form-urlencoded'},
+      body: body.toString(),
+    });
+
+    if (!response.ok) {
+      const errorText = await response.text();
+      throw new GraphError(
+        'graph_error',
+        `Token exchange failed: ${response.status} ${errorText}`,
+        response.status,
+      );
+    }
+
+    const data = await response.json();
+
+    const tokenSet: GraphTokenSet = {
+      access_token: data.access_token,
+      refresh_token: data.refresh_token || '',
+      expires_at: Math.floor(Date.now() / 1000) + data.expires_in,
+      scopes: data.scope || DEFAULT_SCOPES.join(' '),
+    };
+
+    await setTokenSet(tokenSet);
+    return tokenSet;
+  } catch (error) {
+    if (error instanceof GraphError) {
+      throw error;
+    }
+    throw new GraphError(
+      'network',
+      `Token exchange network error: ${error instanceof Error ? error.message : String(error)}`,
+    );
+  }
+}
+
+/**
+ * Refresh the access token using the refresh token.
+ *
+ * @param refreshToken - The refresh token from the previous token set
+ * @returns New token set
+ */
+export async function refreshAccessToken(
+  refreshToken: string,
+): Promise<GraphTokenSet> {
+  const clientId = await getConfiguredClientId();
+  if (!clientId) {
+    throw new GraphError(
+      'not_configured',
+      'No client-id configured. See src/services/graph/README.md.',
+    );
+  }
+
+  const body = new URLSearchParams({
+    client_id: clientId,
+    grant_type: 'refresh_token',
+    refresh_token: refreshToken,
+  });
+
+  try {
+    const response = await fetch(TOKEN_ENDPOINT, {
+      method: 'POST',
+      headers: {'Content-Type': 'application/x-www-form-urlencoded'},
+      body: body.toString(),
+    });
+
+    if (!response.ok) {
+      const errorText = await response.text();
+      throw new GraphError(
+        'token_expired',
+        `Token refresh failed: ${response.status} ${errorText}`,
+        response.status,
+      );
+    }
+
+    const data = await response.json();
+
+    const tokenSet: GraphTokenSet = {
+      access_token: data.access_token,
+      refresh_token: data.refresh_token || refreshToken, // some providers don't rotate
+      expires_at: Math.floor(Date.now() / 1000) + data.expires_in,
+      scopes: data.scope || DEFAULT_SCOPES.join(' '),
+    };
+
+    await setTokenSet(tokenSet);
+    return tokenSet;
+  } catch (error) {
+    if (error instanceof GraphError) {
+      throw error;
+    }
+    throw new GraphError(
+      'network',
+      `Token refresh network error: ${error instanceof Error ? error.message : String(error)}`,
+    );
+  }
+}
+
+// ─── Auth state check ────────────────────────────────────────────────────────
+
+/**
+ * Check if the Graph layer is configured (client-id present).
+ */
+export async function isConfigured(): Promise<boolean> {
+  const clientId = await getConfiguredClientId();
+  return clientId !== null && clientId.trim().length > 0;
+}
+
+/**
+ * Check if the user is authenticated (valid token set present).
+ * Does NOT check token expiry — that's the client's job.
+ */
+export async function isAuthenticated(): Promise<boolean> {
+  const tokenSet = await getTokenSet();
+  return tokenSet !== null && tokenSet.access_token.trim().length > 0;
+}
+
+/**
+ * Get a valid access token, refreshing if necessary.
+ * Throws GraphError if not configured or not authenticated.
+ */
+export async function getValidAccessToken(): Promise<string> {
+  const configured = await isConfigured();
+  if (!configured) {
+    throw new GraphError(
+      'not_configured',
+      'Microsoft Graph is not configured. See src/services/graph/README.md.',
+    );
+  }
+
+  const tokenSet = await getTokenSet();
+  if (!tokenSet) {
+    throw new GraphError(
+      'not_authenticated',
+      'Not authenticated. Please sign in with your Microsoft account.',
+    );
+  }
+
+  const now = Math.floor(Date.now() / 1000);
+  const bufferSeconds = 60; // refresh 60s before expiry
+
+  if (tokenSet.expires_at - now < bufferSeconds) {
+    // Token expired or about to expire — refresh
+    if (!tokenSet.refresh_token) {
+      throw new GraphError(
+        'token_expired',
+        'Access token expired and no refresh token available. Please sign in again.',
+      );
+    }
+
+    try {
+      const newTokenSet = await refreshAccessToken(tokenSet.refresh_token);
+      return newTokenSet.access_token;
+    } catch (error) {
+      // Refresh failed — clear the token set so the user must re-auth
+      await clearTokenSet();
+      throw error;
+    }
+  }
+
+  return tokenSet.access_token;
+}
