+// ---------------------------------------------------------------------------
+// Operation: memo
+// ---------------------------------------------------------------------------
+
+interface MemoInput {
+  title: string;
+  date?: string;
+  preparedBy?: string;
+  facility?: string;
+  sections: {heading: string; paragraphs: string[]}[];
+  signatureLine?: string;
+  path?: string;
+  author?: string;
+}
+
+function generateMemoPdf(input: MemoInput): string {
+  const pageW = 595.28;
+  const pageH = 841.89;
+  const uWidth = pageW - MARGIN_LEFT - MARGIN_RIGHT;
+
+  const fontSize = 10;
+  const headingSize = 13;
+  const titleSize = 22;
+  const lineHeight = fontSize * 1.5;
+  const headingLineHeight = headingSize * 1.5;
+
+  interface PageData {
+    stream: string;
+  }
+  const pageDataList: PageData[] = [];
+  let currentStream = '';
+  let y = pageH - MARGIN_TOP;
+
+  function newPage() {
+    pageDataList.push({stream: currentStream});
+    currentStream = '';
+    y = pageH - MARGIN_TOP;
+  }
+
+  function ensureSpace(needed: number) {
+    if (y - needed < MARGIN_BOTTOM) {
+      newPage();
+    }
+  }
+
+  // Letterhead title
+  y -= titleSize + 10;
+  currentStream += `BT /F2 ${titleSize} Tf ${MARGIN_LEFT} ${y} Td (${pdfEscape(input.title)}) Tj ET\n`;
+  y -= 10;
+
+  // Double rule
+  currentStream += `q 0.2 G\n2 w\n${MARGIN_LEFT} ${y} m ${pageW - MARGIN_RIGHT} ${y} l S\nQ\n`;
+  y -= 4;
+  currentStream += `q 0.2 G\n0.5 w\n${MARGIN_LEFT} ${y} m ${pageW - MARGIN_RIGHT} ${y} l S\nQ\n`;
+  y -= 20;
+
+  // Meta grid
+  const metaItems: string[] = [];
+  if (input.date) metaItems.push(`Date: ${input.date}`);
+  if (input.preparedBy) metaItems.push(`Prepared by: ${input.preparedBy}`);
+  if (input.facility) metaItems.push(`Facility: ${input.facility}`);
+
+  for (const item of metaItems) {
+    y -= lineHeight;
+    currentStream += `BT /F1 ${fontSize} Tf ${MARGIN_LEFT} ${y} Td (${pdfEscape(item)}) Tj ET\n`;
+  }
+
+  y -= 15;
+  currentStream += `q 0.7 G\n0.5 w\n${MARGIN_LEFT} ${y} m ${pageW - MARGIN_RIGHT} ${y} l S\nQ\n`;
+  y -= 15;
+
+  // Numbered sections
+  let sectionNum = 0;
+  for (const section of input.sections) {
+    sectionNum++;
+    ensureSpace(headingLineHeight + 10);
+    y -= headingLineHeight;
+    currentStream += `BT /F2 ${headingSize} Tf ${MARGIN_LEFT} ${y} Td (${pdfEscape(`${sectionNum}. ${section.heading}`)}) Tj ET\n`;
+    y -= 5;
+
+    for (const para of section.paragraphs) {
+      const lines = wrapText(para, fontSize, uWidth);
+      for (const line of lines) {
+        ensureSpace(lineHeight);
+        y -= lineHeight;
+        currentStream += `BT /F1 ${fontSize} Tf ${MARGIN_LEFT} ${y} Td (${pdfEscape(line)}) Tj ET\n`;
+      }
+      y -= lineHeight * 0.5;
+    }
+    y -= 10;
+  }
+
+  // Signature line
+  if (input.signatureLine || input.preparedBy) {
+    ensureSpace(lineHeight * 3);
+    y -= lineHeight * 2;
+    const sigText = input.signatureLine || `________________________\n${input.preparedBy || ''}`;
+    const sigLines = sigText.split('\n');
+    for (const sl of sigLines) {
+      currentStream += `BT /F1 ${fontSize} Tf ${MARGIN_LEFT} ${y} Td (${pdfEscape(sl)}) Tj ET\n`;
+      y -= lineHeight;
+    }
+  }
+
+  pageDataList.push({stream: currentStream});
+
+  // Add page numbers
+  const totalPages = pageDataList.length;
+  for (let i = 0; i < totalPages; i++) {
+    let s = pageDataList[i].stream;
+    const pnText = `${i + 1}`;
+    const pnW = measureWidth(pnText, 8);
+    const pnX = (pageW - pnW) / 2;
+    const pnY = MARGIN_BOTTOM / 2;
+    s += `BT /F1 8 Tf 0.5 0.5 0.5 rg ${pnX} ${pnY} Td (${pnText}) Tj ET\n0 g\n`;
+    pageDataList[i].stream = s;
+  }
+
+  // Assemble PDF
+  let pdf = '%PDF-1.4\n';
+  pdf += '%\xe2\xe3\xcf\xd3\n';
+
+  const totalObjCount = 6 + totalPages * 2;
+  const offsets: number[] = new Array(totalObjCount).fill(0);
+
+  function writeObj(id: number, content: string) {
+    offsets[id] = pdf.length;
+    pdf += `${id} 0 obj\n${content}\nendobj\n`;
+  }
+
+  const pageObjIds: number[] = [];
+  const streamObjIds: number[] = [];
+  for (let i = 0; i < totalPages; i++) {
+    pageObjIds.push(6 + i * 2);
+    streamObjIds.push(6 + i * 2 + 1);
+  }
+  const kidsStr = pageObjIds.map(id => `${id} 0 R`).join(' ');
+
+  writeObj(1, '<< /Type /Catalog /Pages 2 0 R >>');
+  writeObj(2, `<< /Type /Pages /Kids [${kidsStr}] /Count ${totalPages} >>`);
+  writeObj(3, '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>');
+  writeObj(4, '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>');
+  writeObj(5, `<< /Font << /F1 3 0 R /F2 4 0 R >> >>`);
+
+  for (let i = 0; i < totalPages; i++) {
+    const streamContent = pageDataList[i].stream;
+    writeObj(streamObjIds[i], `<< /Length ${streamContent.length} >>\nstream\n${streamContent}\nendstream`);
+    writeObj(pageObjIds[i],
+      `<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${pageW} ${pageH}] ` +
+      `/Contents ${streamObjIds[i]} 0 R /Resources 5 0 R >>`
+    );
+  }
+
+  const xrefOffset = pdf.length;
+  pdf += 'xref\n';
+  pdf += `0 ${totalObjCount}\n`;
+  pdf += '0000000000 65535 f \n';
+  for (let i = 1; i < totalObjCount; i++) {
+    pdf += offsets[i].toString().padStart(10, '0') + ' 00000 n \n';
+  }
+  pdf += 'trailer\n';
+  pdf += `<< /Size ${totalObjCount} /Root 1 0 R >>\n`;
+  pdf += 'startxref\n';
+  pdf += `${xrefOffset}\n`;
+  pdf += '%%EOF\n';
+
+  return pdf;
+}
+
+// ---------------------------------------------------------------------------
+// String to byte array (Latin-1 / binary safe for PDF)
+// ---------------------------------------------------------------------------
+
+function stringToBytes(s: string): Uint8Array {
+  const bytes = new Uint8Array(s.length);
+  for (let i = 0; i < s.length; i++) {
+    bytes[i] = s.charCodeAt(i) & 0xff;
+  }
+  return bytes;
+}
+
+// ---------------------------------------------------------------------------
+// PDF structure verification
+// ---------------------------------------------------------------------------
+
+interface PdfVerification {
+  hasHeader: boolean;
+  hasEof: boolean;
+  startxrefOffset: number | null;
+  xrefValid: boolean;
+  objectCount: number;
+  offsetErrors: number;
+}
+
+function verifyPdfStructure(pdfStr: string): PdfVerification {
+  const result: PdfVerification = {
+    hasHeader: pdfStr.startsWith('%PDF-1.4'),
+    hasEof: pdfStr.trim().endsWith('%%EOF'),
+    startxrefOffset: null,
+    xrefValid: false,
+    objectCount: 0,
+    offsetErrors: 0,
+  };
+
+  // Find startxref
+  const startxrefMatch = pdfStr.match(/startxref\s+(\d+)\s+%%EOF/);
+  if (!startxrefMatch) {
+    return result;
+  }
+
+  result.startxrefOffset = parseInt(startxrefMatch[1], 10);
+
+  // Verify xref is at that offset
+  const actualAtOffset = pdfStr.substring(result.startxrefOffset, result.startxrefOffset + 4);
+  if (actualAtOffset !== 'xref') {
+    return result;
+  }
+  result.xrefValid = true;
+
+  // Parse xref table and verify all object offsets
+  const xrefMatch = pdfStr.match(/xref\s+0\s+(\d+)\s+([\s\S]*?)\s+trailer/);
+  if (!xrefMatch) {
+    return result;
+  }
+
+  result.objectCount = parseInt(xrefMatch[1], 10);
+  const xrefEntries = xrefMatch[2].trim().split('\n');
+
+  for (let i = 1; i < result.objectCount; i++) {
+    const entry = xrefEntries[i];
+    if (!entry) continue;
+
+    const match = entry.match(/^(\d{10})\s+\d+\s+n/);
+    if (!match) continue;
+
+    const expectedOffset = parseInt(match[1], 10);
+
+    // Find actual object position
+    const objPattern = new RegExp(`^${i} 0 obj`, 'm');
+    const objMatch = pdfStr.match(objPattern);
+    if (!objMatch) {
+      result.offsetErrors++;
+      continue;
+    }
+
+    const actualOffset = objMatch.index!;
+    if (actualOffset !== expectedOffset) {
+      result.offsetErrors++;
+    }
+  }
+
+  return result;
+}
+
+// ---------------------------------------------------------------------------
+// PdfEngine class
+// ---------------------------------------------------------------------------
+
+/**
+ * Build the TalentResult for a generated PDF: actually run the structural
+ * verification over the produced bytes and report what was truly found, then
+ * return the PDF as base64 so the caller has something openable. The summary
+ * claims verification only to the extent verifyPdfStructure() confirmed it.
+ */
+function pdfResult(
+  op: string,
+  pdfStr: string,
+  extraLines: string[],
+): TalentResult {
+  const verification = verifyPdfStructure(pdfStr);
+  const pdfBytes = stringToBytes(pdfStr);
+  const base64 = bytesToBase64(pdfBytes);
+
+  const xrefStatus =
+    verification.xrefValid && verification.offsetErrors === 0
+      ? `byte-exact offsets verified (${verification.objectCount} objects, 0 offset errors)`
+      : verification.startxrefOffset === null
+        ? 'NOT VERIFIED — startxref not found'
+        : `FAILED — ${verification.offsetErrors} offset error(s)`;
+
+  const header = verification.hasHeader ? '%PDF-1.4 present' : 'MISSING header';
+  const eof = verification.hasEof ? '%%EOF present' : 'MISSING %%EOF';
+
+  const summary =
+    `[pdf.${op}] Generated PDF\n` +
+    extraLines.join('\n') +
+    `Size: ${pdfBytes.length} bytes\n` +
+    `Header: ${header}\n` +
+    `xref: ${xrefStatus}\n` +
+    `EOF: ${eof}\n` +
+    `Base64 (complete): ${base64}`;
+
+  return {
+    type: 'text',
+    summary,
+  };
+}
+
+const OPERATIONS = ['report', 'table', 'memo'] as const;
+type PdfOperation = (typeof OPERATIONS)[number];
