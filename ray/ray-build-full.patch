+import React from 'react';
+import {runInAction} from 'mobx';
+import {fireEvent, render, waitFor} from '../../../../jest/test-utils';
+
+import {RoutingSettingsCard} from '../RoutingSettingsCard';
+import {routeStore} from '../../../store/RouteStore';
+import {serverStore} from '../../../store/ServerStore';
+import {modelStore} from '../../../store/ModelStore';
+
+/**
+ * RoutingSettingsCard tests.
+ *
+ * Exercises the gating order that mirrors the store guards: nothing cloud-ward
+ * is reachable until the privacy switch is on AND a backend is bound. The store
+ * is the real one (not mocked) so a UI change that the store would reject shows
+ * up here as a no-op rather than silently "working".
+ */
+describe('RoutingSettingsCard', () => {
+  beforeEach(() => {
+    jest.clearAllMocks();
+    runInAction(() => {
+      routeStore.mode = 'local';
+      routeStore.cloudRoutingAcknowledged = false;
+      routeStore.cloudServerId = null;
+      routeStore.cloudRemoteModelId = null;
+    });
+  });
+
+  it('renders with the privacy switch off by default', () => {
+    const {getByTestId} = render(<RoutingSettingsCard />);
+    const sw = getByTestId('routing-acknowledge-switch');
+    expect(sw.props.value).toBe(false);
+  });
+
+  it('disables the mode selector before acknowledgement', () => {
+    const {getByTestId} = render(<RoutingSettingsCard />);
+    const auto = getByTestId('routing-mode-auto');
+    expect(auto.props.disabled).toBe(true);
+  });
+
+  it('enables the mode selector after acknowledgement + backend bound', async () => {
+    runInAction(() => {
+      routeStore.cloudRoutingAcknowledged = true;
+      routeStore.cloudServerId = 'srv-1';
+      routeStore.cloudRemoteModelId = 'gpt-oss-20b';
+    });
+    const {getByTestId} = render(<RoutingSettingsCard />);
+    await waitFor(() => {
+      expect(getByTestId('routing-mode-auto').props.disabled).toBe(false);
+    });
+  });
+
+  it('switching to auto persists the mode via the store guard', async () => {
+    runInAction(() => {
+      routeStore.cloudRoutingAcknowledged = true;
+      routeStore.cloudServerId = 'srv-1';
+      routeStore.cloudRemoteModelId = 'gpt-oss-20b';
+    });
+    const {getByTestId} = render(<RoutingSettingsCard />);
+    fireEvent.press(getByTestId('routing-mode-auto'));
+    await waitFor(() => {
+      expect(routeStore.mode).toBe('auto');
+    });
+  });
+
+  it('cannot switch to a cloud mode without acknowledgement', async () => {
+    // Guard lives in the store; pressing auto with ack off must leave mode local.
+    const {getByTestId} = render(<RoutingSettingsCard />);
+    fireEvent.press(getByTestId('routing-mode-cloud'));
+    await waitFor(() => {
+      expect(routeStore.mode).toBe('local');
+    });
+  });
+
+  it('reflects the wifi-only policy default and toggles it', async () => {
+    const {getByTestId} = render(<RoutingSettingsCard />);
+    const wifi = getByTestId('routing-policy-wifi');
+    expect(wifi.props.value).toBe(true); // DEFAULT_ROUTE_POLICY.wifiOnly
+    fireEvent(wifi, 'valueChange', false);
+    await waitFor(() => {
+      expect(routeStore.policy.wifiOnly).toBe(false);
+    });
+  });
+
+  it('lists configured servers as backend options', () => {
+    runInAction(() => {
+      routeStore.cloudRoutingAcknowledged = true;
+      serverStore.servers = [
+        {id: 'srv-1', name: 'OpenRouter', url: 'https://openrouter.ai/api/v1'},
+      ] as any;
+    });
+    const {getByTestId} = render(<RoutingSettingsCard />);
+    // Server selector is present and enabled once acknowledged.
+    expect(getByTestId('routing-server-selector')).toBeTruthy();
+    runInAction(() => {
+      serverStore.servers = [];
+    });
+  });
+
+  it('shows hybrid status when a hybrid engine is active', () => {
+    runInAction(() => {
+      routeStore.cloudRoutingAcknowledged = true;
+      routeStore.cloudServerId = 'srv-1';
+      routeStore.cloudRemoteModelId = 'gpt-oss-20b';
+      routeStore.mode = 'auto';
+    });
+    // Simulate ModelStore having built a hybrid engine with a last decision.
+    (modelStore as any).hybridEngine = {
+      lastDecision: {useCloud: true, reason: 'tool-using request routed to cloud'},
+    };
+    const {getByText} = render(<RoutingSettingsCard />);
+    expect(getByText(/tool-using request routed to cloud/)).toBeTruthy();
+    (modelStore as any).hybridEngine = undefined;
+  });
+});
