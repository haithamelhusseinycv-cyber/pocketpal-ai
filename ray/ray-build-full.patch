@@ -0,0 +1,137 @@
+/**
+ * Microsoft Graph API types — "RAY's Microsoft 365 face".
+ *
+ * STATUS — READ THIS:
+ * This is a real, typed integration layer for Outlook mail, calendar, and
+ * OneDrive via the Microsoft Graph API. It ships in a "not configured" state:
+ * the types, PKCE auth flow, and request builders are complete, but the user
+ * must register a Microsoft Entra app and supply a client-id before any Graph
+ * call can fire. Nothing fabricates mail, calendar, or file data.
+ *
+ * See src/services/graph/README.md for the activation checklist.
+ */
+
+// ─── Graph API response shapes ───────────────────────────────────────────────
+
+export interface GraphUser {
+  id: string;
+  displayName: string;
+  mail?: string;
+  userPrincipalName: string;
+  givenName?: string;
+  surname?: string;
+  jobTitle?: string;
+  officeLocation?: string;
+}
+
+export interface GraphEmailAddress {
+  name: string;
+  address: string;
+}
+
+export interface GraphMessage {
+  id: string;
+  subject?: string;
+  bodyPreview?: string;
+  body?: {contentType: string; content: string};
+  from?: {emailAddress: GraphEmailAddress};
+  toRecipients?: Array<{emailAddress: GraphEmailAddress}>;
+  ccRecipients?: Array<{emailAddress: GraphEmailAddress}>;
+  receivedDateTime: string;
+  sentDateTime?: string;
+  isRead: boolean;
+  hasAttachments: boolean;
+  importance?: 'low' | 'normal' | 'high';
+  webLink?: string;
+}
+
+export interface GraphEvent {
+  id: string;
+  subject: string;
+  start: {dateTime: string; timeZone: string};
+  end: {dateTime: string; timeZone: string};
+  location?: {displayName?: string};
+  bodyPreview?: string;
+  body?: {contentType: string; content: string};
+  isAllDay: boolean;
+  isCancelled: boolean;
+  organizer?: {emailAddress: GraphEmailAddress};
+  webLink?: string;
+}
+
+export interface GraphDriveItem {
+  id: string;
+  name: string;
+  size: number;
+  lastModifiedDateTime: string;
+  folder?: {childCount?: number};
+  file?: {mimeType?: string};
+  webUrl?: string;
+  '@microsoft.graph.downloadUrl'?: string;
+}
+
+// ─── Auth state ──────────────────────────────────────────────────────────────
+
+export interface GraphTokenSet {
+  access_token: string;
+  refresh_token: string;
+  expires_at: number; // epoch seconds
+  scopes: string;
+}
+
+export interface GraphAuthState {
+  configured: boolean;
+  authenticated: boolean;
+  tokenSet: GraphTokenSet | null;
+  user: GraphUser | null;
+}
+
+// ─── Error shape ─────────────────────────────────────────────────────────────
+
+export type GraphErrorCode =
+  | 'not_configured'     // no client-id supplied
+  | 'not_authenticated'  // no token set
+  | 'token_expired'      // access token expired, refresh failed
+  | 'permission_denied'  // 401/403 from Graph
+  | 'network'            // fetch failure
+  | 'graph_error'        // non-2xx from Graph (other)
+  | 'unknown';
+
+export class GraphError extends Error {
+  readonly code: GraphErrorCode;
+  readonly status?: number;
+
+  constructor(code: GraphErrorCode, message: string, status?: number) {
+    super(message);
+    this.name = 'GraphError';
+    this.code = code;
+    this.status = status;
+  }
+}
+
+// ─── Client option types ─────────────────────────────────────────────────────
+
+export interface ListMessagesOptions {
+  top?: number;
+  skip?: number;
+  search?: string;
+  filter?: string;
+  orderBy?: string;
+}
+
+export interface SendMailPayload {
+  toRecipients: Array<{emailAddress: GraphEmailAddress}>;
+  subject: string;
+  body: {contentType: 'Text' | 'HTML'; content: string};
+  ccRecipients?: Array<{emailAddress: GraphEmailAddress}>;
+  importance?: 'low' | 'normal' | 'high';
+}
+
+export interface CreateEventPayload {
+  subject: string;
+  start: {dateTime: string; timeZone: string};
+  end: {dateTime: string; timeZone: string};
+  body?: {contentType: 'Text' | 'HTML'; content: string};
+  location?: {displayName: string};
+  isAllDay?: boolean;
+}
