+/**
+ * RAY — the two faces.
+ *
+ * Ready-made Pals that share the hardcoded RAY base persona (rayPersona.ts,
+ * injected before every Pal) but each leans into one face of the man and
+ * carries its own toolbelt via `pact.talents`:
+ *
+ *   1. "RAY — The Desk"  : the technical face. Researcher, credit analyst,
+ *      risk assessor, leasing expert, banker, economist, team lead, coder,
+ *      reverse engineer. Carries the full analytical + RE toolbelt.
+ *
+ *   2. "RAY — The Road"  : the lifestyle face. Traveler, gentleman,
+ *      fashionista, photographer, celebrity, a warm flirt with the world.
+ *      Carries a light web/life toolbelt — deliberately small so its schemas
+ *      cost little context on an 8k-window local model.
+ *
+ * Keeping the tool schemas split is the point: a Pal only advertises what it
+ * needs, so each face leaves more of the context window for the conversation.
+ *
+ * Both are seeded idempotently by PalStore.initialize() (same pattern as
+ * Pip/Lookie): an existing record is never overwritten, so user edits survive
+ * app restarts.
+ */
+
+import type {Pal, TalentRef} from '../types/pal';
+
+type SeedPal = Omit<Pal, 'id' | 'created_at' | 'updated_at'>;
+
+/** The Desk: the full analytical + RE + document-pipeline toolbelt. */
+const DESK_TALENTS: TalentRef[] = [
+  'finance',
+  'leasing',
+  'developer_cashflow',
+  'financial_statements',
+  'credit_memo',
+  'egypt_economy',
+  'csv',
+  'xlsx',
+  'pdf',
+  'charts',
+  'scratchpad',
+  'calculate',
+  'render_html',
+  'datetime',
+  'code_edit',
+  'encoding',
+  'regex',
+  'logcat',
+  'hash_checksum',
+  'apk_inspect',
+  'dictation',
+  'deep_search',
+  'microsoft_graph',
+  'memory',
+].map(name => ({name, necessity: 'required' as const}));
+
+/** The Road: light, web-facing, and the lifestyle kit. The small schema
+ *  footprint is a feature — it leaves room for conversation on an 8k window.
+ *  charts/scratchpad are deliberately left off the default (they're desk
+ *  tools); add them in the pact editor if a trip ever needs them. */
+const ROAD_TALENTS: TalentRef[] = [
+  'web_search',
+  'read_url',
+  'render_html',
+  'datetime',
+  'calculate',
+  'finance',
+  'csv',
+  'egypt_economy',
+  'regex',
+  'travel_budget',
+  'exif',
+  'gpx_route',
