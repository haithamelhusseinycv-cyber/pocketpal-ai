+    facility_amount: 10000000,
+    currency: 'USD',
+    facility_type: 'term loan',
+    tenor_months: 60,
+    pricing: {rate: 0.08, margin: 0.03},
+    purpose: 'Working capital and expansion',
+    covenants: ['DSCR >= 1.25x', 'Debt/EBITDA <= 3.0x'],
+    key_ratios: {npv: 1250000, irr: 0.145, dscr: 1.45},
+    risks: ['Market volatility', 'Concentration risk'],
+    mitigants: ['Diversified customer base', 'Strong management team'],
+    recommendation: 'approve_with_conditions',
+    analyst_name: 'Jane Smith',
+  };
+
+  it('exposes name "credit_memo"', () => {
+    expect(engine.name).toBe('credit_memo');
+  });
+
+  it('returns an html TalentResult with all sections present', async () => {
+    const result = await engine.execute(validInputs);
+    expect(result.type).toBe('html');
+    if (result.type === 'html') {
+      expect(result.summary).toMatch(/credit_memo SUCCESS/i);
+      expect(result.summary).toContain('Acme Corp');
+      expect(result.summary).toContain('FACILITY SUMMARY');
+      expect(result.summary).toContain('PURPOSE');
+      expect(result.summary).toContain('FINANCIAL ANALYSIS');
+      expect(result.summary).toContain('COVENANTS');
+      expect(result.summary).toContain('KEY RISKS');
+      expect(result.summary).toContain('MITIGANTS');
+      expect(result.summary).toContain('RECOMMENDATION');
+      expect(result.html).toBeDefined();
+      expect(result.title).toBe('Credit Memo — Acme Corp');
+    }
+  });
+
+  it('includes supplied key_ratios verbatim in output', async () => {
+    const result = await engine.execute(validInputs);
+    if (result.type === 'html') {
+      expect(result.summary).toContain('npv: 1250000');
+      expect(result.summary).toContain('irr: 0.145');
+      expect(result.summary).toContain('dscr: 1.45');
+      // HTML should also contain these
+      expect(result.html).toContain('npv');
+      expect(result.html).toContain('1250000');
+    }
+  });
+
+  it('labels missing ratios as "not provided" and does not fabricate figures', async () => {
+    const result = await engine.execute(validInputs);
+    if (result.type === 'html') {
+      // wacc, leverage, etc. were not supplied
+      expect(result.summary).toContain('wacc: not provided — compute via the finance tool');
+      expect(result.summary).toContain('leverage: not provided — compute via the finance tool');
+      expect(result.summary).toContain('gearing: not provided — compute via the finance tool');
+      // HTML should also show not provided
+      expect(result.html).toContain('not provided — compute via the finance tool');
+      // Should NOT contain fabricated numbers for missing ratios
+      expect(result.summary).not.toMatch(/wacc:\s*\d+/);
+      expect(result.summary).not.toMatch(/leverage:\s*\d+/);
+    }
+  });
+
+  it('HTML-escapes malicious borrower_name to prevent XSS', async () => {
+    const malicious = {
+      ...validInputs,
+      borrower_name: '<script>alert("xss")</script>',
+    };
+    const result = await engine.execute(malicious);
+    if (result.type === 'html') {
+      // Should NOT contain raw script tag
+      expect(result.html).not.toContain('<script>');
+      expect(result.html).not.toContain('</script>');
+      // Should contain escaped version
+      expect(result.html).toContain('&lt;script&gt;');
+      expect(result.html).toContain('&lt;/script&gt;');
+      // Summary should contain the raw string (it's not HTML)
+      expect(result.summary).toContain('<script>alert("xss")</script>');
+    }
+  });
+
+  it('HTML-escapes special characters in all user-provided strings', async () => {
+    const specialChars = {
+      ...validInputs,
+      borrower_name: 'O\'Brien & Sons <LLC>',
+      purpose: 'Test "quotes" & <angles>',
+      covenants: ['Covenant with "special" chars & <symbols>'],
+      risks: ['Risk with \'apostrophes\''],
+    };
+    const result = await engine.execute(specialChars);
+    if (result.type === 'html') {
+      // All special chars should be escaped in HTML
+      expect(result.html).toContain('&amp;');
+      expect(result.html).toContain('&lt;');
+      expect(result.html).toContain('&gt;');
+      expect(result.html).toContain('&quot;');
+      expect(result.html).toContain('&#x27;');
+      // Should NOT contain unescaped special chars in HTML (except in style/script which we control)
+      expect(result.html).not.toContain('O\'Brien & Sons <LLC>');
+    }
+  });
+
+  it('returns error for missing required field: borrower_name', async () => {
+    const result = await engine.execute({...validInputs, borrower_name: ''});
+    expect(result.type).toBe('error');
+    if (result.type === 'error') {
+      expect(result.errorMessage).toMatch(/borrower_name is required/);
+    }
+  });
+
+  it('returns error for missing required field: facility_amount', async () => {
+    const result = await engine.execute({...validInputs, facility_amount: undefined});
+    expect(result.type).toBe('error');
+    if (result.type === 'error') {
+      expect(result.errorMessage).toMatch(/facility_amount is required/);
+    }
+  });
+
+  it('returns error for invalid facility_amount (negative)', async () => {
+    const result = await engine.execute({...validInputs, facility_amount: -1000});
+    expect(result.type).toBe('error');
+    if (result.type === 'error') {
+      expect(result.errorMessage).toMatch(/facility_amount is required/);
+    }
+  });
+
+  it('returns error for missing required field: facility_type', async () => {
+    const result = await engine.execute({...validInputs, facility_type: ''});
+    expect(result.type).toBe('error');
+    if (result.type === 'error') {
+      expect(result.errorMessage).toMatch(/facility_type is required/);
+    }
+  });
+
+  it('returns error for missing required field: tenor_months', async () => {
+    const result = await engine.execute({...validInputs, tenor_months: undefined});
+    expect(result.type).toBe('error');
+    if (result.type === 'error') {
+      expect(result.errorMessage).toMatch(/tenor_months is required/);
+    }
+  });
+
+  it('returns error for invalid recommendation enum', async () => {
+    const result = await engine.execute({...validInputs, recommendation: 'maybe'});
+    expect(result.type).toBe('error');
+    if (result.type === 'error') {
+      expect(result.errorMessage).toMatch(/recommendation must be one of/);
+    }
+  });
+
+  it('accepts valid recommendation enum values', async () => {
+    for (const rec of ['approve', 'approve_with_conditions', 'decline', 'refer']) {
+      const result = await engine.execute({...validInputs, recommendation: rec});
+      expect(result.type).toBe('html');
+    }
+  });
+
+  it('handles optional fields gracefully when omitted', async () => {
+    const minimal = {
+      borrower_name: 'Test Co',
+      facility_amount: 5000000,
+      facility_type: 'revolving',
+      tenor_months: 36,
+    };
+    const result = await engine.execute(minimal);
+    expect(result.type).toBe('html');
+    if (result.type === 'html') {
+      expect(result.summary).toContain('Test Co');
+      expect(result.summary).toContain('Not specified');
+      expect(result.summary).toContain('No covenants specified');
+      expect(result.summary).toContain('No risks specified');
+    }
+  });
+
+  it('formats facility_amount with thousands separator', async () => {
+    const result = await engine.execute(validInputs);
+    if (result.type === 'html') {
+      // 10000000 should be formatted as 10,000,000
+      expect(result.summary).toContain('10,000,000');
+    }
+  });
+
+  describe('toToolDefinition', () => {
+    it('returns a valid ToolDefinition with correct name', () => {
+      const def = engine.toToolDefinition();
+      expect(def.type).toBe('function');
+      expect(def.function.name).toBe('credit_memo');
+      expect(typeof def.function.description).toBe('string');
+      expect(def.function.parameters).toBeDefined();
+      expect(def.function.parameters.required).toContain('borrower_name');
+      expect(def.function.parameters.required).toContain('facility_amount');
+      expect(def.function.parameters.required).toContain('facility_type');
+      expect(def.function.parameters.required).toContain('tenor_months');
+    });
+
+    it('includes key_ratios in parameters', () => {
+      const def = engine.toToolDefinition();
+      expect(def.function.parameters.properties.key_ratios).toBeDefined();
+      expect(def.function.parameters.properties.key_ratios.type).toBe('object');
+    });
+
+    it('includes recommendation enum', () => {
+      const def = engine.toToolDefinition();
+      expect(def.function.parameters.properties.recommendation.enum).toEqual([
+        'approve',
+        'approve_with_conditions',
+        'decline',
+        'refer',
+      ]);
+    });
+  });
+
+  describe('systemPromptFragment', () => {
+    it('returns a non-empty system prompt fragment', () => {
+      const ctx = {
+        now: new Date(),
+        maxToolTurns: 10,
+        activeTalents: new Set(['credit_memo', 'finance']),
+      };
+      const fragment = engine.systemPromptFragment!(ctx);
+      expect(fragment).toBeTruthy();
+      expect(fragment).toContain('CREDIT MEMO TOOL POLICY');
+      expect(fragment).toContain('finance tool');
+      expect(fragment).toContain('not provided');
