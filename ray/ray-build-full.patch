+import {TalentEngine, TalentResult, ToolDefinition} from './types';
+
+/**
+ * Deterministic credit/financial analytics.
+ *
+ * The point of this talent is that numbers come out of arithmetic, not out of
+ * the model. RAY's first policy is "never invent a figure" — this engine makes
+ * that structurally true for NPV, IRR, DSCR, amortisation, sensitivity, WACC,
+ * payback, covenant testing and EGP/FX discounting work by computing them here
+ * and returning the result plus the inputs used.
+ *
+ * Deliberately dependency-free: no new npm packages, no eval, no expression
+ * parser. Every operation is a closed-form or bisection routine with explicit
+ * input validation, so the failure modes are predictable and auditable.
+ *
+ * All rates are decimals (0.12 = 12%), all cash flows end-of-period unless
+ * stated. Rounding is presentational only — intermediate maths stays full
+ * precision.
+ */
+
+/** Round for display without corrupting the underlying value. */
+function round(value: number, decimals = 2): number {
+  if (!Number.isFinite(value)) {
+    return NaN;
+  }
+  const factor = Math.pow(10, decimals);
+  return Math.round((value + Number.EPSILON) * factor) / factor;
+}
+
+/** Percent formatter: 0.0891 -> "8.91%". */
+function pct(value: number, decimals = 2): string {
+  return Number.isFinite(value) ? `${round(value * 100, decimals)}%` : 'n/a';
+}
+
+/** Money formatter with thousands separators, no currency symbol assumed. */
+function money(value: number, decimals = 2): string {
+  if (!Number.isFinite(value)) {
+    return 'n/a';
+  }
+  return value.toLocaleString('en-US', {
+    minimumFractionDigits: decimals,
+    maximumFractionDigits: decimals,
+  });
+}
+
+/** Coerce an unknown arg to a finite number, or null if unusable. */
+function num(value: unknown): number | null {
+  const n = typeof value === 'number' ? value : parseFloat(String(value));
+  return Number.isFinite(n) ? n : null;
+}
+
+/** Coerce an unknown arg to an array of finite numbers, or null. */
+function numArray(value: unknown): number[] | null {
+  if (!Array.isArray(value) || value.length === 0) {
+    return null;
+  }
+  const parsed: number[] = [];
+  for (const item of value) {
+    const n = num(item);
+    if (n === null) {
+      return null;
+    }
+    parsed.push(n);
+  }
+  return parsed;
+}
+
+function err(summary: string, errorMessage: string): TalentResult {
+  return {type: 'error', summary, errorMessage};
+}
+
+/**
+ * Net present value. cashFlows[0] is conventionally the t0 outlay (negative),
+ * but no sign structure is enforced — the caller owns the convention.
+ */
+export function computeNpv(
+  cashFlows: number[],
+  discountRate: number,
+): number {
+  if (discountRate <= -1) {
+    return NaN;
+  }
+  let npv = 0;
+  for (let t = 0; t < cashFlows.length; t++) {
+    npv += cashFlows[t] / Math.pow(1 + discountRate, t);
+  }
+  return npv;
+}
+
+/**
+ * Internal rate of return via bisection.
+ *
+ * Bisection rather than Newton: Newton diverges on irregular sign patterns,
+ * which is exactly what real credit cash flows look like. Slower but bounded,
+ * and it fails cleanly by returning null when there is no root in range.
+ *
+ * Requires at least one sign change; a stream of all-positive flows has no IRR.
+ */
+export function computeIrr(
+  cashFlows: number[],
+  tolerance = 1e-7,
+  maxIterations = 200,
+): number | null {
+  let low = -0.9999;
+  let high = 10;
+
+  const npvAt = (rate: number) => computeNpv(cashFlows, rate);
+
+  let fLow = npvAt(low);
+  let fHigh = npvAt(high);
+
+  if (!Number.isFinite(fLow) || !Number.isFinite(fHigh)) {
+    return null;
+  }
+  // No bracket => no root in range. Common when all flows share one sign.
+  if (fLow * fHigh > 0) {
+    return null;
+  }
+
+  for (let i = 0; i < maxIterations; i++) {
+    const mid = (low + high) / 2;
+    const fMid = npvAt(mid);
+    if (!Number.isFinite(fMid)) {
+      return null;
+    }
+    if (Math.abs(fMid) < tolerance || (high - low) / 2 < tolerance) {
+      return mid;
+    }
+    if (fLow * fMid < 0) {
+      high = mid;
+      fHigh = fMid;
+    } else {
+      low = mid;
+      fLow = fMid;
+    }
+  }
+  return (low + high) / 2;
+}
+
+/**
+ * Level-payment amortisation schedule.
+ * Returns the periodic payment plus a per-period breakdown.
+ * rate is the periodic rate matching periodCount (monthly rate for a monthly
+ * schedule) — callers must convert an annual rate themselves, and the summary
+ * echoes what was used so a mismatch is visible.
+ */
+export interface AmortisationRow {
+  period: number;
+  payment: number;
+  principal: number;
+  interest: number;
+  balance: number;
+}
+
+export function computeAmortisation(
+  principal: number,
+  periodicRate: number,
+  periodCount: number,
+): {payment: number; rows: AmortisationRow[]; totalInterest: number} {
+  if (principal <= 0 || periodCount <= 0 || !Number.isInteger(periodCount)) {
+    return {payment: NaN, rows: [], totalInterest: NaN};
+  }
+
+  const payment =
+    periodicRate === 0
+      ? principal / periodCount
+      : (principal * periodicRate) / (1 - Math.pow(1 + periodicRate, -periodCount));
+
+  const rows: AmortisationRow[] = [];
+  let balance = principal;
+  let totalInterest = 0;
+
+  for (let p = 1; p <= periodCount; p++) {
+    const interest = balance * periodicRate;
+    // Final period absorbs rounding drift so the schedule closes at exactly 0.
+    const principalPart =
+      p === periodCount ? balance : Math.min(payment - interest, balance);
+    const actualPayment = principalPart + interest;
+    balance -= principalPart;
+    totalInterest += interest;
+    rows.push({
+      period: p,
+      payment: actualPayment,
+      principal: principalPart,
+      interest,
+      balance: Math.max(balance, 0),
+    });
+  }
+
+  return {payment, rows, totalInterest};
+}
+
+/**
+ * CFADS (cash flow available for debt service) and DSCR.
+ *
+ * Accepts either a direct cashFlow figure or its components. Component route is
+ * the one credit memos actually use: EBITDA less cash tax, capex and working
+ * capital movement.
+ */
+export function computeDscr(input: {
+  cashFlow?: number | null;
+  ebitda?: number | null;
+  cashTax?: number | null;
+  capex?: number | null;
+  deltaWorkingCapital?: number | null;
+  debtService: number;
+}): {cfads: number; dscr: number} {
+  const cfads =
+    input.cashFlow !== null && input.cashFlow !== undefined
+      ? input.cashFlow
+      : (input.ebitda ?? 0) -
+        (input.cashTax ?? 0) -
+        (input.capex ?? 0) -
+        (input.deltaWorkingCapital ?? 0);
+
+  return {
+    cfads,
+    dscr: input.debtService === 0 ? NaN : cfads / input.debtService,
+  };
+}
+
+/**
+ * Weighted average cost of capital.
+ * WACC = E/(E+D)*Re + D/(E+D)*Rd*(1 - tax)
+ */
+export function computeWacc(input: {
+  costOfEquity: number;
+  costOfDebt: number;
+  taxRate: number;
+  equityValue: number;
+  debtValue: number;
+}): {wacc: number; equityWeight: number; debtWeight: number} {
+  const total = input.equityValue + input.debtValue;
+  const equityWeight = input.equityValue / total;
+  const debtWeight = input.debtValue / total;
+  const wacc =
+    equityWeight * input.costOfEquity +
+    debtWeight * input.costOfDebt * (1 - input.taxRate);
+  return {wacc, equityWeight, debtWeight};
+}
+
+/**
+ * Payback period (undiscounted) and optionally discounted payback.
+ *
+ * initialInvestment is a positive number (the outlay). cashFlows are the
+ * per-period inflows (t1..tn). Interpolates the fractional final period.
+ * Returns null for the payback figure when cumulative flows never recoup.
+ */
+export function computePayback(input: {
+  initialInvestment: number;
+  cashFlows: number[];
+  discountRate?: number;
+}): {
+  paybackPeriod: number | null;
+  discountedPaybackPeriod: number | null;
+  cumulativeFlows: number[];
+  discountedCumulativeFlows: number[];
+  totalUndiscounted: number;
+  totalDiscounted: number;
+} {
+  let cumulative = -input.initialInvestment;
+  let discCumulative = -input.initialInvestment;
+  const cumulativeFlows: number[] = [];
+  const discountedCumulativeFlows: number[] = [];
+  let paybackPeriod: number | null = null;
+  let discountedPaybackPeriod: number | null = null;
+  const rate = input.discountRate;
+
+  for (let t = 0; t < input.cashFlows.length; t++) {
+    const prev = cumulative;
+    cumulative += input.cashFlows[t];
+    cumulativeFlows.push(cumulative);
+
+    if (paybackPeriod === null && cumulative >= 0) {
+      // Interpolate: fraction of this period needed to reach zero from prev.
+      const denom = cumulative - prev;
+      const fraction = denom > 0 ? -prev / denom : 0;
+      paybackPeriod = t + fraction; // t is 0-based index, period = t+1 but fraction already accounts for it
+    }
+
+    if (rate !== undefined && rate > -1) {
+      const period = t + 1;
+      const discounted = input.cashFlows[t] / Math.pow(1 + rate, period);
+      const prevDisc = discCumulative;
+      discCumulative += discounted;
+      discountedCumulativeFlows.push(discCumulative);
+
+      if (discountedPaybackPeriod === null && discCumulative >= 0) {
+        const denom = discCumulative - prevDisc;
+        const fraction = denom > 0 ? -prevDisc / denom : 0;
+        discountedPaybackPeriod = t + fraction;
+      }
+    }
+  }
+
+  if (rate === undefined || rate <= -1) {
+    discountedCumulativeFlows.length = 0;
+  }
+
+  return {
+    paybackPeriod,
+    discountedPaybackPeriod: rate !== undefined && rate > -1 ? discountedPaybackPeriod : null,
+    cumulativeFlows,
+    discountedCumulativeFlows,
+    totalUndiscounted: cumulative,
+    totalDiscounted: discCumulative,
+  };
+}
+
+/**
+ * Covenant breach testing over a projection.
+ *
+ * For each period, checks DSCR against a minimum and leverage against a
+ * maximum. Reports which periods breach, the first breach, and the margin.
+ */
+export interface CovenantPeriodResult {
+  period: number;
+  dscr: number | null;
+  leverage: number | null;
+  dscrBreached: boolean;
+  leverageBreached: boolean;
+  dscrMargin: number | null;
+  leverageMargin: number | null;
+}
+
+export function computeCovenant(input: {
+  dscrByPeriod?: number[];
+  leverageByPeriod?: number[];
+  dscrMin?: number;
+  leverageMax?: number;
+}): {
+  periods: CovenantPeriodResult[];
+  firstBreachPeriod: number | null;
+  totalBreaches: number;
+  dscrBreaches: number;
+  leverageBreaches: number;
+} {
+  const dscrArr = input.dscrByPeriod ?? [];
+  const levArr = input.leverageByPeriod ?? [];
+  const len = Math.max(dscrArr.length, levArr.length);
+
+  const periods: CovenantPeriodResult[] = [];
+  let firstBreach: number | null = null;
+  let totalBreaches = 0;
+  let dscrBreaches = 0;
+  let leverageBreaches = 0;
+
+  for (let i = 0; i < len; i++) {
+    const dscr = i < dscrArr.length ? dscrArr[i] : null;
+    const leverage = i < levArr.length ? levArr[i] : null;
+
+    const dscrBreached =
+      dscr !== null && input.dscrMin !== undefined && dscr < input.dscrMin;
+    const leverageBreached =
+      leverage !== null &&
+      input.leverageMax !== undefined &&
+      leverage > input.leverageMax;
+
+    const dscrMargin =
+      dscr !== null && input.dscrMin !== undefined ? dscr - input.dscrMin : null;
+    const leverageMargin =
+      leverage !== null && input.leverageMax !== undefined
+        ? input.leverageMax - leverage
+        : null;
+
+    if (dscrBreached) {
+      dscrBreaches++;
+    }
+    if (leverageBreached) {
+      leverageBreaches++;
+    }
+    if (dscrBreached || leverageBreached) {
+      totalBreaches++;
+      if (firstBreach === null) {
+        firstBreach = i + 1; // 1-indexed period
+      }
+    }
+
+    periods.push({
+      period: i + 1,
+      dscr,
+      leverage,
+      dscrBreached,
+      leverageBreached,
+      dscrMargin,
+      leverageMargin,
+    });
+  }
+
+  return {periods, firstBreachPeriod: firstBreach, totalBreaches, dscrBreaches, leverageBreaches};
+}
+
+/**
+ * EGP/FX-aware discounting for Egypt credit work.
+ *
+ * Discounts a series of EGP cash flows at a real EGP rate. If an FX path
+ * (EGP per USD by period) is supplied, also converts each flow to USD and
+ * discounts at a USD discount rate.
+ */
+export function computeEgpDiscount(input: {
+  cashFlowsEgp: number[];
+  discountRateEgp: number;
+  fxPath?: number[];
+  usdDiscountRate?: number;
+}): {
+  npvEgp: number;
+  npvUsd: number | null;
+  usdFlows: number[] | null;
+  discountedEgpFlows: number[];
+  discountedUsdFlows: number[] | null;
+} {
+  const discountedEgpFlows: number[] = [];
+  let npvEgp = 0;
+
+  for (let t = 0; t < input.cashFlowsEgp.length; t++) {
+    const df = Math.pow(1 + input.discountRateEgp, t);
+    const discounted = input.cashFlowsEgp[t] / df;
+    discountedEgpFlows.push(discounted);
+    npvEgp += discounted;
+  }
+
+  let npvUsd: number | null = null;
+  let usdFlows: number[] | null = null;
+  let discountedUsdFlows: number[] | null = null;
+
+  if (
+    input.fxPath &&
+    input.usdDiscountRate !== undefined &&
+    input.usdDiscountRate > -1
+  ) {
+    usdFlows = [];
+    discountedUsdFlows = [];
+    npvUsd = 0;
+
+    for (let t = 0; t < input.cashFlowsEgp.length; t++) {
+      const fxRate = t < input.fxPath.length ? input.fxPath[t] : input.fxPath[input.fxPath.length - 1];
+      const usdFlow = fxRate > 0 ? input.cashFlowsEgp[t] / fxRate : 0;
+      usdFlows.push(usdFlow);
+
+      const dfUsd = Math.pow(1 + input.usdDiscountRate, t);
+      const discountedUsd = usdFlow / dfUsd;
+      discountedUsdFlows.push(discountedUsd);
+      npvUsd += discountedUsd;
+    }
+  }
+
+  return {npvEgp, npvUsd, usdFlows, discountedEgpFlows, discountedUsdFlows};
+}
+
+export class FinanceEngine implements TalentEngine {
+  readonly name = 'finance';
+
+  /** DCF and amortisation both want room for multi-period schedules. */
+  readonly recommendedContextTokens = 4096;
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const operation =
+      typeof args.operation === 'string' ? args.operation.toLowerCase() : '';
+
+    switch (operation) {
+      case 'npv':
+        return this.npv(args);
+      case 'irr':
+        return this.irr(args);
+      case 'dscr':
+        return this.dscr(args);
+      case 'amortisation':
+      case 'amortization':
+        return this.amortisation(args);
+      case 'sensitivity':
+        return this.sensitivity(args);
+      case 'wacc':
+        return this.wacc(args);
+      case 'payback':
+        return this.payback(args);
+      case 'covenant':
+        return this.covenant(args);
+      case 'egp_discount':
+        return this.egpDiscount(args);
+      default:
+        return err(
+          `finance: unknown operation "${operation || '(missing)'}"`,
+          'operation must be one of: npv, irr, dscr, amortisation, sensitivity, wacc, payback, covenant, egp_discount',
+        );
+    }
+  }
+
+  private npv(args: Record<string, any>): TalentResult {
+    const cashFlows = numArray(args.cash_flows);
+    const rate = num(args.discount_rate);
+
+    if (!cashFlows) {
+      return err(
+        'finance.npv: "cash_flows" must be a non-empty numeric array',
+        'cash_flows is required, e.g. [-1000000, 300000, 400000, 500000]',
+      );
+    }
+    if (rate === null) {
+      return err(
+        'finance.npv: "discount_rate" must be a number',
+        'discount_rate is required as a decimal, e.g. 0.12 for 12%',
+      );
+    }
+    if (rate <= -1) {
+      return err(
+        'finance.npv: discount_rate must be greater than -1',
+        `received ${rate}; a rate of -100% or lower has no defined present value`,
+      );
+    }
+
+    const npv = computeNpv(cashFlows, rate);
+    const total = cashFlows.reduce((a, b) => a + b, 0);
+
+    return {
+      type: 'text',
+      summary:
+        `NPV @ ${pct(rate)} = ${money(npv)}\n` +
+        `Undiscounted total = ${money(total)}\n` +
+        `Periods = ${cashFlows.length} (t0..t${cashFlows.length - 1}, end-of-period)\n` +
+        `Inputs = [${cashFlows.map(c => money(c, 0)).join(', ')}]\n` +
+        `Verdict: ${npv >= 0 ? 'value-accretive at this hurdle rate' : 'destroys value at this hurdle rate'}`,
+    };
+  }
+
+  private irr(args: Record<string, any>): TalentResult {
+    const cashFlows = numArray(args.cash_flows);
+    if (!cashFlows) {
+      return err(
+        'finance.irr: "cash_flows" must be a non-empty numeric array',
+        'cash_flows is required and must contain at least one sign change',
+      );
+    }
+
+    const irr = computeIrr(cashFlows);
+    if (irr === null) {
+      const signs = new Set(cashFlows.filter(c => c !== 0).map(c => c > 0));
+      return err(
+        'finance.irr: no unique IRR found for these cash flows',
+        signs.size < 2
+          ? 'IRR requires at least one sign change (an outflow and an inflow)'
+          : 'Multiple sign changes may mean no stable root in (-99.99%, 1000%); use npv at explicit hurdle rates instead',
+      );
+    }
+
+    const npvAtIrr = computeNpv(cashFlows, irr);
+    // Bisection converges on the RATE (tolerance 1e-7), not on NPV. The
+    // residual is slope x rate_tolerance, so on large cash flows it prints as a
+    // visibly non-zero figure. Labelling that "≈0" invites the model to treat a
+    // correct solve as a failure, so express it relative to flow magnitude and
+    // state the rate precision instead.
+    const scale = Math.max(...cashFlows.map(c => Math.abs(c)));
+    const residualPct = scale > 0 ? Math.abs(npvAtIrr) / scale : 0;
+
+    return {
+      type: 'text',
+      summary:
+        `IRR = ${pct(irr, 4)}\n` +
+        `Converged: NPV residual ${money(npvAtIrr)} = ${pct(
+          residualPct,
+          6,
+        )} of largest cash flow; rate solved to ±0.00001 pp\n` +
+        `Inputs = [${cashFlows.map(c => money(c, 0)).join(', ')}]\n` +
+        `Note: IRR assumes reinvestment at the IRR itself. For credit or project work, compare against the actual hurdle rate rather than treating IRR as a return.`,
+    };
+  }
+
+  private dscr(args: Record<string, any>): TalentResult {
+    const debtService = num(args.debt_service);
+    if (debtService === null || debtService <= 0) {
+      return err(
+        'finance.dscr: "debt_service" must be a positive number',
+        'debt_service is total periodic principal + interest; DSCR is undefined at zero',
+      );
+    }
+
+    const cashFlow = num(args.cash_flow);
+    const ebitda = num(args.ebitda);
+
+    if (cashFlow === null && ebitda === null) {
+      return err(
+        'finance.dscr: provide either "cash_flow" or "ebitda"',
+        'pass cash_flow directly, or ebitda (with optional cash_tax, capex, delta_working_capital) to derive CFADS',
+      );
+    }
+
+    const {cfads, dscr} = computeDscr({
+      cashFlow,
+      ebitda,
+      cashTax: num(args.cash_tax),
+      capex: num(args.capex),
+      deltaWorkingCapital: num(args.delta_working_capital),
+      debtService,
+    });
+
+    if (!Number.isFinite(dscr)) {
+      return err('finance.dscr: computed DSCR is not finite', 'check inputs');
+    }
+
+    // Standard credit covenant bands. Stated so the model does not have to
+    // recall or invent a threshold.
+    let band: string;
+    if (dscr < 1.0) {
+      band = 'BELOW 1.00x — CFADS does not cover debt service; default risk';
+    } else if (dscr < 1.2) {
+      band = '1.00x–1.20x — thin; typical covenant floor breached or marginal';
+    } else if (dscr < 1.5) {
+      band = '1.20x–1.50x — acceptable; standard covenant territory';
+    } else if (dscr < 2.0) {
+      band = '1.50x–2.00x — comfortable cushion';
+    } else {
+      band = '≥2.00x — strong; capacity for additional leverage';
+    }
+
+    const components =
+      cashFlow !== null
+        ? `CFADS = ${money(cfads)} (supplied directly)`
+        : `CFADS = ${money(cfads)} = EBITDA ${money(ebitda ?? 0)}` +
+          ` − tax ${money(num(args.cash_tax) ?? 0)}` +
+          ` − capex ${money(num(args.capex) ?? 0)}` +
+          ` − ΔWC ${money(num(args.delta_working_capital) ?? 0)}`;
+
+    return {
+      type: 'text',
+      summary:
+        `DSCR = ${round(dscr, 2)}x\n` +
+        `${components}\n` +
+        `Debt service = ${money(debtService)}\n` +
+        `Assessment: ${band}`,
+    };
+  }
+
+  private amortisation(args: Record<string, any>): TalentResult {
+    const principal = num(args.principal);
+    const periodicRate = num(args.periodic_rate);
+    const periodCount = num(args.period_count);
+
+    if (principal === null || principal <= 0) {
+      return err(
+        'finance.amortisation: "principal" must be a positive number',
+        'principal is the drawn facility amount',
+      );
+    }
+    if (periodicRate === null || periodicRate < 0) {
+      return err(
+        'finance.amortisation: "periodic_rate" must be >= 0',
+        'this is the PER-PERIOD rate. For 12% p.a. monthly, pass 0.01 — not 0.12',
+      );
+    }
+    if (periodCount === null || periodCount <= 0 || !Number.isInteger(periodCount)) {
+      return err(
+        'finance.amortisation: "period_count" must be a positive integer',
+        `received ${args.period_count}`,
+      );
+    }
+
+    const {payment, rows, totalInterest} = computeAmortisation(
+      principal,
+      periodicRate,
+      periodCount,
+    );
+
+    if (!Number.isFinite(payment)) {
+      return err(
+        'finance.amortisation: could not compute a payment',
+        'check that periodic_rate and period_count are sane',
+      );
+    }
+
+    // Cap the printed schedule; long tenors would blow the context window.
+    const maxRows = 24;
+    const shown = rows.slice(0, maxRows);
+    const table = [
+      'per | payment | principal | interest | balance',
+      ...shown.map(
+        r =>
+          `${String(r.period).padStart(3)} | ${money(r.payment)} | ${money(
+            r.principal,
+          )} | ${money(r.interest)} | ${money(r.balance)}`,
+      ),
+    ].join('\n');
+
+    const truncated =
+      rows.length > maxRows
+        ? `\n... ${rows.length - maxRows} further periods omitted (ask for a specific period range if needed)`
+        : '';
+
+    return {
+      type: 'text',
+      summary:
+        `Level payment = ${money(payment)} per period\n` +
+        `Principal = ${money(principal)} @ ${pct(periodicRate, 4)} per period over ${periodCount} periods\n` +
+        `Total interest = ${money(totalInterest)}\n` +
+        `Total repayment = ${money(principal + totalInterest)}\n\n` +
+        `${table}${truncated}\n\n` +
+        `Inputs as used: principal ${money(principal)}, periodic_rate ${pct(
+          periodicRate,
+          4,
+        )}, period_count ${periodCount}.\n` +
+        this.annualiseRate(periodicRate, num(args.periods_per_year)),
+    };
+  }
+
+  /**
+   * Annualise a periodic rate for the convention check.
+   *
+   * Frequency is NOT inferable from period_count — 60 periods is 5 years
+   * monthly or 60 years annually. So it takes an explicit periods_per_year and
+   * refuses to guess when absent, which is what RAY's "never invent a figure"
+   * policy requires.
+   */
+  private annualiseRate(
+    periodicRate: number,
+    periodsPerYear: number | null,
+  ): string {
+    if (periodsPerYear === null || periodsPerYear <= 0) {
+      return (
+        `Rate convention: periodic_rate ${pct(
+          periodicRate,
+          4,
+        )} applies per period. Payment frequency was not supplied, so no annual ` +
+        `rate is inferred — pass periods_per_year (12 monthly, 4 quarterly, 2 ` +
+        `semi-annual, 1 annual) to annualise.`
+      );
+    }
+
+    const nominal = periodicRate * periodsPerYear;
+    const effective = Math.pow(1 + periodicRate, periodsPerYear) - 1;
+    const freqName =
+      periodsPerYear === 12
+        ? 'monthly'
+        : periodsPerYear === 4
+        ? 'quarterly'
+        : periodsPerYear === 2
+        ? 'semi-annual'
+        : periodsPerYear === 1
+        ? 'annual'
+        : `${periodsPerYear}x per year`;
+
+    return (
+      `Rate convention (${freqName}): periodic_rate ${pct(
+        periodicRate,
+        4,
+      )} → nominal annual ${pct(nominal, 2)}, effective annual ${pct(
+        effective,
+        2,
+      )}. Verify this matches the intended facility pricing.`
+    );
+  }
+
+  private sensitivity(args: Record<string, any>): TalentResult {
+    const cashFlows = numArray(args.cash_flows);
+    const rates = numArray(args.discount_rates);
+
+    if (!cashFlows) {
+      return err(
+        'finance.sensitivity: "cash_flows" must be a non-empty numeric array',
+        'cash_flows is required',
+      );
+    }
+    if (!rates || rates.length < 2) {
+      return err(
+        'finance.sensitivity: "discount_rates" must be an array of >= 2 numbers',
+        'pass the hurdle rates to sweep, e.g. [0.10, 0.12, 0.14, 0.16]',
+      );
+    }
+    if (rates.some(r => r <= -1)) {
+      return err(
+        'finance.sensitivity: all discount_rates must be greater than -1',
+        'a rate of -100% or lower has no defined present value',
+      );
+    }
+
+    const results = rates.map(r => ({rate: r, npv: computeNpv(cashFlows, r)}));
+    const irr = computeIrr(cashFlows);
+
+    // Breakeven is where NPV crosses zero — that is the IRR when it exists.
+    const positives = results.filter(r => r.npv >= 0);
+    const negatives = results.filter(r => r.npv < 0);
+    const spansZero = positives.length > 0 && negatives.length > 0;
+
+    const grid = [
+      'rate | NPV | verdict',
+      ...results.map(
+        r =>
+          `${pct(r.rate).padStart(8)} | ${money(r.npv).padStart(16)} | ${
+            r.npv >= 0 ? 'accretive' : 'destroys value'
+          }`,
+      ),
+    ].join('\n');
+
+    const best = results.reduce((a, b) => (b.npv > a.npv ? b : a));
+    const worst = results.reduce((a, b) => (b.npv < a.npv ? b : a));
+
+    return {
+      type: 'text',
+      summary:
+        `NPV sensitivity across ${results.length} hurdle rates\n\n${grid}\n\n` +
+        `Range: best ${money(best.npv)} @ ${pct(best.rate)}, worst ${money(worst.npv)} @ ${pct(worst.rate)}\n` +
+        `Spread: ${money(best.npv - worst.npv)}\n` +
+        (irr !== null
+          ? `Breakeven rate (IRR) = ${pct(irr, 4)} — NPV crosses zero here\n`
+          : 'Breakeven: no sign change within the swept range\n') +
+        (spansZero
+          ? `Decision flips inside the tested range: viable below ~${pct(
+              irr ?? best.rate,
+            )}, not above.`
+          : `Decision does NOT flip in this range — all rates are ${
+              positives.length === results.length ? 'viable' : 'unviable'
+            }.`),
+    };
+  }
+
+  private wacc(args: Record<string, any>): TalentResult {
+    const costOfEquity = num(args.cost_of_equity);
+    const costOfDebt = num(args.cost_of_debt);
+    const taxRate = num(args.tax_rate);
+    const equityValue = num(args.equity_value);
+    const debtValue = num(args.debt_value);
+
+    if (costOfEquity === null) {
+      return err(
+        'finance.wacc: "cost_of_equity" must be a number',
+        'cost_of_equity is the required return on equity as a decimal, e.g. 0.15 for 15%',
+      );
+    }
+    if (costOfDebt === null) {
+      return err(
+        'finance.wacc: "cost_of_debt" must be a number',
+        'cost_of_debt is the interest rate on debt as a decimal, e.g. 0.08 for 8%',
+      );
+    }
+    if (taxRate === null || taxRate < 0 || taxRate >= 1) {
+      return err(
+        'finance.wacc: "tax_rate" must be a number in [0, 1)',
+        'tax_rate is the corporate tax rate as a decimal, e.g. 0.25 for 25%',
+      );
+    }
+    if (equityValue === null || equityValue < 0) {
+      return err(
+        'finance.wacc: "equity_value" must be a non-negative number',
+        'equity_value is the market value of equity',
+      );
+    }
+    if (debtValue === null || debtValue < 0) {
+      return err(
+        'finance.wacc: "debt_value" must be a non-negative number',
+        'debt_value is the market value of debt',
+      );
+    }
+    if (equityValue === 0 && debtValue === 0) {
+      return err(
+        'finance.wacc: equity_value + debt_value must be > 0',
+        'WACC is undefined when total capital is zero',
+      );
+    }
+
+    const {wacc, equityWeight, debtWeight} = computeWacc({
+      costOfEquity,
+      costOfDebt,
+      taxRate,
+      equityValue,
+      debtValue,
+    });
+
+    return {
+      type: 'text',
+      summary:
+        `WACC = ${pct(wacc, 4)}\n` +
+        `Capital structure: equity ${money(equityValue)} (${pct(equityWeight, 2)}), debt ${money(debtValue)} (${pct(debtWeight, 2)})\n` +
+        `Cost of equity = ${pct(costOfEquity, 2)}, cost of debt = ${pct(costOfDebt, 2)}, tax rate = ${pct(taxRate, 2)}\n` +
+        `Formula: WACC = E/(E+D)*Re + D/(E+D)*Rd*(1-t)\n` +
+        `Inputs: cost_of_equity ${pct(costOfEquity, 2)}, cost_of_debt ${pct(costOfDebt, 2)}, tax_rate ${pct(taxRate, 2)}, equity_value ${money(equityValue)}, debt_value ${money(debtValue)}`,
+    };
+  }
+
+  private payback(args: Record<string, any>): TalentResult {
+    const initialInvestment = num(args.initial_investment);
+    const cashFlows = numArray(args.cash_flows);
+    const discountRate = num(args.discount_rate);
+
+    if (initialInvestment === null || initialInvestment <= 0) {
+      return err(
+        'finance.payback: "initial_investment" must be a positive number',
+        'initial_investment is the upfront outlay (a positive number, not negative)',
+      );
+    }
+    if (!cashFlows) {
+      return err(
+        'finance.payback: "cash_flows" must be a non-empty numeric array',
+        'cash_flows are the per-period inflows (t1..tn)',
+      );
+    }
+
+    const result = computePayback({
+      initialInvestment,
+      cashFlows,
+      discountRate: discountRate ?? undefined,
+    });
+
+    const paybackStr =
+      result.paybackPeriod !== null
+        ? `${round(result.paybackPeriod, 2)} periods`
+        : 'never recouped';
+
+    let summary =
+      `Payback period = ${paybackStr}\n` +
+      `Initial investment = ${money(initialInvestment)}\n` +
+      `Cash flows = [${cashFlows.map(c => money(c, 0)).join(', ')}]\n` +
+      `Total undiscounted inflows = ${money(cashFlows.reduce((a, b) => a + b, 0))}\n` +
+      `Cumulative at end = ${money(result.totalUndiscounted)}`;
+
+    if (discountRate !== null) {
+      const discPaybackStr =
+        result.discountedPaybackPeriod !== null
+          ? `${round(result.discountedPaybackPeriod, 2)} periods`
+          : 'never recouped (discounted)';
+      summary +=
+        `\n\nDiscounted payback @ ${pct(discountRate)} = ${discPaybackStr}\n` +
+        `Discounted cumulative at end = ${money(result.totalDiscounted)}`;
+    }
+
+    summary += `\n\nInputs: initial_investment ${money(initialInvestment)}, cash_flows [${cashFlows.map(c => money(c, 0)).join(', ')}]` +
+      (discountRate !== null ? `, discount_rate ${pct(discountRate)}` : '');
+
+    return {type: 'text', summary};
+  }
+
+  private covenant(args: Record<string, any>): TalentResult {
+    const dscrByPeriod = numArray(args.dscr_by_period);
+    const leverageByPeriod = numArray(args.leverage_by_period);
+    const dscrMin = num(args.dscr_min);
+    const leverageMax = num(args.leverage_max);
+
+    if (!dscrByPeriod && !leverageByPeriod) {
+      return err(
+        'finance.covenant: provide at least one of "dscr_by_period" or "leverage_by_period"',
+        'pass arrays of per-period DSCR and/or leverage ratios',
+      );
+    }
+    if (dscrMin === null && leverageMax === null) {
+      return err(
+        'finance.covenant: provide at least one of "dscr_min" or "leverage_max"',
+        'dscr_min is the minimum acceptable DSCR (e.g. 1.2), leverage_max is the maximum acceptable leverage (e.g. 4.0)',
+      );
+    }
+    if (dscrMin !== null && dscrMin <= 0) {
+      return err(
+        'finance.covenant: "dscr_min" must be positive',
+        'DSCR is a ratio; a non-positive threshold is not meaningful',
+      );
+    }
+    if (leverageMax !== null && leverageMax <= 0) {
+      return err(
+        'finance.covenant: "leverage_max" must be positive',
+        'leverage is a ratio; a non-positive threshold is not meaningful',
+      );
+    }
+
+    const result = computeCovenant({
+      dscrByPeriod: dscrByPeriod ?? undefined,
+      leverageByPeriod: leverageByPeriod ?? undefined,
+      dscrMin: dscrMin ?? undefined,
+      leverageMax: leverageMax ?? undefined,
+    });
+
+    const breachLines = result.periods
+      .filter(p => p.dscrBreached || p.leverageBreached)
+      .map(p => {
+        const parts: string[] = [`Period ${p.period}`];
+        if (p.dscrBreached && p.dscr !== null) {
+          parts.push(`DSCR ${round(p.dscr, 2)}x < ${dscrMin}x (margin ${round(p.dscrMargin!, 2)})`);
+        }
+        if (p.leverageBreached && p.leverage !== null) {
+          parts.push(`Leverage ${round(p.leverage, 2)}x > ${leverageMax}x (margin ${round(p.leverageMargin!, 2)})`);
+        }
+        return parts.join(': ');
+      });
+
+    const firstBreachStr =
+      result.firstBreachPeriod !== null ? `period ${result.firstBreachPeriod}` : 'none';
+
+    let summary =
+      `Covenant breaches: ${result.totalBreaches} period(s)\n` +
+      `First breach: ${firstBreachStr}\n` +
+      (dscrMin !== null ? `DSCR threshold: min ${dscrMin}x (${result.dscrBreaches} breach(es))\n` : '') +
+      (leverageMax !== null ? `Leverage threshold: max ${leverageMax}x (${result.leverageBreaches} breach(es))\n` : '');
+
+    if (breachLines.length > 0) {
+      summary += `\nBreach details:\n${breachLines.join('\n')}\n`;
+    } else {
+      summary += `\nNo breaches detected.\n`;
+    }
+
+    summary += `\nInputs: `;
+    if (dscrByPeriod) {
+      summary += `dscr_by_period [${dscrByPeriod.map(d => round(d, 2)).join(', ')}]`;
+    }
+    if (leverageByPeriod) {
+      if (dscrByPeriod) summary += ', ';
+      summary += `leverage_by_period [${leverageByPeriod.map(l => round(l, 2)).join(', ')}]`;
+    }
+    if (dscrMin !== null) summary += `, dscr_min ${dscrMin}`;
+    if (leverageMax !== null) summary += `, leverage_max ${leverageMax}`;
+
+    return {type: 'text', summary};
+  }
+
+  private egpDiscount(args: Record<string, any>): TalentResult {
+    const cashFlowsEgp = numArray(args.cash_flows_egp);
+    const discountRateEgp = num(args.discount_rate_egp);
+    const fxPath = numArray(args.fx_path);
+    const usdDiscountRate = num(args.usd_discount_rate);
+
+    if (!cashFlowsEgp) {
+      return err(
+        'finance.egp_discount: "cash_flows_egp" must be a non-empty numeric array',
+        'cash_flows_egp are the EGP-denominated cash flows (t0..tn)',
+      );
+    }
+    if (discountRateEgp === null || discountRateEgp <= -1) {
+      return err(
+        'finance.egp_discount: "discount_rate_egp" must be a number > -1',
+        'discount_rate_egp is the real EGP discount rate as a decimal',
+      );
+    }
+    if (fxPath && fxPath.some(fx => fx <= 0)) {
+      return err(
+        'finance.egp_discount: all fx_path values must be positive',
+        'fx_path is EGP per USD by period; a non-positive rate is not meaningful',
+      );
+    }
+    if (fxPath && (usdDiscountRate === null || usdDiscountRate <= -1)) {
+      return err(
+        'finance.egp_discount: "usd_discount_rate" must be a number > -1 when fx_path is supplied',
+        'usd_discount_rate is the USD discount rate as a decimal',
+      );
+    }
+
+    const result = computeEgpDiscount({
+      cashFlowsEgp,
+      discountRateEgp,
+      fxPath: fxPath ?? undefined,
+      usdDiscountRate: usdDiscountRate ?? undefined,
+    });
+
+    let summary =
+      `NPV (EGP) @ ${pct(discountRateEgp)} = ${money(result.npvEgp)}\n` +
+      `Cash flows (EGP) = [${cashFlowsEgp.map(c => money(c, 0)).join(', ')}]\n` +
+      `Periods = ${cashFlowsEgp.length} (t0..t${cashFlowsEgp.length - 1})`;
+
+    if (result.npvUsd !== null && result.usdFlows) {
+      summary +=
+        `\n\nNPV (USD) @ ${pct(usdDiscountRate!)} = ${money(result.npvUsd)}\n` +
+        `FX path (EGP/USD) = [${fxPath!.map(fx => round(fx, 2)).join(', ')}]\n` +
+        `USD flows = [${result.usdFlows.map(u => money(u, 0)).join(', ')}]`;
+    }
+
+    summary += `\n\nInputs: cash_flows_egp [${cashFlowsEgp.map(c => money(c, 0)).join(', ')}], discount_rate_egp ${pct(discountRateEgp)}`;
+    if (fxPath) {
+      summary += `, fx_path [${fxPath.map(fx => round(fx, 2)).join(', ')}], usd_discount_rate ${pct(usdDiscountRate!)}`;
+    }
+
+    return {type: 'text', summary};
+  }
