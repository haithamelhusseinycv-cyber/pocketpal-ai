+
+    const sunriseH = parseInt(sunriseMatch![1]);
+    const sunriseM = parseInt(sunriseMatch![2]);
+    const sunsetH = parseInt(sunsetMatch![1]);
+    const sunsetM = parseInt(sunsetMatch![2]);
+
+    const sunriseMinutes = sunriseH * 60 + sunriseM;
+    const sunsetMinutes = sunsetH * 60 + sunsetM;
+
+    // Expected (NOAA, cross-checked): sunrise 02:54 UTC = 174 min,
+    // sunset 16:59 UTC = 1019 min. (Egypt is UTC+3 in June, so local
+    // sunrise ~05:54 / sunset ~19:59.) Within 5 minutes.
+    expect(Math.abs(sunriseMinutes - 174)).toBeLessThan(5);
+    expect(Math.abs(sunsetMinutes - 1019)).toBeLessThan(5);
