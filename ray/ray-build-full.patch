+    expect(dscr).toBeCloseTo(1.24, 2);
+  });
+
+  it('defaults omitted deductions to zero', () => {
+    expect(computeDscr({ebitda: 1000, debtService: 500}).cfads).toBe(1000);
+  });
+
+  it('returns NaN at zero debt service', () => {
+    expect(Number.isNaN(computeDscr({cashFlow: 100, debtService: 0}).dscr)).toBe(
+      true,
+    );
+  });
+});
