new file mode 100644
index 0000000..ad54c74
--- /dev/null
+++ b/src/services/graph/client.ts
@@ -0,0 +1,214 @@
+/**
+ * Microsoft Graph request builders — typed wrappers for the Graph API.
+ *
+ * Each function takes an access token, hits the right Graph path, and throws
+ * a GraphError with a proper code on non-2xx. The talent wraps these results
+ * with wrapUntrusted (Graph content is external/untrusted).
+ */
+
+import {GRAPH_BASE} from './config';
+import {GraphError} from './types';
+import type {
+  GraphUser,
+  GraphMessage,
+  GraphEvent,
+  GraphDriveItem,
+  ListMessagesOptions,
+  SendMailPayload,
+  CreateEventPayload,
+} from './types';
+
+// ─── Error mapping ───────────────────────────────────────────────────────────
+
+function mapGraphError(status: number, body: string): GraphError {
+  if (status === 401 || status === 403) {
+    return new GraphError('permission_denied', `Graph permission denied: ${body}`, status);
+  }
+  if (status === 404) {
+    return new GraphError('graph_error', `Graph resource not found: ${body}`, status);
+  }
+  if (status >= 500) {
+    return new GraphError('graph_error', `Graph server error: ${status} ${body}`, status);
+  }
+  return new GraphError('graph_error', `Graph error: ${status} ${body}`, status);
+}
+
+// ─── Generic fetch wrapper ───────────────────────────────────────────────────
+
+async function graphFetch<T>(
+  path: string,
+  accessToken: string,
+  options: RequestInit = {},
+): Promise<T> {
+  const url = path.startsWith('http') ? path : `${GRAPH_BASE}${path}`;
+
+  try {
+    const response = await fetch(url, {
+      ...options,
+      headers: {
+        Authorization: `Bearer ${accessToken}`,
+        'Content-Type': 'application/json',
+        ...options.headers,
+      },
+    });
+
+    if (!response.ok) {
+      const errorText = await response.text();
+      throw mapGraphError(response.status, errorText);
+    }
+
+    // Handle 204 No Content (e.g., successful send/delete)
+    if (response.status === 204) {
+      return {} as T;
+    }
+
+    return await response.json();
+  } catch (error) {
+    if (error instanceof GraphError) {
+      throw error;
+    }
+    throw new GraphError(
+      'network',
+      `Graph network error: ${error instanceof Error ? error.message : String(error)}`,
+    );
+  }
+}
+
+// ─── User profile ────────────────────────────────────────────────────────────
+
+/**
+ * Get the signed-in user's profile.
+ */
+export async function getMe(accessToken: string): Promise<GraphUser> {
+  return graphFetch<GraphUser>('/me', accessToken);
+}
+
+// ─── Mail ────────────────────────────────────────────────────────────────────
+
+/**
+ * List messages from the user's mailbox.
+ */
+export async function listMessages(
+  accessToken: string,
+  opts: ListMessagesOptions = {},
+): Promise<{value: GraphMessage[]}> {
+  const params = new URLSearchParams();
+
+  if (opts.top) params.set('$top', String(opts.top));
+  if (opts.skip) params.set('$skip', String(opts.skip));
+  if (opts.search) params.set('$search', `"${opts.search}"`);
+  if (opts.filter) params.set('$filter', opts.filter);
+  if (opts.orderBy) params.set('$orderby', opts.orderBy);
+
+  const query = params.toString();
+  const path = query ? `/me/messages?${query}` : '/me/messages';
+
+  return graphFetch<{value: GraphMessage[]}>(path, accessToken);
+}
+
+/**
+ * Read a specific message by ID.
+ */
+export async function readMessage(
+  accessToken: string,
+  messageId: string,
+): Promise<GraphMessage> {
+  return graphFetch<GraphMessage>(`/me/messages/${messageId}`, accessToken);
+}
+
+/**
+ * Send an email.
+ */
+export async function sendMail(
+  accessToken: string,
+  payload: SendMailPayload,
+): Promise<void> {
+  const body = {
+    message: {
+      subject: payload.subject,
+      body: payload.body,
+      toRecipients: payload.toRecipients,
+      ccRecipients: payload.ccRecipients || [],
+      importance: payload.importance || 'normal',
+    },
+    saveToSentItems: true,
+  };
+
+  await graphFetch<void>('/me/sendMail', accessToken, {
+    method: 'POST',
+    body: JSON.stringify(body),
+  });
+}
+
+// ─── Calendar ────────────────────────────────────────────────────────────────
+
+/**
+ * List calendar events within a date range.
+ */
+export async function listEvents(
+  accessToken: string,
+  rangeStart: string,
+  rangeEnd: string,
+): Promise<{value: GraphEvent[]}> {
+  const params = new URLSearchParams({
+    startDateTime: rangeStart,
+    endDateTime: rangeEnd,
+    '$orderby': 'start/dateTime',
+  });
+
+  return graphFetch<{value: GraphEvent[]}>(
+    `/me/calendarview?${params.toString()}`,
+    accessToken,
+  );
+}
+
+/**
+ * Create a calendar event.
+ */
+export async function createEvent(
+  accessToken: string,
+  payload: CreateEventPayload,
+): Promise<GraphEvent> {
+  return graphFetch<GraphEvent>('/me/events', accessToken, {
+    method: 'POST',
+    body: JSON.stringify(payload),
+  });
+}
+
+// ─── OneDrive ────────────────────────────────────────────────────────────────
+
+/**
+ * List items in the user's OneDrive root.
+ */
+export async function listDriveItems(
+  accessToken: string,
+): Promise<{value: GraphDriveItem[]}> {
+  return graphFetch<{value: GraphDriveItem[]}>(
+    '/me/drive/root/children',
+    accessToken,
+  );
+}
+
+/**
+ * Download a Drive item by ID.
+ * Returns the download URL (caller must fetch it separately for large files).
+ */
+export async function downloadDriveItem(
+  accessToken: string,
+  itemId: string,
+): Promise<{downloadUrl: string}> {
+  const item = await graphFetch<GraphDriveItem>(
+    `/me/drive/items/${itemId}`,
+    accessToken,
+  );
+
+  const downloadUrl = item['@microsoft.graph.downloadUrl'];
+  if (!downloadUrl) {
+    throw new GraphError(
+      'graph_error',
+      `No download URL available for item ${itemId}`,
+    );
+  }
+
+  return {downloadUrl};
+}
