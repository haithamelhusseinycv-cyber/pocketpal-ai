+/**
+ * Standalone test runner for PdfEngine and ScratchpadEngine.
+ * This file is bundled with esbuild and run in Node.
+ */
+import {PdfEngine} from './PdfEngine';
+import {ScratchpadEngine} from './ScratchpadEngine';
+
+// PDF validation helper
+function validatePdf(pdfStr: string) {
+  const errors: string[] = [];
+  const info: any = {};
+
+  if (!pdfStr.startsWith('%PDF-1.4')) {
+    errors.push('Missing %PDF-1.4 header');
+  }
+  info.hasHeader = pdfStr.startsWith('%PDF-1.4');
+
+  if (!pdfStr.trim().endsWith('%%EOF')) {
+    errors.push('Missing %%EOF tail');
+  }
+  info.hasEof = pdfStr.trim().endsWith('%%EOF');
+
+  const startxrefMatch = pdfStr.match(/startxref\s+(\d+)\s+%%EOF/);
+  if (!startxrefMatch) {
+    errors.push('Missing or malformed startxref');
+  } else {
+    const startxrefOffset = parseInt(startxrefMatch[1], 10);
+    info.startxrefOffset = startxrefOffset;
+
+    const actualAtOffset = pdfStr.substring(startxrefOffset, startxrefOffset + 4);
+    if (actualAtOffset !== 'xref') {
+      errors.push(`startxref offset ${startxrefOffset} does not point to 'xref' (found '${actualAtOffset}')`);
+    } else {
+      info.xrefValid = true;
+    }
+  }
+
+  const xrefMatch = pdfStr.match(/xref\s+0\s+(\d+)\s+([\s\S]*?)\s+trailer/);
+  if (xrefMatch) {
+    const objCount = parseInt(xrefMatch[1], 10);
+    const xrefEntries = xrefMatch[2].trim().split('\n');
+    info.xrefObjectCount = objCount;
+
+    let offsetErrors = 0;
+    for (let i = 1; i < objCount; i++) {
+      const entry = xrefEntries[i];
+      if (!entry) continue;
+      const match = entry.match(/^(\d{10})\s+\d+\s+n/);
+      if (!match) continue;
+      const expectedOffset = parseInt(match[1], 10);
+
+      const objPattern = new RegExp(`^${i} 0 obj`, 'm');
+      const objMatch = pdfStr.match(objPattern);
+      if (!objMatch) {
+        errors.push(`Object ${i} not found`);
+        continue;
+      }
+      const actualOffset = objMatch.index;
+      if (actualOffset !== expectedOffset) {
+        offsetErrors++;
+        if (offsetErrors <= 3) {
+          errors.push(`Object ${i} offset mismatch: xref says ${expectedOffset}, actual is ${actualOffset}`);
+        }
+      }
+    }
+    info.xrefOffsetErrors = offsetErrors;
+    info.allOffsetsCorrect = offsetErrors === 0;
+  }
+
+  return {errors, info};
+}
+
+async function testPdf() {
+  console.log('\n=== Testing PdfEngine ===\n');
+
+  const engine = new PdfEngine();
+
+  console.log('Test 1: Generating report PDF...');
+  const reportResult = await engine.execute({
+    operation: 'report',
+    title: 'Financial Analysis Report',
+    subtitle: 'Q4 2024 Review',
+    author: 'RAY System',
+    sections: [
+      {
+        heading: 'Executive Summary',
+        paragraphs: ['This report presents the financial analysis for Q4 2024.'],
+        bullets: ['Revenue growth: 15%', 'Margin improvement: 200bps', 'Debt reduction: $5M'],
+      },
+      {
+        heading: 'Key Metrics',
+        paragraphs: ['The following table shows key financial metrics:'],
+        table: {
+          headers: ['Metric', 'Q3 2024', 'Q4 2024', 'Change'],
+          rows: [
+            ['Revenue', '$100M', '$115M', '+15%'],
+            ['EBITDA', '$20M', '$23M', '+15%'],
+            ['Net Debt', '$50M', '$45M', '-10%'],
+          ],
+        },
+      },
+    ],
+    footer: 'Confidential - RAY System',
+    path: '/tmp/report.pdf',
+  });
+
+  if (reportResult.type === 'error') {
+    console.error('FAIL: Report generation failed:', reportResult.errorMessage);
+    return false;
+  }
+
+  console.log('✓ Report generated successfully');
+  console.log('  Summary:', reportResult.summary.split('\n')[0]);
+
+  return true;
+}
+
+async function testScratchpad() {
+  console.log('\n=== Testing ScratchpadEngine ===\n');
+
+  const engine = new ScratchpadEngine();
+
+  console.log('Test 1: Basic set/get...');
+  await engine.execute({operation: 'set', key: 'principal', value: 100000});
+  const getResult = await engine.execute({operation: 'get', key: 'principal'});
+  if (getResult.type !== 'text' || !getResult.summary.includes('value=100000')) {
+    console.error('FAIL: set/get failed');
+    return false;
+  }
+  console.log('✓ set/get works');
+
+  console.log('\nTest 2: Compute chain (principal * rate = interest)...');
+  await engine.execute({operation: 'set', key: 'rate', value: 0.12});
+  const computeResult = await engine.execute({
+    operation: 'compute',
+    key: 'interest',
+    expression: '@principal * @rate',
+  });
+
+  if (computeResult.type !== 'text') {
+    console.error('FAIL: compute failed:', computeResult.errorMessage);
+    return false;
+  }
+
+  console.log('  Result:', computeResult.summary);
+
+  if (!computeResult.summary.includes('result=12000')) {
+    console.error('FAIL: Expected result=12000');
+    return false;
+  }
+
+  console.log('✓ Compute chain works: @principal * @rate = 12000');
+
+  console.log('\nTest 3: Verify computed result is stored...');
+  const interestResult = await engine.execute({operation: 'get', key: 'interest'});
+  if (interestResult.type !== 'text' || !interestResult.summary.includes('value=12000')) {
+    console.error('FAIL: Computed result not stored correctly');
+    return false;
+  }
+  console.log('✓ Computed result stored correctly');
+
+  console.log('\nTest 4: Complex expression with parentheses...');
+  await engine.execute({operation: 'set', key: 'a', value: 10});
+  await engine.execute({operation: 'set', key: 'b', value: 5});
+  await engine.execute({operation: 'set', key: 'c', value: 2});
+  const complexResult = await engine.execute({
+    operation: 'compute',
+    key: 'result',
+    expression: '(@a + @b) * @c ^ 2',
+  });
+
+  if (complexResult.type !== 'text' || !complexResult.summary.includes('result=900')) {
+    console.error('FAIL: Complex expression failed');
+    console.error('  Got:', complexResult.summary);
+    return false;
+  }
+  console.log('✓ Complex expression works: (@a + @b) * @c ^ 2 = 900');
+
+  console.log('\nTest 5: Security checks...');
+
+  const unsafeTests = [
+    {expr: '__proto__', desc: '__proto__'},
+    {expr: 'constructor', desc: 'constructor'},
+    {expr: 'eval(1)', desc: 'eval'},
+    {expr: '(1 + 2', desc: 'unbalanced parens'},
+  ];
+
+  for (const test of unsafeTests) {
+    const result = await engine.execute({operation: 'compute', key: 'x', expression: test.expr});
+    if (result.type !== 'error') {
+      console.error(`FAIL: Should reject ${test.desc}`);
+      return false;
+    }
+  }
+  console.log('✓ Security checks pass');
+
+  console.log('\nTest 6: LRU eviction at 200 keys...');
+  await engine.execute({operation: 'clear'});
+
+  for (let i = 0; i < 205; i++) {
+    await engine.execute({operation: 'set', key: `k${i}`, value: i});
+  }
+
+  const listResult = await engine.execute({operation: 'list'});
+  if (listResult.type !== 'text' || !listResult.summary.includes('200 key(s)')) {
+    console.error('FAIL: LRU eviction failed');
+    return false;
+  }
+
+  const evictedResult = await engine.execute({operation: 'get', key: 'k0'});
+  if (evictedResult.type !== 'error') {
+    console.error('FAIL: Old keys should be evicted');
+    return false;
+  }
+  console.log('✓ LRU eviction works');
+
+  console.log('\nTest 7: Value size cap (100KB)...');
+  const bigValue = 'x'.repeat(110 * 1024);
+  const bigResult = await engine.execute({operation: 'set', key: 'big', value: bigValue});
+  if (bigResult.type !== 'error') {
+    console.error('FAIL: Should reject values over 100KB');
+    return false;
+  }
+  console.log('✓ Value size cap enforced');
+
+  return true;
+}
+
+async function main() {
+  console.log('=== Standalone Verification Harness ===\n');
+
+  try {
+    const pdfOk = await testPdf();
+    const scratchpadOk = await testScratchpad();
+
+    console.log('\n=== Summary ===\n');
+    console.log(`PdfEngine: ${pdfOk ? 'PASS' : 'FAIL'}`);
+    console.log(`ScratchpadEngine: ${scratchpadOk ? 'PASS' : 'FAIL'}`);
+
+    if (pdfOk && scratchpadOk) {
+      console.log('\n✓ All tests passed');
