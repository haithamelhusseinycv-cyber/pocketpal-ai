+  private efficiency(args: Record<string, any>): TalentResult {
+    const revenue = num(args.revenue);
+    const cogs = num(args.cogs);
+    const avgAR = num(args.avg_receivables) ?? num(args.receivables);
+    const avgInv = num(args.avg_inventory) ?? num(args.inventory);
+    const avgAP = num(args.avg_payables) ?? num(args.payables);
+    const avgAssets = num(args.avg_assets) ?? num(args.total_assets);
+
+    // Track whether averages were used or period-end balances
+    const usedPeriodEnd: string[] = [];
+    if (num(args.avg_receivables) === null && num(args.receivables) !== null) {
+      usedPeriodEnd.push('receivables (period-end used — averages not supplied)');
+    }
+    if (num(args.avg_inventory) === null && num(args.inventory) !== null) {
+      usedPeriodEnd.push('inventory (period-end used — averages not supplied)');
+    }
+    if (num(args.avg_payables) === null && num(args.payables) !== null) {
+      usedPeriodEnd.push('payables (period-end used — averages not supplied)');
+    }
+    if (num(args.avg_assets) === null && num(args.total_assets) !== null) {
+      usedPeriodEnd.push('total_assets (period-end used — averages not supplied)');
+    }
+
+    const inputLines: string[] = [];
+    if (revenue !== null) inputLines.push(`revenue = ${money(revenue)}`);
+    if (cogs !== null) inputLines.push(`cogs = ${money(cogs)}`);
+    if (avgAR !== null) inputLines.push(`avg_receivables = ${money(avgAR)}`);
+    if (avgInv !== null) inputLines.push(`avg_inventory = ${money(avgInv)}`);
+    if (avgAP !== null) inputLines.push(`avg_payables = ${money(avgAP)}`);
+    if (avgAssets !== null) inputLines.push(`avg_assets = ${money(avgAssets)}`);
+
+    const lines: string[] = ['Efficiency ratios (rules-of-thumb, not hard thresholds):'];
+    const missing: string[] = [];
+
+    // DSO = avg_receivables / revenue * 365
+    if (avgAR === null || revenue === null) {
+      const needed: string[] = [];
+      if (avgAR === null) needed.push('avg_receivables (or receivables)');
+      if (revenue === null) needed.push('revenue');
+      lines.push(`dso: not computable — missing ${needed.join(', ')}`);
+      missing.push('dso');
+    } else {
+      const val = safeDiv(avgAR, revenue);
+      if (val === null) {
+        lines.push('dso: n/a (denominator zero — revenue = 0)');
+      } else {
+        const dso = val * 365;
+        lines.push(`dso = ${round(dso, 2)} days`);
+      }
+    }
+
+    // DIO = avg_inventory / cogs * 365
+    if (avgInv === null || cogs === null) {
+      const needed: string[] = [];
+      if (avgInv === null) needed.push('avg_inventory (or inventory)');
+      if (cogs === null) needed.push('cogs');
+      lines.push(`dio: not computable — missing ${needed.join(', ')}`);
+      missing.push('dio');
+    } else {
+      const val = safeDiv(avgInv, cogs);
+      if (val === null) {
+        lines.push('dio: n/a (denominator zero — cogs = 0)');
+      } else {
+        const dio = val * 365;
+        lines.push(`dio = ${round(dio, 2)} days`);
+      }
+    }
+
+    // DPO = avg_payables / cogs * 365
+    if (avgAP === null || cogs === null) {
+      const needed: string[] = [];
+      if (avgAP === null) needed.push('avg_payables (or payables)');
+      if (cogs === null) needed.push('cogs');
+      lines.push(`dpo: not computable — missing ${needed.join(', ')}`);
+      missing.push('dpo');
+    } else {
+      const val = safeDiv(avgAP, cogs);
+      if (val === null) {
+        lines.push('dpo: n/a (denominator zero — cogs = 0)');
+      } else {
+        const dpo = val * 365;
+        lines.push(`dpo = ${round(dpo, 2)} days`);
+      }
+    }
+
+    // CCC = DSO + DIO - DPO
+    // Only compute if all three are computable
+    const dsoVal = (avgAR !== null && revenue !== null && revenue !== 0) ? (avgAR / revenue * 365) : null;
+    const dioVal = (avgInv !== null && cogs !== null && cogs !== 0) ? (avgInv / cogs * 365) : null;
+    const dpoVal = (avgAP !== null && cogs !== null && cogs !== 0) ? (avgAP / cogs * 365) : null;
+
+    if (dsoVal !== null && dioVal !== null && dpoVal !== null) {
+      const ccc = dsoVal + dioVal - dpoVal;
+      let interp: string;
+      if (ccc < 0) {
+        interp = 'negative — supplier financing exceeds collection cycle (very efficient)';
+      } else if (ccc < 30) {
+        interp = 'short — good working-capital efficiency';
+      } else if (ccc < 60) {
+        interp = 'moderate';
+      } else if (ccc < 90) {
+        interp = 'elevated — working capital tied up';
+      } else {
+        interp = 'long — significant working-capital strain';
+      }
+      lines.push(`cash_conversion_cycle = ${round(ccc, 2)} days — ${interp}`);
+    } else {
+      lines.push('cash_conversion_cycle: not computable — requires dso, dio, and dpo');
+      missing.push('cash_conversion_cycle');
+    }
+
+    // asset_turnover = revenue / avg_assets
+    if (revenue === null || avgAssets === null) {
+      const needed: string[] = [];
+      if (revenue === null) needed.push('revenue');
+      if (avgAssets === null) needed.push('avg_assets (or total_assets)');
+      lines.push(`asset_turnover: not computable — missing ${needed.join(', ')}`);
+      missing.push('asset_turnover');
+    } else {
+      const val = safeDiv(revenue, avgAssets);
+      if (val === null) {
+        lines.push('asset_turnover: n/a (denominator zero — avg_assets = 0)');
+      } else {
+        lines.push(`asset_turnover = ${round(val, 2)}x`);
+      }
+    }
+
+    if (usedPeriodEnd.length > 0) {
+      lines.push(`\nNote: ${usedPeriodEnd.join('; ')}. A real analyst flags this — averages are preferred for ratio analysis.`);
+    }
+
+    if (missing.length > 0) {
+      lines.push(`\nNote: ${missing.join(', ')} omitted due to missing inputs — no figures were estimated.`);
+    }
+
+    lines.push(`\nInputs used: ${inputLines.join(', ')}`);
+
+    return {type: 'text', summary: lines.join('\n')};
+  }
+
+  private commonSize(args: Record<string, any>): TalentResult {
+    const items = numMap(args.items);
+    const basisTotal = num(args.basis_total);
+    const basis = typeof args.basis === 'string' ? args.basis.toLowerCase() : 'revenue';
+
+    if (!items || Object.keys(items).length === 0) {
+      return err(
+        'financial_statements.common_size: "items" (map of label→number) is required',
+        'pass items as {label: value, ...} e.g. {cogs: 1200, gross_profit: 800}',
+      );
+    }
+    if (basisTotal === null || basisTotal === 0) {
+      return err(
+        'financial_statements.common_size: "basis_total" must be a non-zero number',
+        'basis_total is the denominator (e.g. revenue for IS, total_assets for BS)',
+      );
+    }
+
+    const lines: string[] = [`Common-size analysis (basis: ${basis}):`];
+    const itemLines: string[] = [];
+    for (const [label, value] of Object.entries(items)) {
+      const percentage = value / basisTotal;
+      itemLines.push(`  ${label}: ${money(value)} = ${pct(percentage)} of ${basis}`);
+    }
+    lines.push(...itemLines);
+    lines.push(`\nBasis total = ${money(basisTotal)}`);
+
+    const inputSummary = Object.entries(items).map(([k, v]) => `${k} = ${money(v)}`).join(', ');
+    lines.push(`Inputs used: items {${inputSummary}}, basis_total = ${money(basisTotal)}, basis = ${basis}`);
+
+    return {type: 'text', summary: lines.join('\n')};
+  }
+
+  private trend(args: Record<string, any>): TalentResult {
+    const series = numSeriesMap(args.series);
+
+    if (!series || Object.keys(series).length === 0) {
+      return err(
+        'financial_statements.trend: "series" (map of metric→number[]) is required',
+        'pass series as {metric_name: [period1, period2, ...], ...}',
+      );
+    }
+
+    const lines: string[] = ['Trend analysis (period basis is the user\'s — no annualisation assumed):'];
+
+    for (const [metric, values] of Object.entries(series)) {
+      lines.push(`\n${metric}: [${values.map(v => money(v)).join(', ')}] (${values.length} periods)`);
+
+      // Total change
+      const totalChange = values[values.length - 1] - values[0];
+      const totalPct = values[0] !== 0 ? safeDiv(totalChange, values[0]) : null;
+      if (totalPct !== null) {
+        lines.push(`  total change: ${totalChange >= 0 ? '+' : ''}${money(totalChange)} (${totalPct >= 0 ? '+' : ''}${pct(totalPct)})`);
+      } else {
+        lines.push(`  total change: ${money(totalChange)} (% not computable — first period = 0)`);
+      }
+
+      // Period-over-period growth
+      if (values.length >= 2) {
+        lines.push('  period-over-period:');
+        for (let i = 1; i < values.length; i++) {
+          const absChange = values[i] - values[i - 1];
+          const pctChange = values[i - 1] !== 0 ? safeDiv(absChange, values[i - 1]) : null;
+          const direction = absChange >= 0 ? '↑' : '↓';
+          if (pctChange !== null) {
+            lines.push(`    ${i}→${i + 1}: ${absChange >= 0 ? '+' : ''}${money(absChange)} (${pctChange >= 0 ? '+' : ''}${pct(pctChange)}) ${direction}`);
+          } else {
+            lines.push(`    ${i}→${i + 1}: ${absChange >= 0 ? '+' : ''}${money(absChange)} (% n/a — base = 0) ${direction}`);
+          }
+        }
+      } else {
+        lines.push('  period-over-period: not computable — only one period supplied');
+      }
+
+      // CAGR = (last/first)^(1/(n-1)) - 1, requires n>=2 and first!=0
+      const n = values.length;
+      if (n >= 2 && values[0] !== 0) {
+        const ratio = values[n - 1] / values[0];
+        // If ratio is negative (sign change), CAGR is undefined for non-integer exponents
+        if (ratio > 0) {
+          const cagr = Math.pow(ratio, 1 / (n - 1)) - 1;
+          lines.push(`  CAGR: ${pct(cagr)} (over ${n - 1} period transition(s))`);
+        } else {
+          lines.push(`  CAGR: not computable — series changes sign (negative start or end value)`);
+        }
+      } else if (n >= 2 && values[0] === 0) {
+        lines.push('  CAGR: not computable — first period value is zero');
+      } else {
+        lines.push('  CAGR: not computable — need at least 2 periods');
+      }
+    }
+
+    const seriesSummary = Object.entries(series)
+      .map(([k, v]) => `${k} = [${v.join(', ')}]`)
+      .join('; ');
+    lines.push(`\nInputs used: series {${seriesSummary}}`);
+    lines.push('Period basis is the user\'s — no annualisation was applied.');
+
+    return {type: 'text', summary: lines.join('\n')};
+  }
+
+  private dupont(args: Record<string, any>): TalentResult {
+    const netIncome = num(args.net_income);
+    const revenue = num(args.revenue);
+    const ta = num(args.total_assets);
+    const te = num(args.total_equity);
+
+    const inputLines: string[] = [];
+    if (netIncome !== null) inputLines.push(`net_income = ${money(netIncome)}`);
+    if (revenue !== null) inputLines.push(`revenue = ${money(revenue)}`);
+    if (ta !== null) inputLines.push(`total_assets = ${money(ta)}`);
+    if (te !== null) inputLines.push(`total_equity = ${money(te)}`);
+
+    const lines: string[] = ['DuPont 3-factor decomposition:'];
+
+    // Check all required inputs
+    if (netIncome === null || revenue === null || ta === null || te === null) {
+      const needed: string[] = [];
+      if (netIncome === null) needed.push('net_income');
+      if (revenue === null) needed.push('revenue');
+      if (ta === null) needed.push('total_assets');
+      if (te === null) needed.push('total_equity');
+      lines.push(`ROE: not computable — missing ${needed.join(', ')}`);
+      lines.push(`\nNote: omitted due to missing inputs — no figures were estimated.`);
+      lines.push(`\nInputs used: ${inputLines.join(', ')}`);
+      return {type: 'text', summary: lines.join('\n')};
+    }
+
+    // net_margin = net_income / revenue
+    const netMargin = safeDiv(netIncome, revenue);
+    if (netMargin === null) {
+      lines.push('net_margin: n/a (denominator zero — revenue = 0)');
+      lines.push('ROE: not computable — net_margin undefined');
+      lines.push(`\nInputs used: ${inputLines.join(', ')}`);
+      return {type: 'text', summary: lines.join('\n')};
+    }
+
+    // asset_turnover = revenue / total_assets
+    const assetTurnover = safeDiv(revenue, ta);
+    if (assetTurnover === null) {
+      lines.push(`net_margin = ${pct(netMargin)}`);
+      lines.push('asset_turnover: n/a (denominator zero — total_assets = 0)');
+      lines.push('ROE: not computable — asset_turnover undefined');
+      lines.push(`\nInputs used: ${inputLines.join(', ')}`);
+      return {type: 'text', summary: lines.join('\n')};
+    }
+
+    // equity_multiplier = total_assets / total_equity
+    const equityMultiplier = safeDiv(ta, te);
+    if (equityMultiplier === null) {
+      lines.push(`net_margin = ${pct(netMargin)}`);
+      lines.push(`asset_turnover = ${round(assetTurnover, 2)}x`);
+      lines.push('equity_multiplier: n/a (denominator zero — total_equity = 0)');
+      lines.push('ROE: not computable — equity_multiplier undefined');
+      lines.push(`\nInputs used: ${inputLines.join(', ')}`);
+      return {type: 'text', summary: lines.join('\n')};
+    }
+
+    // Product
+    const product = netMargin * assetTurnover * equityMultiplier;
+
+    // Direct ROE
+    const directROE = safeDiv(netIncome, te);
+
+    lines.push(`net_margin = net_income / revenue = ${money(netIncome)} / ${money(revenue)} = ${pct(netMargin)}`);
+    lines.push(`asset_turnover = revenue / total_assets = ${money(revenue)} / ${money(ta)} = ${round(assetTurnover, 2)}x`);
+    lines.push(`equity_multiplier = total_assets / total_equity = ${money(ta)} / ${money(te)} = ${round(equityMultiplier, 2)}x`);
+    lines.push(`\nDuPont ROE = net_margin × asset_turnover × equity_multiplier`);
+    lines.push(`         = ${round(netMargin, 6)} × ${round(assetTurnover, 6)} × ${round(equityMultiplier, 6)}`);
+    lines.push(`         = ${round(product, 6)} (${pct(product)})`);
+
+    if (directROE !== null) {
+      const diff = Math.abs(product - directROE);
+      lines.push(`\nDirect ROE = net_income / total_equity = ${money(netIncome)} / ${money(te)} = ${round(directROE, 6)} (${pct(directROE)})`);
+      if (diff < 1e-9) {
+        lines.push(`DuPont identity verified: product (${round(product, 6)}) = direct ROE (${round(directROE, 6)}) — difference < 1e-9`);
+      } else {
+        lines.push(`DuPont identity check: difference = ${diff} (rounding)`);
+      }
+    } else {
+      lines.push(`\nDirect ROE: n/a (denominator zero — total_equity = 0)`);
+    }
+
+    lines.push(`\nInputs used: ${inputLines.join(', ')}`);
+
+    return {type: 'text', summary: lines.join('\n')};
+  }
+
