+++ b/src/services/graph/config.ts
@@ -0,0 +1,247 @@
+/**
+ * Microsoft Graph configuration — endpoints, scopes, PKCE helpers.
+ *
+ * PKCE (Proof Key for Code Exchange) is required for public clients (mobile apps)
+ * per RFC 7636. We implement SHA-256 + base64url in pure TypeScript to avoid
+ * adding crypto dependencies.
+ */
+
+// ─── Endpoints ───────────────────────────────────────────────────────────────
+
+export const GRAPH_BASE = 'https://graph.microsoft.com/v1.0';
+export const LOGIN_BASE = 'https://login.microsoftonline.com';
+export const TENANT = 'common'; // multi-tenant: personal + work/school accounts
+
+export const AUTH_ENDPOINT = `${LOGIN_BASE}/${TENANT}/oauth2/v2.0/authorize`;
+export const TOKEN_ENDPOINT = `${LOGIN_BASE}/${TENANT}/oauth2/v2.0/token`;
+
+// ─── Scopes ──────────────────────────────────────────────────────────────────
+// Minimal set for the talent's operations. Each scope unlocks:
+//   - offline_access: refresh tokens (so we don't re-auth on every launch)
+//   - User.Read: signed-in user profile (name, mail)
+//   - Mail.Read: read Outlook mail
+//   - Mail.Send: send mail
+//   - Calendars.Read: read calendar events
+//   - Calendars.ReadWrite: create events
+//   - Files.Read: read OneDrive files
+
+export const DEFAULT_SCOPES = [
+  'offline_access',
+  'User.Read',
+  'Mail.Read',
+  'Mail.Send',
+  'Calendars.Read',
+  'Calendars.ReadWrite',
+  'Files.Read',
+];
+
+// ─── PKCE helpers (RFC 7636) ─────────────────────────────────────────────────
+
+/**
+ * Generate a code verifier: 43–128 unreserved characters (RFC 7636 §4.1).
+ * Uses crypto.getRandomValues when available (React Native), falls back to
+ * Math.random for test environments. NOT cryptographically strong in fallback.
+ */
+export function generateCodeVerifier(): string {
+  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~';
+  const len = 64; // middle of the 43–128 range
+  let verifier = '';
+
+  // Prefer crypto.getRandomValues (available in React Native)
+  if (typeof crypto !== 'undefined' && crypto.getRandomValues) {
+    const arr = new Uint8Array(len);
+    crypto.getRandomValues(arr);
+    for (let i = 0; i < len; i++) {
+      verifier += chars[arr[i] % chars.length];
+    }
+  } else {
+    // Fallback for test environments
+    for (let i = 0; i < len; i++) {
+      verifier += chars[Math.floor(Math.random() * chars.length)];
+    }
+  }
+
+  return verifier;
+}
+
+/**
+ * Pure TypeScript SHA-256 implementation (public domain).
+ * Based on the FIPS 180-4 specification.
+ */
+function sha256(message: string): Uint8Array {
+  // Initial hash values (first 32 bits of the fractional parts of the square roots of the first 8 primes)
+  let h0 = 0x6a09e667;
+  let h1 = 0xbb67ae85;
+  let h2 = 0x3c6ef372;
+  let h3 = 0xa54ff53a;
+  let h4 = 0x510e527f;
+  let h5 = 0x9b05688c;
+  let h6 = 0x1f83d9ab;
+  let h7 = 0x5be0cd19;
+
+  // Round constants (first 32 bits of the fractional parts of the cube roots of the first 64 primes)
+  const k = [
+    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+  ];
+
+  // Pre-processing: convert message to bytes (UTF-8)
+  const msgBytes: number[] = [];
+  for (let i = 0; i < message.length; i++) {
+    let c = message.charCodeAt(i);
+    if (c < 0x80) {
+      msgBytes.push(c);
+    } else if (c < 0x800) {
+      msgBytes.push(0xc0 | (c >> 6), 0x80 | (c & 0x3f));
+    } else if (c < 0x10000) {
+      msgBytes.push(0xe0 | (c >> 12), 0x80 | ((c >> 6) & 0x3f), 0x80 | (c & 0x3f));
+    } else {
+      msgBytes.push(
+        0xf0 | (c >> 18),
+        0x80 | ((c >> 12) & 0x3f),
+        0x80 | ((c >> 6) & 0x3f),
+        0x80 | (c & 0x3f),
+      );
+    }
+  }
+
+  // Append length in bits as 64-bit big-endian
+  const msgBitLen = msgBytes.length * 8;
+  msgBytes.push(0x80); // append 1 bit
+  while (msgBytes.length % 64 !== 56) {
+    msgBytes.push(0);
+  }
+  // Append 64-bit length (we only handle messages < 2^32 bits for simplicity)
+  msgBytes.push(0, 0, 0, 0); // high 32 bits (always 0 for our use case)
+  msgBytes.push(
+    (msgBitLen >>> 24) & 0xff,
+    (msgBitLen >>> 16) & 0xff,
+    (msgBitLen >>> 8) & 0xff,
+    msgBitLen & 0xff,
+  );
+
+  // Helper functions
+  const rotr = (n: number, x: number) => (x >>> n) | (x << (32 - n));
+  const ch = (x: number, y: number, z: number) => (x & y) ^ (~x & z);
+  const maj = (x: number, y: number, z: number) => (x & y) ^ (x & z) ^ (y & z);
+  const sigma0 = (x: number) => rotr(2, x) ^ rotr(13, x) ^ rotr(22, x);
+  const sigma1 = (x: number) => rotr(6, x) ^ rotr(11, x) ^ rotr(25, x);
+  const gamma0 = (x: number) => rotr(7, x) ^ rotr(18, x) ^ (x >>> 3);
+  const gamma1 = (x: number) => rotr(17, x) ^ rotr(19, x) ^ (x >>> 10);
+
+  // Process each 512-bit (64-byte) block
+  for (let offset = 0; offset < msgBytes.length; offset += 64) {
+    const w = new Array(64);
+
+    // Break block into sixteen 32-bit big-endian words
+    for (let i = 0; i < 16; i++) {
+      w[i] =
+        (msgBytes[offset + i * 4] << 24) |
+        (msgBytes[offset + i * 4 + 1] << 16) |
+        (msgBytes[offset + i * 4 + 2] << 8) |
+        msgBytes[offset + i * 4 + 3];
+    }
+
+    // Extend the sixteen 32-bit words into sixty-four 32-bit words
+    for (let i = 16; i < 64; i++) {
+      const s0 = gamma0(w[i - 15]);
+      const s1 = gamma1(w[i - 2]);
+      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) | 0;
+    }
+
+    // Initialize working variables
+    let a = h0;
+    let b = h1;
+    let c = h2;
+    let d = h3;
+    let e = h4;
+    let f = h5;
+    let g = h6;
+    let h = h7;
+
+    // Compression function
+    for (let i = 0; i < 64; i++) {
+      const S1 = sigma1(e);
+      const chVal = ch(e, f, g);
+      const temp1 = (h + S1 + chVal + k[i] + w[i]) | 0;
+      const S0 = sigma0(a);
+      const majVal = maj(a, b, c);
+      const temp2 = (S0 + majVal) | 0;
+
+      h = g;
+      g = f;
+      f = e;
+      e = (d + temp1) | 0;
+      d = c;
+      c = b;
+      b = a;
+      a = (temp1 + temp2) | 0;
+    }
+
+    // Add the compressed chunk to the current hash value
+    h0 = (h0 + a) | 0;
+    h1 = (h1 + b) | 0;
+    h2 = (h2 + c) | 0;
+    h3 = (h3 + d) | 0;
+    h4 = (h4 + e) | 0;
+    h5 = (h5 + f) | 0;
+    h6 = (h6 + g) | 0;
+    h7 = (h7 + h) | 0;
+  }
+
+  // Produce the final hash value (big-endian)
+  const digest = new Uint8Array(32);
+  const view = new DataView(digest.buffer);
+  view.setUint32(0, h0, false);
+  view.setUint32(4, h1, false);
+  view.setUint32(8, h2, false);
+  view.setUint32(12, h3, false);
+  view.setUint32(16, h4, false);
+  view.setUint32(20, h5, false);
+  view.setUint32(24, h6, false);
+  view.setUint32(28, h7, false);
+
+  return digest;
+}
+
+/**
+ * Base64url encoding (RFC 4648 §5): base64 with + → -, / → _, no padding.
+ */
+function base64url(bytes: Uint8Array): string {
+  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';
+  let result = '';
+
+  for (let i = 0; i < bytes.length; i += 3) {
+    const b1 = bytes[i];
+    const b2 = i + 1 < bytes.length ? bytes[i + 1] : 0;
+    const b3 = i + 2 < bytes.length ? bytes[i + 2] : 0;
+
+    result += chars[(b1 >> 2) & 0x3f];
+    result += chars[((b1 << 4) | (b2 >> 4)) & 0x3f];
+
+    if (i + 1 < bytes.length) {
+      result += chars[((b2 << 2) | (b3 >> 6)) & 0x3f];
+    }
+
+    if (i + 2 < bytes.length) {
+      result += chars[b3 & 0x3f];
+    }
+  }
+
+  return result;
+}
+
+/**
+ * Compute the code challenge from a code verifier (RFC 7636 §4.2).
+ * challenge = BASE64URL(SHA256(verifier))
+ */
+export function codeChallengeFromVerifier(verifier: string): string {
+  const digest = sha256(verifier);
+  return base64url(digest);
+}
