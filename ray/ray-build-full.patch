+  lat: 30.0444,
+  lon: 31.2357
+});
+console.log('✓ Calculated sun times');
+
+const sunriseMatch = cairoSunResult.summary.match(/Sunrise: (\d{2}:\d{2})/);
+const sunsetMatch = cairoSunResult.summary.match(/Sunset: (\d{2}:\d{2})/);
+const solarNoonMatch = cairoSunResult.summary.match(/Solar noon: (\d{2}:\d{2})/);
+const dayLengthMatch = cairoSunResult.summary.match(/Day length: ([\d.]+) hours/);
+
+const sunrise = sunriseMatch ? sunriseMatch[1] : '';
+const sunset = sunsetMatch ? sunsetMatch[1] : '';
+const solarNoon = solarNoonMatch ? solarNoonMatch[1] : '';
