+import {TalentEngine, TalentResult, ToolDefinition, SystemPromptContext} from './types';
+
+/**
+ * Credit-memo / write-up generator talent.
+ *
+ * RAY's first policy is "never invent a figure." This engine produces a
+ * structured credit memorandum from inputs the model supplies — including
+ * financial ratios that were ALREADY computed by the finance tool. The engine
+ * does NOT compute any financial figure itself; it formats what it is given
+ * and labels any missing ratio as "not provided — compute via the finance tool."
+ *
+ * Output: a structured text memo in `summary` (so the model can read/continue
+ * it) AND an HTML version in `html` for preview (using the 'html' result type).
+ *
+ * Security: all user-provided strings are HTML-escaped before interpolation
+ * to prevent XSS in the rendered preview.
+ */
+
+const KNOWN_RATIOS = [
+  'npv',
+  'irr',
+  'dscr',
+  'wacc',
+  'leverage',
+  'coverage_ratio',
+  'gearing',
+  'interest_cover',
+  'current_ratio',
+  'quick_ratio',
+  'debt_to_equity',
+  'ltv',
+] as const;
+
+const VALID_RECOMMENDATIONS = [
+  'approve',
+  'approve_with_conditions',
+  'decline',
+  'refer',
+] as const;
+
+/** HTML-escape a string to prevent injection in rendered output. */
+function esc(value: unknown): string {
+  const s = value == null ? '' : String(value);
+  return s
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#x27;');
+}
+
+/** Coerce to string or return fallback. */
+function str(value: unknown, fallback = ''): string {
+  return typeof value === 'string' && value.length > 0 ? value : fallback;
+}
+
+/** Coerce to array of strings. */
+function strArray(value: unknown): string[] {
+  if (!Array.isArray(value)) {
+    return [];
+  }
+  return value.filter((v): v is string => typeof v === 'string' && v.length > 0);
+}
+
+/** Coerce to a plain object (for key_ratios). */
+function obj(value: unknown): Record<string, unknown> | null {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+    return null;
+  }
+  return value as Record<string, unknown>;
+}
+
+interface MemoInputs {
+  borrower_name: string;
+  facility_amount: number;
+  currency: string;
+  facility_type: string;
+  tenor_months: number;
+  pricing: {rate?: number; margin?: number} | null;
+  purpose: string;
+  covenants: string[];
+  key_ratios: Record<string, unknown> | null;
+  risks: string[];
+  mitigants: string[];
+  recommendation: string;
+  analyst_name: string;
+}
+
+function parseInputs(args: Record<string, any>): {
+  ok: true;
+  inputs: MemoInputs;
+} | {ok: false; error: string} {
+  const borrower_name = str(args.borrower_name);
+  if (!borrower_name) {
+    return {ok: false, error: 'borrower_name is required and must be a non-empty string'};
+  }
+
+  const facility_amount = typeof args.facility_amount === 'number' ? args.facility_amount : parseFloat(String(args.facility_amount));
+  if (!Number.isFinite(facility_amount) || facility_amount <= 0) {
+    return {ok: false, error: 'facility_amount is required and must be a positive number'};
+  }
+
+  const currency = str(args.currency, 'USD');
+  const facility_type = str(args.facility_type);
+  if (!facility_type) {
+    return {ok: false, error: 'facility_type is required (e.g. term loan, revolving, working capital)'};
+  }
+
+  const tenor_months = typeof args.tenor_months === 'number' ? args.tenor_months : parseInt(String(args.tenor_months), 10);
+  if (!Number.isFinite(tenor_months) || tenor_months <= 0) {
+    return {ok: false, error: 'tenor_months is required and must be a positive integer'};
+  }
+
+  let pricing: {rate?: number; margin?: number} | null = null;
+  if (typeof args.pricing === 'object' && args.pricing !== null && !Array.isArray(args.pricing)) {
+    pricing = {};
+    if (typeof args.pricing.rate === 'number') {
+      pricing.rate = args.pricing.rate;
+    }
+    if (typeof args.pricing.margin === 'number') {
+      pricing.margin = args.pricing.margin;
+    }
+  }
+
+  const purpose = str(args.purpose);
+  const covenants = strArray(args.covenants);
+  const key_ratios = obj(args.key_ratios);
+  const risks = strArray(args.risks);
+  const mitigants = strArray(args.mitigants);
+
+  const recommendation = str(args.recommendation);
+  if (recommendation && !VALID_RECOMMENDATIONS.includes(recommendation as any)) {
+    return {ok: false, error: `recommendation must be one of: ${VALID_RECOMMENDATIONS.join(', ')}`};
+  }
+
+  const analyst_name = str(args.analyst_name);
+
+  return {
+    ok: true,
+    inputs: {
+      borrower_name,
+      facility_amount,
+      currency,
+      facility_type,
+      tenor_months,
+      pricing,
+      purpose,
+      covenants,
+      key_ratios,
+      risks,
+      mitigants,
+      recommendation,
+      analyst_name,
+    },
+  };
+}
+
+function formatRatioValue(value: unknown): string {
+  if (typeof value === 'number') {
+    return String(value);
+  }
+  if (typeof value === 'string') {
+    return value;
+  }
+  return String(value);
+}
+
+function buildTextMemo(inputs: MemoInputs): string {
+  const lines: string[] = [];
+
+  // Header
+  lines.push('CREDIT MEMORANDUM');
+  lines.push('='.repeat(60));
+  lines.push('');
+
+  // Facility Summary
+  lines.push('FACILITY SUMMARY');
+  lines.push('-'.repeat(40));
+  lines.push(`Borrower:        ${inputs.borrower_name}`);
+  lines.push(`Facility Amount: ${inputs.currency} ${inputs.facility_amount.toLocaleString()}`);
+  lines.push(`Facility Type:   ${inputs.facility_type}`);
+  lines.push(`Tenor:           ${inputs.tenor_months} months`);
+  if (inputs.pricing) {
+    const parts: string[] = [];
+    if (inputs.pricing.rate !== undefined) {
+      parts.push(`Rate: ${inputs.pricing.rate}`);
+    }
+    if (inputs.pricing.margin !== undefined) {
+      parts.push(`Margin: ${inputs.pricing.margin}`);
+    }
+    if (parts.length > 0) {
+      lines.push(`Pricing:         ${parts.join(', ')}`);
+    }
+  }
+  if (inputs.analyst_name) {
+    lines.push(`Analyst:         ${inputs.analyst_name}`);
+  }
+  lines.push('');
+
+  // Purpose
+  lines.push('PURPOSE');
+  lines.push('-'.repeat(40));
+  lines.push(inputs.purpose || 'Not specified.');
+  lines.push('');
+
+  // Financial Analysis
+  lines.push('FINANCIAL ANALYSIS');
+  lines.push('-'.repeat(40));
+  if (inputs.key_ratios && Object.keys(inputs.key_ratios).length > 0) {
+    lines.push('Key Ratios:');
+    for (const [key, value] of Object.entries(inputs.key_ratios)) {
+      lines.push(`  ${key}: ${formatRatioValue(value)}`);
+    }
+  } else {
+    lines.push('No key ratios provided.');
+  }
+  // Always note which standard ratios are missing
+  const missingRatios = KNOWN_RATIOS.filter(
+    r => !inputs.key_ratios || !(r in inputs.key_ratios),
+  );
+  if (missingRatios.length > 0) {
+    lines.push('');
+    lines.push('Ratios not provided (compute via the finance tool):');
+    for (const r of missingRatios) {
+      lines.push(`  ${r}: not provided — compute via the finance tool`);
+    }
+  }
+  lines.push('');
+
+  // Covenants
+  lines.push('COVENANTS');
+  lines.push('-'.repeat(40));
+  if (inputs.covenants.length > 0) {
+    inputs.covenants.forEach((c, i) => {
+      lines.push(`  ${i + 1}. ${c}`);
+    });
+  } else {
+    lines.push('No covenants specified.');
+  }
+  lines.push('');
+
+  // Key Risks
+  lines.push('KEY RISKS');
+  lines.push('-'.repeat(40));
+  if (inputs.risks.length > 0) {
+    inputs.risks.forEach((r, i) => {
+      lines.push(`  ${i + 1}. ${r}`);
+    });
+  } else {
+    lines.push('No risks specified.');
+  }
+  lines.push('');
+
+  // Mitigants
+  lines.push('MITIGANTS');
+  lines.push('-'.repeat(40));
+  if (inputs.mitigants.length > 0) {
+    inputs.mitigants.forEach((m, i) => {
+      lines.push(`  ${i + 1}. ${m}`);
+    });
+  } else {
+    lines.push('No mitigants specified.');
+  }
+  lines.push('');
+
+  // Recommendation
+  lines.push('RECOMMENDATION');
+  lines.push('-'.repeat(40));
+  lines.push(inputs.recommendation || 'Not specified.');
+  lines.push('');
+
+  return lines.join('\n');
+}
+
+function buildHtmlMemo(inputs: MemoInputs): string {
+  const e = esc;
+
+  const ratioRows: string[] = [];
+  const providedKeys = new Set<string>();
+
+  if (inputs.key_ratios) {
+    for (const [key, value] of Object.entries(inputs.key_ratios)) {
+      providedKeys.add(key);
+      ratioRows.push(
+        `<tr><td>${e(key)}</td><td>${e(formatRatioValue(value))}</td></tr>`,
+      );
+    }
+  }
+
+  // Add missing standard ratios
+  for (const r of KNOWN_RATIOS) {
+    if (!providedKeys.has(r)) {
+      ratioRows.push(
+        `<tr><td>${e(r)}</td><td class="not-provided">not provided — compute via the finance tool</td></tr>`,
+      );
+    }
+  }
+
+  const pricingHtml = inputs.pricing
+    ? `<p><strong>Pricing:</strong> ${[
+        inputs.pricing.rate !== undefined ? `Rate: ${e(String(inputs.pricing.rate))}` : '',
+        inputs.pricing.margin !== undefined ? `Margin: ${e(String(inputs.pricing.margin))}` : '',
+      ].filter(Boolean).join(', ') || 'N/A'}</p>`
+    : '';
+
+  const covenantsHtml = inputs.covenants.length > 0
+    ? `<ol>${inputs.covenants.map(c => `<li>${e(c)}</li>`).join('')}</ol>`
+    : '<p>None specified.</p>';
+
+  const risksHtml = inputs.risks.length > 0
+    ? `<ol>${inputs.risks.map(r => `<li>${e(r)}</li>`).join('')}</ol>`
+    : '<p>None specified.</p>';
+
+  const mitigantsHtml = inputs.mitigants.length > 0
+    ? `<ol>${inputs.mitigants.map(m => `<li>${e(m)}</li>`).join('')}</ol>`
+    : '<p>None specified.</p>';
+
+  return `<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Credit Memorandum — ${e(inputs.borrower_name)}</title>
+<style>
+  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 720px; margin: 2rem auto; padding: 0 1rem; color: #1a1a1a; line-height: 1.5; }
+  h1 { border-bottom: 2px solid #333; padding-bottom: 0.5rem; }
+  h2 { margin-top: 1.5rem; color: #333; border-bottom: 1px solid #ddd; padding-bottom: 0.25rem; }
+  table { border-collapse: collapse; width: 100%; margin: 0.5rem 0; }
+  th, td { border: 1px solid #ddd; padding: 0.5rem; text-align: left; }
+  th { background: #f5f5f5; }
+  .not-provided { color: #999; font-style: italic; }
+  .recommendation { font-weight: bold; text-transform: uppercase; }
+  .facility-summary p { margin: 0.25rem 0; }
+  ol { padding-left: 1.5rem; }
+</style>
+</head>
+<body>
+<h1>Credit Memorandum</h1>
+
+<h2>Facility Summary</h2>
+<div class="facility-summary">
+  <p><strong>Borrower:</strong> ${e(inputs.borrower_name)}</p>
+  <p><strong>Facility Amount:</strong> ${e(inputs.currency)} ${e(inputs.facility_amount.toLocaleString())}</p>
+  <p><strong>Facility Type:</strong> ${e(inputs.facility_type)}</p>
+  <p><strong>Tenor:</strong> ${e(String(inputs.tenor_months))} months</p>
+  ${pricingHtml}
+  ${inputs.analyst_name ? `<p><strong>Analyst:</strong> ${e(inputs.analyst_name)}</p>` : ''}
+</div>
+
+<h2>Purpose</h2>
