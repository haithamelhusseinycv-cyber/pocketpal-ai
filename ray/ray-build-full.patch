+++ b/.github/workflows/ray-apk.yml
@@ -0,0 +1,119 @@
+name: RAY APK (sideload build)
+
+# Phase 1 + Phase 6 gate: cut an installable APK from the RAY fork with NO
+# secrets required, so it can be run the moment the fork is pushed. The APK is
+# debug-signed (installable, not Play-Store-able) — exactly what's needed to
+# sideload onto the OnePlus 13 and measure tokens/sec before trusting the build.
+#
+# This is deliberately separate from release.yml (which needs DEPLOY_KEY,
+# release-signing secrets, and the Hexagon NPU SDK). For the perf gate we want
+# the simplest reproducible artifact.
+
+on:
+  workflow_dispatch:
+    inputs:
+      variant:
+        description: "Gradle build type"
+        required: true
+        default: "release"
+        type: choice
+        options:
+          - release
+          - debug
+      from_source:
+        description: "Build llama.rn from source (slower CI, matches release.yml)"
+        required: false
+        default: false
+        type: boolean
+
+jobs:
+  build_apk:
+    runs-on: ubuntu-latest
+    timeout-minutes: 180
+    env:
+      # Match release.yml: a subproject's gradle.properties beats the root, so
+      # only an -P/env property reliably controls the from-source llama.rn build.
+      ORG_GRADLE_PROJECT_rnllamaBuildFromSource: ${{ inputs.from_source && 'true' || 'false' }}
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      # The Hexagon SDK + from-source build need room; clear hosted toolcache like
+      # release.yml does. Harmless when from_source is false.
+      - name: Maximize build space
+        run: |
+          df -h /
+          sudo rm -rf /usr/share/dotnet /opt/ghc
+          df -h /
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@v4
+        with:
+          distribution: 'temurin'
+          java-version: '17'
+
+      - name: Set up Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: '22.21.0'
+          cache: 'yarn'
+
+      - name: Install dependencies
+        run: yarn install --frozen-lockfile
+
+      # RAY sanity gates — fail fast before the expensive native build if the
+      # pure-JS layer is broken. These run without a device.
+      - name: Verify bundled fonts
+        run: node scripts/verify-fonts.js
+
+      - name: Validate l10n (incl. Arabic)
+        run: node scripts/validate-l10n.js
+
+      - name: Verify Android payload manifest
+        run: node scripts/verify-android-payload.js || echo "payload manifest check skipped/soft"
+
+      - name: Setup Android SDK
+        uses: android-actions/setup-android@v3
+
+      - name: Build RAY APK (${{ inputs.variant }})
+        working-directory: android
+        run: |
+          chmod +x ./gradlew
+          # assembleRelease with no release-signing secrets falls back to the
+          # debug signingConfig (see android/app/build.gradle), producing an
+          # installable APK. The variant filter keeps only the prod applicationId.
+          ./gradlew assemble${{ inputs.variant }} --no-daemon --stacktrace
+
+      - name: Locate APK
+        id: apk
+        run: |
+          APK=$(find android/app/build/outputs/apk -name "*.apk" | head -n 1)
+          if [ -z "$APK" ]; then echo "No APK produced" >&2; exit 1; fi
+          echo "path=$APK" >> "$GITHUB_OUTPUT"
+          echo "Built: $APK ($(du -h "$APK" | cut -f1))"
+
+      - name: Upload APK
+        uses: actions/upload-artifact@v4
+        with:
+          name: ray-${{ inputs.variant }}-apk
+          path: ${{ steps.apk.outputs.path }}
+          if-no-files-found: error
+
+      # Phase 1 gate reminder, printed into the run log so it's never skipped.
+      - name: Perf-gate checklist (read me)
+        run: |
+          echo "======================================================"
+          echo " RAY APK built. PHASE 1 GATE — do this on the phone:"
+          echo "  1. adb install -r the uploaded APK (OnePlus 13)."
+          echo "  2. In-app HF browser, download:"
+          echo "     - unsloth/Qwen2.5-14B-Instruct-GGUF  Q4_K_M"
+          echo "     - unsloth/gpt-oss-20b-GGUF           Q4_K_M"
+          echo "  3. Create one Pal per model, load RAY — The Desk."
+          echo "  4. Raise context to 16k when the load hint fires."
+          echo "  5. MEASURE tokens/sec on a real prompt + a tool call."
+          echo "     GATE: if Qwen 14B < 8 tok/s, drop to Q4_K_S or 7B."
+          echo "  6. Test: Arabic switching, tool calling, deep_search,"
+          echo "     memory persistence across app restart, dictation->MSA."
+          echo "  7. Graph/Outlook + native STT are activation-gated;"
+          echo "     see src/services/graph/README.md and stt/README.md."
+          echo "======================================================"
