@@ -0,0 +1,74 @@
+import {makeAutoObservable, runInAction} from 'mobx';
+import AsyncStorage from '@react-native-async-storage/async-storage';
+import {makePersistable} from 'mobx-persist-store';
+
+/**
+ * RAY-specific user preferences that are separate from any Pal.
+ *
+ * Kept in its own store (rather than folded into RouteStore) so the persona
+ * layer and the routing layer stay independent: changing how RAY speaks must
+ * never touch where inference runs, and vice versa.
+ *
+ * Defaults are chosen so a fresh install behaves exactly like the hardcoded
+ * persona with no extra directive — see `languageDirective`.
+ */
+export type RayLanguage = 'auto' | 'en' | 'ar';
+const VALID_LANGUAGES: RayLanguage[] = ['auto', 'en', 'ar'];
+
+class RayPrefsStore {
+  /**
+   * Reply-language override.
+   *  - 'auto' (default): no directive; the persona's own "match the user's
+   *    language" rule governs. Keeps the assembled prompt byte-identical to the
+   *    stock persona.
+   *  - 'en' / 'ar': append an explicit directive so RAY answers in that language
+   *    regardless of the prompt's language.
+   */
+  language: RayLanguage = 'auto';
+
+  constructor() {
+    makeAutoObservable(this);
+
+    makePersistable(this, {
+      name: 'RayPrefsStore',
+      properties: ['language'],
+      storage: AsyncStorage,
+    }).then(() => this.normalizeHydratedPrefs());
+  }
+
+  normalizeHydratedPrefs(): void {
+    const language = VALID_LANGUAGES.includes(this.language)
+      ? this.language
+      : 'auto';
+    runInAction(() => {
+      this.language = language;
+    });
+  }
+
+  setLanguage(language: RayLanguage): void {
+    if (!VALID_LANGUAGES.includes(language)) {
+      return;
+    }
+    runInAction(() => {
+      this.language = language;
+    });
+  }
+
+  /**
+   * The directive appended to the persona for the current language setting, or
+   * an empty string for 'auto' (so nothing is appended and the persona is
+   * unchanged). Folded into the same leading system message by assembleMessages.
+   */
+  get languageDirective(): string {
+    switch (this.language) {
+      case 'en':
+        return 'LANGUAGE OVERRIDE: Reply in English (native American register) regardless of the language of the user\u2019s message, unless the user explicitly asks for Arabic.';
+      case 'ar':
+        return 'LANGUAGE OVERRIDE: Reply in modern colloquial Egyptian Arabic (\u0639\u0627\u0645\u064a\u0629 \u0645\u0635\u0631\u064a\u0629 \u0645\u0639\u0627\u0635\u0631\u0629) regardless of the language of the user\u2019s message, unless the user explicitly asks for English. Keep technical and market terms as used in Egyptian banking.';
+      default:
+        return '';
+    }
+  }
+}
+
+export const rayPrefsStore = new RayPrefsStore();
