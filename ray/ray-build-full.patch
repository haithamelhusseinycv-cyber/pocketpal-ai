+/**
+ * Multi-provider search aggregator: fans out to every configured provider,
+ * deduplicates by canonical URL, and re-ranks with a transparent deterministic
+ * score that rewards consensus, recency, and stable ordering.
+ */
+
+import type {SearchProvider, SearchHit, SearchProviderId} from './types';
+
+export interface AggregateResult {
+  /** Merged, deduped, re-ranked hits. */
+  hits: SearchHit[];
+  /** Per-provider diagnostics — which succeeded and how many raw hits each returned. */
+  diagnostics: ProviderDiagnostic[];
+  /** How many duplicate entries were collapsed during dedup (consensus signal). */
+  duplicatesCollapsed: number;
+  /** IDs of providers that contributed at least one hit. */
+  contributingProviders: SearchProviderId[];
+}
+
+export interface ProviderDiagnostic {
+  providerId: SearchProviderId;
+  status: 'fulfilled' | 'rejected';
+  hitCount?: number;
+  error?: string;
+}
+
+// ── URL canonicalisation ────────────────────────────────────────────────────
+
+/** Tracking params stripped before dedup comparison. */
+const TRACKING_PARAMS = new Set([
+  'utm_source',
+  'utm_medium',
+  'utm_campaign',
+  'utm_term',
+  'utm_content',
+  'fbclid',
+  'gclid',
+  'msclkid',
+  'ref',
+]);
+
+/**
+ * Canonical URL for dedup: lowercase host, strip trailing slash on path,
+ * drop common tracking params, drop fragment. Returns null for unparseable
+ * URLs so they're still kept (just never deduped against anything).
+ */
+export const canonicalUrl = (raw: string): string | null => {
+  let parsed: URL;
+  try {
+    parsed = new URL(raw.trim());
+  } catch {
+    return null;
+  }
+  if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') {
+    return null;
+  }
+  parsed.hostname = parsed.hostname.toLowerCase();
+  parsed.hash = '';
+  // Strip trailing slash on path (but keep bare "/" as "/").
+  if (parsed.pathname.length > 1 && parsed.pathname.endsWith('/')) {
+    parsed.pathname = parsed.pathname.slice(0, -1);
+  }
+  // Drop tracking params.
+  for (const key of [...parsed.searchParams.keys()]) {
+    if (TRACKING_PARAMS.has(key)) {
+      parsed.searchParams.delete(key);
+    }
+  }
+  return parsed.toString();
+};
+
+// ── Re-ranking ──────────────────────────────────────────────────────────────
+
+/**
+ * Deterministic score — higher is better.
+ *
+ *   score = consensusWeight × (providerCount − 1)
+ *         + recencyWeight  × recencyFraction
+ *         + positionTieBreak
+ *
+ * - consensusWeight (1000): a hit returned by N providers outranks any hit
+ *   returned by fewer, regardless of recency. The −1 means a single-provider
+ *   hit scores 0 on this axis, so consensus always lifts.
+ * - recencyWeight (100): newer publishedAt ranks higher. Missing dates are
+ *   treated as epoch 0 (oldest possible) — they still appear, just below
+ *   dated hits. recencyFraction = 1 − ageDays/maxAgeDays, clamped to [0,1].
+ * - positionTieBreak: original merge order (0, 1/N, 2/N …) scaled to <1 so
+ *   it never outweighs recency. Stable across identical inputs.
+ *
+ * No randomness. Given the same inputs the order is always identical.
+ */
+const CONSENSUS_WEIGHT = 1000;
+const RECENCY_WEIGHT = 100;
+const MAX_AGE_DAYS = 365;
+
+const daysSince = (iso: string, now: number): number => {
+  const t = Date.parse(iso);
+  if (Number.isNaN(t)) {
+    return MAX_AGE_DAYS + 1; // missing / unparseable → treated as oldest
+  }
+  return (now - t) / 86_400_000;
+};
+
+const scoreHit = (
+  consensusCount: number,
+  publishedAt: string | undefined,
+  originalIndex: number,
+  totalHits: number,
+  now: number,
+): number => {
+  const consensusScore = CONSENSUS_WEIGHT * (consensusCount - 1);
+  const age = daysSince(publishedAt ?? '', now);
+  const recencyFraction = Math.max(0, 1 - age / MAX_AGE_DAYS);
+  const recencyScore = RECENCY_WEIGHT * recencyFraction;
+  const positionTieBreak =
+    totalHits > 0 ? (1 - originalIndex / totalHits) * 0.5 : 0;
+  return consensusScore + recencyScore + positionTieBreak;
+};
+
+// ── Merge + dedup ───────────────────────────────────────────────────────────
+
+interface DedupEntry {
+  hit: SearchHit;
+  consensusCount: number;
+  firstIndex: number;
+}
+
+const mergeHits = (
+  providerHits: Array<{providerId: SearchProviderId; hits: SearchHit[]}>,
+): {merged: DedupEntry[]; duplicatesCollapsed: number} => {
+  const byCanonical = new Map<string, DedupEntry>();
+  const noCanonical: DedupEntry[] = [];
+  let globalIndex = 0;
+  let duplicatesCollapsed = 0;
+
+  for (const {hits} of providerHits) {
+    for (const hit of hits) {
+      const canon = canonicalUrl(hit.url);
+      if (canon === null) {
+        // Unparseable URL — keep as-is, never deduped.
+        noCanonical.push({hit, consensusCount: 1, firstIndex: globalIndex});
+        globalIndex++;
+        continue;
+      }
+      const existing = byCanonical.get(canon);
+      if (existing) {
+        duplicatesCollapsed++;
+        existing.consensusCount++;
+        // Merge: longest non-empty title, longest snippet.
+        if (hit.title.length > existing.hit.title.length) {
+          existing.hit = {...existing.hit, title: hit.title};
+        }
+        if (hit.snippet.length > existing.hit.snippet.length) {
+          existing.hit = {...existing.hit, snippet: hit.snippet};
+        }
+        // Keep the earliest publishedAt if both present.
+        if (
+          hit.publishedAt &&
+          (!existing.hit.publishedAt ||
+            hit.publishedAt < existing.hit.publishedAt)
+        ) {
+          existing.hit = {...existing.hit, publishedAt: hit.publishedAt};
+        }
+      } else {
+        byCanonical.set(canon, {
+          hit: {...hit},
+          consensusCount: 1,
+          firstIndex: globalIndex,
+        });
+        globalIndex++;
+      }
+    }
+  }
+
+  return {
+    merged: [...byCanonical.values(), ...noCanonical],
+    duplicatesCollapsed,
+  };
+};
+
+// ── Public API ──────────────────────────────────────────────────────────────
+
+export interface AggregateOptions {
+  maxResults: number;
+}
+
+/**
+ * Query all providers concurrently, dedup by canonical URL, re-rank.
+ * One failing provider never sinks the call — errors are captured in diagnostics.
+ * If ALL providers fail, the returned AggregateResult has empty hits and every
+ * diagnostic is 'rejected'; callers MUST surface the errors, never silent-empty.
+ */
+export const aggregateSearch = async (
+  providers: SearchProvider[],
+  query: string,
+  opts: AggregateOptions,
+): Promise<AggregateResult> => {
+  const settled = await Promise.allSettled(
+    providers.map(p => p.search(query, {maxResults: opts.maxResults})),
+  );
+
+  const diagnostics: ProviderDiagnostic[] = providers.map((p, i) => {
+    const s = settled[i];
+    if (s.status === 'fulfilled') {
+      return {
+        providerId: p.id,
+        status: 'fulfilled',
+        hitCount: s.value.length,
+      };
+    }
+    return {
+      providerId: p.id,
+      status: 'rejected',
+      error: s.reason instanceof Error ? s.reason.message : String(s.reason),
+    };
+  });
+
+  const providerHits = providers
+    .map((p, i) => ({
+      providerId: p.id,
+      hits:
+        settled[i].status === 'fulfilled'
+          ? (settled[i] as PromiseFulfilledResult<SearchHit[]>).value
+          : [],
+    }))
+    .filter(
+      (
+        entry,
+      ): entry is {
+        providerId: SearchProviderId;
+        hits: SearchHit[];
+      } => entry.hits.length > 0,
+    );
+
+  const {merged, duplicatesCollapsed} = mergeHits(providerHits);
+
+  const now = Date.now();
+  const total = merged.length;
+  const scored = merged.map((entry, idx) => ({
+    entry,
+    score: scoreHit(
+      entry.consensusCount,
+      entry.hit.publishedAt,
+      idx,
+      total,
+      now,
+    ),
+  }));
+
+  // Sort descending by score; ties broken by firstIndex ascending (stable).
+  scored.sort((a, b) => {
+    if (b.score !== a.score) {
+      return b.score - a.score;
+    }
+    return a.entry.firstIndex - b.entry.firstIndex;
+  });
+
+  const hits = scored
+    .slice(0, opts.maxResults)
+    .map(s => s.entry.hit);
+
+  const contributingProviders = providerHits.map(ph => ph.providerId);
+
+  return {
+    hits,
+    diagnostics,
+    duplicatesCollapsed,
+    contributingProviders,
+  };
+};
