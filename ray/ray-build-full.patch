+  // English (or mixed leaning English): prefer a kokoro American male voice.
+  for (const id of PREFERRED_EN_VOICE_IDS) {
+    const hit = voices.find(v => v.id === id);
+    if (hit) {
+      return hit;
+    }
+  }
+  // Fall back: any American English, then any English.
+  const american = voices.find(v => isAmericanEnglish(v));
+  if (american) {
+    return american;
+  }
+  const anyEnglish = voices.find(v => isEnglishLanguageTag(v.language));
+  if (anyEnglish) {
+    return anyEnglish;
+  }
+  // No English voice at all; if Arabic exists and text is mixed, use it, else null.
+  const arabicFallback = voices.find(v => isArabicLanguageTag(v.language));
+  return arabicFallback ?? null;
