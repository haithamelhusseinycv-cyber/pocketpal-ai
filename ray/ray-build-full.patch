+/**
+ * Standalone verification harness for aggregate.ts and DeepSearchEngine.ts
+ * Runs without jest or node_modules - pure Node.js execution
+ */
+
+// React Native global - define for Node.js environment
+(globalThis as any).__DEV__ = false;
+
+import { aggregateSearch, canonicalUrl } from '../aggregate';
+import { DeepSearchEngine } from '../../talents/DeepSearchEngine';
+import type { SearchProvider, SearchHit, SearchProviderId } from '../types';
+import type { DeepSearchAccess } from '../../talents/DeepSearchEngine';
+
+let passCount = 0;
+let failCount = 0;
+
+function assert(condition: boolean, message: string): void {
+  if (condition) {
+    console.log(`  ✓ ${message}`);
+    passCount++;
+  } else {
+    console.log(`  ✗ ${message}`);
+    failCount++;
+  }
+}
+
+function assertEqual<T>(actual: T, expected: T, message: string): void {
+  const pass = JSON.stringify(actual) === JSON.stringify(expected);
+  if (pass) {
+    console.log(`  ✓ ${message}`);
+    passCount++;
+  } else {
+    console.log(`  ✗ ${message}`);
+    console.log(`    Expected: ${JSON.stringify(expected)}`);
+    console.log(`    Actual:   ${JSON.stringify(actual)}`);
+    failCount++;
+  }
+}
+
+function hit(overrides: Partial<SearchHit> = {}): SearchHit {
+  return {
+    title: 'Title',
+    url: 'https://example.com/a',
+    snippet: 'A snippet.',
+    ...overrides,
+  };
+}
+
+function makeProvider(
+  id: SearchProviderId,
+  hits: SearchHit[],
+  shouldFail = false,
+): SearchProvider {
+  return {
+    id,
+    search: async () => {
+      if (shouldFail) {
+        throw new Error(`${id} failed`);
+      }
+      return hits;
+    },
+  };
+}
+
+function makeAccess(overrides: Partial<DeepSearchAccess> = {}): DeepSearchAccess {
+  return {
+    getAvailableProviders: () => [
+      makeProvider('brave', [hit({ title: 'Brave Hit', url: 'https://b.com/1' })]),
+    ],
+    canSearch: () => true,
+    getResultCount: () => 5,
+    ...overrides,
+  };
+}
+
+// ── canonicalUrl tests ──────────────────────────────────────────────────────
+
+console.log('\n=== canonicalUrl tests ===');
+
+assert(
+  canonicalUrl('https://Example.COM/path') === 'https://example.com/path',
+  'lowercases the host',
+);
+
+assert(
+  canonicalUrl('https://example.com/path/') === 'https://example.com/path',
+  'strips trailing slash on path',
+);
+
+assert(
+  canonicalUrl('https://example.com/') === 'https://example.com/',
+  'keeps bare "/" as-is',
+);
+
+assert(
+  canonicalUrl('https://example.com/page?utm_source=twitter&fbclid=abc&keep=yes') ===
+    'https://example.com/page?keep=yes',
+  'drops tracking params (utm_*, fbclid, gclid)',
+);
+
+assert(
+  canonicalUrl('https://example.com/page#section') === 'https://example.com/page',
+  'drops the fragment',
+);
+
+assert(canonicalUrl('not a url') === null, 'returns null for unparseable URLs');
+
+assert(
+  canonicalUrl('ftp://example.com/file') === null,
+  'returns null for non-http(s) protocols',
+);
+
+// ── aggregateSearch tests ───────────────────────────────────────────────────
+
+console.log('\n=== aggregateSearch tests ===');
+
+async function testAggregate() {
+  // Test 1: merges hits from multiple providers
+  {
+    const brave = makeProvider('brave', [
+      hit({ title: 'Brave 1', url: 'https://b.com/1' }),
+    ]);
+    const tavily = makeProvider('tavily', [
+      hit({ title: 'Tavily 1', url: 'https://t.com/1' }),
+    ]);
+    const result = await aggregateSearch([brave, tavily], 'test', {
+      maxResults: 10,
+    });
+    assertEqual(result.hits.length, 2, 'merges hits from multiple providers');
+    assertEqual(result.diagnostics.length, 2, 'returns diagnostics for each provider');
+    assert(
+      result.diagnostics.every(d => d.status === 'fulfilled'),
+      'all diagnostics are fulfilled',
+    );
+  }
+
+  // Test 2: deduplicates by canonical URL (tracking params normalized)
+  {
+    const brave = makeProvider('brave', [
+      hit({
+        title: 'Brave Title',
+        url: 'https://example.com/page?utm_source=twitter',
+        snippet: 'Short',
+      }),
+    ]);
+    const tavily = makeProvider('tavily', [
+      hit({
+        title: 'Tavily Title Longer',
+        url: 'https://example.com/page?fbclid=abc',
+        snippet: 'A longer snippet here',
+      }),
+    ]);
+    const result = await aggregateSearch([brave, tavily], 'test', {
+      maxResults: 10,
+    });
+    assertEqual(result.hits.length, 1, 'deduplicates by canonical URL');
+    assertEqual(result.duplicatesCollapsed, 1, 'reports 1 duplicate collapsed');
+    assertEqual(
+      result.hits[0].title,
+      'Tavily Title Longer',
+      'merges best title (longest)',
+    );
+    assertEqual(
+      result.hits[0].snippet,
+      'A longer snippet here',
+      'merges best snippet (longest)',
+    );
+  }
+
+  // Test 3: deduplicates by trailing-slash normalization
+  {
+    const brave = makeProvider('brave', [
+      hit({ url: 'https://example.com/page/' }),
+    ]);
+    const tavily = makeProvider('tavily', [
+      hit({ url: 'https://example.com/page' }),
+    ]);
+    const result = await aggregateSearch([brave, tavily], 'test', {
+      maxResults: 10,
+    });
+    assertEqual(result.hits.length, 1, 'deduplicates by trailing-slash normalization');
+    assertEqual(result.duplicatesCollapsed, 1, 'reports 1 duplicate collapsed');
+  }
+
+  // Test 4: re-ranks by consensus
+  {
+    const brave = makeProvider('brave', [
+      hit({ title: 'Only Brave', url: 'https://solo.com/1' }),
+      hit({ title: 'Shared', url: 'https://shared.com/1' }),
+    ]);
+    const tavily = makeProvider('tavily', [
+      hit({ title: 'Shared', url: 'https://shared.com/1' }),
+    ]);
+    const result = await aggregateSearch([brave, tavily], 'test', {
+      maxResults: 10,
+    });
+    assertEqual(
+      result.hits[0].url,
+      'https://shared.com/1',
+      're-ranks by consensus: multi-provider hits outrank single-provider hits',
+    );
+  }
+
+  // Test 5: re-ranks by recency as tie-break
+  {
+    const today = new Date().toISOString();
+    const old = new Date(Date.now() - 180 * 86_400_000).toISOString();
+    const brave = makeProvider('brave', [
+      hit({ title: 'Old', url: 'https://old.com/1', publishedAt: old }),
+      hit({ title: 'New', url: 'https://new.com/1', publishedAt: today }),
+    ]);
+    const result = await aggregateSearch([brave], 'test', { maxResults: 10 });
+    assertEqual(
+      result.hits[0].url,
+      'https://new.com/1',
+      're-ranks by recency: newer ranks higher',
+    );
+    assertEqual(
+      result.hits[1].url,
+      'https://old.com/1',
+      're-ranks by recency: older ranks lower',
+    );
+  }
+
+  // Test 6: treats missing publishedAt as oldest
+  {
+    const recent = new Date().toISOString();
+    const brave = makeProvider('brave', [
+      hit({ title: 'No Date', url: 'https://nodate.com/1' }),
+      hit({ title: 'Dated', url: 'https://dated.com/1', publishedAt: recent }),
+    ]);
+    const result = await aggregateSearch([brave], 'test', { maxResults: 10 });
+    assertEqual(result.hits.length, 2, 'keeps both dated and undated hits');
+    assertEqual(
+      result.hits[0].url,
+      'https://dated.com/1',
+      'dated hit ranks first',
