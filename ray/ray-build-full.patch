index 0000000..1cd6e66
--- /dev/null
+++ b/src/services/talents/ExifEngine.ts
@@ -0,0 +1,842 @@
+/**
+ * ExifEngine — pure binary JPEG/EXIF metadata parser.
+ *
+ * Reads EXIF data from JPEG files passed as hex/base64 strings (same mechanism
+ * as ApkInspectEngine and HashEngine). Parses APP1/Exif segments: TIFF header
+ * (both endians), IFD0/ExifIFD/GPSIFD traversal, rational/srational/byte/short/
+ * long/ascii type support, IFD next-pointer chains.
+ *
+ * No dependency, no eval, no file I/O. Never crashes on malformed input —
+ * returns partial results with warnings.
+ */
+
+import {TalentEngine, TalentResult, ToolDefinition, SystemPromptContext} from './types';
+import {decodeInput, InputEncoding} from './byteUtils';
+
+// ─── EXIF tag IDs ────────────────────────────────────────────────────────────
+const TAG = {
+  ImageWidth: 0x0100,
+  ImageLength: 0x0101,
+  Orientation: 0x0112,
+  Make: 0x010f,
+  Model: 0x0110,
+  DateTime: 0x0132,
+  ExposureTime: 0x829a,
+  FNumber: 0x829d,
+  ExposureProgram: 0x8822,
+  MeteringMode: 0x9207,
+  Flash: 0x9209,
+  WhiteBalance: 0xa403,
+  ISOSpeedRatings: 0x8827,
+  FocalLength: 0x920a,
+  LensModel: 0xa434,
+  ExifIFDPointer: 0x8769,
+  GPSIFDPointer: 0x8825,
+  // GPS tags
+  GPSLatitudeRef: 0x0001,
+  GPSLatitude: 0x0002,
+  GPSLongitudeRef: 0x0003,
+  GPSLongitude: 0x0004,
+  GPSAltitudeRef: 0x0005,
+  GPSAltitude: 0x0006,
+  GPSTimeStamp: 0x0007,
+  GPSDateStamp: 0x001d,
+} as const;
+
+const TAG_NAMES: Record<number, string> = {
+  0x0100: 'ImageWidth',
+  0x0101: 'ImageLength',
+  0x010f: 'Make',
+  0x0110: 'Model',
+  0x0112: 'Orientation',
+  0x0132: 'DateTime',
+  0x829a: 'ExposureTime',
+  0x829d: 'FNumber',
+  0x8822: 'ExposureProgram',
+  0x8827: 'ISOSpeedRatings',
+  0x9207: 'MeteringMode',
+  0x9209: 'Flash',
+  0x920a: 'FocalLength',
+  0xa403: 'WhiteBalance',
+  0xa434: 'LensModel',
+  0x8769: 'ExifIFDPointer',
+  0x8825: 'GPSIFDPointer',
+  0x0001: 'GPSLatitudeRef',
+  0x0002: 'GPSLatitude',
+  0x0003: 'GPSLongitudeRef',
+  0x0004: 'GPSLongitude',
+  0x0005: 'GPSAltitudeRef',
+  0x0006: 'GPSAltitude',
+  0x0007: 'GPSTimeStamp',
+  0x001d: 'GPSDateStamp',
+};
+
+// EXIF format type sizes in bytes
+const TYPE_SIZES: Record<number, number> = {
+  1: 1,   // BYTE
+  2: 1,   // ASCII
+  3: 2,   // SHORT
+  4: 4,   // LONG
+  5: 8,   // RATIONAL (2x LONG)
+  6: 1,   // SBYTE
+  7: 1,   // UNDEFINED
+  8: 2,   // SSHORT
+  9: 4,   // SLONG
+  10: 8,  // SRATIONAL (2x SLONG)
+};
+
+interface ExifTag {
+  tag: number;
+  type: number;
+  count: number;
+  value: any;
+  name: string;
+}
+
+interface ExifData {
+  tags: Map<number, ExifTag>;
+  exifTags: Map<number, ExifTag>;
+  gpsTags: Map<number, ExifTag>;
+  warnings: string[];
+}
+
+// ─── Byte reading helpers ────────────────────────────────────────────────────
+function readU16(bytes: Uint8Array, offset: number, le: boolean): number {
+  if (offset + 2 > bytes.length) return 0;
+  return le
+    ? (bytes[offset] | (bytes[offset + 1] << 8))
+    : ((bytes[offset] << 8) | bytes[offset + 1]);
+}
+
+function readU32(bytes: Uint8Array, offset: number, le: boolean): number {
+  if (offset + 4 > bytes.length) return 0;
+  return le
+    ? ((bytes[offset] | (bytes[offset + 1] << 8) | (bytes[offset + 2] << 16) | (bytes[offset + 3] << 24)) >>> 0)
+    : (((bytes[offset] << 24) | (bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) | bytes[offset + 3]) >>> 0);
+}
+
+function readI32(bytes: Uint8Array, offset: number, le: boolean): number {
+  if (offset + 4 > bytes.length) return 0;
+  return le
+    ? (bytes[offset] | (bytes[offset + 1] << 8) | (bytes[offset + 2] << 16) | (bytes[offset + 3] << 24))
+    : ((bytes[offset] << 24) | (bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) | bytes[offset + 3]);
+}
+
+function readAscii(bytes: Uint8Array, offset: number, count: number): string {
+  let end = offset + count;
+  if (end > bytes.length) end = bytes.length;
+  let s = '';
+  for (let i = offset; i < end; i++) {
+    const b = bytes[i];
+    if (b === 0) break;
+    s += String.fromCharCode(b);
+  }
+  return s;
+}
+
+// ─── IFD parsing ─────────────────────────────────────────────────────────────
+function readValue(
+  tiffData: Uint8Array,
+  tiffBase: number,
+  valueOffset: number,
+  type: number,
+  count: number,
+  le: boolean,
+): any {
+  const size = TYPE_SIZES[type] || 1;
+  const totalSize = size * count;
+
+  // Value is inline in the 4-byte value field if totalSize <= 4
+  // Otherwise, the value field contains an offset (relative to tiffBase) to the data
+  let dataOffset: number;
+  if (totalSize <= 4) {
+    dataOffset = valueOffset;
+  } else {
+    const offsetFromTiffBase = readU32(tiffData, valueOffset, le);
+    dataOffset = tiffBase + offsetFromTiffBase;
+  }
+
+  if (dataOffset + totalSize > tiffData.length) {
+    return undefined;
+  }
+
+  switch (type) {
+    case 1: // BYTE
+    case 7: // UNDEFINED
+      if (count === 1) return tiffData[dataOffset];
+      const arr: number[] = [];
+      for (let i = 0; i < count && dataOffset + i < tiffData.length; i++) {
+        arr.push(tiffData[dataOffset + i]);
+      }
+      return arr;
+
+    case 2: // ASCII
+      return readAscii(tiffData, dataOffset, count);
+
+    case 3: // SHORT
+      if (count === 1) return readU16(tiffData, dataOffset, le);
+      const shorts: number[] = [];
+      for (let i = 0; i < count; i++) {
+        shorts.push(readU16(tiffData, dataOffset + i * 2, le));
+      }
+      return shorts;
+
+    case 4: // LONG
+      if (count === 1) return readU32(tiffData, dataOffset, le);
+      const longs: number[] = [];
+      for (let i = 0; i < count; i++) {
+        longs.push(readU32(tiffData, dataOffset + i * 4, le));
+      }
+      return longs;
+
+    case 5: // RATIONAL (unsigned)
+      if (count === 1) {
+        const num = readU32(tiffData, dataOffset, le);
+        const den = readU32(tiffData, dataOffset + 4, le);
+        return [num, den];
+      }
+      const rats: [number, number][] = [];
+      for (let i = 0; i < count; i++) {
+        const off = dataOffset + i * 8;
+        rats.push([readU32(tiffData, off, le), readU32(tiffData, off + 4, le)]);
+      }
+      return rats;
+
+    case 6: // SBYTE
+      if (count === 1) {
+        const v = tiffData[dataOffset];
+        return v > 127 ? v - 256 : v;
+      }
+      return tiffData[dataOffset];
+
+    case 8: // SSHORT
+      if (count === 1) {
+        const v = readU16(tiffData, dataOffset, le);
+        return v > 32767 ? v - 65536 : v;
+      }
+      const sshorts: number[] = [];
+      for (let i = 0; i < count; i++) {
+        const v = readU16(tiffData, dataOffset + i * 2, le);
+        sshorts.push(v > 32767 ? v - 65536 : v);
+      }
+      return sshorts;
+
+    case 9: // SLONG
+      if (count === 1) return readI32(tiffData, dataOffset, le);
+      const slongs: number[] = [];
+      for (let i = 0; i < count; i++) {
+        slongs.push(readI32(tiffData, dataOffset + i * 4, le));
+      }
+      return slongs;
+
+    case 10: // SRATIONAL
+      if (count === 1) {
+        const num = readI32(tiffData, dataOffset, le);
+        const den = readI32(tiffData, dataOffset + 4, le);
+        return [num, den];
+      }
+      const srats: [number, number][] = [];
+      for (let i = 0; i < count; i++) {
+        const off = dataOffset + i * 8;
+        srats.push([readI32(tiffData, off, le), readI32(tiffData, off + 4, le)]);
+      }
+      return srats;
+
+    default:
+      return undefined;
+  }
+}
+
+function parseIFD(
+  tiffData: Uint8Array,
+  tiffBase: number,
+  ifdOffset: number,
+  le: boolean,
+  warnings: string[],
+  maxEntries = 100,
+): Map<number, ExifTag> {
+  const tags = new Map<number, ExifTag>();
+  const absOffset = tiffBase + ifdOffset;
+
+  if (absOffset + 2 > tiffData.length) {
+    warnings.push(`IFD at offset ${ifdOffset} out of bounds`);
+    return tags;
+  }
+
+  const entryCount = readU16(tiffData, absOffset, le);
+  if (entryCount > maxEntries) {
+    warnings.push(`IFD entry count ${entryCount} exceeds max ${maxEntries}, truncating`);
+  }
+
+  const count = Math.min(entryCount, maxEntries);
+
+  for (let i = 0; i < count; i++) {
+    const entryOffset = absOffset + 2 + i * 12;
+    if (entryOffset + 12 > tiffData.length) {
+      warnings.push(`IFD entry ${i} truncated`);
+      break;
+    }
+
+    const tagId = readU16(tiffData, entryOffset, le);
+    const type = readU16(tiffData, entryOffset + 2, le);
+    const cnt = readU32(tiffData, entryOffset + 4, le);
+    const valueField = entryOffset + 8;
+
+    const value = readValue(tiffData, tiffBase, valueField, type, cnt, le);
+
+    tags.set(tagId, {
+      tag: tagId,
+      type,
+      count: cnt,
+      value,
+      name: TAG_NAMES[tagId] || `Tag_0x${tagId.toString(16).padStart(4, '0')}`,
+    });
+  }
+
+  return tags;
+}
+
+// ─── JPEG/EXIF parsing ───────────────────────────────────────────────────────
+function findExifSegment(jpeg: Uint8Array): {tiffData: Uint8Array; tiffBase: number} | null {
+  if (jpeg.length < 2 || jpeg[0] !== 0xff || jpeg[1] !== 0xd8) {
+    return null;
+  }
+
+  let pos = 2;
+  while (pos + 4 < jpeg.length) {
+    if (jpeg[pos] !== 0xff) {
+      pos++;
+      continue;
+    }
+
+    const marker = (jpeg[pos] << 8) | jpeg[pos + 1];
+
+    // SOI, EOI have no length
+    if (marker === 0xffd8 || marker === 0xffd9) {
+      pos += 2;
+      continue;
+    }
+
+    // RST markers
+    if (marker >= 0xffd0 && marker <= 0xffd7) {
+      pos += 2;
+      continue;
+    }
+
+    if (pos + 4 > jpeg.length) break;
+    const segLen = (jpeg[pos + 2] << 8) | jpeg[pos + 3];
+
+    if (marker === 0xffe1) {
+      // APP1 — check for Exif header
+      const dataStart = pos + 4;
+      if (dataStart + 6 > jpeg.length) break;
+
+      // "Exif\0\0"
+      if (
+        jpeg[dataStart] === 0x45 &&
+        jpeg[dataStart + 1] === 0x78 &&
+        jpeg[dataStart + 2] === 0x69 &&
+        jpeg[dataStart + 3] === 0x66 &&
+        jpeg[dataStart + 4] === 0x00 &&
+        jpeg[dataStart + 5] === 0x00
+      ) {
+        const tiffStart = dataStart + 6;
+        if (tiffStart + 8 > jpeg.length) break;
+        return {tiffData: jpeg.subarray(tiffStart), tiffBase: 0};
+      }
+    }
+
+    pos += 2 + segLen;
+  }
+
+  return null;
+}
+
+function parseExif(jpeg: Uint8Array): {exif: ExifData | null; error: string | null} {
+  const warnings: string[] = [];
+
+  const exifSeg = findExifSegment(jpeg);
+  if (!exifSeg) {
+    return {exif: null, error: 'No EXIF data found (no APP1/Exif segment)'};
+  }
+
+  const {tiffData, tiffBase} = exifSeg;
+
+  if (tiffData.length < 8) {
+    return {exif: null, error: 'TIFF header too short'};
+  }
+
+  // Byte order
+  const b0 = tiffData[tiffBase];
+  const b1 = tiffData[tiffBase + 1];
+  let le: boolean;
+  if (b0 === 0x49 && b1 === 0x49) {
+    le = true; // "II" = Intel = little-endian
+  } else if (b0 === 0x4d && b1 === 0x4d) {
+    le = false; // "MM" = Motorola = big-endian
+  } else {
+    return {exif: null, error: `Invalid TIFF byte order: 0x${b0.toString(16)}${b1.toString(16)}`};
+  }
+
+  // TIFF magic = 42
+  const magic = readU16(tiffData, tiffBase + 2, le);
+  if (magic !== 42) {
+    return {exif: null, error: `Invalid TIFF magic: ${magic} (expected 42)`};
+  }
+
+  // Offset to IFD0
+  const ifd0Offset = readU32(tiffData, tiffBase + 4, le);
+
+  // Parse IFD0
+  const ifd0Tags = parseIFD(tiffData, tiffBase, ifd0Offset, le, warnings);
+
+  // Parse ExifIFD if pointer exists
+  let exifTags = new Map<number, ExifTag>();
+  const exifPtr = ifd0Tags.get(TAG.ExifIFDPointer);
+  if (exifPtr && exifPtr.value !== undefined) {
+    const exifOffset = typeof exifPtr.value === 'number' ? exifPtr.value : 0;
+    exifTags = parseIFD(tiffData, tiffBase, exifOffset, le, warnings);
+  }
+
+  // Parse GPSIFD if pointer exists
+  let gpsTags = new Map<number, ExifTag>();
+  const gpsPtr = ifd0Tags.get(TAG.GPSIFDPointer);
+  if (gpsPtr && gpsPtr.value !== undefined) {
+    const gpsOffset = typeof gpsPtr.value === 'number' ? gpsPtr.value : 0;
+    gpsTags = parseIFD(tiffData, tiffBase, gpsOffset, le, warnings);
+  }
+
+  return {
+    exif: {tags: ifd0Tags, exifTags, gpsTags, warnings},
+    error: null,
+  };
+}
+
+// ─── GPS conversion ──────────────────────────────────────────────────────────
+function rationalToDecimal(rational: [number, number] | undefined): number | null {
+  if (!rational || rational[1] === 0) return null;
+  return rational[0] / rational[1];
+}
+
+function gpsDmsToDecimal(
+  dms: [number, number][] | undefined,
+  ref: string | undefined,
+): number | null {
+  if (!dms || dms.length < 3) return null;
+  const d = rationalToDecimal(dms[0]);
+  const m = rationalToDecimal(dms[1]);
+  const s = rationalToDecimal(dms[2]);
+  if (d === null || m === null || s === null) return null;
+  let decimal = d + m / 60 + s / 3600;
+  if (ref === 'S' || ref === 'W') decimal = -decimal;
+  return decimal;
+}
+
+// ─── Formatters ──────────────────────────────────────────────────────────────
+function formatRational(r: [number, number] | undefined): string {
+  if (!r) return 'n/a';
+  if (r[1] === 0) return `${r[0]}/0`;
+  if (r[1] === 1) return `${r[0]}`;
+  const val = r[0] / r[1];
+  // For exposure times, show as fraction if denominator is small
+  if (r[0] <= 100 && r[1] <= 1000 && r[0] < r[1]) {
+    return `${r[0]}/${r[1]}`;
+  }
+  return Number.isInteger(val) ? `${val}` : val.toFixed(2);
+}
+
+function formatExposureTime(r: [number, number] | undefined): string {
+  if (!r || r[1] === 0) return 'n/a';
+  const val = r[0] / r[1];
+  if (val >= 1) return `${val.toFixed(1)}s`;
+  // Express as 1/X
+  const reciprocal = r[1] / r[0];
+  return `1/${Math.round(reciprocal)}s`;
+}
+
+function formatFNumber(r: [number, number] | undefined): string {
+  if (!r || r[1] === 0) return 'n/a';
+  return `f/${(r[0] / r[1]).toFixed(1)}`;
+}
+
+function formatFocalLength(r: [number, number] | undefined): string {
+  if (!r || r[1] === 0) return 'n/a';
+  return `${(r[0] / r[1]).toFixed(0)}mm`;
+}
+
+function getTagValue(tags: Map<number, ExifTag>, tagId: number): any {
+  const t = tags.get(tagId);
+  return t ? t.value : undefined;
+}
+
+function getTagString(tags: Map<number, ExifTag>, tagId: number): string | undefined {
+  const v = getTagValue(tags, tagId);
+  return typeof v === 'string' ? v.trim() : undefined;
+}
+
+function formatCameraSettings(exif: ExifData): string {
+  const all = [exif.tags, exif.exifTags];
+  const get = (tagId: number): any => {
+    for (const m of all) {
+      const v = getTagValue(m, tagId);
+      if (v !== undefined) return v;
+    }
+    return undefined;
+  };
+
+  const parts: string[] = [];
+
+  const exposure = get(TAG.ExposureTime);
+  if (exposure) parts.push(formatExposureTime(exposure));
+
+  const fnum = get(TAG.FNumber);
+  if (fnum) parts.push(formatFNumber(fnum));
+
+  const iso = get(TAG.ISOSpeedRatings);
+  if (iso !== undefined) {
+    const isoVal = Array.isArray(iso) ? iso[0] : iso;
+    parts.push(`ISO${isoVal}`);
+  }
+
+  const focal = get(TAG.FocalLength);
+  if (focal) parts.push(formatFocalLength(focal));
+
+  return parts.join(' ');
+}
+
+function formatTagTable(exif: ExifData): string {
+  const lines: string[] = [];
+
+  const formatSection = (name: string, tags: Map<number, ExifTag>) => {
+    if (tags.size === 0) return;
+    lines.push(`\n${name}:`);
+    for (const [, tag] of tags) {
+      // Skip internal pointers
+      if (tag.tag === TAG.ExifIFDPointer || tag.tag === TAG.GPSIFDPointer) continue;
+
+      let display: string;
+      if (tag.type === 5 || tag.type === 10) {
+        // Rational
+        if (Array.isArray(tag.value) && Array.isArray(tag.value[0])) {
+          // Array of rationals (e.g. GPS)
+          display = (tag.value as [number, number][]).map(r => formatRational(r)).join(', ');
+        } else if (Array.isArray(tag.value)) {
+          display = formatRational(tag.value as [number, number]);
+        } else {
+          display = String(tag.value);
+        }
+      } else if (tag.type === 2) {
+        display = `"${tag.value}"`;
+      } else if (Array.isArray(tag.value)) {
+        display = tag.value.join(', ');
+      } else {
+        display = String(tag.value ?? 'n/a');
+      }
+      lines.push(`  ${tag.name} (0x${tag.tag.toString(16).padStart(4, '0')}): ${display}`);
+    }
+  };
+
+  formatSection('IFD0', exif.tags);
+  formatSection('ExifIFD', exif.exifTags);
+  formatSection('GPSIFD', exif.gpsTags);
+
+  return lines.join('\n');
+}
+
+function formatGpsInfo(exif: ExifData): {lat: number | null; lon: number | null; alt: number | null; time: string | null} {
+  const gps = exif.gpsTags;
+  const latRef = getTagString(gps, TAG.GPSLatitudeRef);
+  const lonRef = getTagString(gps, TAG.GPSLongitudeRef);
+  const latDms = getTagValue(gps, TAG.GPSLatitude) as [number, number][] | undefined;
+  const lonDms = getTagValue(gps, TAG.GPSLongitude) as [number, number][] | undefined;
+  const altR = getTagValue(gps, TAG.GPSAltitude) as [number, number] | undefined;
+  const altRef = getTagValue(gps, TAG.GPSAltitudeRef);
+  const tsR = getTagValue(gps, TAG.GPSTimeStamp) as [number, number][] | undefined;
+
+  const lat = gpsDmsToDecimal(latDms, latRef);
+  const lon = gpsDmsToDecimal(lonDms, lonRef);
+
+  let alt: number | null = null;
+  if (altR && altR[1] !== 0) {
+    alt = altR[0] / altR[1];
+    if (altRef === 1) alt = -alt; // below sea level
+  }
+
+  let time: string | null = null;
+  if (tsR && tsR.length >= 3) {
+    const h = rationalToDecimal(tsR[0]);
+    const m = rationalToDecimal(tsR[1]);
+    const s = rationalToDecimal(tsR[2]);
+    if (h !== null && m !== null && s !== null) {
+      time = `${String(Math.floor(h)).padStart(2, '0')}:${String(Math.floor(m)).padStart(2, '0')}:${String(Math.floor(s)).padStart(2, '0')}Z`;
+    }
+  }
+
+  return {lat, lon, alt, time};
+}
+
+// ─── Engine ──────────────────────────────────────────────────────────────────
+export class ExifEngine implements TalentEngine {
+  readonly name = 'exif';
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const operation = typeof args.operation === 'string' ? args.operation.toLowerCase() : '';
+
+    switch (operation) {
+      case 'read':
+        return this.readOp(args);
+      case 'summary':
+        return this.summaryOp(args);
+      case 'gps_track':
+        return this.gpsTrackOp(args);
+      default:
+        return {
+          type: 'error',
+          summary: `exif: unknown or missing operation "${operation || '(none)'}"`,
+          errorMessage: 'operation must be one of: read, summary, gps_track',
+        };
+    }
+  }
+
+  private parseJpegArg(args: Record<string, any>): {bytes: Uint8Array; path: string} | TalentResult {
+    const data = typeof args.data === 'string' ? args.data : '';
+    const encoding = (args.encoding as InputEncoding) || 'auto';
+    const path = typeof args.path === 'string' ? args.path : '(unknown)';
+
+    if (!data) {
+      return {
+        type: 'error',
+        summary: 'exif: missing or empty "data" argument',
+        errorMessage: 'data argument is required as hex or base64 encoded JPEG bytes',
+      };
+    }
+
+    let bytes: Uint8Array;
+    try {
+      bytes = decodeInput(data, encoding);
+    } catch (e) {
+      return {
+        type: 'error',
+        summary: `exif: failed to decode input: ${e instanceof Error ? e.message : String(e)}`,
+        errorMessage: 'decode failed',
+      };
+    }
+
+    return {bytes, path};
+  }
+
+  private readOp(args: Record<string, any>): TalentResult {
+    const result = this.parseJpegArg(args);
+    if ('type' in result) return result;
+    const {bytes, path} = result;
+
+    const {exif, error} = parseExif(bytes);
+    if (!exif) {
+      return {
+        type: 'error',
+        summary: `exif.read: ${error}`,
+        errorMessage: error || 'parse failed',
+      };
+    }
+
+    const settings = formatCameraSettings(exif);
+    const make = getTagString(exif.tags, TAG.Make) || getTagString(exif.exifTags, TAG.Make);
+    const model = getTagString(exif.tags, TAG.Model) || getTagString(exif.exifTags, TAG.Model);
+    const dateTime = getTagString(exif.tags, TAG.DateTime);
+    const lens = getTagString(exif.exifTags, TAG.LensModel);
+    const gps = formatGpsInfo(exif);
+
+    const lines: string[] = [];
+    lines.push(`EXIF read: ${path}`);
+    lines.push('');
+    if (make || model) lines.push(`Camera: ${[make, model].filter(Boolean).join(' ')}`);
+    if (lens) lines.push(`Lens: ${lens}`);
+    if (dateTime) lines.push(`DateTime: ${dateTime}`);
+    if (settings) lines.push(`Settings: ${settings}`);
+    if (gps.lat !== null && gps.lon !== null) {
+      lines.push(`GPS: ${gps.lat.toFixed(6)}, ${gps.lon.toFixed(6)}${gps.alt !== null ? ` alt ${gps.alt.toFixed(1)}m` : ''}${gps.time ? ` time ${gps.time}` : ''}`);
+    }
+
+    lines.push(formatTagTable(exif));
+
+    if (exif.warnings.length > 0) {
+      lines.push('');
+      lines.push(`Warnings: ${exif.warnings.join('; ')}`);
+    }
+
+    return {type: 'text', summary: lines.join('\n')};
+  }
+
+  private summaryOp(args: Record<string, any>): TalentResult {
+    const paths = Array.isArray(args.paths) ? args.paths : [];
+    const dataList = Array.isArray(args.data_list) ? args.data_list : [];
+
+    if (paths.length === 0 && dataList.length === 0) {
+      return {
+        type: 'error',
+        summary: 'exif.summary: "paths" or "data_list" must be a non-empty array',
+        errorMessage: 'provide an array of file paths and/or data_list (hex/base64 JPEG data)',
+      };
+    }
+
+    const encoding = (args.encoding as InputEncoding) || 'auto';
+
+    const lines: string[] = [];
+    lines.push('filename | datetime | camera | lens | settings | GPS');
+    lines.push('---|---|---|---|---|---');
+
+    for (let i = 0; i < Math.max(paths.length, dataList.length); i++) {
+      const fname = i < paths.length ? String(paths[i]) : `file_${i}`;
+      const dataStr = i < dataList.length ? String(dataList[i]) : '';
+
+      if (!dataStr) {
+        lines.push(`${fname} | (no data provided)`);
+        continue;
+      }
+
+      let bytes: Uint8Array;
+      try {
+        bytes = decodeInput(dataStr, encoding);
+      } catch {
+        lines.push(`${fname} | (decode error)`);
+        continue;
+      }
+
+      const {exif} = parseExif(bytes);
+      if (!exif) {
+        lines.push(`${fname} | (no EXIF)`);
+        continue;
+      }
+
+      const make = getTagString(exif.tags, TAG.Make) || '';
+      const model = getTagString(exif.tags, TAG.Model) || '';
+      const camera = [make, model].filter(Boolean).join(' ') || 'n/a';
+      const dt = getTagString(exif.tags, TAG.DateTime) || 'n/a';
+      const lens = getTagString(exif.exifTags, TAG.LensModel) || 'n/a';
+      const settings = formatCameraSettings(exif) || 'n/a';
+      const gps = formatGpsInfo(exif);
+      const gpsStr = gps.lat !== null && gps.lon !== null
+        ? `${gps.lat.toFixed(4)}, ${gps.lon.toFixed(4)}`
+        : 'n/a';
+
+      lines.push(`${fname} | ${dt} | ${camera} | ${lens} | ${settings} | ${gpsStr}`);
+    }
+
+    return {type: 'text', summary: lines.join('\n')};
+  }
+
+  private gpsTrackOp(args: Record<string, any>): TalentResult {
+    const paths = Array.isArray(args.paths) ? args.paths : [];
+    const dataList = Array.isArray(args.data_list) ? args.data_list : [];
+
+    if (paths.length === 0 && dataList.length === 0) {
+      return {
+        type: 'error',
+        summary: 'exif.gps_track: "paths" or "data_list" must be a non-empty array',
+        errorMessage: 'provide an array of file paths and/or data_list (hex/base64 JPEG data)',
+      };
+    }
+
+    const encoding = (args.encoding as InputEncoding) || 'auto';
+
+    const lines: string[] = [];
+    lines.push('GPS Track (ordered by file sequence):');
+    lines.push('');
+    lines.push('# | filename | time | latitude | longitude | altitude');
+    lines.push('---|---|---|---|---|---');
+
+    let trackCount = 0;
+
+    for (let i = 0; i < Math.max(paths.length, dataList.length); i++) {
+      const fname = i < paths.length ? String(paths[i]) : `file_${i}`;
+      const dataStr = i < dataList.length ? String(dataList[i]) : '';
+
+      if (!dataStr) continue;
+
+      let bytes: Uint8Array;
+      try {
+        bytes = decodeInput(dataStr, encoding);
+      } catch {
+        continue;
+      }
+
+      const {exif} = parseExif(bytes);
+      if (!exif) continue;
+
+      const gps = formatGpsInfo(exif);
+      if (gps.lat === null || gps.lon === null) continue;
+
+      trackCount++;
+      const timeStr = gps.time || 'n/a';
+      const altStr = gps.alt !== null ? `${gps.alt.toFixed(1)}m` : 'n/a';
+      lines.push(`${trackCount} | ${fname} | ${timeStr} | ${gps.lat.toFixed(6)} | ${gps.lon.toFixed(6)} | ${altStr}`);
+    }
+
+    if (trackCount === 0) {
+      return {
+        type: 'text',
+        summary: 'GPS Track: no files contained GPS coordinates.',
+      };
+    }
+
+    lines.push('');
+    lines.push(`Total track points: ${trackCount}`);
+
+    return {type: 'text', summary: lines.join('\n')};
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: 'exif',
+        description:
+          'Read EXIF/metadata from JPEG files via pure binary parsing. Operations: "read" parses a single JPEG and returns camera settings + raw tag table; "summary" produces a shoot-log table across multiple files; "gps_track" extracts ordered GPS coordinates for a route log. Input is JPEG bytes as hex or base64.',
+        parameters: {
+          type: 'object',
+          properties: {
+            operation: {
+              type: 'string',
+              enum: ['read', 'summary', 'gps_track'],
+              description: 'Which EXIF operation to perform.',
+            },
+            data: {
+              type: 'string',
+              description: 'For "read": JPEG bytes as hex or base64 string.',
+            },
+            path: {
+              type: 'string',
+              description: 'For "read": filename/path label for display.',
+            },
+            paths: {
+              type: 'array',
+              items: {type: 'string'},
+              description: 'For "summary"/"gps_track": array of filename labels.',
+            },
+            data_list: {
+              type: 'array',
+              items: {type: 'string'},
+              description: 'For "summary"/"gps_track": array of JPEG bytes as hex/base64, matching paths indices.',
+            },
+            encoding: {
+              type: 'string',
+              enum: ['auto', 'hex', 'base64'],
+              description: 'Input encoding (default: auto-detect hex vs base64).',
+            },
+          },
+          required: ['operation'],
+        },
+      },
+    };
+  }
+
+  systemPromptFragment(_ctx: SystemPromptContext): string | null {
+    return [
+      '## exif talent',
+      'Use the "exif" talent to read camera metadata from JPEG files. It parses EXIF data purely from binary — no external tools.',
+      'Operations: "read" for a single file (camera settings + full tag table), "summary" for a shoot-log table across files, "gps_track" for ordered GPS coordinates.',
+      'Pass JPEG bytes as hex or base64. If a field is missing from the file, it reports "n/a" — never fabricate values.',
+      'GPS coordinates are converted from DMS rationals to decimal degrees.',
+    ].join('\n');
+  }
+}
