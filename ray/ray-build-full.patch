+/** Get width of a character code in Helvetica (units per 1000). */
+function helvWidth(code: number): number {
+  if (code >= 32 && code <= 126) {
+    return HELV_WIDTHS[code - 32];
+  }
+  return 278; // fallback to space width
+}
+
+/** Measure string width in points at a given font size. */
+function measureWidth(text: string, fontSize: number): number {
+  let w = 0;
+  for (let i = 0; i < text.length; i++) {
+    w += helvWidth(text.charCodeAt(i));
+  }
+  return (w / 1000) * fontSize;
+}
+
+/** Escape a string for PDF text operators (WinAnsi). */
+function pdfEscape(text: string): string {
+  let out = '';
+  for (let i = 0; i < text.length; i++) {
+    const ch = text[i];
+    const code = text.charCodeAt(i);
+    if (ch === '\\') out += '\\\\';
+    else if (ch === '(') out += '\\(';
+    else if (ch === ')') out += '\\)';
+    else if (code < 32 || code > 126) {
+      // Strip non-printable / non-ASCII for WinAnsi safety
+      continue;
+    } else {
+      out += ch;
+    }
+  }
+  return out;
+}
+
+/** Wrap text to fit within maxWidth at given fontSize. Returns array of lines. */
+function wrapText(text: string, fontSize: number, maxWidth: number): string[] {
+  const words = text.split(/\s+/);
+  const lines: string[] = [];
+  let currentLine = '';
+
+  for (const word of words) {
+    if (!word) continue;
+    const testLine = currentLine ? currentLine + ' ' + word : word;
+    const testWidth = measureWidth(testLine, fontSize);
+    if (testWidth > maxWidth && currentLine) {
+      lines.push(currentLine);
+      currentLine = word;
+    } else {
+      currentLine = testLine;
+    }
+  }
+  if (currentLine) {
+    lines.push(currentLine);
+  }
+  return lines.length > 0 ? lines : [''];
+}
