+import {computeIrr} from './FinanceEngine';
+import {TalentEngine, TalentResult, ToolDefinition} from './types';
+
+/**
+ * Deterministic lease analytics for RAY.
+ *
+ * The point of this talent is that lease figures come out of arithmetic, not
+ * out of the model. RAY's first policy is "never invent a figure" — this engine
+ * makes that structurally true for lease payment schedules, implicit rates,
+ * PV-of-lease, and finance-vs-operating classification indicators.
+ *
+ * All rates are decimals (0.12 = 12%), all cash flows end-of-period unless
+ * stated. Rounding is presentational only — intermediate maths stays full
+ * precision.
+ */
+
+/** Round for display without corrupting the underlying value. */
+function round(value: number, decimals = 2): number {
+  if (!Number.isFinite(value)) {
+    return NaN;
+  }
+  const factor = Math.pow(10, decimals);
+  return Math.round((value + Number.EPSILON) * factor) / factor;
+}
+
+/** Percent formatter: 0.0891 -> "8.91%". */
+function pct(value: number, decimals = 2): string {
+  return Number.isFinite(value) ? `${round(value * 100, decimals)}%` : 'n/a';
+}
+
+/** Money formatter with thousands separators, no currency symbol assumed. */
+function money(value: number, decimals = 2): string {
+  if (!Number.isFinite(value)) {
+    return 'n/a';
+  }
+  return value.toLocaleString('en-US', {
+    minimumFractionDigits: decimals,
+    maximumFractionDigits: decimals,
+  });
+}
+
+/** Coerce an unknown arg to a finite number, or null if unusable. */
+function num(value: unknown): number | null {
+  const n = typeof value === 'number' ? value : parseFloat(String(value));
+  return Number.isFinite(n) ? n : null;
+}
+
+/** Coerce an unknown arg to an array of finite numbers, or null. */
+function numArray(value: unknown): number[] | null {
+  if (!Array.isArray(value) || value.length === 0) {
+    return null;
+  }
+  const parsed: number[] = [];
+  for (const item of value) {
+    const n = num(item);
+    if (n === null) {
+      return null;
+    }
+    parsed.push(n);
+  }
+  return parsed;
+}
+
+function err(summary: string, errorMessage: string): TalentResult {
+  return {type: 'error', summary, errorMessage};
+}
+
+export interface LeaseScheduleRow {
+  period: number;
+  opening: number;
+  payment: number;
+  interest: number;
+  principal: number;
+  closing: number;
+}
+
+export class LeasingEngine implements TalentEngine {
+  readonly name = 'leasing';
+  readonly recommendedContextTokens = 4096;
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const operation =
+      typeof args.operation === 'string' ? args.operation.toLowerCase() : '';
+
+    switch (operation) {
+      case 'schedule':
+        return this.schedule(args);
+      case 'implicit_rate':
+        return this.implicitRate(args);
+      case 'classify':
+        return this.classify(args);
+      case 'pv_lease':
+        return this.pvLease(args);
+      default:
+        return err(
+          `leasing: unknown operation "${operation || '(missing)'}"`,
+          'operation must be one of: schedule, implicit_rate, classify, pv_lease',
+        );
+    }
+  }
+
+  private schedule(args: Record<string, any>): TalentResult {
+    const assetValue = num(args.asset_value);
+    const annualRate = num(args.annual_rate);
+    const paymentsPerYear = num(args.payments_per_year);
+    const termPeriods = num(args.term_periods);
+    const paymentTiming =
+      typeof args.payment_timing === 'string'
+        ? args.payment_timing.toLowerCase()
+        : 'arrears';
+    const residualValue = num(args.residual_value) ?? 0;
+    const guaranteedResidual = num(args.guaranteed_residual) ?? 0;
+
+    if (assetValue === null || assetValue <= 0) {
+      return err(
+        'leasing.schedule: "asset_value" must be a positive number',
+        'asset_value is the capitalised lease amount (fair value or present value of lease payments)',
+      );
+    }
+    if (annualRate === null || annualRate < 0) {
+      return err(
+        'leasing.schedule: "annual_rate" must be a non-negative number',
+        'annual_rate is the interest rate as a decimal, e.g. 0.12 for 12%',
+      );
+    }
+    if (
+      paymentsPerYear === null ||
+      paymentsPerYear <= 0 ||
+      !Number.isInteger(paymentsPerYear)
+    ) {
+      return err(
+        'leasing.schedule: "payments_per_year" must be a positive integer',
+        'payments_per_year is the payment frequency: 12 monthly, 4 quarterly, 2 semi-annual, 1 annual',
+      );
+    }
+    if (
+      termPeriods === null ||
+      termPeriods <= 0 ||
+      !Number.isInteger(termPeriods)
+    ) {
+      return err(
+        'leasing.schedule: "term_periods" must be a positive integer',
+        'term_periods is the total number of payments',
+      );
+    }
+    if (paymentTiming !== 'advance' && paymentTiming !== 'arrears') {
+      return err(
+        'leasing.schedule: "payment_timing" must be "advance" or "arrears"',
+        'advance = payments at period start (annuity-due), arrears = payments at period end (ordinary annuity)',
+      );
+    }
+    if (residualValue < 0) {
+      return err(
+        'leasing.schedule: "residual_value" must be non-negative',
+        'residual_value is the balloon payment at end of lease',
+      );
+    }
+    if (guaranteedResidual < 0 || guaranteedResidual > residualValue) {
+      return err(
+        'leasing.schedule: "guaranteed_residual" must be in [0, residual_value]',
+        'guaranteed_residual is the portion of residual_value the lessee guarantees',
+      );
+    }
+
+    const i = annualRate / paymentsPerYear;
+    const n = termPeriods;
+    const isAdvance = paymentTiming === 'advance';
+
+    // Compute the level periodic payment that amortises (asset_value - PV(residual))
+    // PV of payments + PV of residual = asset_value
+    const pvResidual = residualValue / Math.pow(1 + i, n);
+    const amountToAmortise = assetValue - pvResidual;
+
+    let payment: number;
+    if (i === 0) {
+      payment = amountToAmortise / n;
+    } else {
+      const annuityFactor = (1 - Math.pow(1 + i, -n)) / i;
+      const arrearsPayment = amountToAmortise / annuityFactor;
+      payment = isAdvance ? arrearsPayment / (1 + i) : arrearsPayment;
+    }
+
+    // Build the amortisation table
+    const rows: LeaseScheduleRow[] = [];
+    let balance = assetValue;
+
+    for (let p = 1; p <= n; p++) {
+      const opening = balance;
+      let interest: number;
+      let principal: number;
+      let totalPayment: number;
+
+      if (isAdvance) {
+        // For advance timing, payment is made at period start
+        // Interest is charged on (opening - payment) for the period
+        interest = (opening - payment) * i;
+        if (p === n && residualValue > 0) {
+          // Final period: settle the residual
+          totalPayment = payment + residualValue;
+          principal = opening; // bring balance to 0
+        } else {
+          totalPayment = payment;
+          principal = totalPayment - interest;
+        }
+      } else {
+        // For arrears timing, payment is made at period end
+        interest = opening * i;
+        if (p === n && residualValue > 0) {
+          // Final period: settle the residual
+          totalPayment = payment + residualValue;
+          principal = opening; // bring balance to 0
+        } else {
+          totalPayment = payment;
+          principal = totalPayment - interest;
+        }
+      }
+
+      balance = opening - principal;
+      rows.push({
+        period: p,
+        opening,
+        payment: totalPayment,
+        interest,
+        principal,
+        closing: Math.max(balance, 0),
+      });
+    }
+
+    const totalPayments = rows.reduce((sum, r) => sum + r.payment, 0);
+    const totalInterest = rows.reduce((sum, r) => sum + r.interest, 0);
+
+    // Cap the printed schedule at 24 rows
+    const maxRows = 24;
+    const shown = rows.slice(0, maxRows);
+    const table = [
+      'per | opening  | payment  | interest | principal | closing',
+      ...shown.map(
+        r =>
+          `${String(r.period).padStart(3)} | ${money(r.opening).padStart(10)} | ${money(r.payment).padStart(10)} | ${money(r.interest).padStart(10)} | ${money(r.principal).padStart(10)} | ${money(r.closing).padStart(10)}`,
+      ),
+    ].join('\n');
+
+    const truncated =
+      rows.length > maxRows
+        ? `\n... ${rows.length - maxRows} further periods omitted (ask for a specific period range if needed)`
+        : '';
+
+    const nominalAnnual = i * paymentsPerYear;
+    const effectiveAnnual = Math.pow(1 + i, paymentsPerYear) - 1;
+    const freqName =
+      paymentsPerYear === 12
+        ? 'monthly'
+        : paymentsPerYear === 4
+          ? 'quarterly'
+          : paymentsPerYear === 2
+            ? 'semi-annual'
+            : paymentsPerYear === 1
+              ? 'annual'
+              : `${paymentsPerYear}x per year`;
+
+    let summary =
+      `Lease payment schedule (${isAdvance ? 'advance/annuity-due' : 'arrears/ordinary annuity'})\n` +
+      `Level payment = ${money(payment)} per period\n` +
+      `Asset value = ${money(assetValue)}\n` +
+      `Annual rate = ${pct(annualRate, 2)} → periodic rate ${pct(i, 4)} (${freqName})\n` +
+      `Nominal annual = ${pct(nominalAnnual, 2)}, effective annual = ${pct(effectiveAnnual, 2)}\n` +
+      `Term = ${n} periods\n`;
+
+    if (residualValue > 0) {
+      summary += `Residual value = ${money(residualValue)} (PV = ${money(pvResidual)})\n`;
+      if (guaranteedResidual > 0) {
+        summary += `Guaranteed residual = ${money(guaranteedResidual)}\n`;
+      }
+    }
+
+    summary +=
+      `Total payments = ${money(totalPayments)}\n` +
+      `Total interest = ${money(totalInterest)}\n` +
+      `Amount amortised = ${money(amountToAmortise)}\n\n` +
+      `${table}${truncated}\n\n` +
+      `Inputs as used: asset_value ${money(assetValue)}, annual_rate ${pct(annualRate, 2)}, ` +
+      `payments_per_year ${paymentsPerYear}, term_periods ${n}, payment_timing ${paymentTiming}` +
+      (residualValue > 0 ? `, residual_value ${money(residualValue)}` : '') +
+      (guaranteedResidual > 0 ? `, guaranteed_residual ${money(guaranteedResidual)}` : '') +
+      `.\n` +
+      `Final closing balance = ${money(rows[rows.length - 1].closing)} (should be ≈0 after residual settlement).`;
+
+    return {type: 'text', summary};
+  }
+
+  private implicitRate(args: Record<string, any>): TalentResult {
+    const assetValue = num(args.asset_value);
+    const payments = numArray(args.payments);
+    const residualValue = num(args.residual_value) ?? 0;
+    const paymentsPerYear = num(args.payments_per_year);
+    const paymentTiming =
+      typeof args.payment_timing === 'string'
+        ? args.payment_timing.toLowerCase()
+        : 'arrears';
+
+    if (assetValue === null || assetValue <= 0) {
+      return err(
+        'leasing.implicit_rate: "asset_value" must be a positive number',
+        'asset_value is the lessor\'s net investment / fair value',
+      );
+    }
+    if (!payments) {
+      return err(
+        'leasing.implicit_rate: "payments" must be a non-empty numeric array',
+        'payments are the periodic lease payments (inflows to the lessor)',
+      );
+    }
+    if (residualValue < 0) {
+      return err(
+        'leasing.implicit_rate: "residual_value" must be non-negative',
+        'residual_value is the unguaranteed residual the lessor expects at end',
+      );
+    }
+    if (
+      paymentsPerYear === null ||
+      paymentsPerYear <= 0 ||
+      !Number.isInteger(paymentsPerYear)
+    ) {
+      return err(
+        'leasing.implicit_rate: "payments_per_year" must be a positive integer',
+        'payments_per_year is needed to annualise the rate correctly',
+      );
+    }
+    if (paymentTiming !== 'advance' && paymentTiming !== 'arrears') {
+      return err(
+        'leasing.implicit_rate: "payment_timing" must be "advance" or "arrears"',
+        'advance = payments at period start, arrears = payments at period end',
+      );
+    }
+
+    // Build the cash-flow stream: t0 = -asset_value, then each payment as inflow
+    // For advance timing, the first payment is at t=0
+    // For arrears timing, the first payment is at t=1
+    const cashFlows: number[] = [];
+    if (paymentTiming === 'advance') {
+      // First payment at t=0, so it's part of the initial outflow
+      cashFlows.push(-assetValue + payments[0]);
+      for (let t = 1; t < payments.length; t++) {
+        cashFlows.push(payments[t]);
+      }
+    } else {
+      // Arrears: outflow at t=0, inflows at t=1..n
+      cashFlows.push(-assetValue);
+      for (let t = 0; t < payments.length; t++) {
+        cashFlows.push(payments[t]);
+      }
+    }
+
+    // Add residual to the final inflow
+    if (residualValue > 0) {
+      cashFlows[cashFlows.length - 1] += residualValue;
+    }
+
+    // Check for sign change
+    const hasNegative = cashFlows.some(c => c < 0);
+    const hasPositive = cashFlows.some(c => c > 0);
+    if (!hasNegative || !hasPositive) {
+      return err(
+        'leasing.implicit_rate: no sign change in cash flows',
+        'IRR requires at least one outflow and one inflow; check that asset_value and payments have opposite signs',
+      );
+    }
+
+    const periodicIrr = computeIrr(cashFlows);
+    if (periodicIrr === null) {
+      return err(
+        'leasing.implicit_rate: could not converge on an implicit rate',
+        'no root found in the bisection range; the cash flows may not have a unique IRR',
+      );
+    }
+
+    const nominalAnnual = periodicIrr * paymentsPerYear;
+    const effectiveAnnual = Math.pow(1 + periodicIrr, paymentsPerYear) - 1;
+
+    const freqName =
+      paymentsPerYear === 12
+        ? 'monthly'
+        : paymentsPerYear === 4
+          ? 'quarterly'
+          : paymentsPerYear === 2
+            ? 'semi-annual'
+            : paymentsPerYear === 1
+              ? 'annual'
+              : `${paymentsPerYear}x per year`;
+
+    const summary =
+      `Lease implicit (effective) interest rate\n` +
+      `Periodic IRR = ${pct(periodicIrr, 4)} per period\n` +
+      `Nominal annual = ${pct(nominalAnnual, 2)} (${freqName})\n` +
+      `Effective annual = ${pct(effectiveAnnual, 2)}\n\n` +
+      `Cash flows: [${cashFlows.map(c => money(c)).join(', ')}]\n` +
+      `Inputs as used: asset_value ${money(assetValue)}, ${payments.length} payments of [${payments.map(p => money(p)).join(', ')}], ` +
+      `residual_value ${money(residualValue)}, payments_per_year ${paymentsPerYear}, payment_timing ${paymentTiming}.\n` +
+      `This is the rate that makes PV of (payments + residual) equal the asset value.`;
+
+    return {type: 'text', summary};
+  }
+
+  private classify(args: Record<string, any>): TalentResult {
+    const leaseTermYears = num(args.lease_term_years);
+    const assetUsefulLifeYears = num(args.asset_useful_life_years);
+    const pvOfPayments = num(args.pv_of_payments);
+    const fairValueOfAsset = num(args.fair_value_of_asset);
+    const transferOfOwnership =
+      typeof args.transfer_of_ownership === 'boolean'
+        ? args.transfer_of_ownership
+        : null;
+    const bargainPurchaseOption =
+      typeof args.bargain_purchase_option === 'boolean'
+        ? args.bargain_purchase_option
+        : null;
+    const specialisedAsset =
+      typeof args.specialised_asset === 'boolean'
+        ? args.specialised_asset
+        : null;
+
+    if (leaseTermYears === null || leaseTermYears <= 0) {
+      return err(
+        'leasing.classify: "lease_term_years" must be a positive number',
+        'lease_term_years is the non-cancellable period of the lease',
+      );
+    }
+    if (assetUsefulLifeYears === null || assetUsefulLifeYears <= 0) {
+      return err(
+        'leasing.classify: "asset_useful_life_years" must be a positive number',
+        'asset_useful_life_years is the economic life of the underlying asset',
+      );
+    }
+    if (pvOfPayments === null || pvOfPayments < 0) {
+      return err(
+        'leasing.classify: "pv_of_payments" must be a non-negative number',
+        'pv_of_payments is the present value of lease payments at the inception date',
+      );
+    }
+    if (fairValueOfAsset === null || fairValueOfAsset <= 0) {
+      return err(
+        'leasing.classify: "fair_value_of_asset" must be a positive number',
+        'fair_value_of_asset is the fair value of the underlying asset at inception',
+      );
+    }
+    if (transferOfOwnership === null) {
+      return err(
+        'leasing.classify: "transfer_of_ownership" must be a boolean',
+        'transfer_of_ownership indicates whether ownership transfers to the lessee by end of lease',
+      );
+    }
+    if (bargainPurchaseOption === null) {
+      return err(
+        'leasing.classify: "bargain_purchase_option" must be a boolean',
+        'bargain_purchase_option indicates whether the lessee has an option to purchase at below fair value',
+      );
+    }
+    if (specialisedAsset === null) {
+      return err(
+        'leasing.classify: "specialised_asset" must be a boolean',
+        'specialised_asset indicates whether the asset is of such a specialised nature that only the lessee can use it',
+      );
+    }
+
+    // Quantitative indicators
+    const termPercent = leaseTermYears / assetUsefulLifeYears;
+    const pvPercent = pvOfPayments / fairValueOfAsset;
+
+    // Rules-of-thumb thresholds (IAS 17 / legacy guidance, not codified in IFRS 16)
+    const termThreshold = 0.75; // ~75% of economic life
+    const pvThreshold = 0.9; // ~90% of fair value
+
+    const termIndicator = termPercent >= termThreshold;
+    const pvIndicator = pvPercent >= pvThreshold;
+
+    // Qualitative indicators
+    const qualitativeIndicators = [
+      {
+        name: 'Transfer of ownership',
+        value: transferOfOwnership,
+        pointsToFinance: transferOfOwnership,
+      },
+      {
+        name: 'Bargain purchase option',
+        value: bargainPurchaseOption,
+        pointsToFinance: bargainPurchaseOption,
+      },
+      {
+        name: 'Specialised asset',
+        value: specialisedAsset,
+        pointsToFinance: specialisedAsset,
+      },
+    ];
+
+    const quantIndicators = [
+      {
+        name: 'Lease term as % of useful life',
+        computed: termPercent,
+        threshold: termThreshold,
+        pointsToFinance: termIndicator,
+      },
+      {
+        name: 'PV of payments as % of fair value',
+        computed: pvPercent,
+        threshold: pvThreshold,
+        pointsToFinance: pvIndicator,
+      },
+    ];
+
+    const totalIndicators = quantIndicators.length + qualitativeIndicators.length;
+    const financeCount =
+      quantIndicators.filter(i => i.pointsToFinance).length +
+      qualitativeIndicators.filter(i => i.pointsToFinance).length;
+
+    let summary = `Lease classification indicators (framework, not a verdict)\n\n`;
+    summary += `QUANTITATIVE INDICATORS (rules-of-thumb, not law):\n`;
+    for (const ind of quantIndicators) {
+      const verdict = ind.pointsToFinance ? '→ finance lease indicator' : '→ operating lease indicator';
+      summary += `  • ${ind.name}: ${pct(ind.computed, 1)} (threshold ~${pct(ind.threshold, 0)} as rule-of-thumb) ${verdict}\n`;
+    }
+
+    summary += `\nQUALITATIVE INDICATORS:\n`;
+    for (const ind of qualitativeIndicators) {
+      const verdict = ind.pointsToFinance ? '→ finance lease indicator' : '→ no finance indicator';
+      summary += `  • ${ind.name}: ${ind.value ? 'YES' : 'NO'} ${verdict}\n`;
+    }
+
+    summary += `\nSUMMARY: ${financeCount} of ${totalIndicators} indicators point to a finance lease.\n\n`;
+    summary += `IMPORTANT NOTE: Under IFRS 16, a lessee recognises almost all leases on the balance sheet `;
+    summary += `(right-of-use asset + lease liability). The finance/operating split is primarily a LESSOR `;
+    summary += `concept under IFRS 16, and was a lessee concept under the old IAS 17. These thresholds `;
+    summary += `(75% / 90%) are rules-of-thumb from legacy guidance, not codified standards. `;
+    summary += `Do not present a single accounting standard's verdict as absolute — classification `;
+    summary += `depends on the specific facts and the applicable framework (IFRS 16, IAS 17, local GAAP).\n\n`;
+    summary += `Inputs as used: lease_term_years ${leaseTermYears}, asset_useful_life_years ${assetUsefulLifeYears}, `;
+    summary += `pv_of_payments ${money(pvOfPayments)}, fair_value_of_asset ${money(fairValueOfAsset)}, `;
+    summary += `transfer_of_ownership ${transferOfOwnership}, bargain_purchase_option ${bargainPurchaseOption}, `;
+    summary += `specialised_asset ${specialisedAsset}.`;
+
+    return {type: 'text', summary};
+  }
+
+  private pvLease(args: Record<string, any>): TalentResult {
+    const payments = numArray(args.payments);
+    const annualRate = num(args.annual_rate);
+    const paymentsPerYear = num(args.payments_per_year);
+    const paymentTiming =
+      typeof args.payment_timing === 'string'
+        ? args.payment_timing.toLowerCase()
+        : 'arrears';
+    const residualValue = num(args.residual_value) ?? 0;
+
+    if (!payments) {
+      return err(
+        'leasing.pv_lease: "payments" must be a non-empty numeric array',
+        'payments are the periodic lease payments',
+      );
+    }
+    if (annualRate === null || annualRate < 0) {
+      return err(
+        'leasing.pv_lease: "annual_rate" must be a non-negative number',
+        'annual_rate is the discount rate as a decimal, e.g. 0.12 for 12%',
+      );
+    }
+    if (
+      paymentsPerYear === null ||
+      paymentsPerYear <= 0 ||
+      !Number.isInteger(paymentsPerYear)
+    ) {
+      return err(
+        'leasing.pv_lease: "payments_per_year" must be a positive integer',
+        'payments_per_year is needed to compute the periodic discount rate',
+      );
+    }
+    if (paymentTiming !== 'advance' && paymentTiming !== 'arrears') {
+      return err(
+        'leasing.pv_lease: "payment_timing" must be "advance" or "arrears"',
+        'advance = payments at period start, arrears = payments at period end',
+      );
+    }
+    if (residualValue < 0) {
+      return err(
+        'leasing.pv_lease: "residual_value" must be non-negative',
+        'residual_value is the balloon payment at end of lease',
+      );
+    }
+
+    const i = annualRate / paymentsPerYear;
+    const n = payments.length;
+    const isAdvance = paymentTiming === 'advance';
+
+    // Discount each payment
+    let pvPayments = 0;
+    for (let t = 0; t < n; t++) {
+      // For advance: payment at period t+1 is made at t=0,1,...,n-1
+      // For arrears: payment at period t+1 is made at t=1,2,...,n
+      const discountPeriod = isAdvance ? t : t + 1;
+      pvPayments += payments[t] / Math.pow(1 + i, discountPeriod);
+    }
+
+    // Discount the residual at the final period
+    const pvResidual = residualValue / Math.pow(1 + i, n);
+    const totalPv = pvPayments + pvResidual;
+
+    const freqName =
+      paymentsPerYear === 12
+        ? 'monthly'
+        : paymentsPerYear === 4
+          ? 'quarterly'
+          : paymentsPerYear === 2
+            ? 'semi-annual'
+            : paymentsPerYear === 1
+              ? 'annual'
+              : `${paymentsPerYear}x per year`;
+
+    let summary = `Present value of lease payment stream\n`;
+    summary += `PV of payments = ${money(pvPayments)}\n`;
+    if (residualValue > 0) {
+      summary += `PV of residual = ${money(pvResidual)} (residual ${money(residualValue)} at period ${n})\n`;
+    }
+    summary += `Total PV = ${money(totalPv)}\n\n`;
+    summary += `Discount rate: annual ${pct(annualRate, 2)} → periodic ${pct(i, 4)} (${freqName})\n`;
+    summary += `Payment timing: ${isAdvance ? 'advance (annuity-due)' : 'arrears (ordinary annuity)'}\n`;
+    summary += `Payments: [${payments.map(p => money(p)).join(', ')}]\n`;
+    if (residualValue > 0) {
+      summary += `Residual value: ${money(residualValue)} at period ${n}\n`;
+    }
+    summary += `\nInputs as used: payments [${payments.map(p => money(p)).join(', ')}], `;
+    summary += `annual_rate ${pct(annualRate, 2)}, payments_per_year ${paymentsPerYear}, `;
+    summary += `payment_timing ${paymentTiming}`;
+    if (residualValue > 0) {
+      summary += `, residual_value ${money(residualValue)}`;
+    }
+    summary += `.\n`;
+    summary += `Note: If these payments came from the schedule operation, total PV must equal asset_value — this is the identity PV(payments) + PV(residual) = asset_value.`;
+
+    return {type: 'text', summary};
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: 'leasing',
+        description:
+          'Deterministic lease analytics: payment schedules (advance or arrears, with residual/balloon handling), implicit interest rate (the lease\'s internal rate of return), finance-vs-operating lease classification indicators, and present value of lease payment streams. Use this for ALL lease arithmetic instead of computing or estimating figures yourself — results are exact and auditable. Rates are decimals (0.12 = 12%). payments_per_year is required to annualise correctly — frequency is NOT inferable from period count alone.',
+        parameters: {
+          type: 'object',
+          properties: {
+            operation: {
+              type: 'string',
+              enum: ['schedule', 'implicit_rate', 'classify', 'pv_lease'],
+              description: 'Which computation to run.',
+            },
+            asset_value: {
+              type: 'number',
+              description:
+                'For schedule / implicit_rate. The capitalised lease amount (fair value or lessor\'s net investment). Must be > 0.',
+            },
+            annual_rate: {
+              type: 'number',
+              description:
+                'For schedule / pv_lease. Annual interest/discount rate as a decimal, e.g. 0.12 for 12%. Must be >= 0.',
+            },
+            payments_per_year: {
+              type: 'number',
+              description:
+                'For schedule / implicit_rate / pv_lease. Payment frequency: 12 monthly, 4 quarterly, 2 semi-annual, 1 annual. Required to compute the periodic rate correctly — frequency cannot be derived from period count alone.',
+            },
+            term_periods: {
+              type: 'number',
+              description:
+                'For schedule. Integer number of payments, e.g. 60 for 5 years monthly.',
+            },
+            payment_timing: {
+              type: 'string',
+              enum: ['advance', 'arrears'],
+              description:
+                'For schedule / implicit_rate / pv_lease. "advance" = payments at period start (annuity-due), "arrears" = payments at period end (ordinary annuity). Default "arrears".',
+            },
+            residual_value: {
+              type: 'number',
+              description:
+                'For schedule / implicit_rate / pv_lease. Balloon payment at end of lease. Must be >= 0. Default 0.',
+            },
+            guaranteed_residual: {
+              type: 'number',
+              description:
+                'For schedule. Subset of residual_value that the lessee guarantees. Must be in [0, residual_value]. Default 0.',
+            },
+            payments: {
+              type: 'array',
+              items: {type: 'number'},
+              description:
+                'For implicit_rate / pv_lease. Array of periodic lease payments (inflows to the lessor).',
+            },
+            lease_term_years: {
+              type: 'number',
+              description:
+                'For classify. The non-cancellable period of the lease in years. Must be > 0.',
+            },
+            asset_useful_life_years: {
+              type: 'number',
+              description:
+                'For classify. The economic life of the underlying asset in years. Must be > 0.',
+            },
+            pv_of_payments: {
+              type: 'number',
+              description:
+                'For classify. Present value of lease payments at inception date. Must be >= 0.',
+            },
+            fair_value_of_asset: {
+              type: 'number',
+              description:
+                'For classify. Fair value of the underlying asset at inception. Must be > 0.',
+            },
+            transfer_of_ownership: {
+              type: 'boolean',
+              description:
+                'For classify. Whether ownership transfers to the lessee by end of lease.',
+            },
+            bargain_purchase_option: {
+              type: 'boolean',
+              description:
+                'For classify. Whether the lessee has an option to purchase at below fair value.',
+            },
+            specialised_asset: {
+              type: 'boolean',
+              description:
+                'For classify. Whether the asset is so specialised that only the lessee can use it.',
+            },
+          },
+          required: ['operation'],
+        },
+      },
+    };
+  }
+
+  systemPromptFragment(): string {
+    return [
+      'LEASING TOOL POLICY:',
+      '- Any lease payment, implicit rate, PV-of-lease, or classification figure you report MUST come from the leasing tool. Do not compute or estimate these yourself, and never restate a lease figure from memory.',
+      '- The tool echoes the inputs it used. When you report a result, keep the inputs visible so the figure is auditable.',
+      '- Rates are decimals: 12% is 0.12. payments_per_year is required to annualise correctly — frequency is NOT inferable from period count alone (12 periods could be 12 months or 12 years).',
+      '- Classification thresholds (75% of useful life, 90% of fair value) are RULES-OF-THUMB indicators from legacy guidance, not codified in IFRS 16. Label them as such and never present a single accounting standard\'s verdict as absolute.',
+      '- Under IFRS 16, a lessee recognises almost all leases on the balance sheet (right-of-use asset + lease liability). The finance/operating split is primarily a LESSOR concept under IFRS 16, and was a lessee concept under the old IAS 17.',
+      '- The tool never invents a residual value — the user must supply it. If residual_value is not provided, assume 0.',
+      '- For implicit rate, the tool solves for the rate that makes PV of (payments + residual) equal the asset value. This is the lease\'s internal rate of return.',
+      '- If an input is missing, ask for it or state the assumption explicitly. Never silently substitute a plausible number.',
+    ].join('\n');
+  }
+}
