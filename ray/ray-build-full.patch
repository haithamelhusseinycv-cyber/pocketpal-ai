index 0000000..14f32c1
--- /dev/null
+++ b/src/api/networkInfo.ts
@@ -0,0 +1,79 @@
+import NetInfo from '@react-native-community/netinfo';
+import type {NetInfoState} from '@react-native-community/netinfo';
+
+/**
+ * Live network detection for hybrid routing.
+ *
+ * Wraps @react-native-community/netinfo behind a tiny synchronous interface so
+ * the routing layer (routeSignals/ModelStore) can read "is this metered?"
+ * per request without awaiting anything. NetInfo pushes state to subscribers,
+ * so we keep the latest snapshot in memory and expose it via getters.
+ *
+ * Privacy-safe default: until NetInfo has reported at least once, the
+ * connection is treated as METERED. That keeps routing on-device on a cold
+ * start rather than assuming wifi and leaking a prompt over cellular.
+ */
+
+let latest: NetInfoState | null = null;
+let subscribed = false;
+
+/** True when the current (or unknown) connection should be treated as metered. */
+export function isMeteredConnection(): boolean {
+  // Lazily subscribe on first read so callers don't have to wire an explicit
+  // init step; the first call returns the safe default (metered) and subsequent
+  // calls reflect live NetInfo state.
+  if (!subscribed) {
+    startNetworkWatch();
+  }
+  if (!latest) {
+    // No reading yet — assume metered (privacy-safe).
+    return true;
+  }
+  if (!latest.isConnected) {
+    // Offline: metered is irrelevant, but returning true keeps cloud routing
+    // gated off, which is the safe direction when there is no network anyway.
+    return true;
+  }
+  // NetInfo flags cellular/metered explicitly where the OS knows it. A
+  // connection marked expensive is metered even if its type is ambiguous.
+  const expensive = latest.details?.isConnectionExpensive === true;
+  const cellularType =
+    latest.type === 'cellular' || latest.type === 'mobile' || latest.type === 'wimax';
+  const knownUnmetered = latest.type === 'wifi' || latest.type === 'ethernet' || latest.type === 'vpn';
+  if (expensive) {
+    return true;
+  }
+  if (cellularType) {
+    return true;
+  }
+  if (knownUnmetered) {
+    return false;
+  }
+  // Unknown/none/other type: treat as metered.
+  return true;
+}
+
+/** Start listening to NetInfo. Idempotent; safe to call from app/store init. */
+export function startNetworkWatch(): void {
+  if (subscribed) {
+    return;
+  }
+  subscribed = true;
+  // Prime synchronously-ish: fetch once, then subscribe for live updates.
+  NetInfo.fetch()
+    .then(state => {
+      latest = state;
+    })
+    .catch(() => {
+      /* leave latest null → stays metered (safe) */
+    });
+  NetInfo.addEventListener(state => {
+    latest = state;
+  });
+}
+
+/** Test/reset hook. */
+export function __resetNetworkWatch(): void {
+  latest = null;
+  subscribed = false;
+}
diff --git a/src/api/routeSignals.ts b/src/api/routeSignals.ts
new file mode 100644
index 0000000..0602a0b
--- /dev/null
+++ b/src/api/routeSignals.ts
@@ -0,0 +1,101 @@
+import type {ApiCompletionParams} from '../utils/completionTypes';
+import type {RouteSignals} from './hybridEngine';
+
+/**
+ * Derives routing signals from the completion params about to be sent.
+ *
+ * Kept in its own module so it can be unit-tested without constructing a
+ * HybridCompletionEngine, and so ModelStore does not have to know the shape of
+ * RouteSignals.
+ */
+
+type ChatMessage = {role?: string; content?: unknown};
+
+/** Flatten message content to text. Content is a string for text turns and an
+ *  array of parts for multimodal turns. */
+function messageText(content: unknown): string {
+  if (typeof content === 'string') {
+    return content;
+  }
+  if (Array.isArray(content)) {
+    return content
+      .map(part =>
+        typeof part === 'string'
+          ? part
+          : part && typeof part === 'object' && 'text' in part
+          ? String((part as {text: unknown}).text ?? '')
+          : '',
+      )
+      .join('');
+  }
+  return '';
+}
+
+/** True when any message content carries a non-text part (image/vision). */
+function hasMultimodalContent(messages: ChatMessage[]): boolean {
+  return messages.some(msg => {
+    if (!Array.isArray(msg.content)) {
+      return false;
+    }
+    return msg.content.some(
+      part =>
+        part &&
+        typeof part === 'object' &&
+        'type' in part &&
+        String((part as {type: unknown}).type) !== 'text',
+    );
+  });
+}
+
+/** Last user turn's text — the thing being classified for "heaviness". */
+export function latestUserText(messages: ChatMessage[]): string {
+  for (let i = messages.length - 1; i >= 0; i--) {
+    if (messages[i]?.role === 'user') {
+      return messageText(messages[i].content);
+    }
+  }
+  return '';
+}
+
+export interface SignalsOverrides {
+  /**
+   * Whether the device is on a metered connection.
+   *
+   * The project has no @react-native-community/netinfo dependency, so this is
+   * supplied by the caller — in practice RouteStore.onCellular, which reflects
+   * the user-declared connection (see ConnectionMode). Pass a thunk to read it
+   * live per request, or a boolean to pin it.
+   *
+   * The default is TRUE — treat the connection as metered — because that is the
+   * privacy- and cost-safe direction: with the default wifiOnly policy it keeps
+   * requests on-device until the caller explicitly confirms wifi. Passing
+   * `false` blindly would silently route prompts to a paid cloud endpoint over
+   * cellular.
+   */
+  onCellular?: boolean | (() => boolean);
+}
+
+export function buildSignalsProvider(
+  overrides: SignalsOverrides = {},
+): (params: ApiCompletionParams) => Omit<RouteSignals, 'localAvailable'> {
+  const resolveOnCellular = (): boolean => {
+    const v = overrides.onCellular;
+    if (typeof v === 'function') {
+      return v() !== false; // anything but an explicit false stays metered
+    }
+    return v ?? true;
+  };
+
+  return (params: ApiCompletionParams) => {
+    const messages = ((params.messages ?? []) as ChatMessage[]) ?? [];
+    const tools = (params as unknown as {tools?: unknown[]}).tools;
+
+    return {
+      userText: latestUserText(messages),
+      messageCount: messages.length,
+      hasTools: Array.isArray(tools) && tools.length > 0,
+      hasImages: hasMultimodalContent(messages),
+      onCellular: resolveOnCellular(),
+    };
+  };
+}
