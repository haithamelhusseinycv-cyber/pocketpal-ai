+if (Math.abs(fullAge - expectedFullMoonAge) <= 0.6) {
+  console.log('✓ Full moon age within ±0.6 days');
+} else {
+  console.log('✗ Full moon age outside tolerance');
+  console.log(`  Expected: ${expectedFullMoonAge} ± 0.6 days`);
