+// ─── Planetary Positions (Natal) ────────────────────────────────────────────
+
+/** Moon ecliptic longitude via truncated Meeus series. Accuracy ~10 arcmin. */
+function moonLongitude(T: number): number {
+  const Lp = 218.3164477 + 481267.88123421 * T - 0.0015786 * T * T;
+  const D = 297.8501921 + 445267.1114034 * T - 0.0018819 * T * T;
+  const M = 357.5291092 + 35999.0502909 * T - 0.0001536 * T * T;
+  const Mp = 134.9633964 + 477198.8675055 * T + 0.0087414 * T * T;
+  const F = 93.2720950 + 483202.0175233 * T - 0.0036539 * T * T;
+
+  // Main periodic terms (Meeus Table 47.A, top terms)
+  const terms: [number, number, number, number, number][] = [
+    [0, 0, 1, 0, 6288774],
+    [2, 0, -1, 0, 1274027],
+    [2, 0, 0, 0, 658314],
+    [0, 0, 2, 0, 213618],
+    [0, 1, 0, 0, -185116],
+    [0, 0, 0, 2, -114332],
+    [2, 0, -2, 0, 58793],
+    [2, -1, -1, 0, 57066],
+    [2, 0, 1, 0, 53322],
+    [2, -1, 0, 0, 45758],
+    [0, 1, -1, 0, -40923],
+    [1, 0, 0, 0, -34720],
+    [0, 1, 1, 0, -30383],
+    [2, 0, 0, -2, 15327],
+    [0, 0, 1, 2, -12528],
+  ];
+
+  let sumL = 0;
+  for (const [dC, mC, mpC, fC, amp] of terms) {
+    const arg = (dC * D + mC * M + mpC * Mp + fC * F) * DEG;
+    sumL += amp * Math.sin(arg);
+  }
+
+  return norm360(Lp + sumL / 1000000);
+}
+
+interface PlanetElements {
+  a: number; e: number; incl: number; L: number; longPeri: number; longNode: number;
+}
+
+function getPlanetElements(planet: string, T: number): PlanetElements | null {
+  // JPL approximate elements for 1800-2050 (from Meeus Table 26.A + rates)
+  // Format: [a, e, i, L, longPeri, longNode] + [rates per century]
+  switch (planet) {
+    case 'mercury': return {
+      a: 0.38709927 + 0.00000037 * T,
+      e: 0.20563593 + 0.00001906 * T,
+      incl: 7.00497902 - 0.00594749 * T,
+      L: norm360(252.25032350 + 149472.67411175 * T),
+      longPeri: norm360(77.45779628 + 0.16047689 * T),
+      longNode: norm360(48.33076593 - 0.12534081 * T),
+    };
+    case 'venus': return {
+      a: 0.72333566 + 0.00000390 * T,
+      e: 0.00677672 - 0.00004107 * T,
+      incl: 3.39467605 - 0.00078890 * T,
+      L: norm360(181.97909660 + 58517.81538729 * T),
+      longPeri: norm360(131.60246718 + 0.00268329 * T),
+      longNode: norm360(76.67984255 - 0.27769418 * T),
+    };
+    case 'mars': return {
+      a: 1.52371034 + 0.00001847 * T,
+      e: 0.09339410 + 0.00007882 * T,
+      incl: 1.84969142 - 0.00813131 * T,
+      L: norm360(-4.55343205 + 19140.30268499 * T),
+      longPeri: norm360(-23.94362959 + 0.44441088 * T),
+      longNode: norm360(49.55953891 - 0.30665436 * T),
+    };
+    default: return null;
+  }
+}
+
+/** Compute geocentric ecliptic longitude for a planet. */
+function geocentricPlanetLon(planet: string, T: number): number {
+  const sunLon = sunEclipticLon(T);
+  const sunR = 1.0000010178; // approx Earth-Sun distance in AU (nearly 1)
+
+  // Get planet heliocentric position
+  const elements = getPlanetElements(planet, T);
+  if (!elements) return NaN;
+
+  const {a, e, incl, L, longPeri, longNode} = elements;
+  const M_anom = norm360(L - longPeri);
+  const Mrad = M_anom * DEG;
+
+  let E = Mrad;
+  for (let i = 0; i < 10; i++) {
+    E = Mrad + e * Math.sin(E);
+  }
+
+  const cosE = Math.cos(E);
+  const sinE = Math.sin(E);
+  const cosV = (cosE - e) / (1 - e * cosE);
+  const sinV = (Math.sqrt(1 - e * e) * sinE) / (1 - e * cosE);
+  const v = Math.atan2(sinV, cosV);
+  const r = a * (1 - e * cosE);
+
+  const lonPeri = longPeri * DEG;
+  const lonNode = longNode * DEG;
+  const inclRad = incl * DEG;
+
+  // Heliocentric ecliptic rectangular
+  const helX = r * (Math.cos(lonNode) * Math.cos(v + lonPeri - lonNode) - Math.sin(lonNode) * Math.sin(v + lonPeri - lonNode) * Math.cos(inclRad));
+  const helY = r * (Math.sin(lonNode) * Math.cos(v + lonPeri - lonNode) + Math.cos(lonNode) * Math.sin(v + lonPeri - lonNode) * Math.cos(inclRad));
+
+  // Earth heliocentric position = Sun's geocentric position reversed
+  // Earth lon = sunLon + 180
+  const earthLon = (sunLon + 180) * DEG;
+  const earthX = sunR * Math.cos(earthLon);
+  const earthY = sunR * Math.sin(earthLon);
+
+  // Geocentric
+  const geoX = helX - earthX;
+  const geoY = helY - earthY;
+
+  return norm360(Math.atan2(geoY, geoX) * RAD);
+}
+
+function lonToSignDeg(lon: number): {sign: string; degree: number; symbol: string} {
+  const signIdx = Math.floor(lon / 30);
+  const deg = lon - signIdx * 30;
+  const signNames = ['Aries', 'Taurus', 'Gemini', 'Cancer', 'Leo', 'Virgo',
+    'Libra', 'Scorpio', 'Sagittarius', 'Capricorn', 'Aquarius', 'Pisces'];
+  const symbols = ['♈', '♉', '♊', '♋', '♌', '♍', '♎', '♏', '♐', '♑', '♒', '♓'];
+  return {sign: signNames[signIdx], degree: deg, symbol: symbols[signIdx]};
+}
