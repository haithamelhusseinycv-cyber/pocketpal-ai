+  // Paginate content into pages
+  interface PageData {
+    stream: string;
+  }
+  const pageDataList: PageData[] = [];
+  let currentStream = '';
+  let y = pageH - MARGIN_TOP;
+
+  function newPage() {
+    pageDataList.push({stream: currentStream});
+    currentStream = '';
+    y = pageH - MARGIN_TOP;
+    // Header rule on continuation pages
+    currentStream += `q 0.7 G\n1 w\n${MARGIN_LEFT} ${y + 10} m ${pageW - MARGIN_RIGHT} ${y + 10} l S\nQ\n`;
+  }
+
+  function ensureSpace(needed: number) {
+    if (y - needed < MARGIN_BOTTOM) {
+      newPage();
+    }
+  }
+
+  // Title
+  y -= titleSize + 10;
+  currentStream += `BT /F2 ${titleSize} Tf ${MARGIN_LEFT} ${y} Td (${pdfEscape(input.title)}) Tj ET\n`;
+
+  if (input.subtitle) {
+    y -= lineHeight;
+    currentStream += `BT /F1 ${fontSize} Tf 0.4 0.4 0.4 rg ${MARGIN_LEFT} ${y} Td (${pdfEscape(input.subtitle)}) Tj ET\n0 g\n`;
+  }
+
+  if (input.author) {
+    y -= lineHeight;
+    currentStream += `BT /F1 ${fontSize} Tf 0.4 0.4 0.4 rg ${MARGIN_LEFT} ${y} Td (${pdfEscape(input.author)}) Tj ET\n0 g\n`;
+  }
+
+  y -= 10;
+  currentStream += `q 0.5 G\n0.5 w\n${MARGIN_LEFT} ${y} m ${pageW - MARGIN_RIGHT} ${y} l S\nQ\n`;
+  y -= 20;
+
+  // Sections
+  for (const section of input.sections) {
+    ensureSpace(headingLineHeight + 10);
+    y -= headingLineHeight;
+    currentStream += `BT /F2 ${headingSize} Tf ${MARGIN_LEFT} ${y} Td (${pdfEscape(section.heading)}) Tj ET\n`;
+    y -= 5;
+
+    for (const para of section.paragraphs) {
+      const lines = wrapText(para, fontSize, uWidth);
+      for (const line of lines) {
+        ensureSpace(lineHeight);
+        y -= lineHeight;
+        currentStream += `BT /F1 ${fontSize} Tf ${MARGIN_LEFT} ${y} Td (${pdfEscape(line)}) Tj ET\n`;
+      }
+      y -= lineHeight * 0.5;
+    }
