+    const pnWidth = measureWidth(pnText, 8);
+    const pnX = (builder.pageWidth - pnWidth) / 2;
+    const pnY = MARGIN_BOTTOM / 2;
+    pageNumStream += `BT /F1 8 Tf 0.5 0.5 0.5 rg ${pnX} ${pnY} Td (${pnText}) Tj ET\n0 g\n`;
+
+    // Footer text
+    if (input.footer) {
+      pageNumStream += `BT /F1 8 Tf 0.5 0.5 0.5 rg ${MARGIN_LEFT} ${pnY} Td (${pdfEscape(input.footer)}) Tj ET\n0 g\n`;
+    }
+
+    // Update stream
+    const streamObj = builder.objects[contentStreamIds[i] - 1];
+    streamObj.content = `<< /Length ${pageNumStream.length} >>\nstream\n${pageNumStream}\nendstream`;
+
+    builder.objects[pageIds[i] - 1].content =
+      `<< /Type /Page /Parent ${pagesObjId} 0 R /MediaBox [0 0 ${builder.pageWidth} ${builder.pageHeight}] ` +
+      `/Contents ${contentStreamIds[i]} 0 R /Resources ${resourcesId} 0 R >>`;
+  }
