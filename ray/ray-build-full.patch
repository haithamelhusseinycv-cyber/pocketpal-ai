+import {HashEngine} from '../HashEngine';
+
+describe('HashEngine', () => {
+  const engine = new HashEngine();
+
+  it('exposes name "hash_checksum"', () => {
+    expect(engine.name).toBe('hash_checksum');
+  });
+
+  describe('MD5', () => {
+    it('hashes empty string', async () => {
+      const result = await engine.execute({algorithm: 'md5', data: '', encoding: 'utf8'});
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        expect(result.summary).toBe('md5(0 bytes) = d41d8cd98f00b204e9800998ecf8427e');
+      }
+    });
+
+    it('hashes "abc"', async () => {
+      const result = await engine.execute({algorithm: 'md5', data: 'abc', encoding: 'utf8'});
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        expect(result.summary).toBe('md5(3 bytes) = 900150983cd24fb0d6963f7d28e17f72');
+      }
+    });
+
+    it('hashes "The quick brown fox jumps over the lazy dog"', async () => {
+      const result = await engine.execute({
+        algorithm: 'md5',
+        data: 'The quick brown fox jumps over the lazy dog',
+        encoding: 'utf8',
+      });
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        expect(result.summary).toBe('md5(43 bytes) = 9e107d9d372bb6826bd81d3542a419d6');
+      }
+    });
+  });
+
+  describe('SHA-1', () => {
+    it('hashes empty string', async () => {
+      const result = await engine.execute({algorithm: 'sha1', data: '', encoding: 'utf8'});
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        expect(result.summary).toBe('sha1(0 bytes) = da39a3ee5e6b4b0d3255bfef95601890afd80709');
+      }
+    });
+
+    it('hashes "abc"', async () => {
+      const result = await engine.execute({algorithm: 'sha1', data: 'abc', encoding: 'utf8'});
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        expect(result.summary).toBe('sha1(3 bytes) = a9993e364706816aba3e25717850c26c9cd0d89d');
+      }
+    });
+  });
+
+  describe('SHA-256', () => {
+    it('hashes empty string', async () => {
+      const result = await engine.execute({algorithm: 'sha256', data: '', encoding: 'utf8'});
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        expect(result.summary).toBe(
+          'sha256(0 bytes) = e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855',
+        );
+      }
+    });
+
+    it('hashes "abc"', async () => {
+      const result = await engine.execute({algorithm: 'sha256', data: 'abc', encoding: 'utf8'});
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        expect(result.summary).toBe(
+          'sha256(3 bytes) = ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad',
+        );
+      }
+    });
+
+    it('hashes multi-byte UTF-8 (Arabic)', async () => {
+      const result = await engine.execute({
+        algorithm: 'sha256',
+        data: 'مرحبا',
+        encoding: 'utf8',
+      });
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        expect(result.summary).toBe(
+          'sha256(10 bytes) = 80eff1a750bb540045622ad23c148c8875790515e3f768c77d5dff8c1d221b49',
+        );
+      }
+    });
+  });
+
+  describe('SHA-512', () => {
+    it('hashes empty string', async () => {
+      const result = await engine.execute({algorithm: 'sha512', data: '', encoding: 'utf8'});
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        expect(result.summary).toBe(
+          'sha512(0 bytes) = cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e',
+        );
+      }
+    });
+
+    it('hashes "abc"', async () => {
+      const result = await engine.execute({algorithm: 'sha512', data: 'abc', encoding: 'utf8'});
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        expect(result.summary).toBe(
+          'sha512(3 bytes) = ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f',
+        );
+      }
+    });
+  });
+
+  describe('CRC32', () => {
+    it('hashes empty string', async () => {
+      const result = await engine.execute({algorithm: 'crc32', data: '', encoding: 'utf8'});
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        expect(result.summary).toBe('crc32(0 bytes) = 00000000');
+      }
+    });
+
+    it('hashes "123456789"', async () => {
+      const result = await engine.execute({
+        algorithm: 'crc32',
+        data: '123456789',
+        encoding: 'utf8',
+      });
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        expect(result.summary).toBe('crc32(9 bytes) = cbf43926');
+      }
+    });
+
+    it('hashes "The quick brown fox jumps over the lazy dog"', async () => {
+      const result = await engine.execute({
+        algorithm: 'crc32',
+        data: 'The quick brown fox jumps over the lazy dog',
+        encoding: 'utf8',
+      });
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        expect(result.summary).toBe('crc32(43 bytes) = 414fa339');
+      }
+    });
+  });
+
+  describe('encoding', () => {
+    it('handles hex-encoded input', async () => {
+      const result = await engine.execute({
+        algorithm: 'md5',
+        data: '616263', // "abc" in hex
+        encoding: 'hex',
+      });
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        expect(result.summary).toBe('md5(3 bytes) = 900150983cd24fb0d6963f7d28e17f72');
+      }
+    });
+
+    it('handles base64-encoded input', async () => {
+      const result = await engine.execute({
+        algorithm: 'md5',
+        data: 'YWJj', // "abc" in base64
+        encoding: 'base64',
+      });
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        expect(result.summary).toBe('md5(3 bytes) = 900150983cd24fb0d6963f7d28e17f72');
+      }
+    });
+
+    it('defaults to auto encoding', async () => {
+      const result = await engine.execute({
+        algorithm: 'md5',
+        data: 'YWJj', // "abc" in base64
+      });
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        expect(result.summary).toBe('md5(3 bytes) = 900150983cd24fb0d6963f7d28e17f72');
+      }
+    });
+  });
+
+  describe('error handling', () => {
+    it('returns error for missing algorithm', async () => {
+      const result = await engine.execute({data: 'abc', encoding: 'utf8'});
+      expect(result.type).toBe('error');
+      if (result.type === 'error') {
+        expect(result.errorMessage).toMatch(/algorithm argument is required/);
+      }
+    });
+
+    it('returns error for unknown algorithm', async () => {
+      const result = await engine.execute({
+        algorithm: 'sha3',
+        data: 'abc',
+        encoding: 'utf8',
+      });
+      expect(result.type).toBe('error');
+      if (result.type === 'error') {
+        expect(result.errorMessage).toMatch(/algorithm must be one of/);
+      }
+    });
+
+    it('returns error for invalid hex input', async () => {
+      const result = await engine.execute({
+        algorithm: 'md5',
+        data: 'xyz', // invalid hex
+        encoding: 'hex',
+      });
+      expect(result.type).toBe('error');
+      if (result.type === 'error') {
+        expect(result.errorMessage).toMatch(/failed to decode input data/);
+      }
+    });
+
+    it('returns error for invalid base64 input', async () => {
+      const result = await engine.execute({
+        algorithm: 'md5',
+        data: '!!!', // invalid base64
+        encoding: 'base64',
+      });
+      expect(result.type).toBe('error');
+      if (result.type === 'error') {
+        expect(result.errorMessage).toMatch(/failed to decode input data/);
+      }
+    });
+  });
+
+  describe('toToolDefinition', () => {
+    it('returns valid tool definition', () => {
+      const def = engine.toToolDefinition();
+      expect(def.type).toBe('function');
+      expect(def.function.name).toBe('hash_checksum');
+      expect(def.function.description).toMatch(/cryptographic hash/);
+      expect(def.function.parameters.type).toBe('object');
+      expect(def.function.parameters.properties.algorithm).toBeDefined();
+      expect(def.function.parameters.properties.data).toBeDefined();
+      expect(def.function.parameters.properties.encoding).toBeDefined();
+      expect(def.function.parameters.required).toContain('algorithm');
+      expect(def.function.parameters.required).toContain('data');
+    });
+  });
+
+  describe('systemPromptFragment', () => {
+    it('returns guidance about computing digests', () => {
+      const ctx = {
+        now: new Date('2024-01-01'),
+        maxToolTurns: 10,
+        activeTalents: new Set(['hash_checksum']),
+      };
+      const fragment = engine.systemPromptFragment(ctx);
+      expect(fragment).toMatch(/Use hash_checksum/);
+      expect(fragment).toMatch(/Do NOT invent or guess digests/);
+      expect(fragment).toMatch(/exact bytes given/);
+    });
+  });
+});
