+  it('creates valid ZIP with correct signatures', async () => {
+    const createResult = await engine.execute({
+      operation: 'create',
+      sheets: [{name: 'Test', rows: [['A'], [1]]}],
+    });
+
+    const base64Match = /Base64: ([A-Za-z0-9+/=]+)/.exec(text(createResult));
+    const base64 = base64Match![1];
+
+    // Decode and check ZIP signatures
+    const bytes = Uint8Array.from(atob(base64), c => c.charCodeAt(0));
+    const dv = new DataView(bytes.buffer);
+
+    // Check local file header signature
+    expect(dv.getUint32(0, true)).toBe(0x04034b50);
+
+    // Find EOCD signature
+    let eocdFound = false;
+    for (let i = bytes.length - 22; i >= 0; i--) {
+      if (dv.getUint32(i, true) === 0x06054b50) {
+        eocdFound = true;
+        break;
+      }
+    }
+    expect(eocdFound).toBe(true);
+  });
+});
