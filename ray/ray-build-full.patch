+import {EgyptEconomyEngine, EgyptEconomyTopic} from '../EgyptEconomyEngine';
+
+describe('EgyptEconomyEngine', () => {
+  const engine = new EgyptEconomyEngine();
+
+  it('exposes name "egypt_economy"', () => {
+    expect(engine.name).toBe('egypt_economy');
+  });
+
+  it('returns text for central_bank topic containing structural keywords', async () => {
+    const result = await engine.execute({topics: ['central_bank']});
+    expect(result.type).toBe('text');
+    if (result.type === 'text') {
+      expect(result.summary).toContain('Central Bank of Egypt');
+      expect(result.summary).toContain('monetary policy');
+      expect(result.summary).toContain('overnight deposit');
+      expect(result.summary).toContain('overnight lending');
+      expect(result.summary).toContain('corridor');
+      expect(result.summary).toContain('discount rate');
+    }
+  });
+
+  it('returns text for banking_sector topic containing structural keywords', async () => {
+    const result = await engine.execute({topics: ['banking_sector']});
+    expect(result.type).toBe('text');
+    if (result.type === 'text') {
+      expect(result.summary).toContain('National Bank of Egypt');
+      expect(result.summary).toContain('Banque Misr');
+      expect(result.summary).toContain('Commercial International Bank');
+      expect(result.summary).toContain('QNB Alahli');
+      expect(result.summary).toContain('bank-dominated');
+    }
+  });
+
+  it('returns text for nbfis topic containing structural keywords', async () => {
+    const result = await engine.execute({topics: ['nbfis']});
+    expect(result.type).toBe('text');
+    if (result.type === 'text') {
+      expect(result.summary).toContain('Financial Regulatory Authority');
+      expect(result.summary).toContain('FRA');
+      expect(result.summary).toContain('factoring');
+      expect(result.summary).toContain('leasing');
+      expect(result.summary).toContain('mortgage finance');
+      expect(result.summary).toContain('microfinance');
+      expect(result.summary).toContain('insurance');
+    }
+  });
+
+  it('returns text for currency_fx topic without fabricated live rates', async () => {
+    const result = await engine.execute({topics: ['currency_fx']});
+    expect(result.type).toBe('text');
+    if (result.type === 'text') {
+      expect(result.summary).toContain('Egyptian pound');
+      expect(result.summary).toContain('EGP');
+      expect(result.summary).toContain('managed float');
+      expect(result.summary).toContain('foreign-exchange');
+      // Must NOT contain a hard-coded live rate
+      expect(result.summary).not.toMatch(/1 USD = \d+ EGP/);
+      expect(result.summary).not.toMatch(/1 USD = \d+\.\d+ EGP/);
+      expect(result.summary).not.toMatch(/EGP\/USD.*\d+\.\d+/);
+    }
+  });
+
+  it('returns text for macro_indicators topic containing structural keywords', async () => {
+    const result = await engine.execute({topics: ['macro_indicators']});
+    expect(result.type).toBe('text');
+    if (result.type === 'text') {
+      expect(result.summary).toContain('GDP');
+      expect(result.summary).toContain('inflation');
+      expect(result.summary).toContain('fiscal deficit');
+      expect(result.summary).toContain('debt-to-GDP');
+      expect(result.summary).toContain('current account');
+      expect(result.summary).toContain('foreign-exchange reserves');
+    }
+  });
+
+  it('returns text for sovereign_credit topic containing structural keywords', async () => {
+    const result = await engine.execute({topics: ['sovereign_credit']});
+    expect(result.type).toBe('text');
+    if (result.type === 'text') {
+      expect(result.summary).toContain('Standard & Poor');
+      expect(result.summary).toContain('Moody');
+      expect(result.summary).toContain('Fitch');
+      expect(result.summary).toContain('sovereign credit');
+      expect(result.summary).toContain('IMF');
+      expect(result.summary).toContain('Extended Fund Facility');
+    }
+  });
+
+  it('returns concatenated text for multiple topics', async () => {
+    const result = await engine.execute({
+      topics: ['central_bank', 'nbfis'],
+    });
+    expect(result.type).toBe('text');
+    if (result.type === 'text') {
+      expect(result.summary).toContain('Central Bank of Egypt');
+      expect(result.summary).toContain('Financial Regulatory Authority');
+      expect(result.summary).toContain('---');
+    }
+  });
+
+  it('returns error for unknown topic', async () => {
+    const result = await engine.execute({topics: ['unknown_topic']});
+    expect(result.type).toBe('error');
+    if (result.type === 'error') {
+      expect(result.summary).toContain('unknown topic');
+      expect(result.summary).toContain('unknown_topic');
+    }
+  });
+
+  it('returns error for empty topics array', async () => {
+    const result = await engine.execute({topics: []});
+    expect(result.type).toBe('error');
+    if (result.type === 'error') {
+      expect(result.summary).toContain('non-empty array');
+    }
+  });
+
+  it('returns error for missing topics argument', async () => {
+    const result = await engine.execute({});
+    expect(result.type).toBe('error');
+    if (result.type === 'error') {
+      expect(result.summary).toContain('non-empty array');
+    }
+  });
+
+  it('returns error for non-array topics argument', async () => {
+    const result = await engine.execute({topics: 'central_bank' as any});
+    expect(result.type).toBe('error');
+    if (result.type === 'error') {
+      expect(result.summary).toContain('non-empty array');
+    }
+  });
+
+  it('toToolDefinition returns proper schema with topics enum', () => {
+    const def = engine.toToolDefinition();
+    expect(def.type).toBe('function');
+    expect(def.function.name).toBe('egypt_economy');
+    expect(def.function.parameters.type).toBe('object');
+    expect(def.function.parameters.properties.topics.type).toBe('array');
+    expect(def.function.parameters.properties.topics.items.enum).toEqual([
+      'central_bank',
+      'banking_sector',
+      'nbfis',
+      'currency_fx',
+      'macro_indicators',
+      'sovereign_credit',
+    ]);
+    expect(def.function.parameters.required).toContain('topics');
+  });
+
+  it('systemPromptFragment returns non-null string mentioning live sourcing', () => {
+    const ctx = {
+      now: new Date(),
+      maxToolTurns: 10,
+      activeTalents: new Set(['egypt_economy']),
+    };
+    const fragment = engine.systemPromptFragment(ctx);
+    expect(fragment).not.toBeNull();
+    expect(fragment).toContain('egypt_economy');
+    expect(fragment).toContain('live');
+    expect(fragment).toContain('Never guess');
+  });
+
+  it('does not fabricate any live numbers in any topic block', async () => {
+    const allTopics = [
+      'central_bank',
+      'banking_sector',
+      'nbfis',
+      'currency_fx',
+      'macro_indicators',
+      'sovereign_credit',
+    ];
+    const result = await engine.execute({topics: allTopics});
+    expect(result.type).toBe('text');
+    if (result.type === 'text') {
+      // Check for common patterns of fabricated live numbers
+      expect(result.summary).not.toMatch(/\b\d{1,2}\.\d{2}%\b/); // No "X.XX%"
+      expect(result.summary).not.toMatch(/\b\d{4}\s*billion\b/i); // No "2024 billion"
+      expect(result.summary).not.toMatch(/rating.*[A-Z]{1,3}[+-]?/i); // No "rating: BBB-"
+    }
+  });
+});
diff --git a/src/services/talents/__tests__/EncodingEngine.test.ts b/src/services/talents/__tests__/EncodingEngine.test.ts
