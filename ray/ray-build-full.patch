index 0000000..0ffa865
--- /dev/null
+++ b/__mocks__/external/@react-native-community/netinfo.js
@@ -0,0 +1,32 @@
+const defaultState = {
+  type: 'wifi',
+  isConnected: true,
+  isInternetReachable: true,
+  details: {isConnectionExpensive: false},
+};
+
+let currentState = {...defaultState};
+
+const listeners = new Set();
+
+const NetInfoMock = {
+  fetch: jest.fn(() => Promise.resolve(currentState)),
+  // Register-only: does NOT synchronously replay state on subscribe (real
+  // NetInfo does, but tests drive updates explicitly via __setState so the
+  // "no reading yet" path stays deterministically observable).
+  addEventListener: jest.fn(listener => {
+    listeners.add(listener);
+    return () => listeners.delete(listener);
+  }),
+  // Test helper: set the state the mock reports and notify listeners.
+  __setState: (partial = {}) => {
+    currentState = {...defaultState, ...partial};
+    listeners.forEach(fn => fn(currentState));
+  },
+  __reset: () => {
+    currentState = {...defaultState};
+    listeners.clear();
+  },
+};
+
+export default NetInfoMock;
