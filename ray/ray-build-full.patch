+import {TalentEngine, TalentResult, ToolDefinition} from './types';
+
+/**
+ * CSV / tabular-data talent.
+ *
+ * The point of this talent is that tabular analytics come out of deterministic
+ * operations on the user's actual data, not out of the model re-eyeballing
+ * retyped numbers. RAY's "never invent a figure" policy is structurally enforced
+ * here: the parser is a hand-rolled state machine (no dependencies), every
+ * operation echoes the inputs it used, and summaries are bounded so context
+ * does not blow up.
+ *
+ * Input is CSV/TSV text the user pastes or that an .xlsx was exported to.
+ * Binary .xlsx parsing is deliberately out of scope — it needs a dependency
+ * (SheetJS etc.) and is not worth the surface area when export-to-CSV is one
+ * click in every spreadsheet app.
+ *
+ * Ragged rows are padded with empty strings to the header width. This is the
+ * choice that keeps downstream column lookups total (every row has every
+ * column) rather than forcing each operation to handle missing cells. The
+ * padding is visible in the parse summary so the user can see it happened.
+ */
+
+/** One parsed table: headers + rows of string cells. */
+export interface ParsedTable {
+  headers: string[];
+  rows: string[][];
+  /** Number of rows that were shorter than the header and got padded. */
+  paddedRowCount: number;
+}
+
+/**
+ * Hand-rolled CSV parser.
+ *
+ * State machine with three states: FIELD (unquoted), QUOTED (inside "..."),
+ * QUOTE_IN_QUOTED (just saw a " while quoted — next char decides: another "
+ * is a literal, anything else ends the quoted region).
+ *
+ * Handles: quoted fields with embedded commas, escaped "" quotes, embedded
+ * newlines inside quotes, CRLF and LF line endings, bare CR as a line ending
+ * (old Mac files). Empty input returns zero rows. A trailing newline does NOT
+ * produce a phantom empty row.
+ */
+export function parseCsv(text: string): string[][] {
+  const rows: string[][] = [];
+  let field = '';
+  let row: string[] = [];
+  let inQuotes = false;
+  let i = 0;
+
+  while (i < text.length) {
+    const ch = text[i];
+
+    if (inQuotes) {
+      if (ch === '"') {
+        // Look ahead: "" is an escaped quote, otherwise end of quoted region.
+        if (i + 1 < text.length && text[i + 1] === '"') {
+          field += '"';
+          i += 2;
+          continue;
+        }
+        inQuotes = false;
+        i++;
+        continue;
+      }
+      field += ch;
+      i++;
+      continue;
+    }
+
+    // Not in quotes.
+    if (ch === '"') {
+      inQuotes = true;
+      i++;
+      continue;
+    }
+    if (ch === ',') {
+      row.push(field);
+      field = '';
+      i++;
+      continue;
+    }
+    if (ch === '\r') {
+      // End of row. Swallow a following \n (CRLF).
+      row.push(field);
+      field = '';
+      rows.push(row);
+      row = [];
+      if (i + 1 < text.length && text[i + 1] === '\n') {
+        i += 2;
+      } else {
+        i++;
+      }
+      continue;
+    }
+    if (ch === '\n') {
+      row.push(field);
+      field = '';
+      rows.push(row);
+      row = [];
+      i++;
+      continue;
+    }
+    field += ch;
+    i++;
+  }
+
+  // Flush whatever is left. If the input ended in a newline, field is empty
+  // and row is empty — we do NOT push a phantom row in that case.
+  if (field.length > 0 || row.length > 0) {
+    row.push(field);
+    rows.push(row);
+  }
+
+  return rows;
+}
+
+/**
+ * Build a ParsedTable from raw text. First row becomes headers. Ragged rows
+ * (shorter than headers) are padded with empty strings; rows LONGER than
+ * headers are truncated and the count is reported so the user sees it.
+ */
+export function buildTable(text: string): ParsedTable {
+  const raw = parseCsv(text);
+  if (raw.length === 0) {
+    return {headers: [], rows: [], paddedRowCount: 0};
+  }
+  const headers = raw[0].map(h => h.trim());
+  const width = headers.length;
+  const rows: string[][] = [];
+  let paddedRowCount = 0;
+  for (let r = 1; r < raw.length; r++) {
+    const src = raw[r];
+    // Skip completely blank trailing rows (an artefact of some editors).
+    if (src.length === 1 && src[0] === '') {
+      continue;
+    }
+    if (src.length < width) {
+      const padded = src.slice();
+      while (padded.length < width) {
+        padded.push('');
+      }
+      rows.push(padded);
+      paddedRowCount++;
+    } else if (src.length > width) {
+      rows.push(src.slice(0, width));
+    } else {
+      rows.push(src);
+    }
+  }
+  return {headers, rows, paddedRowCount};
+}
+
+/** Try to read a cell as a finite number; return null otherwise. */
+function asNumber(cell: string): number | null {
+  if (cell === '') {
+    return null;
+  }
+  const n = Number(cell);
+  return Number.isFinite(n) ? n : null;
+}
+
+/** Find a column index by exact name or case-insensitive match. -1 if missing. */
+function findColumn(headers: string[], name: string): number {
+  const exact = headers.indexOf(name);
+  if (exact >= 0) {
+    return exact;
+  }
+  const lower = name.toLowerCase();
+  return headers.findIndex(h => h.toLowerCase() === lower);
+}
+
+function err(summary: string, errorMessage: string): TalentResult {
+  return {type: 'error', summary, errorMessage};
+}
+
+function textResult(summary: string): TalentResult {
+  return {type: 'text', summary};
+}
+
+/** Round for display only — intermediate maths stays full precision. */
+function round(value: number, decimals = 4): number {
+  if (!Number.isFinite(value)) {
+    return NaN;
+  }
+  const factor = Math.pow(10, decimals);
+  return Math.round((value + Number.EPSILON) * factor) / factor;
+}
+
+/** Cap a string for output so a huge table cannot blow the context window. */
+function truncate(s: string, maxChars = 4000): {text: string; truncated: boolean} {
+  if (s.length <= maxChars) {
+    return {text: s, truncated: false};
+  }
+  return {
+    text: s.slice(0, maxChars) + `\n... [truncated ${s.length - maxChars} chars]`,
+    truncated: true,
+  };
+}
+
+/**
+ * Per-column type inference and basic stats for numeric columns.
+ * A column is numeric iff every non-empty cell parses as a finite number.
+ */
+function describeColumn(rows: string[][], colIdx: number): {
+  kind: 'numeric' | 'text';
+  count: number;
+  emptyCount: number;
+  sum?: number;
+  mean?: number;
+  min?: number;
+  max?: number;
+  distinct?: number;
+} {
+  const values: number[] = [];
+  let emptyCount = 0;
+  const textSet = new Set<string>();
+  let allNumeric = true;
+
+  for (const row of rows) {
+    const cell = row[colIdx] ?? '';
+    if (cell === '') {
+      emptyCount++;
+      continue;
+    }
+    const n = asNumber(cell);
+    if (n !== null) {
+      values.push(n);
+    } else {
+      allNumeric = false;
+    }
+    textSet.add(cell);
+  }
+
+  if (allNumeric && values.length > 0) {
+    const sum = values.reduce((a, b) => a + b, 0);
+    return {
+      kind: 'numeric',
+      count: values.length,
+      emptyCount,
+      sum,
+      mean: sum / values.length,
+      min: Math.min(...values),
+      max: Math.max(...values),
+      distinct: textSet.size,
+    };
+  }
+  return {
+    kind: 'text',
+    count: rows.length - emptyCount,
+    emptyCount,
+    distinct: textSet.size,
+  };
+}
+
+/** Extract a numeric column; returns null with a reason if not usable. */
+function extractNumericColumn(
+  table: ParsedTable,
+  columnName: string,
+): {values: number[]; index: number} | {error: string} {
+  const idx = findColumn(table.headers, columnName);
+  if (idx < 0) {
+    return {error: `column "${columnName}" not found in headers [${table.headers.join(', ')}]`};
+  }
+  const values: number[] = [];
+  for (const row of table.rows) {
+    const n = asNumber(row[idx] ?? '');
+    if (n === null) {
+      return {
+        error: `column "${columnName}" is not fully numeric (first non-numeric cell: "${row[idx]}")`,
+      };
+    }
+    values.push(n);
+  }
+  return {values, index: idx};
+}
+
+const OPERATIONS = [
+  'parse',
+  'describe',
+  'column',
+  'filter',
+  'aggregate',
+  'sum',
+  'mean',
+  'min',
+  'max',
+  'count',
+] as const;
+type Operation = (typeof OPERATIONS)[number];
+
+const FILTER_OPS = ['=', '!=', '>', '<', '>=', '<='] as const;
+type FilterOp = (typeof FILTER_OPS)[number];
+
+const AGG_FUNCS = ['sum', 'mean', 'count'] as const;
+type AggFunc = (typeof AGG_FUNCS)[number];
+
+export class CsvEngine implements TalentEngine {
+  readonly name = 'csv';
+
+  /** Tables can be wide; give the model room for the parse summary. */
+  readonly recommendedContextTokens = 4096;
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const operation =
+      typeof args.operation === 'string' ? args.operation.toLowerCase() : '';
+
+    if (!(OPERATIONS as readonly string[]).includes(operation)) {
+      return err(
+        `csv: unknown operation "${operation || '(missing)'}"`,
+        `operation must be one of: ${OPERATIONS.join(', ')}`,
+      );
+    }
+
+    const csv = typeof args.csv === 'string' ? args.csv : '';
+    if (!csv) {
+      return err(
+        'csv: "csv" text is required',
+        'paste the CSV/TSV text (export .xlsx to CSV first — binary .xlsx is not supported)',
+      );
+    }
+
+    let table: ParsedTable;
+    try {
+      table = buildTable(csv);
+    } catch (e) {
+      const msg = e instanceof Error ? e.message : String(e);
+      return err(`csv: failed to parse input: ${msg}`, 'check the CSV text for malformed quoting');
+    }
+
+    if (table.headers.length === 0 || table.rows.length === 0) {
+      return err(
+        'csv: input has no data rows',
+        'the first row must be a header and there must be at least one data row',
+      );
+    }
+
+    switch (operation as Operation) {
+      case 'parse':
+      case 'describe':
+        return this.describe(table);
+      case 'column':
+        return this.column(table, args);
+      case 'filter':
+        return this.filter(table, args);
+      case 'aggregate':
+        return this.aggregate(table, args);
+      case 'sum':
+      case 'mean':
+      case 'min':
+      case 'max':
+      case 'count':
+        return this.reduce(table, operation as Operation, args);
+      default:
+        return err(
+          `csv: unhandled operation "${operation}"`,
+          'internal error — this should be unreachable',
+        );
+    }
+  }
+
+  private describe(table: ParsedTable): TalentResult {
+    const colDescriptions = table.headers.map((h, i) => {
+      const d = describeColumn(table.rows, i);
+      if (d.kind === 'numeric') {
+        return (
+          `  - "${h}" [numeric]: count=${d.count}, empty=${d.emptyCount}, ` +
+          `sum=${round(d.sum!, 4)}, mean=${round(d.mean!, 4)}, ` +
+          `min=${round(d.min!, 4)}, max=${round(d.max!, 4)}, distinct=${d.distinct}`
+        );
+      }
+      return `  - "${h}" [text]: count=${d.count}, empty=${d.emptyCount}, distinct=${d.distinct}`;
+    });
+
+    const paddedNote =
+      table.paddedRowCount > 0
+        ? `\nNote: ${table.paddedRowCount} row(s) were shorter than the header and were padded with empty cells.`
+        : '';
+
+    const summary =
+      `Table: ${table.rows.length} rows x ${table.headers.length} columns\n` +
+      `Headers: [${table.headers.join(', ')}]` +
+      paddedNote +
+      `\nColumns:\n${colDescriptions.join('\n')}`;
+
+    return textResult(summary);
+  }
+
+  private column(table: ParsedTable, args: Record<string, any>): TalentResult {
+    const name = typeof args.column === 'string' ? args.column : '';
+    if (!name) {
+      return err(
+        'csv.column: "column" name is required',
+        'pass the exact header text of the column to extract',
+      );
+    }
+    const result = extractNumericColumn(table, name);
+    if ('error' in result) {
+      return err(`csv.column: ${result.error}`, 'column must exist and be fully numeric');
+    }
+    const {values} = result;
+    const preview = values.slice(0, 20).map(v => String(v)).join(', ');
+    const more = values.length > 20 ? `, ... (${values.length - 20} more)` : '';
+    return textResult(
+      `Column "${name}" as numeric array (${values.length} values):\n[${preview}${more}]`,
+    );
+  }
+
+  private filter(table: ParsedTable, args: Record<string, any>): TalentResult {
+    const colName = typeof args.column === 'string' ? args.column : '';
+    const op = typeof args.op === 'string' ? args.op : '';
+    const value = args.value;
+
+    if (!colName) {
+      return err('csv.filter: "column" name is required', 'the column to test');
+    }
+    if (!(FILTER_OPS as readonly string[]).includes(op)) {
+      return err(
+        `csv.filter: bad op "${op}"`,
+        `op must be one of: ${FILTER_OPS.join(', ')}`,
+      );
+    }
+    if (value === undefined || value === null) {
+      return err('csv.filter: "value" is required', 'the value to compare against');
+    }
+
+    const idx = findColumn(table.headers, colName);
+    if (idx < 0) {
+      return err(
+        `csv.filter: column "${colName}" not found`,
+        `available: [${table.headers.join(', ')}]`,
+      );
+    }
+
+    // Decide numeric vs string comparison based on whether BOTH sides parse.
+    const numValue = typeof value === 'number' ? value : parseFloat(String(value));
+    const useNumeric = Number.isFinite(numValue);
+
+    const match = (cell: string): boolean => {
+      if (useNumeric) {
+        const n = asNumber(cell);
+        if (n === null) {
+          return false;
+        }
+        return compareNum(n, numValue, op as FilterOp);
+      }
+      const s = cell;
+      const v = String(value);
+      switch (op as FilterOp) {
+        case '=':
+          return s === v;
+        case '!=':
+          return s !== v;
+        default:
+          // Ordering on strings: fall back to locale-free lexicographic.
+          return compareNum(s < v ? -1 : s > v ? 1 : 0, 0, op as FilterOp);
+      }
+    };
+
+    const matching: string[][] = [];
+    for (const row of table.rows) {
+      if (match(row[idx] ?? '')) {
+        matching.push(row);
+      }
+    }
+
+    const cap = 50;
+    const shown = matching.slice(0, cap);
+    const dropped = matching.length - shown.length;
+    const rendered = renderTable(table.headers, shown);
+    const {text, truncated} = truncate(rendered);
+
+    const header =
+      `Filter: ${colName} ${op} ${String(value)}\n` +
+      `Matched ${matching.length} of ${table.rows.length} rows` +
+      (dropped > 0 ? ` (showing first ${cap}; ${dropped} more omitted)` : '') +
+      (truncated ? ' [output truncated to fit context]' : '') +
+      `\n\n${text}`;
+
+    return textResult(header);
+  }
+
+  private aggregate(table: ParsedTable, args: Record<string, any>): TalentResult {
+    const groupCol = typeof args.group_by === 'string' ? args.group_by : '';
+    const valueCol = typeof args.column === 'string' ? args.column : '';
+    const func = typeof args.func === 'string' ? args.func.toLowerCase() : '';
+
+    if (!groupCol) {
+      return err('csv.aggregate: "group_by" column is required', 'the column to group on');
+    }
+    if (!valueCol) {
+      return err('csv.aggregate: "column" is required', 'the column to aggregate');
+    }
+    if (!(AGG_FUNCS as readonly string[]).includes(func as AggFunc)) {
+      return err(
+        `csv.aggregate: bad func "${func}"`,
+        `func must be one of: ${AGG_FUNCS.join(', ')}`,
+      );
+    }
+
+    const groupIdx = findColumn(table.headers, groupCol);
+    if (groupIdx < 0) {
+      return err(
+        `csv.aggregate: group_by column "${groupCol}" not found`,
+        `available: [${table.headers.join(', ')}]`,
+      );
+    }
+    const valueIdx = findColumn(table.headers, valueCol);
+    if (valueIdx < 0) {
+      return err(
+        `csv.aggregate: column "${valueCol}" not found`,
+        `available: [${table.headers.join(', ')}]`,
+      );
+    }
+
+    // "count" does not require the value column to be numeric; sum/mean do.
+    const groups = new Map<string, number[]>();
+    const counts = new Map<string, number>();
+    for (const row of table.rows) {
+      const key = row[groupIdx] ?? '';
+      counts.set(key, (counts.get(key) ?? 0) + 1);
+      if (func === 'count') {
+        continue;
+      }
+      const n = asNumber(row[valueIdx] ?? '');
+      if (n === null) {
+        return err(
+          `csv.aggregate: value column "${valueCol}" is not numeric (cell: "${row[valueIdx]}")`,
+          'sum/mean require a numeric column; use func=count for non-numeric data',
+        );
+      }
+      const arr = groups.get(key) ?? [];
+      arr.push(n);
+      groups.set(key, arr);
+    }
+
+    const keys = Array.from(counts.keys()).sort();
+    const lines = keys.map(k => {
+      if (func === 'count') {
+        return `  ${k}: count=${counts.get(k)}`;
+      }
+      const arr = groups.get(k) ?? [];
+      const s = arr.reduce((a, b) => a + b, 0);
+      const result = func === 'sum' ? s : s / arr.length;
+      return `  ${k}: ${func}=${round(result, 4)} (n=${arr.length})`;
+    });
+
+    return textResult(
+      `Aggregate: ${func}(${valueCol}) grouped by ${groupCol}\n` +
+        `${lines.join('\n')}`,
+    );
+  }
+
+  private reduce(
+    table: ParsedTable,
+    op: Operation,
+    args: Record<string, any>,
+  ): TalentResult {
+    const name = typeof args.column === 'string' ? args.column : '';
+    if (!name) {
+      return err(
+        `csv.${op}: "column" name is required`,
+        'pass the exact header text of the column',
+      );
+    }
+    if (op === 'count') {
+      // count works on any column, numeric or not — it is just non-empty cells.
+      const idx = findColumn(table.headers, name);
+      if (idx < 0) {
+        return err(
+          `csv.count: column "${name}" not found`,
+          `available: [${table.headers.join(', ')}]`,
+        );
+      }
+      let nonEmpty = 0;
+      for (const row of table.rows) {
+        if ((row[idx] ?? '') !== '') {
+          nonEmpty++;
+        }
+      }
+      return textResult(
+        `count("${name}") = ${nonEmpty} of ${table.rows.length} rows`,
+      );
+    }
+
+    const result = extractNumericColumn(table, name);
+    if ('error' in result) {
+      return err(`csv.${op}: ${result.error}`, 'column must exist and be fully numeric');
+    }
+    const {values} = result;
+    if (values.length === 0) {
+      return err(`csv.${op}: column "${name}" has no values`, 'all cells were empty');
+    }
+
+    let out: number;
+    switch (op) {
+      case 'sum':
+        out = values.reduce((a, b) => a + b, 0);
+        break;
+      case 'mean':
+        out = values.reduce((a, b) => a + b, 0) / values.length;
+        break;
+      case 'min':
+        out = Math.min(...values);
+        break;
+      case 'max':
+        out = Math.max(...values);
+        break;
+      default:
+        return err(`csv.${op}: unhandled`, 'internal error');
+    }
+
+    return textResult(
+      `${op}("${name}") = ${round(out, 6)} (n=${values.length})`,
+    );
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: 'csv',
+        description:
+          'Deterministic CSV/TSV table analytics. Use this for ALL analysis of user-provided tabular or spreadsheet data — parse the data here and report figures that come out of this tool, never eyeball or retype numbers. Binary .xlsx is NOT supported; the user must export to CSV first. Accepts the raw CSV/TSV text and runs one of: parse/describe (dimensions, headers, per-column type inference and stats), column (extract a numeric column as an array), filter (rows matching a condition), aggregate (group-by with sum/mean/count), or a direct reduction (sum/mean/min/max/count) on a column. Every result echoes the inputs used.',
+        parameters: {
+          type: 'object',
+          properties: {
+            operation: {
+              type: 'string',
+              enum: [...OPERATIONS],
+              description: 'Which computation to run.',
+            },
+            csv: {
+              type: 'string',
+              description:
+                'The raw CSV or TSV text. First row is the header. Use commas as separators; quoted fields, embedded commas, and "" escapes are handled. For .xlsx data, the user must export to CSV first — binary .xlsx is not parsed here.',
+            },
+            column: {
+              type: 'string',
+              description:
+                'Column name (exact header text) for column / filter / aggregate / sum / mean / min / max / count.',
+            },
+            op: {
+              type: 'string',
+              enum: [...FILTER_OPS],
+              description:
+                'For filter. Comparison operator against the column.',
+            },
+            value: {
+              description:
+                'For filter. The value to compare against. Numeric values trigger numeric comparison; strings trigger string comparison.',
+            },
+            group_by: {
+              type: 'string',
+              description:
+                'For aggregate. Column name to group by.',
+            },
+            func: {
+              type: 'string',
+              enum: [...AGG_FUNCS],
+              description:
+                'For aggregate. The reduction to apply per group: sum, mean, or count.',
+            },
+          },
+          required: ['operation', 'csv'],
+        },
+      },
+    };
+  }
+
+  systemPromptFragment(): string {
+    return [
+      'CSV / TABULAR DATA TOOL POLICY:',
+      '- For ANY analysis of user-provided tabular, spreadsheet, or Excel data, you MUST call the csv tool with the pasted CSV text. Do not eyeball numbers, retype figures, or compute aggregates in your head.',
+      '- All derived figures (sums, means, counts, filtered totals, group-by results) MUST come from this tool. Never invent a figure that the tool could compute.',
+      '- Binary .xlsx files are NOT parsed by this tool. Tell the user to export the workbook to CSV first, then paste the CSV text.',
+      '- The tool echoes the inputs it used (dimensions, column names, values). When you report a result, keep the inputs visible so the figure is auditable.',
+      '- If a column is missing or not numeric when you expected it to be, say so and ask the user to confirm the header text — do not silently guess a similar-looking column.',
+      '- For large tables, start with operation=describe to see dimensions and column types before drilling in with filter/aggregate.',
+    ].join('\n');
+  }
+}
+
+function compareNum(a: number, b: number, op: FilterOp): boolean {
+  switch (op) {
+    case '=':
+      return a === b;
+    case '!=':
+      return a !== b;
+    case '>':
+      return a > b;
+    case '<':
+      return a < b;
+    case '>=':
+      return a >= b;
+    case '<=':
+      return a <= b;
+  }
+}
+
+/** Render a small table as aligned text. Used by filter output. */
+function renderTable(headers: string[], rows: string[][]): string {
+  if (rows.length === 0) {
+    return `(no rows)\nHeaders: [${headers.join(', ')}]`;
+  }
+  const widths = headers.map((h, i) =>
+    Math.max(h.length, ...rows.map(r => (r[i] ?? '').length)),
+  );
+  const fmt = (cells: string[]) =>
+    cells.map((c, i) => (c ?? '').padEnd(widths[i])).join(' | ');
+  const sep = widths.map(w => '-'.repeat(w)).join('-+-');
+  return [fmt(headers), sep, ...rows.map(fmt)].join('\n');
+}
diff --git a/src/services/talents/DeepSearchEngine.ts b/src/services/talents/DeepSearchEngine.ts
new file mode 100644
index 0000000..a061b31
--- /dev/null
+++ b/src/services/talents/DeepSearchEngine.ts
@@ -0,0 +1,195 @@
+/**
+ * `deep_search` talent — the "supreme search" that fans out across ALL
+ * configured providers, deduplicates, and re-ranks. Unlike `web_search`
+ * which queries only the single active provider, deep_search queries every
+ * provider the user has configured keys for.
+ */
+
+import {
+  TalentEngine,
+  TalentResult,
+  ToolDefinition,
+  SystemPromptContext,
+} from './types';
+import type {SearchProvider, SearchHit} from '../search/types';
+import {aggregateSearch, AggregateResult} from '../search/aggregate';
+import {budgetHits} from '../search/searchBudget';
+import {wrapUntrusted} from './untrustedContent';
+import {allowReadUrls} from './readUrlAllowlist';
+
+const PER_SNIPPET_CHARS = 280;
+
+/**
+ * Injected at registration so the engine never imports the MobX store.
+ * Mirrors SearchAccess but exposes all available providers, not just one.
+ */
+export interface DeepSearchAccess {
+  /** All providers the user has configured keys for. */
+  getAvailableProviders(): SearchProvider[];
+  /** True only when at least one provider is available AND user has consented. */
+  canSearch(): boolean;
+  /** Result count from settings. */
+  getResultCount(): number;
+}
+
+const formatHit = (hit: SearchHit): string => {
+  const date = hit.publishedAt ? ` *(${hit.publishedAt})*` : '';
+  const lines = [`- **${hit.title || hit.url}**${date}`];
+  if (hit.snippet) {
+    lines.push(`  ${hit.snippet}`);
+  }
+  lines.push(`  <${hit.url}>`);
+  return lines.join('\n');
+};
+
+const formatMenu = (query: string, hits: SearchHit[]): string => {
+  const retrievedAt = new Date().toISOString().slice(0, 10);
+  return [
+    `## Deep search results for "${query}" (retrieved ${retrievedAt})`,
+    ...hits.map(formatHit),
+  ].join('\n');
+};
+
+const buildDiagnosticsLine = (result: AggregateResult): string => {
+  const contributing = result.contributingProviders.join('+') || 'none';
+  return `> Merged from ${contributing}, ${result.duplicatesCollapsed} duplicate${result.duplicatesCollapsed === 1 ? '' : 's'} collapsed`;
+};
+
+/**
+ * `deep_search` talent. Searches multiple engines at once, deduplicates by
+ * canonical URL, and re-ranks with consensus + recency scoring.
+ */
+export class DeepSearchEngine implements TalentEngine {
+  readonly name = 'deep_search';
+  readonly recommendedContextTokens = 1500;
+
+  constructor(private access: DeepSearchAccess) {}
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const query = typeof args.query === 'string' ? args.query.trim() : '';
+    if (!query) {
+      return {
+        type: 'error',
+        summary: 'deep_search: missing or empty "query" argument',
+        errorMessage:
+          'query argument is required and must be a non-empty string',
+      };
+    }
+
+    const providers = this.access.getAvailableProviders();
+    if (providers.length === 0 || !this.access.canSearch()) {
+      return {
+        type: 'error',
+        summary: 'deep_search: no search providers enabled',
+        errorMessage:
+          'Internet search is not enabled. Accept the disclosure and set API keys for one or more providers in Settings → Internet Search.',
+      };
+    }
+
+    const maxResults = this.access.getResultCount();
+
+    let result: AggregateResult;
+    try {
+      result = await aggregateSearch(providers, query, {maxResults});
+    } catch (e) {
+      const errMsg = e instanceof Error ? e.message : String(e);
+      return {
+        type: 'error',
+        summary: `deep_search: ${errMsg}`,
+        errorMessage: errMsg,
+      };
+    }
+
+    // All providers failed — surface the errors, never silent-empty.
+    const allFailed = result.diagnostics.every(d => d.status === 'rejected');
+    if (allFailed) {
+      const errors = result.diagnostics
+        .map(d => `${d.providerId}: ${d.error ?? 'unknown error'}`)
+        .join('; ');
+      const summary = `deep_search: all providers failed — ${errors}`;
+      return {type: 'error', summary, errorMessage: summary};
+    }
+
+    const budgeted = budgetHits(
+      result.hits,
+      {
+        maxResults,
+        perSnippetChars: PER_SNIPPET_CHARS,
+        tokenCeiling: this.recommendedContextTokens,
+      },
+      formatHit,
+    );
+
+    if (budgeted.length === 0) {
+      const summary = `deep_search: no results for "${query}". Try a shorter or less restrictive query.`;
+      return {type: 'error', summary, errorMessage: summary};
+    }
+
+    allowReadUrls(budgeted.map(h => h.url));
+
+    if (__DEV__) {
+      console.log('[deep_search]', {
+        query,
+        providers: providers.map(p => p.id),
+        count: budgeted.length,
+        duplicatesCollapsed: result.duplicatesCollapsed,
+        results: budgeted.map(h => ({title: h.title, url: h.url})),
+      });
+    }
+
+    const menuContent = [
+      formatMenu(query, budgeted),
+      '',
+      buildDiagnosticsLine(result),
+    ].join('\n');
+
+    return {
+      type: 'search',
+      query,
+      results: budgeted.map(h => ({
+        title: h.title,
+        url: h.url,
+        snippet: h.snippet,
+      })),
+      summary: wrapUntrusted(menuContent),
+    };
+  }
+
+  systemPromptFragment(ctx: SystemPromptContext): string | null {
+    const today = ctx.now.toISOString().slice(0, 10);
+    const budget = ctx.maxToolTurns - 1;
+    const readUrl = ctx.activeTalents.has('read_url')
+      ? ' and open promising hits with read_url'
+      : '';
+    return (
+      `Today's date is ${today}. You can search the web with deep_search${readUrl}. ` +
+      `deep_search queries multiple search engines at once, deduplicates results, and re-ranks by consensus — ` +
+      `prefer it over web_search when you need breadth, cross-checking, or higher confidence. ` +
+      `For time-sensitive or factual questions, search first; usually one or two searches suffice — ` +
+      `you have a budget of ${budget} tool calls. Answer using the facts in the results and cite ` +
+      'source URLs. If the results do not contain the answer, say so rather than guessing.'
+    );
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: 'deep_search',
+        description:
+          'Search multiple web search engines at once, deduplicate results by URL, and re-rank by consensus and recency. Use this instead of web_search when you need broader coverage, cross-checking across sources, or higher confidence in results. Write short keyword queries (2-6 words), like a search engine user, not full sentences. Returns result titles, source URLs, and text snippets.',
+        parameters: {
+          type: 'object',
+          properties: {
+            query: {
+              type: 'string',
+              description:
+                "Short keyword search query, e.g. 'nobel prize physics 2026 winner'.",
+            },
+          },
+          required: ['query'],
+        },
+      },
+    };
+  }
+}
diff --git a/src/services/talents/DeveloperCashFlowEngine.ts b/src/services/talents/DeveloperCashFlowEngine.ts
new file mode 100644
index 0000000..b8bf073
--- /dev/null
+++ b/src/services/talents/DeveloperCashFlowEngine.ts
@@ -0,0 +1,767 @@
+import {computeNpv, computeIrr} from './FinanceEngine';
+import {TalentEngine, TalentResult, ToolDefinition} from './types';
+
+/**
+ * Deterministic real-estate development cash-flow model.
+ *
+ * The point: make developer cash-flow, peak deficit (funding gap), construction
+ * facility sizing, and project/equity IRR come out of arithmetic — not out of
+ * the model. RAY's first policy is "never invent a figure"; this engine makes
+ * that structurally true for development appraisals.
+ *
+ * SIGN CONVENTION: outflows negative, inflows positive. Cumulative balance
+ * starts at 0 (or +equity_contribution at t0). Interest is charged on the
+ * OPENING negative cumulative balance each period (before that period's
+ * operating flows), so interest_t = rate * max(0, -cumulative_{t-1}).
+ *
+ * All rates are PER-PERIOD. Frequency is NOT inferable — callers must convert
+ * annual rates themselves. The summary echoes what was used.
+ *
+ * Deliberately dependency-free beyond the FinanceEngine IRR/NPV imports.
+ * No eval, no new packages.
+ */
+
+function round(value: number, decimals = 2): number {
+  if (!Number.isFinite(value)) return NaN;
+  const f = Math.pow(10, decimals);
+  return Math.round((value + Number.EPSILON) * f) / f;
+}
+
+function pct(value: number, decimals = 2): string {
+  return Number.isFinite(value) ? `${round(value * 100, decimals)}%` : 'n/a';
+}
+
+function money(value: number, decimals = 2): string {
+  if (!Number.isFinite(value)) return 'n/a';
+  return value.toLocaleString('en-US', {
+    minimumFractionDigits: decimals,
+    maximumFractionDigits: decimals,
+  });
+}
+
+function num(value: unknown): number | null {
+  const n = typeof value === 'number' ? value : parseFloat(String(value));
+  return Number.isFinite(n) ? n : null;
+}
+
+function numArray(value: unknown): number[] | null {
+  if (!Array.isArray(value) || value.length === 0) return null;
+  const out: number[] = [];
+  for (const item of value) {
+    const n = num(item);
+    if (n === null) return null;
+    out.push(n);
+  }
+  return out;
+}
+
+function err(summary: string, errorMessage: string): TalentResult {
+  return {type: 'error', summary, errorMessage};
+}
+
+/* ------------------------------------------------------------------ */
+/*  Core model                                                         */
+/* ------------------------------------------------------------------ */
+
+interface ModelInputs {
+  periods: number;
+  constructionCost: number;
+  constructionSchedule: number[];
+  landCost: number;
+  /** Per-period sales receipts (length = periods). */
+  salesSchedule: number[];
+  collectionLag: number;
+  equityContribution: number;
+  interestRate: number;
+}
+
+interface ModelRow {
+  period: number;
+  construction: number;
+  collections: number;
+  interest: number;
+  net: number;
+  cumulative: number;
+}
+
+interface ModelResult {
+  rows: ModelRow[];
+  receivableAtHorizon: number;
+  totalConstruction: number;
+  totalSales: number;
+  totalCollections: number;
+  totalInterest: number;
+  finalCumulative: number;
+  inputs: ModelInputs;
+  renormalised: boolean;
+}
+
+function buildModel(args: Record<string, any>): ModelResult | TalentResult {
+  const periods = num(args.periods);
+  if (periods === null || !Number.isInteger(periods) || periods <= 0) {
+    return err(
+      'developer_cashflow.model: "periods" must be a positive integer',
+      `received ${args.periods}`,
+    );
+  }
+  if (periods > 120) {
+    return err(
+      'developer_cashflow.model: "periods" capped at 120',
+      `received ${periods}; reduce or break into phases`,
+    );
+  }
+
+  const constructionCost = num(args.construction_cost);
+  if (constructionCost === null || constructionCost < 0) {
+    return err(
+      'developer_cashflow.model: "construction_cost" must be >= 0',
+      'total hard + soft cost as a non-negative number',
+    );
+  }
+
+  const constructionSchedule = numArray(args.construction_schedule);
+  if (!constructionSchedule || constructionSchedule.length !== periods) {
+    return err(
+      `developer_cashflow.model: "construction_schedule" must be an array of length ${periods} (matching periods)`,
+      `received length ${constructionSchedule ? constructionSchedule.length : 0}`,
+    );
+  }
+  if (constructionSchedule.some(v => v < 0)) {
+    return err(
+      'developer_cashflow.model: "construction_schedule" fractions must be >= 0',
+      'negative fractions are not meaningful',
+    );
+  }
+  const csSum = constructionSchedule.reduce((a, b) => a + b, 0);
+  let renormalised = false;
+  let csWorking = constructionSchedule.slice();
+  if (csSum < 0.99 || csSum > 1.01) {
+    return err(
+      `developer_cashflow.model: "construction_schedule" must sum to ~1.0 (within 0.99..1.01); got ${round(csSum, 4)}`,
+      'provide fractions that sum to ~1.0, e.g. [0.25, 0.25, 0.25, 0.25]',
+    );
+  }
+  if (Math.abs(csSum - 1.0) > 1e-9) {
+    renormalised = true;
+    csWorking = csWorking.map(v => v / csSum);
+  }
+
+  const landCost = num(args.land_cost) ?? 0;
+  if (landCost < 0) {
+    return err(
+      'developer_cashflow.model: "land_cost" must be >= 0',
+      `received ${landCost}`,
+    );
+  }
+
+  const equityContribution = num(args.equity_contribution) ?? 0;
+  if (equityContribution < 0) {
+    return err(
+      'developer_cashflow.model: "equity_contribution" must be >= 0',
+      `received ${equityContribution}`,
+    );
+  }
+
+  const interestRate = num(args.interest_rate) ?? 0;
+  if (interestRate < 0) {
+    return err(
+      'developer_cashflow.model: "interest_rate" must be >= 0',
+      'this is the PER-PERIOD rate; pass 0.01 for 1% per period, not 0.12 for 12% p.a.',
+    );
+  }
+
+  const collectionLagRaw = num(args.collection_lag) ?? 0;
+  if (
+    !Number.isInteger(collectionLagRaw) ||
+    collectionLagRaw < 0
+  ) {
+    return err(
+      'developer_cashflow.model: "collection_lag" must be an integer >= 0',
+      `received ${args.collection_lag}`,
+    );
+  }
+  const collectionLag = collectionLagRaw;
+
+  // --- Sales: accept sales_schedule OR total_sales + absorption_schedule ---
+  const salesSchedule = numArray(args.sales_schedule);
+  const totalSales = num(args.total_sales);
+  const absorptionSchedule = numArray(args.absorption_schedule);
+
+  let sales: number[];
+  if (salesSchedule && totalSales !== null) {
+    return err(
+      'developer_cashflow.model: provide EITHER "sales_schedule" OR "total_sales"+"absorption_schedule", not both',
+      'sales_schedule gives per-period receipts directly; total_sales+absorption_schedule derives them',
+    );
+  }
+  if (salesSchedule) {
+    if (salesSchedule.length !== periods) {
+      return err(
+        `developer_cashflow.model: "sales_schedule" must be length ${periods} (matching periods)`,
+        `received length ${salesSchedule.length}`,
+      );
+    }
+    if (salesSchedule.some(v => v < 0)) {
+      return err(
+        'developer_cashflow.model: "sales_schedule" values must be >= 0',
+        'receipts cannot be negative',
+      );
+    }
+    sales = salesSchedule;
+  } else if (totalSales !== null && absorptionSchedule) {
+    if (totalSales < 0) {
+      return err(
+        'developer_cashflow.model: "total_sales" must be >= 0',
+        `received ${totalSales}`,
+      );
+    }
+    if (absorptionSchedule.length !== periods) {
+      return err(
+        `developer_cashflow.model: "absorption_schedule" must be length ${periods} (matching periods)`,
+        `received length ${absorptionSchedule.length}`,
+      );
+    }
+    if (absorptionSchedule.some(v => v < 0)) {
+      return err(
+        'developer_cashflow.model: "absorption_schedule" fractions must be >= 0',
+        'negative fractions are not meaningful',
+      );
+    }
+    const asSum = absorptionSchedule.reduce((a, b) => a + b, 0);
+    if (asSum < 0.99 || asSum > 1.01) {
+      return err(
+        `developer_cashflow.model: "absorption_schedule" must sum to ~1.0 (within 0.99..1.01); got ${round(asSum, 4)}`,
+        'provide fractions that sum to ~1.0',
+      );
+    }
+    const asNorm = Math.abs(asSum - 1.0) > 1e-9
+      ? absorptionSchedule.map(v => v / asSum)
+      : absorptionSchedule;
+    sales = asNorm.map(f => f * totalSales);
+  } else {
+    return err(
+      'developer_cashflow.model: provide EITHER "sales_schedule" OR "total_sales"+"absorption_schedule"',
+      'sales_schedule gives per-period receipts directly; total_sales+absorption_schedule derives them',
+    );
+  }
+
+  // --- Build period-by-period cash flow ---
+  const rows: ModelRow[] = [];
+  let cumulative = equityContribution; // t0: equity injected
+  let receivableAtHorizon = 0;
+  let totalInterest = 0;
+
+  for (let t = 0; t < periods; t++) {
+    const construction = -(constructionCost * csWorking[t]);
+
+    // Collections: sale at period t is received at t + collectionLag
+    let collections = 0;
+    const collectPeriod = t - collectionLag; // which period's sale arrives now
+    if (collectPeriod >= 0 && collectPeriod < periods) {
+      collections = sales[collectPeriod];
+    }
+
+    // Receivable at horizon: sales in the last `collectionLag` periods that
+    // won't be collected within the horizon.
+    if (collectionLag > 0 && t >= periods - collectionLag) {
+      receivableAtHorizon += sales[t];
+    }
+
+    // Interest on opening negative balance
+    const openingBalance = cumulative;
+    const interest =
+      interestRate > 0 && openingBalance < 0
+        ? interestRate * Math.abs(openingBalance)
+        : 0;
+
+    const net = construction + collections - interest;
+    cumulative = cumulative + net;
+
+    totalInterest += interest;
+
+    rows.push({
+      period: t + 1,
+      construction,
+      collections,
+      interest: -interest, // display as negative (cost)
+      net,
+      cumulative,
+    });
+  }
+
+  const totalConstruction = constructionCost;
+  const totalSalesSum = sales.reduce((a, b) => a + b, 0);
+  const totalCollections = rows.reduce((a, r) => a + r.collections, 0);
+
+  const inputs: ModelInputs = {
+    periods,
+    constructionCost,
+    constructionSchedule: csWorking,
+    landCost,
+    salesSchedule: sales,
+    collectionLag,
+    equityContribution,
+    interestRate,
+  };
+
+  return {
+    rows,
+    receivableAtHorizon,
+    totalConstruction,
+    totalSales: totalSalesSum,
+    totalCollections,
+    totalInterest,
+    finalCumulative: cumulative,
+    inputs,
+    renormalised,
+  };
+}
+
+function formatModelTable(rows: ModelRow[], cap = 24): string {
+  const header = 'per | construction | collections |  interest  |    net     | cumulative';
+  const shown = rows.slice(0, cap);
+  const lines = shown.map(
+    r =>
+      `${String(r.period).padStart(3)} | ${money(r.construction).padStart(12)} | ${money(r.collections).padStart(11)} | ${money(r.interest).padStart(10)} | ${money(r.net).padStart(10)} | ${money(r.cumulative).padStart(10)}`,
+  );
+  let table = [header, ...lines].join('\n');
+  if (rows.length > cap) {
+    table += `\n... ${rows.length - cap} further periods omitted`;
+  }
+  return table;
+}
+
+/* ------------------------------------------------------------------ */
+/*  Deficit analysis                                                    */
+/* ------------------------------------------------------------------ */
+
+interface DeficitResult {
+  peakDeficit: number;
+  peakPeriod: number | null; // 1-indexed
+  deficitPeriodStart: number | null; // 1-indexed, first negative
+  recoveryPeriod: number | null; // 1-indexed, first >=0 after trough, or null
+  recoversWithinHorizon: boolean;
+  cumulative: number[];
+}
+
+function computeDeficit(cumulative: number[]): DeficitResult {
+  let minVal = Infinity;
+  let minIdx = -1;
+  for (let i = 0; i < cumulative.length; i++) {
+    if (cumulative[i] < minVal) {
+      minVal = cumulative[i];
+      minIdx = i;
+    }
+  }
+
+  const peakDeficit = minVal < 0 ? Math.abs(minVal) : 0;
+  const peakPeriod = minVal < 0 ? minIdx + 1 : null;
+
+  let deficitPeriodStart: number | null = null;
+  for (let i = 0; i < cumulative.length; i++) {
+    if (cumulative[i] < 0) {
+      deficitPeriodStart = i + 1;
+      break;
+    }
+  }
+
+  let recoveryPeriod: number | null = null;
+  if (peakPeriod !== null) {
+    for (let i = minIdx + 1; i < cumulative.length; i++) {
+      if (cumulative[i] >= 0) {
+        recoveryPeriod = i + 1;
+        break;
+      }
+    }
+  }
+
+  const recoversWithinHorizon =
+    peakDeficit === 0 || recoveryPeriod !== null;
+
+  return {
+    peakDeficit,
+    peakPeriod,
+    deficitPeriodStart,
+    recoveryPeriod,
+    recoversWithinHorizon,
+    cumulative,
+  };
+}
+
+/* ------------------------------------------------------------------ */
+
+export class DeveloperCashFlowEngine implements TalentEngine {
+  readonly name = 'developer_cashflow';
+  readonly recommendedContextTokens = 4096;
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const operation =
+      typeof args.operation === 'string' ? args.operation.toLowerCase() : '';
+
+    switch (operation) {
+      case 'model':
+        return this.model(args);
+      case 'deficit':
+        return this.deficit(args);
+      case 'debt_size':
+        return this.debtSize(args);
+      case 'equity_irr':
+        return this.equityIrr(args);
+      default:
+        return err(
+          `developer_cashflow: unknown operation "${operation || '(missing)'}"`,
+          'operation must be one of: model, deficit, debt_size, equity_irr',
+        );
+    }
+  }
+
+  /* ---- model ---- */
+  private model(args: Record<string, any>): TalentResult {
+    const result = buildModel(args);
+    if ('type' in result && result.type === 'error') return result;
+    const m = result as ModelResult;
+
+    const table = formatModelTable(m.rows);
+
+    let summary =
+      `DEVELOPER CASH-FLOW MODEL\n` +
+      `Sign convention: outflows negative, inflows positive. Period basis = per-period as supplied.\n` +
+      `Interest convention: interest_t = rate * max(0, -opening_cumulative_balance), charged within period.\n\n` +
+      `Inputs:\n` +
+      `  periods = ${m.inputs.periods}\n` +
+      `  construction_cost = ${money(m.inputs.constructionCost)}\n` +
+      `  construction_schedule = [${m.inputs.constructionSchedule.map(v => round(v, 4)).join(', ')}] (sum = ${round(m.inputs.constructionSchedule.reduce((a, b) => a + b, 0), 4)})\n` +
+      `  land_cost = ${money(m.inputs.landCost)} (paid at t0)\n` +
+      `  sales (per-period) = [${m.inputs.salesSchedule.map(v => round(v, 2)).join(', ')}] (total = ${money(m.totalSales)})\n` +
+      `  collection_lag = ${m.inputs.collectionLag} period(s)\n` +
+      `  equity_contribution = ${money(m.inputs.equityContribution)} (at t0)\n` +
+      `  interest_rate = ${pct(m.inputs.interestRate, 4)} per period\n` +
+      (m.renormalised ? `  NOTE: schedule was renormalised to sum to exactly 1.0\n` : '') +
+      `\n${table}\n\n` +
+      `Total construction = ${money(m.totalConstruction)}\n` +
+      `Total sales = ${money(m.totalSales)}\n` +
+      `Total collections within horizon = ${money(m.totalCollections)}\n` +
+      `Total interest charged = ${money(m.totalInterest)}\n` +
+      `Final cumulative = ${money(m.finalCumulative)}\n` +
+      (m.receivableAtHorizon > 0
+        ? `Receivable at horizon = ${money(m.receivableAtHorizon)} (sales in final ${m.inputs.collectionLag} period(s) collected after horizon)\n`
+        : '') +
+      `\nProject profit before financing = ${money(m.totalSales - m.totalConstruction - m.inputs.landCost)} (sales − construction − land)`;
+
+    return {type: 'text', summary};
+  }
+
+  /* ---- deficit ---- */
+  private deficit(args: Record<string, any>): TalentResult {
+    // Accept a cumulative array directly, or recompute from model inputs.
+    let cumulative: number[];
+
+    if (args.cumulative && Array.isArray(args.cumulative)) {
+      const c = numArray(args.cumulative);
+      if (!c) {
+        return err(
+          'developer_cashflow.deficit: "cumulative" must be a numeric array',
+          'pass the per-period cumulative cash-flow array',
+        );
+      }
+      cumulative = c;
+    } else {
+      const result = buildModel(args);
+      if ('type' in result && result.type === 'error') return result;
+      const m = result as ModelResult;
+      cumulative = m.rows.map(r => r.cumulative);
+    }
+
+    const d = computeDeficit(cumulative);
+
+    let summary =
+      `DEFICIT ANALYSIS\n` +
+      `Sign convention: outflows negative, inflows positive.\n` +
+      `Cumulative = [${cumulative.map(v => money(v)).join(', ')}]\n\n` +
+      `Peak deficit = ${money(d.peakDeficit)} (at period ${d.peakPeriod ?? 'n/a'})\n` +
+      `Deficit starts at period ${d.deficitPeriodStart ?? 'n/a'} (first negative cumulative)\n`;
+
+    if (d.peakDeficit === 0) {
+      summary += `No deficit: cumulative balance never goes negative. Project is self-funding.\n`;
+    } else if (d.recoveryPeriod !== null) {
+      summary += `Recovery period = ${d.recoveryPeriod} (first period cumulative returns to >= 0 after the trough)\n`;
+      summary += `Project recovers its own funding within the horizon.\n`;
+    } else {
+      summary += `Recovery period = does NOT recover within horizon (cumulative remains negative at final period)\n`;
+    }
+
+    return {type: 'text', summary};
+  }
+
+  /* ---- debt_size ---- */
+  private debtSize(args: Record<string, any>): TalentResult {
+    const result = buildModel(args);
+    if ('type' in result && result.type === 'error') return result;
+    const m = result as ModelResult;
+
+    const cumulative = m.rows.map(r => r.cumulative);
+    const d = computeDeficit(cumulative);
+
+    const headroomPct = num(args.headroom_pct);
+    if (headroomPct !== null && headroomPct < 0) {
+      return err(
+        'developer_cashflow.debt_size: "headroom_pct" must be >= 0',
+        'e.g. 0.10 for 10% headroom',
+      );
+    }
+
+    // Facility required = peak deficit (which already includes interest if rate > 0)
+    const facilityRequired = d.peakDeficit;
+    const facilityWithHeadroom =
+      headroomPct !== null ? facilityRequired * (1 + headroomPct) : null;
+
+    let summary =
+      `DEBT SIZING\n` +
+      `Sign convention: outflows negative, inflows positive.\n` +
+      `Interest convention: interest on opening negative balance, charged in-period.\n\n` +
+      `Inputs:\n` +
+      `  periods = ${m.inputs.periods}\n` +
+      `  construction_cost = ${money(m.inputs.constructionCost)}\n` +
+      `  land_cost = ${money(m.inputs.landCost)}\n` +
+      `  total sales = ${money(m.totalSales)}\n` +
+      `  equity_contribution = ${money(m.inputs.equityContribution)}\n` +
+      `  interest_rate = ${pct(m.inputs.interestRate, 4)} per period\n` +
+      (headroomPct !== null ? `  headroom_pct = ${pct(headroomPct)}\n` : '') +
+      `\n` +
+      `Peak deficit = ${money(d.peakDeficit)} at period ${d.peakPeriod ?? 'n/a'}\n` +
+      `Total interest over life = ${money(m.totalInterest)}\n`;
+
+    if (m.inputs.equityContribution > 0 && facilityRequired === 0) {
+      summary += `\nRequired facility = 0. Project is equity-funded (equity covers the entire funding need).\n`;
+    } else {
+      summary += `\nRequired facility = ${money(facilityRequired)} (peak funding gap including accrued interest)\n`;
+      summary += `Peak period facility must be fully drawn = ${d.peakPeriod ?? 'n/a'}\n`;
+      if (facilityWithHeadroom !== null) {
+        summary += `Suggested facility with ${pct(headroomPct!)} headroom = ${money(facilityWithHeadroom)}\n`;
+      }
+    }
+
+    if (!d.recoversWithinHorizon && d.peakDeficit > 0) {
+      summary += `\nWARNING: project does NOT recover its own funding within the horizon (cumulative remains negative at final period).\n`;
+    }
+
+    return {type: 'text', summary};
+  }
+
+  /* ---- equity_irr ---- */
+  private equityIrr(args: Record<string, any>): TalentResult {
+    const result = buildModel(args);
+    if ('type' in result && result.type === 'error') return result;
+    const m = result as ModelResult;
+
+    // Unlevered project stream: t0 = -(land + equity outlay for construction),
+    // then per-period: collections - construction draws.
+    // For IRR we need an initial outflow. Build as:
+    //   t0 = -(landCost) [equity contribution is financing, not project cost]
+    //   t1..tn = collections_t - construction_t (construction is negative, so this = collections + |construction|)
+    // Actually: unlevered = all project cash flows without financing effects.
+    // t0 = -(landCost) — the upfront capital needed
+    // t1..tn = -construction_draw + collections
+    // This gives: total = -land - construction + total_collections + land = total_sales - construction (if all collected)
+
+    // For a proper project IRR, include land at t0 as outflow:
+    const unleveredStream: number[] = [];
+    unleveredStream.push(-(m.inputs.landCost));
+    for (const row of m.rows) {
+      // construction is already negative, collections positive
+      unleveredStream.push(row.construction + row.collections);
+    }
+
+    // Levered equity stream: t0 = -equity_contribution, then per-period
+    // residual after debt service. Simplification: debt is sized to cover the
+    // deficit; debt draws = max(0, -cumulative_before_financing); debt repays
+    // when cumulative goes positive. This is complex; for the levered stream,
+    // use: equity out at t0, then per-period = collections - construction -
+    // interest - debt_principal_repayment.
+    // Simplified: equity stream = unlevered but with t0 = -equity_contribution
+    // and interest deducted.
+    const leveredStream: number[] = [];
+    leveredStream.push(-m.inputs.equityContribution - m.inputs.landCost);
+    for (const row of m.rows) {
+      // net already includes construction + collections - interest
+      leveredStream.push(row.construction + row.collections + row.interest);
+    }
+
+    // Check sign changes
+    const hasSignChange = (stream: number[]) => {
+      let hasPos = false, hasNeg = false;
+      for (const v of stream) {
+        if (v > 0) hasPos = true;
+        if (v < 0) hasNeg = true;
+      }
+      return hasPos && hasNeg;
+    };
+
+    let projectIrr: number | null = null;
+    let equityIrr: number | null = null;
+    let irrBasis = '';
+
+    if (hasSignChange(unleveredStream)) {
+      projectIrr = computeIrr(unleveredStream);
+    }
+
+    if (m.inputs.equityContribution > 0 && hasSignChange(leveredStream)) {
+      equityIrr = computeIrr(leveredStream);
+    }
+
+    if (projectIrr === null && equityIrr === null) {
+      return err(
+        'developer_cashflow.equity_irr: no sign change in cash-flow streams',
+        'IRR requires at least one outflow and one inflow; check that construction outflows and sales inflows are both present',
+      );
+    }
+
+    if (equityIrr !== null) {
+      irrBasis = 'levered (equity IRR)';
+    } else if (projectIrr !== null) {
+      irrBasis = 'unlevered (project IRR)';
+    }
+
+    let summary =
+      `EQUITY IRR ANALYSIS\n` +
+      `Sign convention: outflows negative, inflows positive.\n\n` +
+      `Inputs:\n` +
+      `  periods = ${m.inputs.periods}\n` +
+      `  construction_cost = ${money(m.inputs.constructionCost)}\n` +
+      `  land_cost = ${money(m.inputs.landCost)}\n` +
+      `  total sales = ${money(m.totalSales)}\n` +
+      `  equity_contribution = ${money(m.inputs.equityContribution)}\n` +
+      `  interest_rate = ${pct(m.inputs.interestRate, 4)} per period\n\n`;
+
+    summary += `Unlevered project stream = [${unleveredStream.map(v => money(v)).join(', ')}]\n`;
+    if (projectIrr !== null) {
+      const npvCheck = computeNpv(unleveredStream, projectIrr);
+      summary += `Project IRR (unlevered) = ${pct(projectIrr, 4)} per period\n`;
+      summary += `  NPV at IRR = ${money(npvCheck)} (should be ~0)\n`;
+    } else {
+      summary += `Project IRR (unlevered): not computable (no sign change)\n`;
+    }
+
+    summary += `\nLevered equity stream = [${leveredStream.map(v => money(v)).join(', ')}]\n`;
+    if (equityIrr !== null) {
+      const npvCheck = computeNpv(leveredStream, equityIrr);
+      summary += `Equity IRR (levered) = ${pct(equityIrr, 4)} per period\n`;
+      summary += `  NPV at IRR = ${money(npvCheck)} (should be ~0)\n`;
+    } else {
+      summary += `Equity IRR (levered): not computable`;
+      if (m.inputs.equityContribution === 0) {
+        summary += ` (equity_contribution = 0, so no levered stream)`;
+      } else {
+        summary += ` (no sign change in levered stream)`;
+      }
+      summary += `\n`;
+    }
+
+    summary += `\nBasis reported: ${irrBasis}\n`;
+    summary += `Note: IRR assumes reinvestment at the IRR. Compare against actual hurdle rate.\n`;
+    summary += `Rates are PER-PERIOD. Pass periods_per_year to annualise if needed.`;
+
+    return {type: 'text', summary};
+  }
+
+  /* ---- tool definition ---- */
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: 'developer_cashflow',
+        description:
+          'Deterministic real-estate development cash-flow model: construction phasing & draw schedule, sales absorption, period-by-period cumulative cash flow, peak deficit identification (the funding gap), debt facility sizing, and project/equity IRR. Use this for ALL development appraisal figures — never estimate a deficit, facility size, or absorption pattern. Rates are PER-PERIOD (frequency not inferable). construction_schedule and absorption_schedule are FRACTION arrays summing to ~1. Sales come via sales_schedule OR total_sales+absorption_schedule.',
+        parameters: {
+          type: 'object',
+          properties: {
+            operation: {
+              type: 'string',
+              enum: ['model', 'deficit', 'debt_size', 'equity_irr'],
+              description:
+                'model = period-by-period cash flow; deficit = peak funding gap; debt_size = construction facility sizing; equity_irr = project/equity IRR.',
+            },
+            periods: {
+              type: 'number',
+              description:
+                'Number of periods (e.g. quarters or months). Positive integer, capped at 120.',
+            },
+            construction_cost: {
+              type: 'number',
+              description:
+                'Total hard + soft construction cost (> 0). Phased by construction_schedule.',
+            },
+            construction_schedule: {
+              type: 'array',
+              items: {type: 'number'},
+              description:
+                'Array of length = periods. Fractions summing to ~1.0 describing how construction spend is phased across periods. E.g. [0.25,0.25,0.25,0.25] for even spread.',
+            },
+            land_cost: {
+              type: 'number',
+              description:
+                'Land cost paid at t0 (>= 0). Default 0.',
+            },
+            sales_schedule: {
+              type: 'array',
+              items: {type: 'number'},
+              description:
+                'Per-period sales receipts (length = periods). Provide EITHER this OR total_sales + absorption_schedule.',
+            },
+            total_sales: {
+              type: 'number',
+              description:
+                'Total sales value. Use with absorption_schedule to derive per-period receipts. Provide EITHER this+absorption_schedule OR sales_schedule.',
+            },
+            absorption_schedule: {
+              type: 'array',
+              items: {type: 'number'},
+              description:
+                'Fractions (length = periods, summing to ~1.0) describing how sales are absorbed. Used with total_sales.',
+            },
+            collection_lag: {
+              type: 'number',
+              description:
+                'Integer >= 0. Sales receipts are collected this many periods later. Default 0. Tail collections beyond horizon are reported as receivable-at-horizon.',
+            },
+            equity_contribution: {
+              type: 'number',
+              description:
+                'Equity injected at t0 (>= 0). Default 0.',
+            },
+            interest_rate: {
+              type: 'number',
+              description:
+                'PER-PERIOD interest rate as a decimal (e.g. 0.01 for 1% per period). Frequency is NOT inferable — caller must convert annual rates. Interest accrues on the opening negative cumulative balance each period. Default 0.',
+            },
+            headroom_pct: {
+              type: 'number',
+              description:
+                'For debt_size. Buffer added to required facility (e.g. 0.10 for 10%). Default none.',
+            },
+            cumulative: {
+              type: 'array',
+              items: {type: 'number'},
+              description:
+                'For deficit. Optional: pass a pre-computed cumulative cash-flow array instead of model inputs.',
+            },
+          },
+          required: ['operation'],
+        },
+      },
+    };
+  }
+
+  systemPromptFragment(): string {
+    return [
+      'DEVELOPER CASHFLOW TOOL POLICY:',
+      '- Any development cash-flow table, peak deficit, construction facility size, or project/equity IRR you report MUST come from the developer_cashflow tool. Never estimate or invent these figures.',
+      '- Define the DEFICIT precisely before recommending any structure: state the peak amount, the period it occurs, when the deficit starts, and whether the project recovers within the horizon.',
+      '- Rates are PER-PERIOD. The tool does not infer frequency. If the user gives an annual rate, ask for periods_per_year (12 monthly, 4 quarterly) before converting — never assume.',
+      '- Never invent an absorption schedule or construction phasing pattern. Require the user to supply construction_schedule and either sales_schedule or total_sales + absorption_schedule.',
+      '- The tool echoes all inputs used. When reporting results, keep the inputs visible so figures are auditable.',
+      '- Sign convention: outflows negative, inflows positive. Interest is charged on the opening negative cumulative balance each period.',
+      '- If the project does not recover within the horizon, state this explicitly — do not assume recovery beyond the modelled periods.',
+    ].join('\n');
+  }
+}
