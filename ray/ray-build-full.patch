@@ -0,0 +1,238 @@
+import {aggregateSearch, canonicalUrl} from '../aggregate';
+import type {SearchProvider, SearchHit, SearchProviderId} from '../types';
+
+const hit = (overrides: Partial<SearchHit> = {}): SearchHit => ({
+  title: 'Title',
+  url: 'https://example.com/a',
+  snippet: 'A snippet.',
+  ...overrides,
+});
+
+const makeProvider = (
+  id: SearchProviderId,
+  hits: SearchHit[],
+  shouldFail = false,
+): SearchProvider => ({
+  id,
+  search: jest.fn().mockImplementation(() =>
+    shouldFail
+      ? Promise.reject(new Error(`${id} failed`))
+      : Promise.resolve(hits),
+  ),
+});
+
+describe('canonicalUrl', () => {
+  it('lowercases the host', () => {
+    expect(canonicalUrl('https://Example.COM/path')).toBe(
+      'https://example.com/path',
+    );
+  });
+
+  it('strips trailing slash on path', () => {
+    expect(canonicalUrl('https://example.com/path/')).toBe(
+      'https://example.com/path',
+    );
+  });
+
+  it('keeps bare "/" as-is', () => {
+    expect(canonicalUrl('https://example.com/')).toBe('https://example.com/');
+  });
+
+  it('drops tracking params (utm_*, fbclid, gclid)', () => {
+    expect(
+      canonicalUrl(
+        'https://example.com/page?utm_source=twitter&fbclid=abc&keep=yes',
+      ),
+    ).toBe('https://example.com/page?keep=yes');
+  });
+
+  it('drops the fragment', () => {
+    expect(canonicalUrl('https://example.com/page#section')).toBe(
+      'https://example.com/page',
+    );
+  });
+
+  it('returns null for unparseable URLs', () => {
+    expect(canonicalUrl('not a url')).toBeNull();
+  });
+
+  it('returns null for non-http(s) protocols', () => {
+    expect(canonicalUrl('ftp://example.com/file')).toBeNull();
+  });
+});
+
+describe('aggregateSearch', () => {
+  it('merges hits from multiple providers', async () => {
+    const brave = makeProvider('brave', [
+      hit({title: 'Brave 1', url: 'https://b.com/1'}),
+    ]);
+    const tavily = makeProvider('tavily', [
+      hit({title: 'Tavily 1', url: 'https://t.com/1'}),
+    ]);
+    const result = await aggregateSearch([brave, tavily], 'test', {
+      maxResults: 10,
+    });
+    expect(result.hits).toHaveLength(2);
+    expect(result.diagnostics).toHaveLength(2);
+    expect(result.diagnostics.every(d => d.status === 'fulfilled')).toBe(true);
+  });
+
+  it('deduplicates by canonical URL (tracking params normalized)', async () => {
+    const brave = makeProvider('brave', [
+      hit({
+        title: 'Brave Title',
+        url: 'https://example.com/page?utm_source=twitter',
+        snippet: 'Short',
+      }),
+    ]);
+    const tavily = makeProvider('tavily', [
+      hit({
+        title: 'Tavily Title Longer',
+        url: 'https://example.com/page?fbclid=abc',
+        snippet: 'A longer snippet here',
+      }),
+    ]);
+    const result = await aggregateSearch([brave, tavily], 'test', {
+      maxResults: 10,
+    });
+    expect(result.hits).toHaveLength(1);
+    expect(result.duplicatesCollapsed).toBe(1);
+    // Best title (longest) and best snippet (longest) are merged.
+    expect(result.hits[0].title).toBe('Tavily Title Longer');
+    expect(result.hits[0].snippet).toBe('A longer snippet here');
+  });
+
+  it('deduplicates by trailing-slash normalization', async () => {
+    const brave = makeProvider('brave', [
+      hit({url: 'https://example.com/page/'}),
+    ]);
+    const tavily = makeProvider('tavily', [
+      hit({url: 'https://example.com/page'}),
+    ]);
+    const result = await aggregateSearch([brave, tavily], 'test', {
+      maxResults: 10,
+    });
+    expect(result.hits).toHaveLength(1);
+    expect(result.duplicatesCollapsed).toBe(1);
+  });
+
+  it('re-ranks by consensus: multi-provider hits outrank single-provider hits', async () => {
+    const brave = makeProvider('brave', [
+      hit({title: 'Only Brave', url: 'https://solo.com/1'}),
+      hit({title: 'Shared', url: 'https://shared.com/1'}),
+    ]);
+    const tavily = makeProvider('tavily', [
+      hit({title: 'Shared', url: 'https://shared.com/1'}),
+    ]);
+    const result = await aggregateSearch([brave, tavily], 'test', {
+      maxResults: 10,
+    });
+    // The shared hit (consensus=2) should rank first.
+    expect(result.hits[0].url).toBe('https://shared.com/1');
+  });
+
+  it('re-ranks by recency as a tie-break within same consensus', async () => {
+    const today = new Date().toISOString();
+    const old = new Date(Date.now() - 180 * 86_400_000).toISOString();
+    const brave = makeProvider('brave', [
+      hit({title: 'Old', url: 'https://old.com/1', publishedAt: old}),
+      hit({title: 'New', url: 'https://new.com/1', publishedAt: today}),
+    ]);
+    const result = await aggregateSearch([brave], 'test', {maxResults: 10});
+    // Both have consensus=1, so recency decides: newer first.
+    expect(result.hits[0].url).toBe('https://new.com/1');
+    expect(result.hits[1].url).toBe('https://old.com/1');
+  });
+
+  it('treats missing publishedAt as oldest (not excluded)', async () => {
+    const recent = new Date().toISOString();
+    const brave = makeProvider('brave', [
+      hit({title: 'No Date', url: 'https://nodate.com/1'}),
+      hit({title: 'Dated', url: 'https://dated.com/1', publishedAt: recent}),
+    ]);
+    const result = await aggregateSearch([brave], 'test', {maxResults: 10});
+    expect(result.hits).toHaveLength(2);
+    expect(result.hits[0].url).toBe('https://dated.com/1');
+    expect(result.hits[1].url).toBe('https://nodate.com/1');
+  });
+
+  it('surfaces errors when ALL providers fail (no silent empty)', async () => {
+    const brave = makeProvider('brave', [], true);
+    const tavily = makeProvider('tavily', [], true);
+    const result = await aggregateSearch([brave, tavily], 'test', {
+      maxResults: 10,
+    });
+    expect(result.hits).toHaveLength(0);
+    expect(result.diagnostics.every(d => d.status === 'rejected')).toBe(true);
+    expect(result.diagnostics[0].error).toContain('brave failed');
+    expect(result.diagnostics[1].error).toContain('tavily failed');
+  });
+
+  it('succeeds with partial results when only some providers fail', async () => {
+    const brave = makeProvider('brave', [], true);
+    const tavily = makeProvider('tavily', [
+      hit({title: 'Tavily Hit', url: 'https://t.com/1'}),
+    ]);
+    const result = await aggregateSearch([brave, tavily], 'test', {
+      maxResults: 10,
+    });
+    expect(result.hits).toHaveLength(1);
+    expect(result.diagnostics[0].status).toBe('rejected');
+    expect(result.diagnostics[1].status).toBe('fulfilled');
+  });
+
+  it('respects maxResults as the final count after dedup/rank', async () => {
+    const brave = makeProvider('brave', [
+      hit({url: 'https://a.com/1'}),
+      hit({url: 'https://b.com/1'}),
+      hit({url: 'https://c.com/1'}),
+    ]);
+    const tavily = makeProvider('tavily', [
+      hit({url: 'https://d.com/1'}),
+      hit({url: 'https://e.com/1'}),
+    ]);
+    const result = await aggregateSearch([brave, tavily], 'test', {
+      maxResults: 3,
+    });
+    expect(result.hits).toHaveLength(3);
+  });
+
+  it('reports contributingProviders correctly', async () => {
+    const brave = makeProvider('brave', [
+      hit({url: 'https://a.com/1'}),
+    ]);
+    const tavily = makeProvider('tavily', [
+      hit({url: 'https://b.com/1'}),
+    ]);
+    const exa = makeProvider('exa', [], true);
+    const result = await aggregateSearch([brave, tavily, exa], 'test', {
+      maxResults: 10,
+    });
+    expect(result.contributingProviders).toContain('brave');
+    expect(result.contributingProviders).toContain('tavily');
+    expect(result.contributingProviders).not.toContain('exa');
+  });
+
+  it('is deterministic: same inputs produce same output order', async () => {
+    const brave = makeProvider('brave', [
+      hit({title: 'A', url: 'https://a.com/1', publishedAt: new Date().toISOString()}),
+      hit({title: 'B', url: 'https://b.com/1'}),
+    ]);
+    const tavily = makeProvider('tavily', [
+      hit({title: 'C', url: 'https://c.com/1', publishedAt: new Date().toISOString()}),
+    ]);
+    const r1 = await aggregateSearch([brave, tavily], 'test', {maxResults: 10});
+    // Reset mocks to get fresh calls
+    (brave.search as jest.Mock).mockClear();
+    (tavily.search as jest.Mock).mockClear();
+    (brave.search as jest.Mock).mockResolvedValue([
+      hit({title: 'A', url: 'https://a.com/1', publishedAt: new Date().toISOString()}),
+      hit({title: 'B', url: 'https://b.com/1'}),
+    ]);
+    (tavily.search as jest.Mock).mockResolvedValue([
+      hit({title: 'C', url: 'https://c.com/1', publishedAt: new Date().toISOString()}),
+    ]);
+    const r2 = await aggregateSearch([brave, tavily], 'test', {maxResults: 10});
+    expect(r1.hits.map(h => h.url)).toEqual(r2.hits.map(h => h.url));
+  });
+});
