@@ -0,0 +1,115 @@
+import {buildSignalsProvider} from '../routeSignals';
+import {routeStore} from '../../store/RouteStore';
+import {rayPrefsStore} from '../../store/RayPrefsStore';
+import {resolveSystemMessages} from '../../utils/systemPromptResolver';
+import {__resetNetworkWatch} from '../networkInfo';
+import NetInfoMock from '../../../__mocks__/external/@react-native-community/netinfo';
+import type {Pal} from '../../types/pal';
+
+/**
+ * Integration coverage for the RAY additions that are not self-contained in a
+ * single engine: the user-declared connection gate (routeSignals ↔ RouteStore)
+ * and the persona language directive (RayPrefsStore ↔ systemPromptResolver).
+ *
+ * These use the real singletons, so a wiring regression shows up here.
+ */
+describe('RAY integration', () => {
+  describe('connection gate', () => {
+    beforeEach(() => {
+      __resetNetworkWatch();
+      NetInfoMock.__reset();
+    });
+    afterEach(() => routeStore.setConnection('auto'));
+
+    it('treats unknown and cellular as metered; wifi as unmetered', () => {
+      routeStore.setConnection('unknown');
+      expect(routeStore.onCellular).toBe(true);
+      routeStore.setConnection('cellular');
+      expect(routeStore.onCellular).toBe(true);
+      routeStore.setConnection('wifi');
+      expect(routeStore.onCellular).toBe(false);
+    });
+
+    it('in auto mode defers to live netinfo (metered until reported, then wifi)', () => {
+      routeStore.setConnection('auto');
+      // Before any reading: privacy-safe metered.
+      expect(routeStore.onCellular).toBe(true);
+      // After netinfo reports wifi: unmetered.
+      NetInfoMock.__setState({type: 'wifi', isConnected: true, details: {isConnectionExpensive: false}});
+      expect(routeStore.onCellular).toBe(false);
+      // Switching to cellular flips it back.
+      NetInfoMock.__setState({type: 'cellular', isConnected: true, details: {isConnectionExpensive: true}});
+      expect(routeStore.onCellular).toBe(true);
+    });
+
+    it('manual wifi override beats a metered netinfo reading', () => {
+      // e.g. user insists they are on wifi even though the OS is unsure.
+      NetInfoMock.__setState({type: 'cellular', isConnected: true, details: {isConnectionExpensive: true}});
+      routeStore.setConnection('wifi');
+      expect(routeStore.onCellular).toBe(false);
+    });
+
+    it('reads the connection live per request via the thunk', () => {
+      const provider = buildSignalsProvider({
+        onCellular: () => routeStore.onCellular,
+      });
+      const params: any = {messages: [{role: 'user', content: 'hi'}]};
+
+      routeStore.setConnection('cellular');
+      expect(provider(params).onCellular).toBe(true);
+
+      // Changing the store after the provider was built still takes effect.
+      routeStore.setConnection('wifi');
+      expect(provider(params).onCellular).toBe(false);
+    });
+
+    it('defaults to metered when no override is given', () => {
+      const provider = buildSignalsProvider();
+      const params: any = {messages: [{role: 'user', content: 'hi'}]};
+      expect(provider(params).onCellular).toBe(true);
+    });
+
+    it('rejects an invalid connection value, keeping the prior one', () => {
+      routeStore.setConnection('wifi');
+      routeStore.setConnection('carrier-pigeon' as any);
+      expect(routeStore.connection).toBe('wifi');
+    });
+  });
+
+  describe('persona language directive', () => {
+    afterEach(() => rayPrefsStore.setLanguage('auto'));
+
+    it('emits no directive on auto', () => {
+      rayPrefsStore.setLanguage('auto');
+      expect(rayPrefsStore.languageDirective).toBe('');
+    });
+
+    it('emits an English override directive', () => {
+      rayPrefsStore.setLanguage('en');
+      expect(rayPrefsStore.languageDirective).toMatch(/Reply in English/);
+    });
+
+    it('emits an Egyptian Arabic override directive', () => {
+      rayPrefsStore.setLanguage('ar');
+      expect(rayPrefsStore.languageDirective).toMatch(/colloquial Egyptian Arabic/);
+    });
+
+    it('leaves the persona byte-identical when language is auto', () => {
+      rayPrefsStore.setLanguage('auto');
+      const pal: Partial<Pal> = {systemPrompt: 'Pal prompt', parameters: {}};
+      const msgs = resolveSystemMessages({pal: pal as Pal});
+      // First system entry is the persona; with auto there is no appended
+      // directive, so it must not contain the override marker.
+      expect(msgs[0].content).not.toMatch(/LANGUAGE OVERRIDE/);
+      expect(msgs[1].content).toBe('Pal prompt');
+    });
+
+    it('appends the directive to the persona entry when a language is set', () => {
+      rayPrefsStore.setLanguage('ar');
+      const msgs = resolveSystemMessages({pal: null, model: null});
+      expect(msgs).toHaveLength(1); // persona only
+      expect(msgs[0].content).toMatch(/LANGUAGE OVERRIDE/);
+      expect(msgs[0].content).toMatch(/RAY/); // persona text still present
+    });
+  });
+});
diff --git a/src/api/hybridEngine.ts b/src/api/hybridEngine.ts
new file mode 100644
index 0000000..18c8f44
--- /dev/null
+++ b/src/api/hybridEngine.ts
@@ -0,0 +1,260 @@
+import {
+  ApiCompletionParams,
+  CompletionEngine,
+  CompletionResult,
+  CompletionStreamData,
+} from '../utils/completionTypes';
+
+/**
+ * Routing backend for HybridCompletionEngine.
+ *
+ * 'local'    — always use the local engine
+ * 'cloud'    — always use the cloud engine
+ * 'auto'     — route per request via RoutePolicy
+ * 'cloud-fallback' — local first, cloud if local fails or is unavailable
+ */
+export type RouteMode = 'local' | 'cloud' | 'auto' | 'cloud-fallback';
+
+export interface RouteDecision {
+  useCloud: boolean;
+  reason: string;
+}
+
+export interface RouteSignals {
+  /** User prompt text for this turn. */
+  userText: string;
+  /** Total messages in the assembled context, including system. */
+  messageCount: number;
+  /** True when tools are advertised to the model this turn. */
+  hasTools: boolean;
+  /** True when the request carries image attachments. */
+  hasImages: boolean;
+  /** True when the device is on a metered/cellular connection. */
+  onCellular: boolean;
+  /** True when a local engine exists and its context is loaded. */
+  localAvailable: boolean;
+}
+
+export interface RoutePolicy {
+  /** Prompt length (chars) at or above which the request is "heavy". */
+  heavyPromptChars: number;
+  /** Context message count at or above which the request is "heavy". */
+  heavyMessageCount: number;
+  /** Send tool-using turns to cloud (function calling is stronger there). */
+  preferCloudForTools: boolean;
+  /** Send multimodal turns to cloud (local vision support varies). */
+  preferCloudForImages: boolean;
+  /** Never route to cloud on cellular, regardless of other signals. */
+  wifiOnly: boolean;
+}
+
+export const DEFAULT_ROUTE_POLICY: RoutePolicy = {
+  heavyPromptChars: 4000,
+  heavyMessageCount: 40,
+  preferCloudForTools: true,
+  preferCloudForImages: true,
+  wifiOnly: true,
+};
+
+/**
+ * Classifies a request into local or cloud.
+ *
+ * Deliberately a pure function of its inputs: no store reads, no clock, no
+ * network. That keeps it unit-testable and makes routing decisions explainable
+ * — the returned `reason` is surfaced so a user can see why a turn went out
+ * over the network instead of staying on-device.
+ *
+ * Privacy ordering matters: the cellular/wifi gate is checked BEFORE any
+ * "prefer cloud" signal, so a user on metered data never leaks a prompt to a
+ * paid endpoint by accident.
+ */
+export function decideRoute(
+  signals: RouteSignals,
+  policy: RoutePolicy = DEFAULT_ROUTE_POLICY,
+): RouteDecision {
+  if (!signals.localAvailable) {
+    return {useCloud: true, reason: 'local engine unavailable'};
+  }
+
+  if (policy.wifiOnly && signals.onCellular) {
+    return {useCloud: false, reason: 'on cellular and wifi-only is enabled'};
+  }
+
+  if (policy.preferCloudForImages && signals.hasImages) {
+    return {useCloud: true, reason: 'multimodal request routed to cloud'};
+  }
+
+  if (policy.preferCloudForTools && signals.hasTools) {
+    return {useCloud: true, reason: 'tool-using request routed to cloud'};
+  }
+
+  if (signals.userText.length >= policy.heavyPromptChars) {
+    return {
+      useCloud: true,
+      reason: `prompt ${signals.userText.length} chars >= ${policy.heavyPromptChars} threshold`,
+    };
+  }
+
+  if (signals.messageCount >= policy.heavyMessageCount) {
+    return {
+      useCloud: true,
+      reason: `context ${signals.messageCount} messages >= ${policy.heavyMessageCount} threshold`,
+    };
+  }
+
+  return {useCloud: false, reason: 'light request stays on-device'};
+}
+
+/**
+ * Wraps a local and a cloud CompletionEngine and routes each request.
+ *
+ * Implements CompletionEngine so it drops into the existing
+ * `modelStore.engine` seam with no changes to AgentRunner — the runner only
+ * ever sees the two-method interface and does not know routing happened.
+ *
+ * Both engines are optional: with only one present this degrades to a
+ * pass-through, which is what makes it safe to install before a cloud server
+ * has been configured.
+ *
+ * Failure handling: in 'cloud-fallback' and 'auto' modes a failing primary is
+ * retried once against the secondary, but ONLY when nothing has been streamed
+ * yet. A partial stream cannot be unsent — retrying would duplicate visible
+ * text — so once any token has reached the UI the error propagates instead.
+ */
+export class HybridCompletionEngine implements CompletionEngine {
+  private activeEngine: CompletionEngine | null = null;
+  private streamedAny = false;
+
+  /** Last routing decision, exposed for UI/debug surfaces. */
+  lastDecision: RouteDecision = {useCloud: false, reason: 'not yet routed'};
+
+  constructor(
+    private local: CompletionEngine | null,
+    private cloud: CompletionEngine | null,
+    private mode: RouteMode = 'auto',
+    private policy: RoutePolicy = DEFAULT_ROUTE_POLICY,
+    private signalsProvider?: (
+      params: ApiCompletionParams,
+    ) => Omit<RouteSignals, 'localAvailable'>,
+  ) {}
+
+  setLocalEngine(engine: CompletionEngine | null): void {
+    this.local = engine;
+  }
+
+  setCloudEngine(engine: CompletionEngine | null): void {
+    this.cloud = engine;
+  }
+
+  setMode(mode: RouteMode): void {
+    this.mode = mode;
+  }
+
+  setPolicy(policy: RoutePolicy): void {
+    this.policy = policy;
+  }
+
+  /** True when routing can actually pick between two backends. */
+  get isHybrid(): boolean {
+    return this.local !== null && this.cloud !== null;
+  }
+
+  private resolve(params: ApiCompletionParams): {
+    primary: CompletionEngine | null;
+    secondary: CompletionEngine | null;
+  } {
+    switch (this.mode) {
+      case 'local':
+        return {primary: this.local, secondary: null};
+      case 'cloud':
+        return {primary: this.cloud, secondary: null};
+      case 'cloud-fallback':
+        return {primary: this.local, secondary: this.cloud};
+      case 'auto':
+      default: {
+        const decision = this.classify(params);
+        this.lastDecision = decision;
+        return decision.useCloud
+          ? {primary: this.cloud, secondary: this.local}
+          : {primary: this.local, secondary: this.cloud};
+      }
+    }
+  }
+
+  private classify(params: ApiCompletionParams): RouteDecision {
+    if (!this.cloud) {
+      return {useCloud: false, reason: 'no cloud engine configured'};
+    }
+    if (!this.local) {
+      return {useCloud: true, reason: 'no local engine configured'};
+    }
+    if (!this.signalsProvider) {
+      // Without signals there is nothing to classify on; staying local is the
+      // privacy-preserving default.
+      return {useCloud: false, reason: 'no signal provider; defaulting local'};
+    }
+
+    const base = this.signalsProvider(params);
+    return decideRoute({...base, localAvailable: true}, this.policy);
+  }
+
+  async completion(
+    params: ApiCompletionParams,
+    callback?: (data: CompletionStreamData) => void,
+  ): Promise<CompletionResult> {
+    const {primary, secondary} = this.resolve(params);
+
+    if (!primary) {
+      // Mirrors the existing "no engine" state rather than throwing, so the
+      // caller's error surface is unchanged.
+      return {
+        text: '',
+        content: '',
+        interrupted: true,
+      };
+    }
+
+    this.streamedAny = false;
+
+    // Wrap the callback once so BOTH engines report through the same tracker.
+    // Tracking the stream is what makes the retry guard below correct.
+    const tracked = callback
+      ? (data: CompletionStreamData) => {
+          if (data.token || data.content || data.accumulated_text) {
+            this.streamedAny = true;
+          }
+          callback(data);
+        }
+      : undefined;
+
+    this.activeEngine = primary;
+    try {
+      return await primary.completion(params, tracked);
+    } catch (err) {
+      const canRetry = secondary !== null && !this.streamedAny;
+      if (!canRetry) {
+        this.activeEngine = null;
+        throw err;
+      }
+      this.activeEngine = secondary;
+      this.lastDecision = {
+        useCloud: secondary === this.cloud,
+        reason: `primary failed, fell back to ${
+          secondary === this.cloud ? 'cloud' : 'local'
+        }`,
+      };
+      try {
+        return await secondary.completion(params, tracked);
+      } finally {
+        this.activeEngine = null;
+      }
+    }
+  }
+
+  async stopCompletion(): Promise<void> {
+    // Stop only the engine currently in flight. Stopping both would abort an
+    // idle engine's unrelated state and is not needed.
+    await this.activeEngine?.stopCompletion();
+    this.activeEngine = null;
+  }
+}
