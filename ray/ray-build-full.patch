diff --git a/src/services/talents/byteUtils.ts b/src/services/talents/byteUtils.ts
new file mode 100644
index 0000000..fe8321d
--- /dev/null
+++ b/src/services/talents/byteUtils.ts
@@ -0,0 +1,229 @@
+/**
+ * byteUtils — pure-JS byte/encoding conversion shared by the binary-inspection
+ * talents (encoding, hash_checksum, apk_inspect, dex tools).
+ *
+ * Why hand-rolled: React Native/Hermes has no guaranteed `Buffer`, and the
+ * native crypto/FS paths in this repo (RNFS.hash, RNFS.readFile base64) are
+ * FILE-PATH based. These talents operate on bytes the model passes IN MEMORY
+ * (as hex or base64 strings), so they need dependency-free, synchronous,
+ * fully-testable conversions. Every function here is verified against known
+ * vectors in byteUtils.test.ts.
+ *
+ * No dependency, no eval, no file I/O.
+ */
+
+const B64_ALPHABET =
+  'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
+const B64URL_ALPHABET =
+  'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';
+
+/** Build a reverse lookup for a base64-style alphabet. */
+function makeDecoder(alphabet: string): Record<string, number> {
+  const map: Record<string, number> = {};
+  for (let i = 0; i < alphabet.length; i++) {
+    map[alphabet[i]] = i;
+  }
+  return map;
+}
+const B64_DEC = makeDecoder(B64_ALPHABET);
+const B64URL_DEC = makeDecoder(B64URL_ALPHABET);
+
+/** Encode bytes to a base64 string. `urlSafe` uses the base64url alphabet. */
+export function bytesToBase64(bytes: Uint8Array, urlSafe = false): string {
+  const alphabet = urlSafe ? B64URL_ALPHABET : B64_ALPHABET;
+  let out = '';
+  let i = 0;
+  for (; i + 2 < bytes.length; i += 3) {
+    const n = (bytes[i] << 16) | (bytes[i + 1] << 8) | bytes[i + 2];
+    out +=
+      alphabet[(n >> 18) & 63] +
+      alphabet[(n >> 12) & 63] +
+      alphabet[(n >> 6) & 63] +
+      alphabet[n & 63];
+  }
+  const rem = bytes.length - i;
+  if (rem === 1) {
+    const n = bytes[i] << 16;
+    out += alphabet[(n >> 18) & 63] + alphabet[(n >> 12) & 63];
+    out += urlSafe ? '' : '==';
+  } else if (rem === 2) {
+    const n = (bytes[i] << 16) | (bytes[i + 1] << 8);
+    out += alphabet[(n >> 18) & 63] + alphabet[(n >> 12) & 63] + alphabet[(n >> 6) & 63];
+    out += urlSafe ? '' : '=';
+  }
+  return out;
+}
+
+/**
+ * Decode a base64 or base64url string to bytes. Tolerates missing padding,
+ * whitespace, and both alphabets. Throws on invalid characters.
+ */
+export function base64ToBytes(input: string): Uint8Array {
+  const clean = input.replace(/[\s\r\n]/g, '');
+  // Pick alphabet: if it contains url-safe chars, decode as url-safe.
+  const dec = /[-_]/.test(clean) ? B64URL_DEC : B64_DEC;
+  const stripped = clean.replace(/=+$/, '');
+  const out: number[] = [];
+  let buffer = 0;
+  let bits = 0;
+  for (const ch of stripped) {
+    const val = dec[ch];
+    if (val === undefined) {
+      throw new Error(`invalid base64 character "${ch}"`);
+    }
+    buffer = (buffer << 6) | val;
+    bits += 6;
+    if (bits >= 8) {
+      bits -= 8;
+      out.push((buffer >> bits) & 0xff);
+    }
+  }
+  return Uint8Array.from(out);
+}
+
+/** Encode bytes to a lowercase hex string. */
+export function bytesToHex(bytes: Uint8Array): string {
+  let out = '';
+  for (let i = 0; i < bytes.length; i++) {
+    out += bytes[i].toString(16).padStart(2, '0');
+  }
+  return out;
+}
+
+/** Decode a hex string (with optional spaces/0x/colon separators) to bytes. */
+export function hexToBytes(input: string): Uint8Array {
+  const clean = input.replace(/0x/gi, '').replace(/[\s:]/g, '');
+  if (clean.length % 2 !== 0) {
+    throw new Error('hex string has an odd number of digits');
+  }
+  if (!/^[0-9a-fA-F]*$/.test(clean)) {
+    throw new Error('hex string contains a non-hex character');
+  }
+  const out = new Uint8Array(clean.length / 2);
+  for (let i = 0; i < out.length; i++) {
+    out[i] = parseInt(clean.substr(i * 2, 2), 16);
+  }
+  return out;
+}
+
+/** Encode a JS string to UTF-8 bytes. */
+export function stringToUtf8Bytes(str: string): Uint8Array {
+  const out: number[] = [];
+  for (const ch of str) {
+    const cp = ch.codePointAt(0)!;
+    if (cp < 0x80) {
+      out.push(cp);
+    } else if (cp < 0x800) {
+      out.push(0xc0 | (cp >> 6), 0x80 | (cp & 0x3f));
+    } else if (cp < 0x10000) {
+      out.push(0xe0 | (cp >> 12), 0x80 | ((cp >> 6) & 0x3f), 0x80 | (cp & 0x3f));
+    } else {
+      out.push(
+        0xf0 | (cp >> 18),
+        0x80 | ((cp >> 12) & 0x3f),
+        0x80 | ((cp >> 6) & 0x3f),
+        0x80 | (cp & 0x3f),
+      );
+    }
+  }
+  return Uint8Array.from(out);
+}
+
+/** Decode UTF-8 bytes to a JS string, replacing invalid sequences with U+FFFD. */
+export function utf8BytesToString(bytes: Uint8Array): string {
+  let out = '';
+  let i = 0;
+  while (i < bytes.length) {
+    const b = bytes[i];
+    let cp: number;
+    let extra: number;
+    if (b < 0x80) {
+      cp = b;
+      extra = 0;
+    } else if ((b & 0xe0) === 0xc0) {
+      cp = b & 0x1f;
+      extra = 1;
+    } else if ((b & 0xf0) === 0xe0) {
+      cp = b & 0x0f;
+      extra = 2;
+    } else if ((b & 0xf8) === 0xf0) {
+      cp = b & 0x07;
+      extra = 3;
+    } else {
+      out += '\uFFFD';
+      i++;
+      continue;
+    }
+    if (extra > bytes.length - i - 1) {
+      // Not enough continuation bytes remain.
+      out += '\uFFFD';
+      break;
+    }
+    let valid = true;
+    for (let k = 1; k <= extra; k++) {
+      const cb = bytes[i + k];
+      if ((cb & 0xc0) !== 0x80) {
+        valid = false;
+        break;
+      }
+      cp = (cp << 6) | (cb & 0x3f);
+    }
+    if (!valid) {
+      out += '\uFFFD';
+      i++;
+      continue;
+    }
+    out += String.fromCodePoint(cp);
+    i += extra + 1;
+  }
+  return out;
+}
+
+export type InputEncoding = 'auto' | 'hex' | 'base64' | 'utf8';
+
+/**
+ * Decode a model-supplied `data` string into bytes.
+ *
+ *  - 'hex'    → interpret as hex
+ *  - 'base64' → interpret as base64/base64url
+ *  - 'utf8'   → interpret as raw UTF-8 text
+ *  - 'auto'   → if it is valid even-length hex with no base64-only chars, treat
+ *               as hex; otherwise treat as base64. (utf8 must be requested
+ *               explicitly, since arbitrary text is ambiguous.)
+ */
+export function decodeInput(data: string, encoding: InputEncoding = 'auto'): Uint8Array {
+  if (typeof data !== 'string') {
+    throw new Error('data must be a string');
+  }
+  switch (encoding) {
+    case 'hex':
+      return hexToBytes(data);
+    case 'base64':
+      return base64ToBytes(data);
+    case 'utf8':
+      return stringToUtf8Bytes(data);
+    case 'auto':
+    default: {
+      const trimmed = data.replace(/[\s:]/g, '').replace(/0x/gi, '');
+      const looksHex = /^[0-9a-fA-F]*$/.test(trimmed) && trimmed.length % 2 === 0;
+      if (looksHex) {
+        return hexToBytes(trimmed);
+      }
+      return base64ToBytes(data);
+    }
+  }
+}
+
+/** Read a little-endian uint16/uint32 at an offset. */
+export function readU16LE(bytes: Uint8Array, offset: number): number {
+  return bytes[offset] | (bytes[offset + 1] << 8);
+}
+export function readU32LE(bytes: Uint8Array, offset: number): number {
+  return (
+    (bytes[offset] |
+      (bytes[offset + 1] << 8) |
+      (bytes[offset + 2] << 16) |
+      (bytes[offset + 3] << 24)) >>>
+    0
+  );
+}
