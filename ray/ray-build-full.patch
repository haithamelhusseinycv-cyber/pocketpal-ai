@@ -0,0 +1,353 @@
+import {GpxRouteEngine} from '../GpxRouteEngine';
+import type {TalentResult} from '../types';
+
+const text = (r: TalentResult): string =>
+  r.type === 'text' || r.type === 'error' ? r.summary : '';
+
+describe('GpxRouteEngine contract', () => {
+  const engine = new GpxRouteEngine();
+
+  it('is named "gpx_route"', () => {
+    expect(engine.name).toBe('gpx_route');
+  });
+
+  it('advertises an OpenAI function-calling schema', () => {
+    const def = engine.toToolDefinition();
+    expect(def.type).toBe('function');
+    expect(def.function.name).toBe('gpx_route');
+    expect(def.function.parameters.required).toEqual(['operation']);
+    expect(def.function.parameters.properties.operation.enum).toEqual([
+      'generate',
+      'plan_day',
+      'import',
+      'profile',
+    ]);
+  });
+
+  it('contributes a system-prompt fragment', () => {
+    const fragment = engine.systemPromptFragment?.({
+      now: new Date(),
+      maxToolTurns: 5,
+      activeTalents: new Set(['gpx_route']),
+    });
+    expect(fragment).toBeTruthy();
+    expect(fragment).toMatch(/haversine/);
+    expect(fragment).toMatch(/4\.2 km\/h/);
+  });
+});
+
+describe('GpxRouteEngine.execute validation', () => {
+  const engine = new GpxRouteEngine();
+
+  it('rejects unknown operation', async () => {
+    const r = await engine.execute({operation: 'fly'});
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/unknown operation/);
+  });
+
+  it('rejects missing operation', async () => {
+    const r = await engine.execute({});
+    expect(r.type).toBe('error');
+  });
+
+  it('rejects invalid lat', async () => {
+    const r = await engine.execute({
+      operation: 'generate',
+      points: [{lat: 91, lon: 0}, {lat: 0, lon: 0}],
+      type: 'hike',
+    });
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/lat must be/);
+  });
+
+  it('rejects invalid lon', async () => {
+    const r = await engine.execute({
+      operation: 'generate',
+      points: [{lat: 0, lon: 181}, {lat: 0, lon: 0}],
+      type: 'hike',
+    });
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/lon must be/);
+  });
+
+  it('rejects < 2 points', async () => {
+    const r = await engine.execute({
+      operation: 'generate',
+      points: [{lat: 0, lon: 0}],
+      type: 'hike',
+    });
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/at least 2/);
+  });
+
+  it('rejects invalid type', async () => {
+    const r = await engine.execute({
+      operation: 'generate',
+      points: [{lat: 0, lon: 0}, {lat: 1, lon: 1}],
+      type: 'swim',
+    });
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/type must be/);
+  });
+});
+
+describe('GpxRouteEngine.execute generate', () => {
+  const engine = new GpxRouteEngine();
+
+  it('generates GPX with haversine distance', async () => {
+    // Cairo (30.0444, 31.2357) to Alexandria (31.2001, 29.9187)
+    // Approx straight-line distance: ~180 km
+    const r = await engine.execute({
+      operation: 'generate',
+      name: 'Cairo-Alex',
+      points: [
+        {name: 'Cairo', lat: 30.0444, lon: 31.2357},
+        {name: 'Alexandria', lat: 31.2001, lon: 29.9187},
+      ],
+      type: 'drive',
+    });
+    expect(r.type).toBe('text');
+    const summary = text(r);
+    expect(summary).toMatch(/Cairo-Alex/);
+    expect(summary).toMatch(/Total distance:/);
+    expect(summary).toMatch(/haversine/);
+    expect(summary).toMatch(/GPX 1\.1 XML/);
+    expect(summary).toMatch(/<gpx/);
+    expect(summary).toMatch(/<wpt/);
+    expect(summary).toMatch(/<trkpt/);
+
+    // Extract distance and verify it's in reasonable range (170-190 km)
+    const distMatch = summary.match(/Total distance: ([\d.]+) km/);
+    expect(distMatch).toBeTruthy();
+    const dist = parseFloat(distMatch![1]);
+    expect(dist).toBeGreaterThan(170);
+    expect(dist).toBeLessThan(190);
+  });
+
+  it('computes ascent/descent when ele provided', async () => {
+    const r = await engine.execute({
+      operation: 'generate',
+      name: 'Mountain',
+      points: [
+        {lat: 0, lon: 0, ele: 100},
+        {lat: 0.01, lon: 0, ele: 200},
+        {lat: 0.02, lon: 0, ele: 150},
+      ],
+      type: 'hike',
+    });
+    expect(r.type).toBe('text');
+    const summary = text(r);
+    expect(summary).toMatch(/Cumulative ascent: 100\.0 m/);
+    expect(summary).toMatch(/Cumulative descent: 50\.0 m/);
+  });
+
+  it('respects speed_kmh override', async () => {
+    const r = await engine.execute({
+      operation: 'generate',
+      points: [{lat: 0, lon: 0}, {lat: 1, lon: 0}],
+      type: 'hike',
+      speed_kmh: 10,
+    });
+    expect(r.type).toBe('text');
+    const summary = text(r);
+    expect(summary).toMatch(/at 10 km\/h/);
+    expect(summary).toMatch(/overridden to 10 km\/h/);
+  });
+
+  it('uses default speed for type', async () => {
+    const r = await engine.execute({
+      operation: 'generate',
+      points: [{lat: 0, lon: 0}, {lat: 1, lon: 0}],
+      type: 'bike',
+    });
+    expect(r.type).toBe('text');
+    const summary = text(r);
+    expect(summary).toMatch(/at 15 km\/h/);
+    expect(summary).toMatch(/default bike speed = 15 km\/h/);
+  });
+});
+
+describe('GpxRouteEngine.execute plan_day', () => {
+  const engine = new GpxRouteEngine();
+
+  it('generates itinerary with arrival times', async () => {
+    const r = await engine.execute({
+      operation: 'plan_day',
+      points: [
+        {name: 'Start', lat: 0, lon: 0},
+        {name: 'Mid', lat: 0.1, lon: 0},
+        {name: 'End', lat: 0.2, lon: 0},
+      ],
+      type: 'hike',
+      start_time: '2026-01-01T08:00:00Z',
+    });
+    expect(r.type).toBe('text');
+    const summary = text(r);
+    expect(summary).toMatch(/Itinerary for "hike"/);
+    expect(summary).toMatch(/Start:/);
+    expect(summary).toMatch(/Finish:/);
+    expect(summary).toMatch(/Total moving time:/);
+    expect(summary).toMatch(/Start/);
+    expect(summary).toMatch(/Mid/);
+    expect(summary).toMatch(/End/);
+  });
+
+  it('suggests breaks for hike/bike every 2h', async () => {
+    // Create a long route that will trigger breaks
+    const points = [];
+    for (let i = 0; i < 10; i++) {
+      points.push({lat: i * 0.5, lon: 0});
+    }
+    const r = await engine.execute({
+      operation: 'plan_day',
+      points,
+      type: 'hike',
+    });
+    expect(r.type).toBe('text');
+    const summary = text(r);
+    // Should have at least one break suggestion for a long hike
+    expect(summary).toMatch(/Suggested break/);
+  });
+});
+
+describe('GpxRouteEngine.execute import', () => {
+  const engine = new GpxRouteEngine();
+
+  it('imports GPX and round-trips through generate', async () => {
+    // Generate GPX
+    const genResult = await engine.execute({
+      operation: 'generate',
+      name: 'Test Route',
+      points: [
+        {name: 'A', lat: 30.0, lon: 31.0, ele: 100},
+        {name: 'B', lat: 30.1, lon: 31.1, ele: 150},
+        {name: 'C', lat: 30.2, lon: 31.2, ele: 120},
+      ],
+      type: 'hike',
+    });
+    expect(genResult.type).toBe('text');
+    const genSummary = text(genResult);
+
+    // Extract GPX XML
+    const gpxMatch = genSummary.match(/GPX 1\.1 XML:\n([\s\S]+)\n\nInputs:/);
+    expect(gpxMatch).toBeTruthy();
+    const gpxXml = gpxMatch![1];
+
+    // Import it back
+    const importResult = await engine.execute({
+      operation: 'import',
+      gpx_xml_string: gpxXml,
+    });
+    expect(importResult.type).toBe('text');
+    const importSummary = text(importResult);
+
+    expect(importSummary).toMatch(/GPX imported: "Test Route"/);
+    expect(importSummary).toMatch(/Waypoints \(named\): 3/);
+    expect(importSummary).toMatch(/Trackpoints: 3/);
+    expect(importSummary).toMatch(/Total distance:/);
+    expect(importSummary).toMatch(/Cumulative ascent:/);
+    expect(importSummary).toMatch(/Cumulative descent:/);
+
+    // Extract distance from import and compare to generate
+    const genDistMatch = genSummary.match(/Total distance: ([\d.]+) km/);
+    const impDistMatch = importSummary.match(/Total distance: ([\d.]+) km/);
+    expect(genDistMatch).toBeTruthy();
+    expect(impDistMatch).toBeTruthy();
+    const genDist = parseFloat(genDistMatch![1]);
+    const impDist = parseFloat(impDistMatch![1]);
+    // Should be identical (round-trip)
+    expect(Math.abs(genDist - impDist)).toBeLessThan(0.01);
+  });
+
+  it('rejects invalid GPX', async () => {
+    const r = await engine.execute({
+      operation: 'import',
+      gpx_xml_string: '<not-gpx></not-gpx>',
+    });
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/not appear to be valid GPX/);
+  });
+
+  it('rejects empty GPX', async () => {
+    const r = await engine.execute({
+      operation: 'import',
+      gpx_xml_string: '',
+    });
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/gpx_xml_string is required/);
+  });
+});
+
+describe('GpxRouteEngine.execute profile', () => {
+  const engine = new GpxRouteEngine();
+
+  it('generates ASCII elevation profile', async () => {
+    const r = await engine.execute({
+      operation: 'profile',
+      points: [
+        {lat: 0, lon: 0, ele: 100},
+        {lat: 0.01, lon: 0, ele: 200},
+        {lat: 0.02, lon: 0, ele: 150},
+        {lat: 0.03, lon: 0, ele: 250},
+        {lat: 0.04, lon: 0, ele: 180},
+      ],
+    });
+    expect(r.type).toBe('text');
+    const summary = text(r);
+    expect(summary).toMatch(/Elevation profile/);
+    expect(summary).toMatch(/Grade stats/);
+    expect(summary).toMatch(/Max grade:/);
+    expect(summary).toMatch(/Avg absolute grade:/);
+    expect(summary).toMatch(/Elevation range:/);
+    // Should contain ASCII art characters
+    expect(summary).toMatch(/█/);
+    expect(summary).toMatch(/▓/);
+  });
+
+  it('rejects profile without elevation data', async () => {
+    const r = await engine.execute({
+      operation: 'profile',
+      points: [
+        {lat: 0, lon: 0},
+        {lat: 0.01, lon: 0},
+      ],
+    });
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/at least 2 points with elevation/);
+  });
+});
+
+describe('GpxRouteEngine haversine accuracy', () => {
+  const engine = new GpxRouteEngine();
+
+  it('Cairo to Alexandria distance within 1% of hand calculation', async () => {
+    // Cairo (30.0444, 31.2357) to Alexandria (31.2001, 29.9187)
+    // Hand calculation using haversine:
+    // dLat = 1.1557° = 0.02017 rad
+    // dLon = -1.317° = -0.02299 rad
+    // a = sin²(0.01009) + cos(30.0444°) * cos(31.2001°) * sin²(-0.01150)
+    //   = 0.0001018 + 0.8656 * 0.8553 * 0.0001323
+    //   = 0.0001018 + 0.0000981 = 0.0001999
+    // c = 2 * atan2(√0.0001999, √0.9998001) = 0.02828 rad
+    // d = 6371008.8 * 0.02828 = 180,193 m ≈ 180.2 km
+
+    const r = await engine.execute({
+      operation: 'generate',
+      points: [
+        {lat: 30.0444, lon: 31.2357},
+        {lat: 31.2001, lon: 29.9187},
+      ],
+      type: 'drive',
+    });
+    expect(r.type).toBe('text');
+    const summary = text(r);
+    const distMatch = summary.match(/Total distance: ([\d.]+) km/);
+    expect(distMatch).toBeTruthy();
+    const dist = parseFloat(distMatch![1]);
+
+    // Hand calculation: ~180.2 km
+    // Within 1%: 178.4 - 182.0 km
+    expect(dist).toBeGreaterThan(178);
+    expect(dist).toBeLessThan(182);
+  });
+});
