@@ -0,0 +1,508 @@
+/**
+ * MicrosoftGraphEngine — the `microsoft_graph` talent.
+ *
+ * STATUS — READ THIS:
+ * This is a real, typed talent that exposes Outlook mail, calendar, and OneDrive
+ * via the Microsoft Graph API. It ships in a "not configured" state: the user
+ * must register a Microsoft Entra app and supply a client-id before any Graph
+ * call can fire. Nothing fabricates mail, calendar, or file data.
+ *
+ * The talent honestly reports its activation state via the 'status' op:
+ *   - not_configured: no client-id in Keychain
+ *   - not_authenticated: no token set in Keychain
+ *   - authenticated: valid token set present
+ *
+ * See src/services/graph/README.md for the activation checklist.
+ */
+
+import {
+  TalentEngine,
+  TalentResult,
+  ToolDefinition,
+  SystemPromptContext,
+} from './types';
+import {wrapUntrusted} from './untrustedContent';
+import {
+  isConfigured,
+  isAuthenticated,
+  getValidAccessToken,
+} from '../graph/auth';
+import * as client from '../graph/client';
+import type {GraphError} from '../graph/types';
+
+const MAX_OUTPUT = 50_000;
+
+function truncate(s: string): string {
+  if (s.length <= MAX_OUTPUT) return s;
+  return s.slice(0, MAX_OUTPUT) + `\n… [truncated, ${s.length - MAX_OUTPUT} chars omitted]`;
+}
+
+type GraphOp =
+  | 'status'
+  | 'mail_list'
+  | 'mail_read'
+  | 'mail_send'
+  | 'calendar_list'
+  | 'calendar_create'
+  | 'files_list'
+  | 'me';
+
+const OPS: GraphOp[] = [
+  'status',
+  'mail_list',
+  'mail_read',
+  'mail_send',
+  'calendar_list',
+  'calendar_create',
+  'files_list',
+  'me',
+];
+
+export class MicrosoftGraphEngine implements TalentEngine {
+  readonly name = 'microsoft_graph';
+  readonly recommendedContextTokens = 1200;
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const op = args.op as string | undefined;
+    if (!op || !OPS.includes(op as GraphOp)) {
+      return {
+        type: 'error',
+        summary: `microsoft_graph: unknown or missing operation "${op}". Valid: ${OPS.join(', ')}`,
+        errorMessage: `op must be one of: ${OPS.join(', ')}`,
+      };
+    }
+
+    // Status op doesn't require auth
+    if (op === 'status') {
+      return this.status();
+    }
+
+    // All other ops require configuration + authentication
+    const configured = await isConfigured();
+    if (!configured) {
+      return {
+        type: 'error',
+        summary:
+          'microsoft_graph: not configured. No client-id found. See src/services/graph/README.md for the activation checklist.',
+        errorMessage:
+          'Microsoft Graph is not configured. Register a Microsoft Entra app and supply the client-id. See src/services/graph/README.md.',
+      };
+    }
+
+    const authenticated = await isAuthenticated();
+    if (!authenticated) {
+      return {
+        type: 'error',
+        summary:
+          'microsoft_graph: not authenticated. Please sign in with your Microsoft account.',
+        errorMessage:
+          'Not authenticated. Please sign in with your Microsoft account to access Outlook mail, calendar, and OneDrive.',
+      };
+    }
+
+    try {
+      const accessToken = await getValidAccessToken();
+
+      switch (op) {
+        case 'me':
+          return await this.me(accessToken);
+        case 'mail_list':
+          return await this.mailList(accessToken, args);
+        case 'mail_read':
+          return await this.mailRead(accessToken, args);
+        case 'mail_send':
+          return await this.mailSend(accessToken, args);
+        case 'calendar_list':
+          return await this.calendarList(accessToken, args);
+        case 'calendar_create':
+          return await this.calendarCreate(accessToken, args);
+        case 'files_list':
+          return await this.filesList(accessToken);
+        default:
+          return {
+            type: 'error',
+            summary: `microsoft_graph: unhandled operation "${op}"`,
+            errorMessage: 'unhandled operation',
+          };
+      }
+    } catch (error) {
+      const graphError = error as GraphError;
+      const errMsg = graphError.message || String(error);
+      return {
+        type: 'error',
+        summary: `microsoft_graph: ${op} failed — ${errMsg}`,
+        errorMessage: errMsg,
+      };
+    }
+  }
+
+  private async status(): Promise<TalentResult> {
+    const configured = await isConfigured();
+    const authenticated = await isAuthenticated();
+
+    let state: string;
+    if (!configured) {
+      state = 'not_configured';
+    } else if (!authenticated) {
+      state = 'not_authenticated';
+    } else {
+      state = 'authenticated';
+    }
+
+    const lines = [
+      `status: ${state}`,
+      `configured: ${configured}`,
+      `authenticated: ${authenticated}`,
+    ];
+
+    if (!configured) {
+      lines.push('');
+      lines.push('Activation required:');
+      lines.push('1. Register a Microsoft Entra app (free)');
+      lines.push('2. Add a mobile/desktop redirect URI');
+      lines.push('3. Grant delegated permissions (User.Read, Mail.Read, etc.)');
+      lines.push('4. Supply the client-id via Settings → Microsoft Graph');
+      lines.push('');
+      lines.push('See src/services/graph/README.md for the full checklist.');
+    } else if (!authenticated) {
+      lines.push('');
+      lines.push('Sign in with your Microsoft account to access Outlook mail, calendar, and OneDrive.');
+    }
+
+    return {
+      type: 'text',
+      summary: truncate(lines.join('\n')),
+    };
+  }
+
+  private async me(accessToken: string): Promise<TalentResult> {
+    const user = await client.getMe(accessToken);
+
+    const lines = [
+      `## Signed-in user`,
+      ``,
+      `- **Name**: ${user.displayName}`,
+      `- **Email**: ${user.mail || user.userPrincipalName}`,
+    ];
+
+    if (user.jobTitle) lines.push(`- **Job title**: ${user.jobTitle}`);
+    if (user.officeLocation) lines.push(`- **Office**: ${user.officeLocation}`);
+
+    return {
+      type: 'text',
+      summary: wrapUntrusted(truncate(lines.join('\n'))),
+    };
+  }
+
+  private async mailList(
+    accessToken: string,
+    args: Record<string, any>,
+  ): Promise<TalentResult> {
+    const top = typeof args.top === 'number' ? args.top : 10;
+    const search = typeof args.search === 'string' ? args.search : undefined;
+
+    const result = await client.listMessages(accessToken, {top, search});
+
+    if (result.value.length === 0) {
+      return {
+        type: 'text',
+        summary: 'No messages found.',
+      };
+    }
+
+    const lines = [`## Recent messages (${result.value.length})`, ``];
+
+    for (const msg of result.value) {
+      const from = msg.from?.emailAddress;
+      const fromStr = from ? `${from.name} <${from.address}>` : 'Unknown';
+      const subject = msg.subject || '(no subject)';
+      const preview = msg.bodyPreview || '';
+      const date = new Date(msg.receivedDateTime).toLocaleString();
+
+      lines.push(`### ${subject}`);
+      lines.push(`**From**: ${fromStr}`);
+      lines.push(`**Date**: ${date}`);
+      if (preview) lines.push(`**Preview**: ${preview}`);
+      lines.push(`**ID**: ${msg.id}`);
+      lines.push('');
+    }
+
+    return {
+      type: 'text',
+      summary: wrapUntrusted(truncate(lines.join('\n'))),
+    };
+  }
+
+  private async mailRead(
+    accessToken: string,
+    args: Record<string, any>,
+  ): Promise<TalentResult> {
+    const id = typeof args.id === 'string' ? args.id : '';
+    if (!id) {
+      return {
+        type: 'error',
+        summary: 'microsoft_graph: mail_read requires "id" argument',
+        errorMessage: 'id argument is required',
+      };
+    }
+
+    const msg = await client.readMessage(accessToken, id);
+
+    const from = msg.from?.emailAddress;
+    const fromStr = from ? `${from.name} <${from.address}>` : 'Unknown';
+    const subject = msg.subject || '(no subject)';
+    const body = msg.body?.content || '';
+    const date = new Date(msg.receivedDateTime).toLocaleString();
+
+    const lines = [
+      `## ${subject}`,
+      ``,
+      `**From**: ${fromStr}`,
+      `**Date**: ${date}`,
+      `**Read**: ${msg.isRead ? 'Yes' : 'No'}`,
+      `**Attachments**: ${msg.hasAttachments ? 'Yes' : 'No'}`,
+      ``,
+      body,
+    ];
+
+    return {
+      type: 'text',
+      summary: wrapUntrusted(truncate(lines.join('\n'))),
+    };
+  }
+
+  private async mailSend(
+    accessToken: string,
+    args: Record<string, any>,
+  ): Promise<TalentResult> {
+    const to = args.to as string | undefined;
+    const subject = args.subject as string | undefined;
+    const body = args.body as string | undefined;
+
+    if (!to || !subject || !body) {
+      return {
+        type: 'error',
+        summary: 'microsoft_graph: mail_send requires "to", "subject", and "body" arguments',
+        errorMessage: 'to, subject, and body arguments are required',
+      };
+    }
+
+    // Parse "to" — accept "name <email>" or just "email"
+    const toMatch = to.match(/^(.+?)\s*<(.+?)>$/) || [null, '', to];
+    const toName = toMatch[1]?.trim() || '';
+    const toEmail = toMatch[2]?.trim() || to;
+
+    await client.sendMail(accessToken, {
+      toRecipients: [{emailAddress: {name: toName, address: toEmail}}],
+      subject,
+      body: {contentType: 'Text', content: body},
+    });
+
+    return {
+      type: 'text',
+      summary: `Email sent to ${toEmail}.`,
+    };
+  }
+
+  private async calendarList(
+    accessToken: string,
+    args: Record<string, any>,
+  ): Promise<TalentResult> {
+    const rangeStart = args.rangeStart as string | undefined;
+    const rangeEnd = args.rangeEnd as string | undefined;
+
+    if (!rangeStart || !rangeEnd) {
+      return {
+        type: 'error',
+        summary: 'microsoft_graph: calendar_list requires "rangeStart" and "rangeEnd" arguments (ISO 8601)',
+        errorMessage: 'rangeStart and rangeEnd arguments are required (ISO 8601 format)',
+      };
+    }
+
+    const result = await client.listEvents(accessToken, rangeStart, rangeEnd);
+
+    if (result.value.length === 0) {
+      return {
+        type: 'text',
+        summary: 'No events found in the specified range.',
+      };
+    }
+
+    const lines = [`## Upcoming events (${result.value.length})`, ``];
+
+    for (const event of result.value) {
+      const start = new Date(event.start.dateTime).toLocaleString();
+      const end = new Date(event.end.dateTime).toLocaleString();
+      const location = event.location?.displayName || '';
+
+      lines.push(`### ${event.subject}`);
+      lines.push(`**Start**: ${start}`);
+      lines.push(`**End**: ${end}`);
+      if (location) lines.push(`**Location**: ${location}`);
+      if (event.bodyPreview) lines.push(`**Preview**: ${event.bodyPreview}`);
+      lines.push(`**ID**: ${event.id}`);
+      lines.push('');
+    }
+
+    return {
+      type: 'text',
+      summary: wrapUntrusted(truncate(lines.join('\n'))),
+    };
+  }
+
+  private async calendarCreate(
+    accessToken: string,
+    args: Record<string, any>,
+  ): Promise<TalentResult> {
+    const subject = args.subject as string | undefined;
+    const start = args.start as string | undefined;
+    const end = args.end as string | undefined;
+    const timeZone = (args.timeZone as string) || 'UTC';
+
+    if (!subject || !start || !end) {
+      return {
+        type: 'error',
+        summary: 'microsoft_graph: calendar_create requires "subject", "start", and "end" arguments (ISO 8601)',
+        errorMessage: 'subject, start, and end arguments are required (ISO 8601 format)',
+      };
+    }
+
+    const location = args.location as string | undefined;
+
+    const event = await client.createEvent(accessToken, {
+      subject,
+      start: {dateTime: start, timeZone},
+      end: {dateTime: end, timeZone},
+      location: location ? {displayName: location} : undefined,
+    });
+
+    return {
+      type: 'text',
+      summary: `Event created: "${event.subject}" (ID: ${event.id})`,
+    };
+  }
+
+  private async filesList(accessToken: string): Promise<TalentResult> {
+    const result = await client.listDriveItems(accessToken);
+
+    if (result.value.length === 0) {
+      return {
+        type: 'text',
+        summary: 'No files found in OneDrive root.',
+      };
+    }
+
+    const lines = [`## OneDrive files (${result.value.length})`, ``];
+
+    for (const item of result.value) {
+      const isFolder = !!item.folder;
+      const icon = isFolder ? '📁' : '📄';
+      const size = item.folder ? `${item.folder.childCount || 0} items` : formatBytes(item.size);
+      const date = new Date(item.lastModifiedDateTime).toLocaleDateString();
+
+      lines.push(`${icon} **${item.name}**`);
+      lines.push(`   Size: ${size} | Modified: ${date}`);
+      lines.push(`   ID: ${item.id}`);
+      lines.push('');
+    }
+
+    return {
+      type: 'text',
+      summary: wrapUntrusted(truncate(lines.join('\n'))),
+    };
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: 'microsoft_graph',
+        description:
+          'Access Microsoft 365 (Outlook mail, calendar, OneDrive) via the Microsoft Graph API. Requires the user to have completed Graph authentication (see src/services/graph/README.md). NEVER fabricate email, calendar, or file contents — only relay what Graph returns.',
+        parameters: {
+          type: 'object',
+          properties: {
+            op: {
+              type: 'string',
+              enum: OPS,
+              description:
+                'Operation to perform. "status" returns activation state; "me" returns signed-in user; "mail_list" lists recent emails; "mail_read" reads a specific email; "mail_send" sends an email; "calendar_list" lists events in a date range; "calendar_create" creates an event; "files_list" lists OneDrive files.',
+            },
+            top: {
+              type: 'number',
+              description: 'Number of messages to return (mail_list). Default 10.',
+            },
+            search: {
+              type: 'string',
+              description: 'Search query for mail_list (KQL syntax).',
+            },
+            id: {
+              type: 'string',
+              description: 'Message ID (mail_read).',
+            },
+            to: {
+              type: 'string',
+              description: 'Recipient email (mail_send). Format: "name <email>" or just "email".',
+            },
