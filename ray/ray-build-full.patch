+// ---------------------------------------------------------------------------
+// Helvetica widths for printable ASCII 32..126 (units per 1000 at 1pt)
+// Source: Adobe AFM for Helvetica (regular).
+// ---------------------------------------------------------------------------
+const HELV_WIDTHS: number[] = [
