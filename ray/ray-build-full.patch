@@ -0,0 +1,196 @@
+import {EncodingEngine} from '../EncodingEngine';
+import {
+  bytesToBase64,
+  stringToUtf8Bytes,
+  bytesToHex,
+  hexToBytes,
+} from '../byteUtils';
+
+describe('EncodingEngine', () => {
+  let engine: EncodingEngine;
+
+  beforeEach(() => {
+    engine = new EncodingEngine();
+  });
+
+  it('has name "encoding"', () => {
+    expect(engine.name).toBe('encoding');
+  });
+
+  // ─── to_base64 ────────────────────────────────────────────────────────
+
+  it('to_base64: "foobar" → "Zm9vYmFy"', async () => {
+    const r = await engine.execute({operation: 'to_base64', data: 'foobar', from: 'utf8'});
+    expect(r.type).toBe('text');
+    expect(r.summary).toContain('Zm9vYmFy');
+  });
+
+  it('to_base64 RFC 4648 padding: "f" → "Zg=="', async () => {
+    const r = await engine.execute({operation: 'to_base64', data: 'f', from: 'utf8'});
+    expect(r.summary).toContain('Zg==');
+  });
+
+  it('to_base64 RFC 4648 padding: "fo" → "Zm8="', async () => {
+    const r = await engine.execute({operation: 'to_base64', data: 'fo', from: 'utf8'});
+    expect(r.summary).toContain('Zm8=');
+  });
+
+  it('to_base64 RFC 4648 padding: "foo" → "Zm9v"', async () => {
+    const r = await engine.execute({operation: 'to_base64', data: 'foo', from: 'utf8'});
+    expect(r.summary).toContain('Zm9v');
+  });
+
+  it('to_base64 url_safe strips padding and uses -_', async () => {
+    // base64url of 'foobar' is 'Zm9vYmFy' (same, no padding needed)
+    // Test with 'f' which is 'Zg==' in standard, 'Zg' in url-safe
+    const r = await engine.execute({operation: 'to_base64', data: 'f', from: 'utf8', url_safe: true});
+    expect(r.summary).toContain('Zg');
+    expect(r.summary).not.toContain('==');
+  });
+
+  // ─── from_base64 ──────────────────────────────────────────────────────
+
+  it('from_base64: "Zm9vYmFy" → "foobar"', async () => {
+    const r = await engine.execute({operation: 'from_base64', data: 'Zm9vYmFy'});
+    expect(r.type).toBe('text');
+    expect(r.summary).toContain('foobar');
+  });
+
+  it('from_base64 accepts base64url', async () => {
+    // base64url of 'foo' is 'Zm9v' (same as standard for this input)
+    const r = await engine.execute({operation: 'from_base64', data: 'Zm9v'});
+    expect(r.summary).toContain('foo');
+  });
+
+  it('from_base64 error on invalid input', async () => {
+    const r = await engine.execute({operation: 'from_base64', data: '!!!!'});
+    expect(r.type).toBe('error');
+    expect(r.summary).toContain('failed');
+  });
+
+  // ─── to_hex / from_hex ────────────────────────────────────────────────
+
+  it('to_hex: "deadbeef" from hex → "deadbeef"', async () => {
+    const r = await engine.execute({operation: 'to_hex', data: 'deadbeef', from: 'hex'});
+    expect(r.summary).toContain('deadbeef');
+  });
+
+  it('from_hex: "deadbeef" round-trips', async () => {
+    const r = await engine.execute({operation: 'from_hex', data: 'deadbeef'});
+    expect(r.type).toBe('text');
+    // hexToBytes('deadbeef') → bytes, bytesToHex → 'deadbeef'
+    expect(r.summary).toContain('deadbeef');
+  });
+
+  it('from_hex error on invalid hex', async () => {
+    const r = await engine.execute({operation: 'from_hex', data: 'zz'});
+    expect(r.type).toBe('error');
+    expect(r.summary).toContain('failed');
+  });
+
+  // ─── to_utf8 / from_utf8 ──────────────────────────────────────────────
+
+  it('to_utf8: hex "666f6f" → "foo"', async () => {
+    const r = await engine.execute({operation: 'to_utf8', data: '666f6f', from: 'hex'});
+    expect(r.summary).toContain('foo');
+  });
+
+  it('from_utf8: "foo" → hex "666f6f"', async () => {
+    const r = await engine.execute({operation: 'from_utf8', data: 'foo'});
+    expect(r.summary).toContain('666f6f');
+  });
+
+  // ─── url_encode / url_decode ──────────────────────────────────────────
+
+  it('url_encode: "a b&c" → "a%20b%26c"', async () => {
+    const r = await engine.execute({operation: 'url_encode', data: 'a b&c'});
+    expect(r.type).toBe('text');
+    expect(r.summary).toContain('a%20b%26c');
+  });
+
+  it('url_decode reverses url_encode', async () => {
+    const r = await engine.execute({operation: 'url_decode', data: 'a%20b%26c'});
+    expect(r.type).toBe('text');
+    expect(r.summary).toContain('a b&c');
+  });
+
+  // ─── jwt_decode ───────────────────────────────────────────────────────
+
+  const JWT_TOKEN =
+    'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c';
+
+  it('jwt_decode: decodes jwt.io token correctly', async () => {
+    const r = await engine.execute({operation: 'jwt_decode', data: JWT_TOKEN});
+    expect(r.type).toBe('text');
+    expect(r.summary).toContain('John Doe');
+    expect(r.summary).toContain('1234567890');
+    expect(r.summary).toContain('NOT verified');
+  });
+
+  it('jwt_decode: header has alg HS256 and typ JWT', async () => {
+    const r = await engine.execute({operation: 'jwt_decode', data: JWT_TOKEN});
+    expect(r.summary).toContain('"alg":"HS256"');
+    expect(r.summary).toContain('"typ":"JWT"');
+  });
+
+  it('jwt_decode: error on malformed JWT', async () => {
+    const r = await engine.execute({operation: 'jwt_decode', data: 'not.a.jwt'});
+    expect(r.type).toBe('error');
+    expect(r.summary).toContain('failed');
+  });
+
+  // ─── auto ─────────────────────────────────────────────────────────────
+
+  it('auto: hex → utf8', async () => {
+    const r = await engine.execute({operation: 'auto', data: '666f6f', from: 'hex', to: 'utf8'});
+    expect(r.summary).toContain('foo');
+  });
+
+  it('auto: base64 → utf8', async () => {
+    const r = await engine.execute({operation: 'auto', data: 'Zm9v', from: 'base64', to: 'utf8'});
+    expect(r.summary).toContain('foo');
+  });
+
+  // ─── error cases ──────────────────────────────────────────────────────
+
+  it('unknown operation returns error', async () => {
+    const r = await engine.execute({operation: 'bogus', data: 'x'});
+    expect(r.type).toBe('error');
+  });
+
+  it('missing data returns error', async () => {
+    const r = await engine.execute({operation: 'to_base64'});
+    expect(r.type).toBe('error');
+  });
+
+  // ─── tool definition / prompt ─────────────────────────────────────────
+
+  it('toToolDefinition returns valid schema', () => {
+    const def = engine.toToolDefinition();
+    expect(def.type).toBe('function');
+    expect(def.function.name).toBe('encoding');
+    expect(def.function.parameters.properties.operation.enum).toContain('jwt_decode');
+    expect(def.function.parameters.required).toContain('operation');
+    expect(def.function.parameters.required).toContain('data');
+  });
+
+  it('systemPromptFragment mentions JWT signature not verified', () => {
+    const frag = engine.systemPromptFragment!({
+      now: new Date(),
+      maxToolTurns: 10,
+      activeTalents: new Set(['encoding']),
+    });
+    expect(frag).toBeTruthy();
+    expect(frag).toContain('NOT verified');
+  });
+
+  // ─── byteUtils shared helper sanity ───────────────────────────────────
+
+  it('byteUtils: bytesToBase64(stringToUtf8Bytes("foobar")) === "Zm9vYmFy"', () => {
+    expect(bytesToBase64(stringToUtf8Bytes('foobar'))).toBe('Zm9vYmFy');
+  });
+
