@@ -0,0 +1,258 @@
+import {RegexEngine} from '../RegexEngine';
+
+// Minimal jest-compatible test harness types
+interface TestDef {
+  name: string;
+  fn: () => Promise<void> | void;
+}
+
+const tests: TestDef[] = [];
+
+function test(name: string, fn: () => Promise<void> | void) {
+  tests.push({name, fn});
+}
+
+function expect<T>(actual: T) {
+  return {
+    toBe(expected: T) {
+      if (actual !== expected) {
+        throw new Error(`Expected ${JSON.stringify(expected)}, got ${JSON.stringify(actual)}`);
+      }
+    },
+    toEqual(expected: T) {
+      const a = JSON.stringify(actual);
+      const e = JSON.stringify(expected);
+      if (a !== e) {
+        throw new Error(`Expected ${e}, got ${a}`);
+      }
+    },
+    toContain(substr: string) {
+      if (typeof actual !== 'string' || !actual.includes(substr)) {
+        throw new Error(`Expected "${String(actual)}" to contain "${substr}"`);
+      }
+    },
+    toBeTruthy() {
+      if (!actual) {
+        throw new Error(`Expected truthy, got ${JSON.stringify(actual)}`);
+      }
+    },
+  };
+}
+
+// ---- Tests ----
+
+test('match: date pattern finds 2 matches with correct groups', async () => {
+  const engine = new RegexEngine();
+  const result = await engine.execute({
+    pattern: '(\\d{4})-(\\d{2})-(\\d{2})',
+    subject: 'dates: 2024-01-15 and 2023-12-31',
+    operation: 'match',
+  });
+  expect(result.type).toBe('text');
+  if (result.type !== 'text') {return;}
+  expect(result.summary).toContain('2 matches');
+  expect(result.summary).toContain('"2024-01-15"');
+  expect(result.summary).toContain('"2023-12-31"');
+  expect(result.summary).toContain('$1 = "2024"');
+  expect(result.summary).toContain('$1 = "2023"');
+  expect(result.summary).toContain('$2 = "01"');
+  expect(result.summary).toContain('$2 = "12"');
+  expect(result.summary).toContain('$3 = "15"');
+  expect(result.summary).toContain('$3 = "31"');
+});
+
+test('groups: named group works', async () => {
+  const engine = new RegexEngine();
+  const result = await engine.execute({
+    pattern: '(?<year>\\d{4})',
+    subject: '2024',
+    operation: 'groups',
+  });
+  expect(result.type).toBe('text');
+  if (result.type !== 'text') {return;}
+  expect(result.summary).toContain('year = "2024"');
+});
+
+test('error: invalid pattern returns error, not throw', async () => {
+  const engine = new RegexEngine();
+  const result = await engine.execute({
+    pattern: '(',
+    subject: 'test',
+    operation: 'match',
+  });
+  expect(result.type).toBe('error');
+  if (result.type !== 'error') {return;}
+  expect(result.errorMessage).toBeTruthy();
+});
+
+test('error: bad flags returns error', async () => {
+  const engine = new RegexEngine();
+  const result = await engine.execute({
+    pattern: 'abc',
+    flags: 'q',
+    subject: 'test',
+    operation: 'match',
+  });
+  expect(result.type).toBe('error');
+  if (result.type !== 'error') {return;}
+  expect(result.errorMessage).toContain('Invalid flag');
+});
+
+test('replace: a->b in banana', async () => {
+  const engine = new RegexEngine();
+  const result = await engine.execute({
+    pattern: 'a',
+    flags: 'g',
+    replacement: 'b',
+    subject: 'banana',
+    operation: 'replace',
+  });
+  expect(result.type).toBe('text');
+  if (result.type !== 'text') {return;}
+  expect(result.summary).toContain('bbnbnb');
+  expect(result.summary).toContain('3 replacements');
+});
+
+test('split: comma-separated', async () => {
+  const engine = new RegexEngine();
+  const result = await engine.execute({
+    pattern: ',',
+    subject: 'a,b,c',
+    operation: 'split',
+  });
+  expect(result.type).toBe('text');
+  if (result.type !== 'text') {return;}
+  expect(result.summary).toContain('["a","b","c"]');
+  expect(result.summary).toContain('3 parts');
+});
+
+test('test: finds match and reports index', async () => {
+  const engine = new RegexEngine();
+  const result = await engine.execute({
+    pattern: 'world',
+    subject: 'hello world',
+    operation: 'test',
+  });
+  expect(result.type).toBe('text');
+  if (result.type !== 'text') {return;}
+  expect(result.summary).toContain('matches at index 6');
+});
+
+test('test: no match reports does NOT match', async () => {
+  const engine = new RegexEngine();
+  const result = await engine.execute({
+    pattern: 'xyz',
+    subject: 'hello world',
+    operation: 'test',
+  });
+  expect(result.type).toBe('text');
+  if (result.type !== 'text') {return;}
+  expect(result.summary).toContain('does NOT match');
+});
+
+test('explain: describes pattern structure', async () => {
+  const engine = new RegexEngine();
+  const result = await engine.execute({
+    pattern: '\\d{3}-\\w+',
+    operation: 'explain',
+  });
+  expect(result.type).toBe('text');
+  if (result.type !== 'text') {return;}
+  expect(result.summary).toContain('digit');
+  expect(result.summary).toContain('{3}');
+  expect(result.summary).toContain('word character');
+  expect(result.summary).toContain('+');
+});
+
+test('error: missing pattern', async () => {
+  const engine = new RegexEngine();
+  const result = await engine.execute({});
+  expect(result.type).toBe('error');
+});
+
+test('error: missing subject for match', async () => {
+  const engine = new RegexEngine();
+  const result = await engine.execute({
+    pattern: 'abc',
+    operation: 'match',
+  });
+  expect(result.type).toBe('error');
+});
+
+test('ReDoS guard: subject truncation', async () => {
+  const engine = new RegexEngine();
+  // Create a subject larger than 100_000 chars
+  const bigSubject = 'a'.repeat(200_000);
+  const result = await engine.execute({
+    pattern: 'a',
+    subject: bigSubject,
+    operation: 'match',
+  });
+  expect(result.type).toBe('text');
+  if (result.type !== 'text') {return;}
+  expect(result.summary).toContain('capped at 500');
+  expect(result.summary).toContain('subject truncated');
+});
+
+test('ReDoS guard: pathological pattern with small input completes', async () => {
+  const engine = new RegexEngine();
+  // Pathological pattern but small input (20 chars) completes quickly
+  // Larger inputs would hang JS regex (no timeout available), so we cap subject
+  // length at 100_000 chars and document this limitation in the tool description
+  const result = await engine.execute({
+    pattern: '(a+)+$',
+    subject: 'aaaaaaaaaaaaaaaaaaaa!', // 20 a's + !
+    operation: 'test',
+  });
+  expect(result.type).toBe('text');
+  if (result.type !== 'text') {return;}
+  expect(result.summary).toContain('does NOT match');
+});
+
+test('toToolDefinition: has correct shape', () => {
+  const engine = new RegexEngine();
+  const def = engine.toToolDefinition();
+  expect(def.type).toBe('function');
+  expect(def.function.name).toBe('regex');
+  expect(def.function.parameters.properties.pattern).toBeTruthy();
+  expect(def.function.parameters.properties.operation).toBeTruthy();
+  const ops = def.function.parameters.properties.operation.enum;
+  expect(ops).toEqual(['test', 'match', 'groups', 'replace', 'explain', 'split']);
+});
+
+test('systemPromptFragment: returns guidance text', () => {
+  const engine = new RegexEngine();
+  const fragment = engine.systemPromptFragment({
+    now: new Date(),
+    maxToolTurns: 10,
+    activeTalents: new Set(['regex']),
+  });
+  expect(fragment).toBeTruthy();
+  if (!fragment) {return;}
+  expect(fragment).toContain('regex');
+  expect(fragment).toContain('verify');
+});
+
+// ---- Runner ----
+
+async function run() {
+  let passed = 0;
+  let failed = 0;
+  for (const t of tests) {
+    try {
+      await t.fn();
+      passed++;
+      console.log(`  PASS  ${t.name}`);
+    } catch (e) {
+      failed++;
+      console.log(`  FAIL  ${t.name}`);
+      console.log(`        ${e instanceof Error ? e.message : String(e)}`);
+    }
+  }
+  console.log(`\n${passed} passed, ${failed} failed, ${tests.length} total`);
+  if (failed > 0) {
+    process.exit(1);
+  }
+}
+
+run();
