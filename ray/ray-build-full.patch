+    if (section.bullets) {
+      for (const bullet of section.bullets) {
+        const bulletLines = wrapText(bullet, fontSize, uWidth - 20);
+        for (let bi = 0; bi < bulletLines.length; bi++) {
+          ensureSpace(lineHeight);
+          y -= lineHeight;
+          const indent = bi === 0 ? MARGIN_LEFT + 10 : MARGIN_LEFT + 24;
+          const prefix = bi === 0 ? '- ' : '  ';
+          currentStream += `BT /F1 ${fontSize} Tf ${indent} ${y} Td (${pdfEscape(prefix + bulletLines[bi])}) Tj ET\n`;
+        }
+      }
+      y -= lineHeight * 0.3;
+    }
+
+    if (section.table) {
+      const {headers, rows} = section.table;
+      const colCount = headers.length;
+
+      // Compute column widths based on content
+      const colWidths = computeColumnWidths(headers, rows, uWidth);
+
+      const rowHeight = fontSize * 2;
+      const cellPad = 4;
+
+      // Draw table header
+      ensureSpace(rowHeight + 5);
+      const tableTop = y;
+      y -= rowHeight;
+
+      // Header background
+      currentStream += `q 0.85 0.85 0.9 rg\n${MARGIN_LEFT} ${y} ${uWidth} ${rowHeight} re f\nQ\n`;
+
+      // Header text
+      let cx = MARGIN_LEFT;
+      for (let c = 0; c < colCount; c++) {
+        currentStream += `BT /F2 ${fontSize} Tf ${cx + cellPad} ${y + cellPad} Td (${pdfEscape(headers[c])}) Tj ET\n`;
+        cx += colWidths[c];
+      }
+
+      // Header bottom border
+      currentStream += `q 0.3 G\n0.5 w\n${MARGIN_LEFT} ${y} m ${MARGIN_LEFT + uWidth} ${y} l S\nQ\n`;
+
+      // Data rows
+      for (let r = 0; r < rows.length; r++) {
+        ensureSpace(rowHeight);
+        y -= rowHeight;
+
+        // Alternating shading
+        if (r % 2 === 1) {
+          currentStream += `q 0.95 0.95 0.95 rg\n${MARGIN_LEFT} ${y} ${uWidth} ${rowHeight} re f\nQ\n`;
+        }
+
+        // Cell text
+        cx = MARGIN_LEFT;
+        for (let c = 0; c < colCount; c++) {
+          const cellText = (rows[r] && rows[r][c]) || '';
+          currentStream += `BT /F1 ${fontSize} Tf ${cx + cellPad} ${y + cellPad} Td (${pdfEscape(cellText)}) Tj ET\n`;
+          cx += colWidths[c];
+        }
+
+        // Row border (light)
+        currentStream += `q 0.8 G\n0.25 w\n${MARGIN_LEFT} ${y} m ${MARGIN_LEFT + uWidth} ${y} l S\nQ\n`;
+      }
+
+      // Table outer border
+      const tableHeight = tableTop - y;
+      currentStream += `q 0.3 G\n0.5 w\n${MARGIN_LEFT} ${y} ${uWidth} ${tableHeight} re S\nQ\n`;
+
+      // Column dividers
+      cx = MARGIN_LEFT;
+      for (let c = 0; c < colCount - 1; c++) {
+        cx += colWidths[c];
+        currentStream += `q 0.7 G\n0.25 w\n${cx} ${y} m ${cx} ${tableTop} l S\nQ\n`;
+      }
+
+      y -= 10;
+    }
+
+    y -= 10;
+  }
+
+  // Push last page
+  pageDataList.push({stream: currentStream});
+
+  // Now build the PDF with known structure:
+  // Obj 1: Catalog
+  // Obj 2: Pages
+  // Obj 3: Font Helvetica
+  // Obj 4: Font Helvetica-Bold
+  // Obj 5: Resources
+  // Then for each page: content stream + page object
+
+  const totalPages = pageDataList.length;
+
+  // Build page numbers and footers into streams
+  for (let i = 0; i < totalPages; i++) {
+    let s = pageDataList[i].stream;
+    // Page number
+    const pnText = `${i + 1}`;
+    const pnW = measureWidth(pnText, 8);
+    const pnX = (pageW - pnW) / 2;
+    const pnY = MARGIN_BOTTOM / 2;
+    s += `BT /F1 8 Tf 0.5 0.5 0.5 rg ${pnX} ${pnY} Td (${pnText}) Tj ET\n0 g\n`;
+    if (input.footer) {
+      s += `BT /F1 8 Tf 0.5 0.5 0.5 rg ${MARGIN_LEFT} ${pnY} Td (${pdfEscape(input.footer)}) Tj ET\n0 g\n`;
+    }
+    pageDataList[i].stream = s;
+  }
+
+  // Assemble PDF manually with byte-exact offsets
+  let pdf = '%PDF-1.4\n';
+  pdf += '%\xe2\xe3\xcf\xd3\n';
+
+  const offsets: number[] = new Array(6 + totalPages * 2).fill(0);
+
+  function writeObj(id: number, content: string) {
+    offsets[id] = pdf.length;
+    pdf += `${id} 0 obj\n${content}\nendobj\n`;
+  }
+
+  // Obj 1: Catalog
+  writeObj(1, '<< /Type /Catalog /Pages 2 0 R >>');
+
+  // Obj 2: Pages (placeholder, fill after page IDs known)
+  const pagesObjOffset = pdf.length;
+  offsets[2] = pagesObjOffset;
+
+  // We'll write pages placeholder, then fix it
+  const pageObjIds: number[] = [];
+  const streamObjIds: number[] = [];
+  for (let i = 0; i < totalPages; i++) {
+    pageObjIds.push(6 + i * 2);
+    streamObjIds.push(6 + i * 2 + 1);
+  }
+
+  const kidsStr = pageObjIds.map(id => `${id} 0 R`).join(' ');
+  writeObj(2, `<< /Type /Pages /Kids [${kidsStr}] /Count ${totalPages} >>`);
+
+  // Obj 3: Font
+  writeObj(3, '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>');
+
+  // Obj 4: Font Bold
+  writeObj(4, '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>');
+
+  // Obj 5: Resources
+  writeObj(5, `<< /Font << /F1 3 0 R /F2 4 0 R >> >>`);
+
+  // Page objects and streams
+  for (let i = 0; i < totalPages; i++) {
+    const streamContent = pageDataList[i].stream;
+    const pageId = pageObjIds[i];
+    const streamId = streamObjIds[i];
+
+    writeObj(streamId, `<< /Length ${streamContent.length} >>\nstream\n${streamContent}\nendstream`);
+    writeObj(pageId,
+      `<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${pageW} ${pageH}] ` +
+      `/Contents ${streamId} 0 R /Resources 5 0 R >>`
+    );
+  }
+
+  // xref
+  const xrefOffset = pdf.length;
+  const totalObjCount = 6 + totalPages * 2;
+  pdf += 'xref\n';
+  pdf += `0 ${totalObjCount}\n`;
+  pdf += '0000000000 65535 f \n';
+  for (let i = 1; i < totalObjCount; i++) {
+    pdf += offsets[i].toString().padStart(10, '0') + ' 00000 n \n';
+  }
+
+  pdf += 'trailer\n';
+  pdf += `<< /Size ${totalObjCount} /Root 1 0 R >>\n`;
+  pdf += 'startxref\n';
+  pdf += `${xrefOffset}\n`;
+  pdf += '%%EOF\n';
+
+  return pdf;
+}
+
+/** Compute column widths proportional to max content width per column. */
+function computeColumnWidths(headers: string[], rows: string[][], totalWidth: number): number[] {
+  const colCount = headers.length;
+  const maxContentWidth: number[] = new Array(colCount).fill(0);
+  const fontSize = 10;
+
+  for (let c = 0; c < colCount; c++) {
+    maxContentWidth[c] = measureWidth(headers[c], fontSize);
+    for (const row of rows) {
+      const cellText = (row && row[c]) || '';
+      const w = measureWidth(cellText, fontSize);
+      if (w > maxContentWidth[c]) {
+        maxContentWidth[c] = w;
+      }
+    }
+    // Add padding
+    maxContentWidth[c] += 8;
+  }
+
+  const totalContent = maxContentWidth.reduce((a, b) => a + b, 0);
+  if (totalContent === 0) {
+    return new Array(colCount).fill(totalWidth / colCount);
+  }
+
+  return maxContentWidth.map(w => (w / totalContent) * totalWidth);
+}
+
+// ---------------------------------------------------------------------------
+// Operation: table
+// ---------------------------------------------------------------------------
+
+interface TableInput {
+  headers: string[];
+  rows: string[][];
+  title?: string;
+  path?: string;
+  landscape?: boolean;
+}
+
+function generateTablePdf(input: TableInput): string {
+  const landscape = input.landscape || false;
+  const pageW = landscape ? 841.89 : 595.28;
+  const pageH = landscape ? 595.28 : 841.89;
+  const uWidth = pageW - MARGIN_LEFT - MARGIN_RIGHT;
+
+  const fontSize = 9;
+  const lineHeight = fontSize * 2;
+  const cellPad = 4;
+  const colCount = input.headers.length;
+  const colWidths = computeColumnWidths(input.headers, input.rows, uWidth);
+
+  interface PageData {
+    stream: string;
+  }
+  const pageDataList: PageData[] = [];
+  let currentStream = '';
+  let y = pageH - MARGIN_TOP;
+
+  // Title
+  if (input.title) {
+    y -= 18;
+    currentStream += `BT /F2 16 Tf ${MARGIN_LEFT} ${y} Td (${pdfEscape(input.title)}) Tj ET\n`;
+    y -= 15;
+    currentStream += `q 0.5 G\n0.5 w\n${MARGIN_LEFT} ${y} m ${pageW - MARGIN_RIGHT} ${y} l S\nQ\n`;
+    y -= 10;
+  }
+
+  function drawTableHeader() {
+    currentStream += `q 0.85 0.85 0.9 rg\n${MARGIN_LEFT} ${y - lineHeight} ${uWidth} ${lineHeight} re f\nQ\n`;
+    let cx = MARGIN_LEFT;
+    for (let c = 0; c < colCount; c++) {
+      currentStream += `BT /F2 ${fontSize} Tf ${cx + cellPad} ${y - lineHeight + cellPad} Td (${pdfEscape(input.headers[c])}) Tj ET\n`;
+      cx += colWidths[c];
+    }
+    currentStream += `q 0.3 G\n0.5 w\n${MARGIN_LEFT} ${y - lineHeight} m ${MARGIN_LEFT + uWidth} ${y - lineHeight} l S\nQ\n`;
+    y -= lineHeight;
+  }
+
+  function newPage() {
+    pageDataList.push({stream: currentStream});
+    currentStream = '';
+    y = pageH - MARGIN_TOP;
+    // Repeat header
+    drawTableHeader();
+  }
+
+  // Draw initial header
+  drawTableHeader();
+
+  // Data rows
+  for (let r = 0; r < input.rows.length; r++) {
+    if (y - lineHeight < MARGIN_BOTTOM) {
+      newPage();
+    }
+    y -= lineHeight;
+
+    // Alternating shading
+    if (r % 2 === 1) {
+      currentStream += `q 0.95 0.95 0.95 rg\n${MARGIN_LEFT} ${y} ${uWidth} ${lineHeight} re f\nQ\n`;
+    }
+
+    // Cell text
+    let cx = MARGIN_LEFT;
+    for (let c = 0; c < colCount; c++) {
+      const cellText = (input.rows[r] && input.rows[r][c]) || '';
+      currentStream += `BT /F1 ${fontSize} Tf ${cx + cellPad} ${y + cellPad} Td (${pdfEscape(cellText)}) Tj ET\n`;
+      cx += colWidths[c];
+    }
+
+    // Row border
+    currentStream += `q 0.8 G\n0.25 w\n${MARGIN_LEFT} ${y} m ${MARGIN_LEFT + uWidth} ${y} l S\nQ\n`;
+  }
+
+  // Table outer border
+  // We need to track the table top; approximate with current y and total rows drawn
+  const tableBottom = y;
+
+  pageDataList.push({stream: currentStream});
+
+  // Add page numbers
+  const totalPages = pageDataList.length;
+  for (let i = 0; i < totalPages; i++) {
+    let s = pageDataList[i].stream;
+    const pnText = `${i + 1}`;
+    const pnW = measureWidth(pnText, 8);
+    const pnX = (pageW - pnW) / 2;
+    const pnY = MARGIN_BOTTOM / 2;
+    s += `BT /F1 8 Tf 0.5 0.5 0.5 rg ${pnX} ${pnY} Td (${pnText}) Tj ET\n0 g\n`;
+    pageDataList[i].stream = s;
+  }
+
+  // Assemble PDF
+  let pdf = '%PDF-1.4\n';
+  pdf += '%\xe2\xe3\xcf\xd3\n';
+
+  const totalObjCount = 6 + totalPages * 2;
+  const offsets: number[] = new Array(totalObjCount).fill(0);
+
+  function writeObj(id: number, content: string) {
+    offsets[id] = pdf.length;
+    pdf += `${id} 0 obj\n${content}\nendobj\n`;
+  }
+
+  const pageObjIds: number[] = [];
+  const streamObjIds: number[] = [];
+  for (let i = 0; i < totalPages; i++) {
+    pageObjIds.push(6 + i * 2);
+    streamObjIds.push(6 + i * 2 + 1);
+  }
+
+  const kidsStr = pageObjIds.map(id => `${id} 0 R`).join(' ');
+
+  writeObj(1, '<< /Type /Catalog /Pages 2 0 R >>');
+  writeObj(2, `<< /Type /Pages /Kids [${kidsStr}] /Count ${totalPages} >>`);
+  writeObj(3, '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>');
+  writeObj(4, '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>');
+  writeObj(5, `<< /Font << /F1 3 0 R /F2 4 0 R >> >>`);
+
+  for (let i = 0; i < totalPages; i++) {
+    const streamContent = pageDataList[i].stream;
+    writeObj(streamObjIds[i], `<< /Length ${streamContent.length} >>\nstream\n${streamContent}\nendstream`);
+    writeObj(pageObjIds[i],
+      `<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${pageW} ${pageH}] ` +
+      `/Contents ${streamObjIds[i]} 0 R /Resources 5 0 R >>`
+    );
+  }
+
+  const xrefOffset = pdf.length;
+  pdf += 'xref\n';
+  pdf += `0 ${totalObjCount}\n`;
+  pdf += '0000000000 65535 f \n';
+  for (let i = 1; i < totalObjCount; i++) {
+    pdf += offsets[i].toString().padStart(10, '0') + ' 00000 n \n';
+  }
+  pdf += 'trailer\n';
+  pdf += `<< /Size ${totalObjCount} /Root 1 0 R >>\n`;
+  pdf += 'startxref\n';
+  pdf += `${xrefOffset}\n`;
+  pdf += '%%EOF\n';
+
+  return pdf;
+}
