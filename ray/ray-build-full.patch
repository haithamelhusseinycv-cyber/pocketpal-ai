+function usableWidth(builder: PdfBuilder): number {
+  return builder.pageWidth - MARGIN_LEFT - MARGIN_RIGHT;
+}
+
+function usableHeight(builder: PdfBuilder): number {
+  return builder.pageHeight - MARGIN_TOP - MARGIN_BOTTOM;
+}
