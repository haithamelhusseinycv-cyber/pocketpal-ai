+/**
+ * ApkInspectEngine tests — jest test suite
+ *
+ * Builds synthetic ZIP/APK fixtures in pure JS and verifies:
+ * - entries: lists ZIP entries with correct names/sizes/methods
+ * - manifest: decodes binary AXML to extract package and permissions
+ * - axml: decodes raw AXML bytes
+ * - signing: detects v1 artifacts and APK Sig Block presence
+ * - summary: compact overview
+ * - error handling: non-ZIP, truncated AXML, compressed manifest
+ */
+
+import {ApkInspectEngine} from '../ApkInspectEngine';
+
+// ─── ZIP builder ─────────────────────────────────────────────────────────────
+function writeU16LE(val: number): number[] {
+  return [val & 0xff, (val >> 8) & 0xff];
+}
+function writeU32LE(val: number): number[] {
+  return [val & 0xff, (val >> 8) & 0xff, (val >> 16) & 0xff, (val >> 24) & 0xff];
+}
+function concatBytes(...arrays: Uint8Array[]): Uint8Array {
+  const total = arrays.reduce((s, a) => s + a.length, 0);
+  const result = new Uint8Array(total);
+  let offset = 0;
+  for (const arr of arrays) {
+    result.set(arr, offset);
+    offset += arr.length;
+  }
+  return result;
+}
+
+function buildZip(entries: {name: string; data: Uint8Array; method: number}[]): Uint8Array {
+  const localHeaders: Uint8Array[] = [];
+  const centralEntries: {name: string; method: number; size: number; offset: number}[] = [];
+  let offset = 0;
+
+  for (const entry of entries) {
+    const nameBytes = new TextEncoder().encode(entry.name);
+    const data = entry.data || new Uint8Array(0);
+    const method = entry.method || 0;
+
+    const local = concatBytes(
+      new Uint8Array([0x50, 0x4b, 0x03, 0x04]),
+      new Uint8Array([0x14, 0x00]),
+      new Uint8Array([0x00, 0x00]),
+      new Uint8Array(writeU16LE(method)),
+      new Uint8Array([0x00, 0x00]),
+      new Uint8Array([0x00, 0x00]),
+      new Uint8Array([0x00, 0x00, 0x00, 0x00]),
+      new Uint8Array(writeU32LE(data.length)),
+      new Uint8Array(writeU32LE(data.length)),
+      new Uint8Array(writeU16LE(nameBytes.length)),
+      new Uint8Array([0x00, 0x00]),
+      nameBytes,
+      data
+    );
+    localHeaders.push(local);
+
+    centralEntries.push({
+      name: entry.name,
+      method,
+      size: data.length,
+      offset,
+    });
+
+    offset += local.length;
+  }
+
+  const cdOffset = offset;
+  const centralDir: Uint8Array[] = [];
+  for (const entry of centralEntries) {
+    const nameBytes = new TextEncoder().encode(entry.name);
+    const cd = concatBytes(
+      new Uint8Array([0x50, 0x4b, 0x01, 0x02]),
+      new Uint8Array([0x14, 0x00]),
+      new Uint8Array([0x14, 0x00]),
+      new Uint8Array([0x00, 0x00]),
+      new Uint8Array(writeU16LE(entry.method)),
+      new Uint8Array([0x00, 0x00]),
+      new Uint8Array([0x00, 0x00]),
+      new Uint8Array([0x00, 0x00, 0x00, 0x00]),
+      new Uint8Array(writeU32LE(entry.size)),
+      new Uint8Array(writeU32LE(entry.size)),
+      new Uint8Array(writeU16LE(nameBytes.length)),
+      new Uint8Array([0x00, 0x00]),
+      new Uint8Array([0x00, 0x00]),
+      new Uint8Array([0x00, 0x00]),
+      new Uint8Array([0x00, 0x00]),
+      new Uint8Array([0x00, 0x00, 0x00, 0x00]),
+      new Uint8Array(writeU32LE(entry.offset)),
+      nameBytes
+    );
+    centralDir.push(cd);
+    offset += cd.length;
+  }
+
+  const cdSize = offset - cdOffset;
+
+  const eocd = concatBytes(
+    new Uint8Array([0x50, 0x4b, 0x05, 0x06]),
+    new Uint8Array([0x00, 0x00]),
+    new Uint8Array([0x00, 0x00]),
+    new Uint8Array(writeU16LE(centralEntries.length)),
+    new Uint8Array(writeU16LE(centralEntries.length)),
+    new Uint8Array(writeU32LE(cdSize)),
+    new Uint8Array(writeU32LE(cdOffset)),
+    new Uint8Array([0x00, 0x00])
+  );
+
+  return concatBytes(...localHeaders, ...centralDir, eocd);
+}
+
+// ─── AXML builder ────────────────────────────────────────────────────────────
+function buildAXML(): Uint8Array {
+  const strings = ['package', 'android', 'com.example.app', 'uses-permission', 'android.permission.INTERNET', 'http://schemas.android.com/apk/res/android', 'name', 'manifest'];
+
+  const stringCount = strings.length;
+  const offsets: number[] = [];
+  const stringData: number[] = [];
+  let currentOffset = 0;
+
+  for (const str of strings) {
+    offsets.push(currentOffset);
+    const bytes = new TextEncoder().encode(str);
+    stringData.push(str.length);
+    stringData.push(bytes.length);
+    stringData.push(...bytes);
+    currentOffset += 2 + bytes.length;
+  }
+
+  const offsetsArray = new Uint8Array(stringCount * 4);
+  for (let i = 0; i < stringCount; i++) {
+    const val = offsets[i];
+    offsetsArray[i * 4] = val & 0xff;
+    offsetsArray[i * 4 + 1] = (val >> 8) & 0xff;
+    offsetsArray[i * 4 + 2] = (val >> 16) & 0xff;
+    offsetsArray[i * 4 + 3] = (val >> 24) & 0xff;
+  }
+
+  const stringDataArray = new Uint8Array(stringData);
+  const stringsStart = 28 + offsetsArray.length;
+  const poolSize = stringsStart + stringDataArray.length;
+
+  const stringPool = concatBytes(
+    new Uint8Array([0x01, 0x00]),
+    new Uint8Array([0x1c, 0x00]),
+    new Uint8Array(writeU32LE(poolSize)),
+    new Uint8Array(writeU32LE(stringCount)),
+    new Uint8Array([0x00, 0x00, 0x00, 0x00]),
+    new Uint8Array([0x00, 0x01, 0x00, 0x00]),
+    new Uint8Array(writeU32LE(stringsStart)),
+    new Uint8Array([0x00, 0x00, 0x00, 0x00]),
+    offsetsArray,
+    stringDataArray
+  );
+
+  const manifestAttr = concatBytes(
+    new Uint8Array([0xff, 0xff, 0xff, 0xff]),
+    new Uint8Array(writeU32LE(0)),
+    new Uint8Array(writeU32LE(2)),
+    new Uint8Array([0x08, 0x00, 0x00, 0x03, 0x02, 0x00, 0x00, 0x00])
+  );
+
+  const manifestElemSize = 36 + manifestAttr.length;
+  const manifestElem = concatBytes(
+    new Uint8Array([0x02, 0x01]),
+    new Uint8Array([0x10, 0x00]),
+    new Uint8Array(writeU32LE(manifestElemSize)),
+    new Uint8Array([0x00, 0x00, 0x00, 0x00]),
+    new Uint8Array([0xff, 0xff, 0xff, 0xff]),
+    new Uint8Array([0xff, 0xff, 0xff, 0xff]),
+    new Uint8Array(writeU32LE(7)),
+    new Uint8Array([0x14, 0x00]),
+    new Uint8Array([0x14, 0x00]),
+    new Uint8Array([0x01, 0x00]),
+    new Uint8Array([0x00, 0x00]),
+    new Uint8Array([0x00, 0x00]),
+    new Uint8Array([0x00, 0x00]),
+    manifestAttr
+  );
+
+  const permAttr = concatBytes(
+    new Uint8Array(writeU32LE(5)),
+    new Uint8Array(writeU32LE(6)),
+    new Uint8Array(writeU32LE(4)),
+    new Uint8Array([0x08, 0x00, 0x00, 0x03, 0x04, 0x00, 0x00, 0x00])
+  );
+
+  const permElemSize = 36 + permAttr.length;
+  const permElem = concatBytes(
+    new Uint8Array([0x02, 0x01]),
+    new Uint8Array([0x10, 0x00]),
+    new Uint8Array(writeU32LE(permElemSize)),
+    new Uint8Array([0x00, 0x00, 0x00, 0x00]),
+    new Uint8Array([0xff, 0xff, 0xff, 0xff]),
+    new Uint8Array([0xff, 0xff, 0xff, 0xff]),
+    new Uint8Array(writeU32LE(3)),
+    new Uint8Array([0x14, 0x00]),
+    new Uint8Array([0x14, 0x00]),
+    new Uint8Array([0x01, 0x00]),
+    new Uint8Array([0x00, 0x00]),
+    new Uint8Array([0x00, 0x00]),
+    new Uint8Array([0x00, 0x00]),
+    permAttr
+  );
+
+  const totalSize = 8 + stringPool.length + manifestElem.length + permElem.length;
+
+  const header = concatBytes(
+    new Uint8Array([0x03, 0x00, 0x08, 0x00]),
+    new Uint8Array(writeU32LE(totalSize))
+  );
+
+  return concatBytes(header, stringPool, manifestElem, permElem);
+}
+
+function bytesToHex(bytes: Uint8Array): string {
+  return Array.from(bytes).map(b => b.toString(16).padStart(2, '0')).join('');
+}
