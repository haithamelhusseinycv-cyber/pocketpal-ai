+ */
+
+import { GpxRouteEngine } from './src/services/talents/GpxRouteEngine.ts';
+import { AstroEngine } from './src/services/talents/AstroEngine.ts';
+
+console.log('=== COMPREHENSIVE TEST HARNESS ===\n');
+
+// ============================================================================
+// GPX ROUTE ENGINE TESTS
+// ============================================================================
+
+console.log('📍 GPX ROUTE ENGINE TESTS\n');
+
+const gpxEngine = new GpxRouteEngine();
+
+// Test 1: Cairo to Alexandria 5-point route
+console.log('Test 1: Cairo to Alexandria 5-point route');
+const cairoAlexRoute = {
+  operation: 'generate',
+  name: 'Cairo-Alexandria Coastal Route',
+  points: [
+    { name: 'Cairo', lat: 30.0444, lon: 31.2357, ele: 75 },
+    { name: 'Damanhur', lat: 30.7242, lon: 30.5085, ele: 20 },
+    { name: 'Damanhur Waypoint', lat: 30.9000, lon: 30.3000, ele: 15 },
+    { name: 'Desert Junction', lat: 31.0500, lon: 30.1000, ele: 25 },
+    { name: 'Alexandria', lat: 31.2001, lon: 29.9187, ele: 10 }
+  ],
+  type: 'drive',
+  speed_kmh: 80
+};
+
+const gpxResult = await gpxEngine.execute(cairoAlexRoute);
+console.log('✓ Generated GPX');
+
+// Parse the summary to extract values
+const distanceMatch = gpxResult.summary.match(/Total distance: ([\d.]+) km/);
+const durationMatch = gpxResult.summary.match(/Estimated duration: (\d+h \d+m)/);
+const ascentMatch = gpxResult.summary.match(/Cumulative ascent: ([\d.]+) m/);
+const descentMatch = gpxResult.summary.match(/Cumulative descent: ([\d.]+) m/);
+
+const totalDistance = distanceMatch ? parseFloat(distanceMatch[1]) : 0;
+const duration = durationMatch ? durationMatch[1] : '0h 0m';
+const ascent = ascentMatch ? parseFloat(ascentMatch[1]) : 0;
+const descent = descentMatch ? parseFloat(descentMatch[1]) : 0;
+
+console.log('  Distance:', totalDistance.toFixed(2), 'km');
+console.log('  Duration:', duration);
+console.log('  Ascent:', ascent.toFixed(1), 'm');
+console.log('  Descent:', descent.toFixed(1), 'm');
+
+// Cairo to Alexandria direct distance is ~180 km
+// The 5-point route follows roughly the same path
+const expectedDistance = 180; // km
+const tolerance = expectedDistance * 0.01; // 1%
+if (Math.abs(totalDistance - expectedDistance) <= tolerance) {
+  console.log('✓ Distance within 1% of hand calculation');
+} else {
+  console.log('✗ Distance outside tolerance');
+  console.log(`  Expected: ${expectedDistance} ± ${tolerance} km`);
+  console.log(`  Got: ${totalDistance} km`);
+}
+
+// Test 2: GPX round-trip through import
