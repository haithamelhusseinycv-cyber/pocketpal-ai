+
+    const inputLines: string[] = [];
+    if (ebit !== null) inputLines.push(`ebit = ${money(ebit)}`);
+    if (ebitda !== null) inputLines.push(`ebitda = ${money(ebitda)}`);
+    if (depreciation !== null) inputLines.push(`depreciation = ${money(depreciation)}`);
+    if (interestExpense !== null) inputLines.push(`interest_expense = ${money(interestExpense)}`);
