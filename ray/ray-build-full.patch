@@ -0,0 +1,62 @@
+import React from 'react';
+import {View} from 'react-native';
+import {observer} from 'mobx-react-lite';
+import {Card, Text, SegmentedButtons} from 'react-native-paper';
+
+import {useTheme} from '../../hooks';
+import {rayPrefsStore} from '../../store/RayPrefsStore';
+import type {RayLanguage} from '../../store/RayPrefsStore';
+
+import {createStyles} from './styles';
+
+/**
+ * RAY persona card — exposes the one user-facing knob over the hardcoded
+ * persona: the reply-language override.
+ *
+ * The persona text itself stays in code (rayPersona.ts) and cannot be edited
+ * here; this only chooses whether RAY answers in English, Egyptian Arabic, or
+ * mirrors the user (auto). Kept separate from RoutingSettingsCard because
+ * persona preferences and routing live in different stores on purpose.
+ */
+
+const LANGUAGE_OPTIONS: {value: RayLanguage; label: string}[] = [
+  {value: 'auto', label: 'Auto'},
+  {value: 'en', label: 'English'},
+  {value: 'ar', label: 'عربي'},
+];
+
+export const RayPersonaCard = observer(() => {
+  const theme = useTheme();
+  const styles = createStyles(theme);
+
+  return (
+    <Card elevation={0} style={styles.card} testID="ray-persona-card">
+      <Card.Title title="RAY persona" />
+      <Card.Content>
+        <View style={styles.settingItemContainer}>
+          <Text variant="titleMedium" style={styles.textLabel}>
+            Reply language
+          </Text>
+          <Text variant="labelSmall" style={styles.textDescription}>
+            Auto mirrors whatever language you write in. English and عربي force
+            that language regardless of your message. The persona itself is
+            fixed in code and cannot be edited from here.
+          </Text>
+          <SegmentedButtons
+            testID="ray-language-buttons"
+            value={rayPrefsStore.language}
+            onValueChange={v => rayPrefsStore.setLanguage(v as RayLanguage)}
+            density="medium"
+            buttons={LANGUAGE_OPTIONS.map(o => ({
+              value: o.value,
+              label: o.label,
+              labelStyle: {fontSize: 11},
+              testID: `ray-language-${o.value}`,
+            }))}
+            style={styles.segmentedButtons}
+          />
+        </View>
+      </Card.Content>
+    </Card>
+  );
+});
