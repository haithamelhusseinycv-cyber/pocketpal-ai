+        }
+        // Cell text
+        for (let c = 0; c < colCount; c++) {
+          const x = MARGIN_LEFT + c * colWidth + cellPad;
+          const cellText = (rows[r] && rows[r][c]) || '';
+          currentStream += `BT /F1 ${fontSize} Tf ${x} ${y + cellPad} Td (${pdfEscape(cellText)}) Tj ET\n`;
+        }
+        // Row bottom border (light)
+        currentStream += `q 0.8 G\n0.25 w\n${MARGIN_LEFT} ${y} m ${MARGIN_LEFT + uWidth} ${y} l S\nQ\n`;
+      }
+      // Table outer border
+      const tableTop = y + rowHeight * (rows.length + 1);
+      currentStream += `q 0.3 G\n0.5 w\n${MARGIN_LEFT} ${y} ${uWidth} ${rowHeight * (rows.length + 1)} re S\nQ\n`;
+      y -= 10;
+    }
+
+    y -= 10; // section spacing
+  }
+
+  // Footer
+  if (input.footer) {
+    // Place on last page
+  }
+
+  // Push last page
+  pages.push({contentStream: currentStream});
+
+  // Now build page objects and content streams
+  const contentStreamIds: number[] = [];
+  const pageIds: number[] = [];
+
+  for (let i = 0; i < pages.length; i++) {
+    const streamContent = pages[i].contentStream;
+    const streamBytes = streamContent;
