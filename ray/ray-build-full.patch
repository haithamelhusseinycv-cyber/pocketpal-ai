+  test('has correct name', () => {
+    expect(engine.name).toBe('exif');
+  });
+
+  test('toToolDefinition returns valid schema', () => {
+    const tool = engine.toToolDefinition();
+    expect(tool.type).toBe('function');
+    expect(tool.function.name).toBe('exif');
+    expect(tool.function.parameters.properties.operation).toBeDefined();
+  });
+
+  test('systemPromptFragment returns string', () => {
+    const ctx = {now: new Date(), maxToolTurns: 10, activeTalents: new Set()};
+    const fragment = engine.systemPromptFragment(ctx);
+    expect(typeof fragment).toBe('string');
+    expect(fragment).toContain('exif');
+  });
+
+  test('execute rejects unknown operation', async () => {
+    const result = await engine.execute({operation: 'invalid'});
+    expect(result.type).toBe('error');
+    if (result.type === 'error') {
+      expect(result.summary).toContain('unknown');
+    }
+  });
+
+  test('execute rejects missing operation', async () => {
+    const result = await engine.execute({});
+    expect(result.type).toBe('error');
+  });
+
+  test('read operation rejects missing data', async () => {
+    const result = await engine.execute({operation: 'read'});
+    expect(result.type).toBe('error');
+    if (result.type === 'error') {
+      expect(result.summary).toContain('missing');
+    }
+  });
+
+  test('read operation rejects non-JPEG data', async () => {
+    const result = await engine.execute({
+      operation: 'read',
+      data: 'not-a-jpeg',
+      encoding: 'utf8',
