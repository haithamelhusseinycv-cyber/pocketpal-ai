@@ -0,0 +1,646 @@
+import {TalentEngine, TalentResult, ToolDefinition, SystemPromptContext} from './types';
+
+/**
+ * Scratchpad — small persistent key-value store for tool chaining.
+ *
+ * Mirrors the AsyncStorage pattern from RayPrefsStore for persistence.
+ * Supports TTL, LRU eviction at 200 keys, 100KB value cap, and a safe
+ * arithmetic evaluator (tokenizer + shunting-yard + RPN) for the 'compute' op.
+ *
+ * No eval/Function. No new dependencies.
+ */
+
+// ---------------------------------------------------------------------------
+// Storage abstraction — mirrors RayPrefsStore's AsyncStorage pattern
+// ---------------------------------------------------------------------------
+
+interface StorageBackend {
+  getItem(key: string): Promise<string | null>;
+  setItem(key: string, value: string): Promise<void>;
+  removeItem(key: string): Promise<void>;
+}
+
+const STORAGE_KEY = '@ray_scratchpad';
+const MAX_KEYS = 200;
+const MAX_VALUE_SIZE = 100 * 1024; // 100KB
+
+/** In-memory storage for environments without AsyncStorage (tests, SSR). */
+class MemoryStorage implements StorageBackend {
+  private store = new Map<string, string>();
+  async getItem(key: string): Promise<string | null> {
+    return this.store.get(key) ?? null;
+  }
+  async setItem(key: string, value: string): Promise<void> {
+    this.store.set(key, value);
+  }
+  async removeItem(key: string): Promise<void> {
+    this.store.delete(key);
+  }
+}
+
+/** Try to load AsyncStorage; fall back to memory. */
+function createStorage(): StorageBackend {
+  try {
+    // Dynamic require to avoid hard dependency
+    const AsyncStorage = require('@react-native-async-storage/async-storage').default;
+    if (AsyncStorage && typeof AsyncStorage.getItem === 'function') {
+      return AsyncStorage as StorageBackend;
+    }
+  } catch {
+    // Fall through to memory
+  }
+  return new MemoryStorage();
+}
+
+// ---------------------------------------------------------------------------
+// Data model
+// ---------------------------------------------------------------------------
+
+interface StoredEntry {
+  value: any;
+  stored_at: number; // epoch ms
+  ttl_minutes?: number;
+  last_access: number; // epoch ms, for LRU
+}
+
+interface ScratchpadData {
+  entries: Record<string, StoredEntry>;
+}
+
+// ---------------------------------------------------------------------------
+// Safe arithmetic evaluator: tokenizer + shunting-yard + RPN
+// ---------------------------------------------------------------------------
+
+type TokenType = 'number' | 'op' | 'lparen' | 'rparen' | 'ref';
+
+interface Token {
+  type: TokenType;
+  value: string;
+}
+
+const FORBIDDEN_PATTERNS = ['__proto__', 'constructor', 'prototype', 'eval', 'Function', 'import', 'require'];
+
+function tokenize(expr: string): Token[] {
+  const tokens: Token[] = [];
+  let i = 0;
+
+  while (i < expr.length) {
+    const ch = expr[i];
+
+    // Skip whitespace
+    if (/\s/.test(ch)) {
+      i++;
+      continue;
+    }
+
+    // Number (including decimals)
+    if (/[0-9.]/.test(ch)) {
+      let num = '';
+      while (i < expr.length && /[0-9.]/.test(expr[i])) {
+        num += expr[i];
+        i++;
+      }
+      tokens.push({type: 'number', value: num});
+      continue;
+    }
+
+    // Reference (@key_name)
+    if (ch === '@') {
+      i++;
+      let name = '';
+      while (i < expr.length && /[a-zA-Z0-9_]/.test(expr[i])) {
+        name += expr[i];
+        i++;
+      }
+      if (!name) {
+        throw new Error('empty reference after @');
+      }
+      tokens.push({type: 'ref', value: name});
+      continue;
+    }
+
+    // Operators
+    if ('+-*/%^'.includes(ch)) {
+      tokens.push({type: 'op', value: ch});
+      i++;
+      continue;
+    }
+
+    if (ch === '(') {
+      tokens.push({type: 'lparen', value: '('});
+      i++;
+      continue;
+    }
+
+    if (ch === ')') {
+      tokens.push({type: 'rparen', value: ')'});
+      i++;
+      continue;
+    }
+
+    throw new Error(`unexpected character: "${ch}"`);
+  }
+
+  return tokens;
+}
+
+function precedence(op: string): number {
+  switch (op) {
+    case '+':
+    case '-':
+      return 1;
+    case '*':
+    case '/':
+    case '%':
+      return 2;
+    case '^':
+      return 3;
+    default:
+      return 0;
+  }
+}
+
+function isRightAssociative(op: string): boolean {
+  return op === '^';
+}
+
+/** Shunting-yard: infix tokens -> RPN token array. */
+function toRPN(tokens: Token[]): Token[] {
+  const output: Token[] = [];
+  const opStack: Token[] = [];
+
+  for (const tok of tokens) {
+    switch (tok.type) {
+      case 'number':
+      case 'ref':
+        output.push(tok);
+        break;
+      case 'op':
+        while (
+          opStack.length > 0 &&
+          opStack[opStack.length - 1].type === 'op' &&
+          (precedence(opStack[opStack.length - 1].value) > precedence(tok.value) ||
+            (precedence(opStack[opStack.length - 1].value) === precedence(tok.value) &&
+              !isRightAssociative(tok.value)))
+        ) {
+          output.push(opStack.pop()!);
+        }
+        opStack.push(tok);
+        break;
+      case 'lparen':
+        opStack.push(tok);
+        break;
+      case 'rparen':
+        while (opStack.length > 0 && opStack[opStack.length - 1].type !== 'lparen') {
+          output.push(opStack.pop()!);
+        }
+        if (opStack.length === 0) {
+          throw new Error('unbalanced parentheses');
+        }
+        opStack.pop(); // discard lparen
+        break;
+    }
+  }
+
+  while (opStack.length > 0) {
+    const top = opStack.pop()!;
+    if (top.type === 'lparen') {
+      throw new Error('unbalanced parentheses');
+    }
+    output.push(top);
+  }
+
+  return output;
+}
+
+/** Evaluate RPN tokens with a resolver for @references. */
+function evalRPN(rpn: Token[], resolve: (name: string) => number): number {
+  const stack: number[] = [];
+
+  for (const tok of rpn) {
+    if (tok.type === 'number') {
+      const n = parseFloat(tok.value);
+      if (!Number.isFinite(n)) {
+        throw new Error(`invalid number: "${tok.value}"`);
+      }
+      stack.push(n);
+    } else if (tok.type === 'ref') {
+      const val = resolve(tok.value);
+      if (!Number.isFinite(val)) {
+        throw new Error(`reference @${tok.value} is not a finite number`);
+      }
+      stack.push(val);
+    } else if (tok.type === 'op') {
+      if (stack.length < 2) {
+        throw new Error('not enough operands for operator ' + tok.value);
+      }
+      const b = stack.pop()!;
+      const a = stack.pop()!;
+      let result: number;
+      switch (tok.value) {
+        case '+': result = a + b; break;
+        case '-': result = a - b; break;
+        case '*': result = a * b; break;
+        case '/':
+          if (b === 0) throw new Error('division by zero');
+          result = a / b;
+          break;
+        case '%':
+          if (b === 0) throw new Error('modulo by zero');
+          result = a % b;
+          break;
+        case '^': result = Math.pow(a, b); break;
+        default: throw new Error('unknown operator: ' + tok.value);
+      }
+      stack.push(result);
+    }
+  }
+
+  if (stack.length !== 1) {
+    throw new Error('expression did not reduce to a single value');
+  }
+  return stack[0];
+}
+
+/** Validate and evaluate an arithmetic expression. */
+function safeEval(expression: string, resolve: (name: string) => number): number {
+  // Security: reject dangerous patterns
+  for (const pat of FORBIDDEN_PATTERNS) {
+    if (expression.includes(pat)) {
+      throw new Error(`unsafe expression: contains "${pat}"`);
+    }
+  }
+
+  const tokens = tokenize(expression);
+  if (tokens.length === 0) {
+    throw new Error('empty expression');
+  }
+
+  const rpn = toRPN(tokens);
+  return evalRPN(rpn, resolve);
+}
+
+// ---------------------------------------------------------------------------
+// ScratchpadEngine
+// ---------------------------------------------------------------------------
+
+const OPERATIONS = ['set', 'get', 'delete', 'list', 'clear', 'compute'] as const;
+type ScratchpadOperation = (typeof OPERATIONS)[number];
+
+export class ScratchpadEngine implements TalentEngine {
+  readonly name = 'scratchpad';
+  private storage: StorageBackend;
+  private cache: ScratchpadData | null = null;
+
+  constructor(storage?: StorageBackend) {
+    this.storage = storage || createStorage();
+  }
+
+  private async load(): Promise<ScratchpadData> {
+    if (this.cache) return this.cache;
+    try {
+      const raw = await this.storage.getItem(STORAGE_KEY);
+      if (raw) {
+        const parsed = JSON.parse(raw);
+        if (parsed && typeof parsed.entries === 'object') {
+          this.cache = parsed;
+          return this.cache;
+        }
+      }
+    } catch {
+      // Corrupt data — start fresh
+    }
+    this.cache = {entries: {}};
+    return this.cache;
+  }
+
+  private async save(): Promise<void> {
+    if (!this.cache) return;
+    await this.storage.setItem(STORAGE_KEY, JSON.stringify(this.cache));
+  }
+
+  private isExpired(entry: StoredEntry, now: number): boolean {
+    if (!entry.ttl_minutes) return false;
+    const expiryMs = entry.stored_at + entry.ttl_minutes * 60 * 1000;
+    return now > expiryMs;
+  }
+
+  private async evictLRU(data: ScratchpadData): Promise<void> {
+    const keys = Object.keys(data.entries);
+    if (keys.length <= MAX_KEYS) return;
+
+    // Sort by last_access ascending, remove oldest
+    const sorted = keys
+      .map(k => ({key: k, access: data.entries[k].last_access}))
+      .sort((a, b) => a.access - b.access);
+
+    const toRemove = keys.length - MAX_KEYS;
+    for (let i = 0; i < toRemove; i++) {
+      delete data.entries[sorted[i].key];
+    }
+  }
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const operation = typeof args.operation === 'string' ? args.operation.toLowerCase() : '';
+    if (!(OPERATIONS as readonly string[]).includes(operation as ScratchpadOperation)) {
+      return {
+        type: 'error',
+        summary: `scratchpad: unknown operation "${operation || '(missing)'}"`,
+        errorMessage: `operation must be one of: ${OPERATIONS.join(', ')}`,
+      };
+    }
+
+    try {
+      switch (operation as ScratchpadOperation) {
+        case 'set':
+          return await this.doSet(args);
+        case 'get':
+          return await this.doGet(args);
+        case 'delete':
+          return await this.doDelete(args);
+        case 'list':
+          return await this.doList();
+        case 'clear':
+          return await this.doClear();
+        case 'compute':
+          return await this.doCompute(args);
+        default:
+          return {type: 'error', summary: `scratchpad: unhandled`, errorMessage: 'internal'};
+      }
+    } catch (e) {
+      const msg = e instanceof Error ? e.message : String(e);
+      return {type: 'error', summary: `scratchpad: ${operation} failed — ${msg}`, errorMessage: msg};
+    }
+  }
+
+  private async doSet(args: Record<string, any>): Promise<TalentResult> {
+    const key = typeof args.key === 'string' ? args.key : '';
+    if (!key) {
+      return {type: 'error', summary: 'scratchpad.set: "key" is required', errorMessage: 'key is required'};
+    }
+
+    const value = args.value;
+    if (value === undefined) {
+      return {type: 'error', summary: 'scratchpad.set: "value" is required', errorMessage: 'value is required'};
+    }
+
+    // Serialize value
+    let serialized: string;
+    try {
+      serialized = JSON.stringify(value);
+    } catch {
+      return {type: 'error', summary: 'scratchpad.set: value is not serializable', errorMessage: 'value must be JSON-serializable'};
+    }
+
+    if (serialized.length > MAX_VALUE_SIZE) {
+      return {
+        type: 'error',
+        summary: `scratchpad.set: value too large (${serialized.length} bytes, max ${MAX_VALUE_SIZE})`,
+        errorMessage: `value exceeds 100KB limit`,
+      };
+    }
+
+    const ttl = typeof args.ttl_minutes === 'number' ? args.ttl_minutes : undefined;
+    const now = Date.now();
+
+    const data = await this.load();
+    data.entries[key] = {
+      value,
+      stored_at: now,
+      ttl_minutes: ttl,
+      last_access: now,
+    };
+
+    await this.evictLRU(data);
+    await this.save();
+
+    return {
+      type: 'text',
+      summary:
+        `[scratchpad.set OK] key="${key}" stored_at=${new Date(now).toISOString()}` +
+        (ttl ? ` ttl=${ttl}min` : '') +
+        `\nvalue_size=${serialized.length} bytes` +
+        `\ntotal_keys=${Object.keys(data.entries).length}`,
+    };
+  }
+
+  private async doGet(args: Record<string, any>): Promise<TalentResult> {
+    const key = typeof args.key === 'string' ? args.key : '';
+    if (!key) {
+      return {type: 'error', summary: 'scratchpad.get: "key" is required', errorMessage: 'key is required'};
+    }
+
+    const data = await this.load();
+    const entry = data.entries[key];
+
+    if (!entry) {
+      return {type: 'error', summary: `scratchpad.get: key "${key}" not found`, errorMessage: 'key does not exist'};
+    }
+
+    const now = Date.now();
+    if (this.isExpired(entry, now)) {
+      delete data.entries[key];
+      await this.save();
+      return {type: 'error', summary: `scratchpad.get: key "${key}" expired`, errorMessage: 'TTL expired'};
+    }
+
+    // Update last_access for LRU
+    entry.last_access = now;
+    await this.save();
+
+    const storedAt = new Date(entry.stored_at).toISOString();
+    let ttlStatus = 'none';
+    if (entry.ttl_minutes) {
+      const remaining = entry.stored_at + entry.ttl_minutes * 60 * 1000 - now;
+      const remainingMin = Math.max(0, Math.round(remaining / 60000));
+      ttlStatus = `${remainingMin}min remaining`;
+    }
+
+    const valueStr = typeof entry.value === 'string' ? entry.value : JSON.stringify(entry.value);
+
+    return {
+      type: 'text',
+      summary:
+        `[scratchpad.get OK] key="${key}"\n` +
+        `stored_at=${storedAt}\n` +
+        `ttl=${ttlStatus}\n` +
+        `value=${valueStr}`,
+    };
+  }
+
+  private async doDelete(args: Record<string, any>): Promise<TalentResult> {
+    const key = typeof args.key === 'string' ? args.key : '';
+    if (!key) {
+      return {type: 'error', summary: 'scratchpad.delete: "key" is required', errorMessage: 'key is required'};
+    }
+
+    const data = await this.load();
+    if (!data.entries[key]) {
+      return {type: 'error', summary: `scratchpad.delete: key "${key}" not found`, errorMessage: 'key does not exist'};
+    }
+
+    delete data.entries[key];
+    await this.save();
+
+    return {
+      type: 'text',
+      summary: `[scratchpad.delete OK] key="${key}" removed\ntotal_keys=${Object.keys(data.entries).length}`,
+    };
+  }
+
+  private async doList(): Promise<TalentResult> {
+    const data = await this.load();
+    const now = Date.now();
+    const keys = Object.keys(data.entries);
+
+    if (keys.length === 0) {
+      return {type: 'text', summary: '[scratchpad.list] empty (0 keys)'};
+    }
+
+    const lines = keys.map(k => {
+      const e = data.entries[k];
+      const expired = this.isExpired(e, now);
+      const size = JSON.stringify(e.value).length;
+      const storedAt = new Date(e.stored_at).toISOString();
+      const ttl = e.ttl_minutes ? ` ttl=${e.ttl_minutes}min` : '';
+      const status = expired ? ' [EXPIRED]' : '';
+      return `  ${k}: size=${size}B stored_at=${storedAt}${ttl}${status}`;
+    });
+
+    return {
+      type: 'text',
+      summary: `[scratchpad.list] ${keys.length} key(s):\n${lines.join('\n')}`,
+    };
+  }
+
+  private async doClear(): Promise<TalentResult> {
+    const data = await this.load();
+    const count = Object.keys(data.entries).length;
+    data.entries = {};
+    await this.save();
+
+    return {
+      type: 'text',
+      summary: `[scratchpad.clear OK] removed ${count} key(s)`,
+    };
+  }
+
+  private async doCompute(args: Record<string, any>): Promise<TalentResult> {
+    const key = typeof args.key === 'string' ? args.key : '';
+    const expression = typeof args.expression === 'string' ? args.expression : '';
+
+    if (!key) {
+      return {type: 'error', summary: 'scratchpad.compute: "key" is required', errorMessage: 'key is required'};
+    }
+    if (!expression) {
+      return {type: 'error', summary: 'scratchpad.compute: "expression" is required', errorMessage: 'expression is required'};
+    }
+
+    const data = await this.load();
+    const now = Date.now();
+
+    // Resolve references
+    const resolve = (name: string): number => {
+      const entry = data.entries[name];
+      if (!entry) {
+        throw new Error(`reference @${name} not found in scratchpad`);
+      }
+      if (this.isExpired(entry, now)) {
+        throw new Error(`reference @${name} has expired`);
+      }
+      const val = typeof entry.value === 'number' ? entry.value : parseFloat(String(entry.value));
+      if (!Number.isFinite(val)) {
+        throw new Error(`reference @${name} is not a number (got ${JSON.stringify(entry.value)})`);
+      }
+      // Update last_access
+      entry.last_access = now;
+      return val;
+    };
+
+    let result: number;
+    try {
+      result = safeEval(expression, resolve);
+    } catch (e) {
+      const msg = e instanceof Error ? e.message : String(e);
+      return {type: 'error', summary: `scratchpad.compute: expression error — ${msg}`, errorMessage: msg};
+    }
+
+    // Store the result
+    data.entries[key] = {
+      value: result,
+      stored_at: now,
+      last_access: now,
+    };
+
+    await this.evictLRU(data);
+    await this.save();
+
+    return {
+      type: 'text',
+      summary:
+        `[scratchpad.compute OK] key="${key}"\n` +
+        `expression="${expression}"\n` +
+        `result=${result}\n` +
+        `stored_at=${new Date(now).toISOString()}`,
+    };
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: 'scratchpad',
+        description:
+          'Persistent key-value store for tool chaining within and between sessions. ' +
+          'Store intermediate results from finance/csv/memo tools and reference them by key. ' +
+          'Operations: "set" (store a value with optional TTL), "get" (retrieve with stored_at and TTL status), ' +
+          '"delete" (remove a key), "list" (show all keys with sizes and timestamps), ' +
+          '"clear" (remove all keys), "compute" (evaluate a safe arithmetic expression using stored values ' +
+          'via @key references, then store the result). ' +
+          'The compute expression supports + - * / % ^ parentheses and @key references. ' +
+          'Max 200 keys with LRU eviction. Max 100KB per value.',
+        parameters: {
+          type: 'object',
+          properties: {
+            operation: {
+              type: 'string',
+              enum: [...OPERATIONS],
+              description: 'Which scratchpad operation to perform.',
+            },
+            key: {
+              type: 'string',
+              description: 'The key to set/get/delete/compute.',
+            },
+            value: {
+              description: 'Value to store (string, number, or JSON-serializable object).',
+            },
+            ttl_minutes: {
+              type: 'number',
+              description: 'Time-to-live in minutes. After expiry, the key is auto-deleted on access.',
+            },
+            expression: {
+              type: 'string',
+              description:
+                'Arithmetic expression for "compute". Use @key to reference stored values. ' +
+                'Example: "@principal * @rate" or "(@a + @b) / 2". Supports + - * / % ^ and parentheses.',
+            },
+          },
+          required: ['operation'],
+        },
+      },
+    };
+  }
+
+  systemPromptFragment(_ctx: SystemPromptContext): string {
+    return [
+      'SCRATCHPAD TOOL POLICY:',
+      '- When chaining tools (e.g. finance -> memo -> pdf), store intermediate results in the scratchpad and reference them by key.',
+      '- Use scratchpad "set" to store computed values, then "get" or "@key" references in "compute" to build derived values.',
+      '- This avoids re-typing numbers and keeps the chain auditable.',
+      '- Example: store @principal=100000, @rate=0.12, then compute @interest=@principal*@rate.',
+      '- The compute expression is safe arithmetic only (+ - * / % ^ parentheses @refs). No eval, no function calls.',
+      '- Values persist across tool calls and sessions (via AsyncStorage).',
+      '- Max 200 keys with LRU eviction. Max 100KB per value. Optional TTL for auto-expiry.',
+    ].join('\n');
+  }
+}
diff --git a/src/services/talents/TravelBudgetEngine.ts b/src/services/talents/TravelBudgetEngine.ts
