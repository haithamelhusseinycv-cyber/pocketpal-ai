+ * Charts talent — pure SVG chart generation.
+ *
+ * Builds SVG strings from data series with no dependencies. Supports line, bar,
+ * pie, scatter, and area charts with auto axis scaling, gridlines, legends,
+ * value labels, and highlight markers.
+ *
+ * Output is TalentResult type:'html' (like RenderHtmlEngine) with the raw SVG
+ * also echoed in a text field for auditability.
+ *
+ * All operations echo inputs and truncate large outputs.
+ */
+
+const MAX_OUTPUT = 50_000;
+
+function truncate(s: string): string {
+  if (s.length <= MAX_OUTPUT) return s;
+  return s.slice(0, MAX_OUTPUT) + `\n… [truncated, ${s.length - MAX_OUTPUT} chars omitted]`;
+}
+
+function err(summary: string, errorMessage: string): TalentResult {
+  return {type: 'error', summary, errorMessage};
+}
+
+// ============== Formatting Helpers ==============
+
+function formatNumber(n: number): string {
+  if (!Number.isFinite(n)) return String(n);
+  // Thousands separators
+  const parts = n.toString().split('.');
+  parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return parts.join('.');
+}
+
+function escapeXml(s: string): string {
+  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
+}
+
+// ============== Nice Tick Values (1/2/5 steps) ==============
+
+function niceNum(range: number, round: boolean): number {
+  const exponent = Math.floor(Math.log10(range));
+  const fraction = range / Math.pow(10, exponent);
+  let niceFraction: number;
+
+  if (round) {
+    if (fraction < 1.5) niceFraction = 1;
+    else if (fraction < 3) niceFraction = 2;
+    else if (fraction < 7) niceFraction = 5;
+    else niceFraction = 10;
+  } else {
+    if (fraction <= 1) niceFraction = 1;
+    else if (fraction <= 2) niceFraction = 2;
+    else if (fraction <= 5) niceFraction = 5;
+    else niceFraction = 10;
+  }
+
+  return niceFraction * Math.pow(10, exponent);
+}
+
+function computeNiceTicks(min: number, max: number, targetTicks: number = 5): {min: number, max: number, step: number, ticks: number[]} {
+  if (min === max) {
+    min = min - 1;
+    max = max + 1;
+  }
+  const range = niceNum(max - min, false);
+  const step = niceNum(range / (targetTicks - 1), true);
+  const niceMin = Math.floor(min / step) * step;
+  const niceMax = Math.ceil(max / step) * step;
+
+  const ticks: number[] = [];
+  for (let v = niceMin; v <= niceMax + step * 0.5; v += step) {
+    ticks.push(parseFloat(v.toFixed(10)));
+  }
+
+  return {min: niceMin, max: niceMax, step, ticks};
+}
+
+// ============== Color Palette ==============
+
+const DEFAULT_COLORS = [
+  '#4e79a7', '#f28e2b', '#e15759', '#76b7b2', '#59a14f',
+  '#edc948', '#b07aa1', '#ff9da7', '#9c755f', '#bab0ac',
+];
+
+function getColor(colors: string[] | undefined, index: number): string {
+  if (colors && colors[index]) return colors[index];
+  return DEFAULT_COLORS[index % DEFAULT_COLORS.length];
+}
+
+// ============== Chart Types ==============
+
+interface Point {
+  x: number | string;
+  y: number;
+}
+
+interface Series {
+  name: string;
+  points?: Point[];
+  labels?: string[];
+  values?: number[];
+}
+
+interface ChartInput {
+  type: 'line' | 'bar' | 'pie' | 'scatter' | 'area';
+  series: Series[];
+  title?: string;
+  x_label?: string;
+  y_label?: string;
+  width?: number;
+  height?: number;
+  colors?: string[];
+  highlight?: {index: number; color: string; label: string};
+}
+
+function buildSvg(input: ChartInput): string {
+  const {type, series, title, x_label, y_label, colors, highlight} = input;
+  const width = input.width || 800;
+  const height = input.height || 500;
+
+  const margin = {top: 40, right: 120, bottom: 60, left: 80};
+  const plotWidth = width - margin.left - margin.right;
+  const plotHeight = height - margin.top - margin.bottom;
+
+  let svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}" viewBox="0 0 ${width} ${height}">`;
+  svg += `<style>text{font-family:sans-serif;font-size:12px;}</style>`;
+
+  // Background
+  svg += `<rect width="${width}" height="${height}" fill="white"/>`;
+
+  // Title
+  if (title) {
+    svg += `<text x="${width / 2}" y="20" text-anchor="middle" font-size="16" font-weight="bold">${escapeXml(title)}</text>`;
+  }
+
+  // Compute data bounds
+  let allX: (number | string)[] = [];
+  let allY: number[] = [];
+
+  for (const s of series) {
+    if (s.points) {
+      allX = allX.concat(s.points.map(p => p.x));
+      allY = allY.concat(s.points.map(p => p.y));
+    } else if (s.labels && s.values) {
+      allX = allX.concat(s.labels);
+      allY = allY.concat(s.values);
+    }
+  }
+
+  if (allY.length === 0) {
+    svg += `<text x="${width / 2}" y="${height / 2}" text-anchor="middle">No data</text></svg>`;
+    return svg;
+  }
+
+  const yMin = Math.min(...allY);
+  const yMax = Math.max(...allY);
+  const yTicks = computeNiceTicks(yMin, yMax, 5);
+
+  // Determine if x-axis is numeric or categorical
+  const isNumericX = allX.every(x => typeof x === 'number');
+  let xMin = 0, xMax = 0, xTicks = {min: 0, max: 0, step: 0, ticks: [] as number[]};
+  if (isNumericX) {
+    const numericX = allX as number[];
+    xMin = Math.min(...numericX);
+    xMax = Math.max(...numericX);
+    xTicks = computeNiceTicks(xMin, xMax, 5);
+  }
+
+  // Scale functions
+  const scaleX = (x: number | string): number => {
+    if (isNumericX) {
+      return margin.left + ((x as number - xTicks.min) / (xTicks.max - xTicks.min)) * plotWidth;
+    } else {
+      // Categorical: find index
+      const uniqueX = Array.from(new Set(allX));
+      const idx = uniqueX.indexOf(x);
+      const step = plotWidth / (uniqueX.length + 1);
+      return margin.left + step * (idx + 1);
+    }
+  };
+
+  const scaleY = (y: number): number => {
+    return margin.top + plotHeight - ((y - yTicks.min) / (yTicks.max - yTicks.min)) * plotHeight;
+  };
+
+  // Gridlines
+  svg += `<g stroke="#e0e0e0" stroke-width="1">`;
+  for (const tick of yTicks.ticks) {
+    const y = scaleY(tick);
+    svg += `<line x1="${margin.left}" y1="${y}" x2="${width - margin.right}" y2="${y}"/>`;
+  }
+  if (isNumericX) {
+    for (const tick of xTicks.ticks) {
+      const x = scaleX(tick);
+      svg += `<line x1="${x}" y1="${margin.top}" x2="${x}" y2="${height - margin.bottom}"/>`;
+    }
+  }
+  svg += `</g>`;
+
+  // Axes
+  svg += `<g stroke="#333" stroke-width="2">`;
+  svg += `<line x1="${margin.left}" y1="${margin.top}" x2="${margin.left}" y2="${height - margin.bottom}"/>`;
+  svg += `<line x1="${margin.left}" y1="${height - margin.bottom}" x2="${width - margin.right}" y2="${height - margin.bottom}"/>`;
+  svg += `</g>`;
+
+  // Y-axis ticks and labels
+  svg += `<g fill="#333">`;
+  for (const tick of yTicks.ticks) {
+    const y = scaleY(tick);
+    svg += `<line x1="${margin.left - 5}" y1="${y}" x2="${margin.left}" y2="${y}" stroke="#333" stroke-width="1"/>`;
+    svg += `<text x="${margin.left - 10}" y="${y + 4}" text-anchor="end">${formatNumber(tick)}</text>`;
+  }
+  svg += `</g>`;
+
+  // X-axis ticks and labels
+  svg += `<g fill="#333">`;
+  if (isNumericX) {
+    for (const tick of xTicks.ticks) {
+      const x = scaleX(tick);
+      svg += `<line x1="${x}" y1="${height - margin.bottom}" x2="${x}" y2="${height - margin.bottom + 5}" stroke="#333" stroke-width="1"/>`;
+      svg += `<text x="${x}" y="${height - margin.bottom + 20}" text-anchor="middle">${formatNumber(tick)}</text>`;
+    }
+  } else {
+    const uniqueX = Array.from(new Set(allX));
+    for (const x of uniqueX) {
+      const px = scaleX(x);
+      svg += `<line x1="${px}" y1="${height - margin.bottom}" x2="${px}" y2="${height - margin.bottom + 5}" stroke="#333" stroke-width="1"/>`;
+      svg += `<text x="${px}" y="${height - margin.bottom + 20}" text-anchor="middle">${escapeXml(String(x))}</text>`;
+    }
+  }
+  svg += `</g>`;
+
+  // Axis labels
+  if (x_label) {
+    svg += `<text x="${margin.left + plotWidth / 2}" y="${height - 10}" text-anchor="middle" font-size="14">${escapeXml(x_label)}</text>`;
+  }
+  if (y_label) {
+    svg += `<text x="15" y="${margin.top + plotHeight / 2}" text-anchor="middle" font-size="14" transform="rotate(-90, 15, ${margin.top + plotHeight / 2})">${escapeXml(y_label)}</text>`;
+  }
+
+  // Draw chart based on type
+  if (type === 'line' || type === 'area') {
+    for (let si = 0; si < series.length; si++) {
+      const s = series[si];
+      const color = getColor(colors, si);
+      const points = s.points || (s.labels && s.values ? s.labels.map((l, i) => ({x: l, y: s.values![i]})) : []);
+
+      if (points.length === 0) continue;
+
+      if (type === 'area') {
+        let path = `M ${scaleX(points[0].x)} ${scaleY(points[0].y)}`;
+        for (let i = 1; i < points.length; i++) {
+          path += ` L ${scaleX(points[i].x)} ${scaleY(points[i].y)}`;
+        }
+        path += ` L ${scaleX(points[points.length - 1].x)} ${height - margin.bottom}`;
+        path += ` L ${scaleX(points[0].x)} ${height - margin.bottom} Z`;
+        svg += `<path d="${path}" fill="${color}" opacity="0.3"/>`;
+      }
+
+      // Line
+      let path = `M ${scaleX(points[0].x)} ${scaleY(points[0].y)}`;
+      for (let i = 1; i < points.length; i++) {
+        path += ` L ${scaleX(points[i].x)} ${scaleY(points[i].y)}`;
+      }
+      svg += `<path d="${path}" fill="none" stroke="${color}" stroke-width="2"/>`;
+
+      // Points
+      for (const p of points) {
+        svg += `<circle cx="${scaleX(p.x)}" cy="${scaleY(p.y)}" r="3" fill="${color}"/>`;
+      }
+    }
+  } else if (type === 'bar') {
+    const uniqueX = Array.from(new Set(allX));
+    const barWidth = plotWidth / (uniqueX.length * (series.length + 1));
+    const groupWidth = barWidth * series.length;
+
+    for (let si = 0; si < series.length; si++) {
+      const s = series[si];
+      const color = getColor(colors, si);
+      const points = s.points || (s.labels && s.values ? s.labels.map((l, i) => ({x: l, y: s.values![i]})) : []);
+
+      for (const p of points) {
+        const xIdx = uniqueX.indexOf(p.x);
+        const baseX = scaleX(p.x) - groupWidth / 2 + si * barWidth;
+        const barHeight = scaleY(yTicks.min) - scaleY(p.y);
+        svg += `<rect x="${baseX}" y="${scaleY(p.y)}" width="${barWidth}" height="${barHeight}" fill="${color}"/>`;
+      }
+    }
+  } else if (type === 'scatter') {
+    for (let si = 0; si < series.length; si++) {
+      const s = series[si];
+      const color = getColor(colors, si);
+      const points = s.points || [];
+
+      for (const p of points) {
+        svg += `<circle cx="${scaleX(p.x)}" cy="${scaleY(p.y)}" r="5" fill="${color}"/>`;
+      }
+    }
+  } else if (type === 'pie') {
+    // Pie chart: use first series
+    const s = series[0];
+    if (!s) {
+      svg += `</svg>`;
+      return svg;
+    }
+
+    const values = s.values || (s.points ? s.points.map(p => p.y) : []);
+    const labels = s.labels || (s.points ? s.points.map(p => String(p.x)) : []);
+    const total = values.reduce((a, b) => a + b, 0);
+
+    if (total === 0) {
+      svg += `<text x="${width / 2}" y="${height / 2}" text-anchor="middle">No data</text></svg>`;
+      return svg;
+    }
+
+    const cx = width / 2;
+    const cy = height / 2;
+    const radius = Math.min(plotWidth, plotHeight) / 2 - 20;
+
+    let startAngle = -Math.PI / 2;
+    for (let i = 0; i < values.length; i++) {
+      const angle = (values[i] / total) * 2 * Math.PI;
+      const endAngle = startAngle + angle;
+
+      const x1 = cx + radius * Math.cos(startAngle);
+      const y1 = cy + radius * Math.sin(startAngle);
+      const x2 = cx + radius * Math.cos(endAngle);
+      const y2 = cy + radius * Math.sin(endAngle);
+
+      const largeArc = angle > Math.PI ? 1 : 0;
+      const color = getColor(colors, i);
+
+      svg += `<path d="M ${cx} ${cy} L ${x1} ${y1} A ${radius} ${radius} 0 ${largeArc} 1 ${x2} ${y2} Z" fill="${color}"/>`;
+
+      // Label
+      const midAngle = startAngle + angle / 2;
+      const labelRadius = radius * 0.7;
+      const lx = cx + labelRadius * Math.cos(midAngle);
+      const ly = cy + labelRadius * Math.sin(midAngle);
+      const pct = ((values[i] / total) * 100).toFixed(1);
+      svg += `<text x="${lx}" y="${ly}" text-anchor="middle" fill="white" font-size="11">${escapeXml(labels[i] || '')} (${pct}%)</text>`;
+
+      startAngle = endAngle;
+    }
+  }
+
+  // Highlight marker
+  if (highlight && (type === 'line' || type === 'area' || type === 'scatter')) {
+    const s = series[0];
+    if (s) {
+      const points = s.points || (s.labels && s.values ? s.labels.map((l, i) => ({x: l, y: s.values![i]})) : []);
+      if (highlight.index < points.length) {
+        const p = points[highlight.index];
+        const px = scaleX(p.x);
+        const py = scaleY(p.y);
+        svg += `<circle cx="${px}" cy="${py}" r="8" fill="${highlight.color}" stroke="white" stroke-width="2"/>`;
+        svg += `<text x="${px}" y="${py - 15}" text-anchor="middle" font-size="11" font-weight="bold">${escapeXml(highlight.label)}</text>`;
+      }
+    }
+  } else if (highlight && type === 'bar') {
+    const uniqueX = Array.from(new Set(allX));
+    if (highlight.index < uniqueX.length) {
+      const x = uniqueX[highlight.index];
+      const px = scaleX(x);
+      svg += `<text x="${px}" y="${margin.top - 5}" text-anchor="middle" font-size="11" font-weight="bold" fill="${highlight.color}">${escapeXml(highlight.label)}</text>`;
+    }
+  }
+
+  // Legend
+  if (series.length > 1 || type === 'pie') {
+    const legendX = width - margin.right + 10;
+    let legendY = margin.top + 10;
+
+    const legendSeries = type === 'pie' && series[0]
+      ? (series[0].labels || []).map((l, i) => ({name: l}))
+      : series;
+
+    for (let i = 0; i < legendSeries.length; i++) {
+      const color = getColor(colors, i);
+      svg += `<rect x="${legendX}" y="${legendY - 10}" width="12" height="12" fill="${color}"/>`;
+      svg += `<text x="${legendX + 18}" y="${legendY}">${escapeXml(legendSeries[i].name)}</text>`;
+      legendY += 20;
+    }
+  }
+
+  svg += `</svg>`;
+  return svg;
+}
+
+// ============== ChartsEngine ==============
+
+type ChartType = 'line' | 'bar' | 'pie' | 'scatter' | 'area';
+const CHART_TYPES: ChartType[] = ['line', 'bar', 'pie', 'scatter', 'area'];
+
+export class ChartsEngine implements TalentEngine {
+  readonly name = 'charts';
+  readonly recommendedContextTokens = 4096;
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const type = typeof args.type === 'string' ? args.type.toLowerCase() : '';
+
+    if (!CHART_TYPES.includes(type as ChartType)) {
+      return err(
+        `charts: unknown chart type "${type || '(missing)'}"`,
+        `type must be one of: ${CHART_TYPES.join(', ')}`,
+      );
+    }
+
+    const series = args.series;
+    if (!Array.isArray(series) || series.length === 0) {
+      return err('charts: "series" must be a non-empty array', 'series is required');
+    }
+
+    try {
+      const input: ChartInput = {
+        type: type as ChartType,
+        series,
+        title: args.title,
+        x_label: args.x_label,
+        y_label: args.y_label,
+        width: args.width,
+        height: args.height,
+        colors: args.colors,
+        highlight: args.highlight,
+      };
+
+      const svg = buildSvg(input);
+
+      const summary =
+        `Generated ${type} chart\n` +
+        `Series: ${series.length}\n` +
+        `Size: ${input.width || 800}x${input.height || 500}\n` +
+        `SVG length: ${svg.length} chars\n` +
+        `Inputs: ${series.length} series as specified`;
+
+      return {
+        type: 'html',
+        html: svg,
+        title: args.title || `${type} chart`,
+        summary: truncate(summary + `\n\nSVG:\n${svg.slice(0, 2000)}${svg.length > 2000 ? '...' : ''}`),
+      };
+    } catch (e) {
+      const msg = e instanceof Error ? e.message : String(e);
+      return err(`charts: ${type} failed — ${msg}`, msg);
+    }
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: 'charts',
+        description:
+          'Generate SVG charts from data. Supports line, bar, pie, scatter, and area charts with auto axis scaling, gridlines, legends, and highlight markers. Returns SVG as HTML for preview. Use this for ALL visualizations instead of ASCII charts. Pure TypeScript with zero dependencies.',
+        parameters: {
+          type: 'object',
+          properties: {
+            type: {
+              type: 'string',
+              enum: [...CHART_TYPES],
+              description: 'Chart type.',
+            },
+            series: {
+              type: 'array',
+              items: {
+                type: 'object',
+                properties: {
+                  name: {type: 'string'},
+                  points: {type: 'array', items: {type: 'object'}},
+                  labels: {type: 'array', items: {type: 'string'}},
+                  values: {type: 'array', items: {type: 'number'}},
+                },
+              },
+              description: 'Data series. Each has name and either points [{x,y}] or {labels, values}.',
+            },
+            title: {type: 'string', description: 'Chart title.'},
+            x_label: {type: 'string', description: 'X-axis label.'},
+            y_label: {type: 'string', description: 'Y-axis label.'},
+            width: {type: 'number', description: 'SVG width (default 800).'},
+            height: {type: 'number', description: 'SVG height (default 500).'},
+            colors: {type: 'array', items: {type: 'string'}, description: 'Custom colors for series.'},
+            highlight: {
+              type: 'object',
+              properties: {
+                index: {type: 'number'},
+                color: {type: 'string'},
+                label: {type: 'string'},
+              },
+              description: 'Highlight a specific point/bar with marker and label.',
+            },
+          },
+          required: ['type', 'series'],
+        },
+      },
+    };
+  }
+
+  systemPromptFragment(): string {
+    return [
+      'CHARTS / VISUALIZATION TOOL POLICY:',
+      '- For ANY cash-flow, ratio, trend, or data visualization, use the charts talent instead of ASCII charts.',
+      '- The charts tool generates SVG with auto axis scaling, gridlines, legends, and highlight markers.',
+      '- Supports line, bar, pie, scatter, and area charts.',
+      '- Returns SVG as HTML for preview. The raw SVG is also in the summary for auditability.',
+      '- Use highlight to mark peak deficit, breakeven point, or other key values.',
+      '- All operations are pure TypeScript with zero dependencies.',
+      '- Echo inputs when reporting results for auditability.',
+    ].join('\n');
+  }
+}
