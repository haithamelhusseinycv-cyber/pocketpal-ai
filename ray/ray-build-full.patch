+    expect(result.type).toBe('error');
+    if (result.type === 'error') {
+      expect(result.summary).toContain('EXIF');
+    }
+  });
+
+  test('summary operation rejects empty arrays', async () => {
+    const result = await engine.execute({operation: 'summary'});
+    expect(result.type).toBe('error');
+  });
+
+  test('gps_track operation rejects empty arrays', async () => {
+    const result = await engine.execute({operation: 'gps_track'});
+    expect(result.type).toBe('error');
+  });
+});
