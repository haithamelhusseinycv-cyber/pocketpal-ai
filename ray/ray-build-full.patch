+import {LogcatEngine} from '../LogcatEngine';
+
+// ── Fixture ──────────────────────────────────────────────────────────────────
+
+/**
+ * A realistic logcat fixture containing:
+ * - Normal threadtime lines across all levels (V, D, I, W, E, F)
+ * - A "FATAL EXCEPTION: main" AndroidRuntime crash block with stack frames
+ * - An "ANR in com.example.app" line with Reason/Load context
+ * - A repeated message (same tag+message appearing 3 times) for dedupe
+ * - A brief-format line
+ * - 2 malformed lines (unparsed)
+ * - A Java exception block (non-fatal)
+ */
+const FIXTURE = [
+  // --- Normal threadtime lines ---
+  '09-21 10:00:00.100  1000  1000 V VerboseTag: starting up',
+  '09-21 10:00:00.200  1000  1000 D DebugTag: init complete',
+  '09-21 10:00:00.300  1000  1000 I ActivityManager: Start proc com.example.app',
+  '09-21 10:00:00.400  1000  1000 W ResourceType: No known package when getting value',
+  '09-21 10:00:00.500  1000  1000 E ReactNativeJS: Unexpected value for key "foo"',
+  '09-21 10:00:00.600  1000  1000 I ActivityManager: Displayed com.example.app/.MainActivity',
+  // --- Repeated message (3 times) ---
+  '09-21 10:00:01.000  1000  1000 D Choreographer: doFrame callback',
+  '09-21 10:00:02.000  1000  1000 D Choreographer: doFrame callback',
+  '09-21 10:00:03.000  1000  1000 D Choreographer: doFrame callback',
+  // --- Brief format ---
+  'I/ReactNativeJS( 1000): Running application',
+  // --- Malformed lines ---
+  '--- beginning of system',
+  'THIS IS NOT A VALID LOG LINE',
+  // --- Non-fatal Java exception block ---
+  'java.lang.NullPointerException: Attempt to invoke virtual method on null',
+  '\tat com.example.app.MyClass.doStuff(MyClass.java:42)',
+  '\tat com.example.app.MyClass.onCreate(MyClass.java:10)',
+  '\t... 12 more',
+  // --- FATAL EXCEPTION crash block ---
+  '09-21 10:00:05.000  1000  1000 E AndroidRuntime: FATAL EXCEPTION: main',
+  '09-21 10:00:05.000  1000  1000 E AndroidRuntime: Process: com.example.app, PID: 1000',
+  'java.lang.RuntimeException: Unable to start activity',
+  '\tat android.app.ActivityThread.performLaunchActivity(ActivityThread.java:3000)',
+  '\tat android.app.ActivityThread.handleLaunchActivity(ActivityThread.java:3100)',
+  'Caused by: java.lang.IllegalStateException: broken',
+  '\tat com.example.app.MainActivity.onCreate(MainActivity.java:25)',
+  '',
+  // --- ANR ---
+  '09-21 10:00:10.000  1000  1000 I ActivityManager: ANR in com.example.app',
+  'Reason: Input dispatching timed out',
+  'Load: 1.5 / 2.0 / 1.8',
+  // --- More normal lines ---
+  '09-21 10:00:15.000  1000  1000 F SystemServer: Watchdog killed process',
+  '09-21 10:00:20.000  1000  1000 I ActivityManager: Process died',
+].join('\n');
+
+// ── Tests ────────────────────────────────────────────────────────────────────
+
+describe('LogcatEngine', () => {
+  const engine = new LogcatEngine();
+
+  it('exposes name "logcat"', () => {
+    expect(engine.name).toBe('logcat');
+  });
+
+  // --- Error handling ---
+
+  it('returns error for missing log', async () => {
+    const result = await engine.execute({});
+    expect(result.type).toBe('error');
+    if (result.type === 'error') {
+      expect(result.errorMessage).toMatch(/log argument is required/);
+    }
+  });
+
+  it('returns error for empty log', async () => {
+    const result = await engine.execute({log: ''});
+    expect(result.type).toBe('error');
+  });
+
+  it('returns error for unknown operation', async () => {
+    const result = await engine.execute({log: 'some log', operation: 'bogus'});
+    expect(result.type).toBe('error');
+    if (result.type === 'error') {
+      expect(result.summary).toMatch(/unknown operation/);
+    }
+  });
+
+  // --- Summary ---
+
+  describe('summary', () => {
+    it('counts levels correctly', async () => {
+      const result = await engine.execute({log: FIXTURE, operation: 'summary'});
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        // Hand-counted from fixture (threadtime + brief parseable lines):
+        // V:1  D:4(3 Choreographer + 1 DebugTag)  I:5(3 ActivityManager + 1 brief ReactNativeJS + 1 ANR ActivityManager + 1 Process died)
+        // W:1  E:3(1 ReactNativeJS + 2 AndroidRuntime)  F:1
+        expect(result.summary).toContain('V: 1');
+        expect(result.summary).toContain('D: 4');
+        expect(result.summary).toContain('I: 5');
+        expect(result.summary).toContain('W: 1');
+        expect(result.summary).toContain('E: 3');
+        expect(result.summary).toContain('F: 1');
+      }
+    });
+
+    it('counts unparsed lines', async () => {
+      const result = await engine.execute({log: FIXTURE, operation: 'summary'});
+      if (result.type === 'text') {
+        // 2 malformed lines + exception/stack/ANR-context lines that don't match threadtime/brief
+        // The fixture has lines that are exception blocks, ANR context, etc.
+        // which won't parse as threadtime/brief — those count as unparsed.
+        expect(result.summary).toMatch(/unparsed: \d+/);
+        // At least the 2 clearly malformed lines
+        const match = result.summary.match(/unparsed: (\d+)/);
+        expect(match).toBeTruthy();
+        expect(parseInt(match![1])).toBeGreaterThanOrEqual(2);
+      }
+    });
+
+    it('reports time span', async () => {
+      const result = await engine.execute({log: FIXTURE, operation: 'summary'});
+      if (result.type === 'text') {
+        expect(result.summary).toContain('10:00:00.100');
+        expect(result.summary).toContain('10:00:20.000');
+      }
+    });
+
+    it('lists top tags', async () => {
+      const result = await engine.execute({log: FIXTURE, operation: 'summary'});
+      if (result.type === 'text') {
+        expect(result.summary).toContain('Choreographer');
+        expect(result.summary).toContain('ActivityManager');
+      }
+    });
+  });
+
+  // --- Errors ---
+
+  describe('errors', () => {
+    it('captures E/F lines and exception blocks', async () => {
+      const result = await engine.execute({log: FIXTURE, operation: 'errors'});
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        // Should contain E-level lines
+        expect(result.summary).toContain('[E]');
+        // Should contain F-level lines
+        expect(result.summary).toContain('[F]');
+        // Should contain the NullPointerException block
+        expect(result.summary).toContain('NullPointerException');
+        expect(result.summary).toContain('MyClass.java:42');
+        // Should contain the FATAL EXCEPTION block
+        expect(result.summary).toContain('FATAL EXCEPTION');
+        expect(result.summary).toContain('RuntimeException');
+      }
+    });
+
+    it('reports total counts', async () => {
+      const result = await engine.execute({log: FIXTURE, operation: 'errors'});
+      if (result.type === 'text') {
+        expect(result.summary).toMatch(/Total: \d+ error\/exception items/);
+      }
+    });
+  });
+
+  // --- Crash ---
+
+  describe('crash', () => {
+    it('finds the FATAL EXCEPTION block with stack', async () => {
+      const result = await engine.execute({log: FIXTURE, operation: 'crash'});
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        expect(result.summary).toContain('FATAL EXCEPTION: main');
+        expect(result.summary).toContain('RuntimeException');
+        expect(result.summary).toContain('ActivityThread.java:3000');
+        expect(result.summary).toContain('ActivityThread.java:3100');
+        expect(result.summary).toContain('Caused by:');
+        expect(result.summary).toContain('IllegalStateException');
+        expect(result.summary).toContain('MainActivity.java:25');
+        expect(result.summary).toMatch(/Stack frames: \d+/);
+      }
+    });
+
+    it('reports no crash when none present', async () => {
+      const cleanLog = '09-21 10:00:00.100  1000  1000 I Tag: all good\n';
+      const result = await engine.execute({log: cleanLog, operation: 'crash'});
+      if (result.type === 'text') {
+        expect(result.summary).toContain('No fatal exception');
+      }
+    });
+  });
+
+  // --- ANR ---
+
+  describe('anr', () => {
+    it('finds ANR events with context', async () => {
+      const result = await engine.execute({log: FIXTURE, operation: 'anr'});
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        expect(result.summary).toContain('ANR in com.example.app');
+        expect(result.summary).toContain('Reason: Input dispatching timed out');
+        expect(result.summary).toContain('Load:');
+        expect(result.summary).toContain('Found 1 ANR event(s)');
+      }
+    });
+
+    it('reports no ANR when none present', async () => {
+      const cleanLog = '09-21 10:00:00.100  1000  1000 I Tag: all good\n';
+      const result = await engine.execute({log: cleanLog, operation: 'anr'});
+      if (result.type === 'text') {
+        expect(result.summary).toContain('No ANR events');
+      }
+    });
+  });
+
+  // --- Filter ---
+
+  describe('filter', () => {
+    it('filters by tag (case-insensitive substring)', async () => {
+      const result = await engine.execute({
+        log: FIXTURE,
+        operation: 'filter',
