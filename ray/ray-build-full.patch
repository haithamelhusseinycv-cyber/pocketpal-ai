+++ b/src/services/talents/__tests__/CsvEngine.test.ts
@@ -0,0 +1,366 @@
+/**
+ * CsvEngine tests.
+ *
+ * Every expected value is hand-computed from the small fixture tables so the
+ * suite catches real regressions rather than pinning whatever the
+ * implementation currently returns. Arithmetic is shown in comments.
+ */
+import {CsvEngine, parseCsv, buildTable} from '../CsvEngine';
+import type {TalentResult} from '../types';
+
+const text = (r: TalentResult): string =>
+  r.type === 'text' || r.type === 'error' ? r.summary : '';
+
+// ---------------------------------------------------------------------------
+// CSV parser edge cases
+// ---------------------------------------------------------------------------
+
+describe('parseCsv — edge cases', () => {
+  it('handles a quoted field with an embedded comma', () => {
+    // "Smith, John" is one field, not two.
+    const rows = parseCsv('name,age\n"Smith, John",30\n');
+    expect(rows).toEqual([
+      ['name', 'age'],
+      ['Smith, John', '30'],
+    ]);
+  });
+
+  it('handles escaped "" quotes inside a quoted field', () => {
+    // He said ""hi"" → literal He said "hi"
+    const rows = parseCsv('msg\n"He said ""hi"""\n');
+    expect(rows).toEqual([['msg'], ['He said "hi"']]);
+  });
+
+  it('handles embedded newlines inside a quoted field', () => {
+    // The quoted field spans two physical lines.
+    const rows = parseCsv('a,b\n"line1\nline2",x\n');
+    expect(rows).toEqual([['a', 'b'], ['line1\nline2', 'x']]);
+  });
+
+  it('handles CRLF line endings', () => {
+    const rows = parseCsv('a,b\r\n1,2\r\n3,4\r\n');
+    expect(rows).toEqual([
+      ['a', 'b'],
+      ['1', '2'],
+      ['3', '4'],
+    ]);
+  });
+
+  it('handles bare CR line endings (old Mac)', () => {
+    const rows = parseCsv('a,b\r1,2\r3,4\r');
+    expect(rows).toEqual([
+      ['a', 'b'],
+      ['1', '2'],
+      ['3', '4'],
+    ]);
+  });
+
+  it('does not produce a phantom row for a trailing newline', () => {
+    const rows = parseCsv('a,b\n1,2\n');
+    expect(rows).toEqual([['a', 'b'], ['1', '2']]);
+  });
+
+  it('handles empty input', () => {
+    expect(parseCsv('')).toEqual([]);
+  });
+
+  it('handles a header-only input (no data rows)', () => {
+    expect(parseCsv('a,b,c')).toEqual([['a', 'b', 'c']]);
+  });
+
+  it('handles empty fields (consecutive commas)', () => {
+    const rows = parseCsv('a,b,c\n1,,3\n');
+    expect(rows).toEqual([
+      ['a', 'b', 'c'],
+      ['1', '', '3'],
+    ]);
+  });
+});
+
+// ---------------------------------------------------------------------------
+// buildTable — ragged row handling
+// ---------------------------------------------------------------------------
+
+describe('buildTable — ragged rows', () => {
+  it('pads short rows with empty strings and reports the count', () => {
+    const t = buildTable('a,b,c\n1,2\n3,4,5\n');
+    expect(t.headers).toEqual(['a', 'b', 'c']);
+    expect(t.rows[0]).toEqual(['1', '2', '']);
+    expect(t.rows[1]).toEqual(['3', '4', '5']);
+    expect(t.paddedRowCount).toBe(1);
+  });
+
+  it('truncates rows longer than the header', () => {
+    const t = buildTable('a,b\n1,2,3,4\n');
+    expect(t.rows[0]).toEqual(['1', '2']);
+  });
+});
+
+// ---------------------------------------------------------------------------
+// Operations — hand-computed against a small fixture
+// ---------------------------------------------------------------------------
+
+// Fixture (hand arithmetic shown in each test):
+//   region,product,revenue
+//   North,Alpha,100
+//   North,Beta,200
+//   South,Alpha,150
+//   South,Beta,250
+//   East,Alpha,300
+const CSV = [
+  'region,product,revenue',
+  'North,Alpha,100',
+  'North,Beta,200',
+  'South,Alpha,150',
+  'South,Beta,250',
+  'East,Alpha,300',
+].join('\n');
+
+describe('CsvEngine.execute — describe', () => {
+  const engine = new CsvEngine();
+
+  it('reports dimensions and per-column stats', async () => {
+    const r = await engine.execute({operation: 'describe', csv: CSV});
+    expect(r.type).toBe('text');
+    // 5 rows x 3 columns
+    expect(text(r)).toMatch(/5 rows x 3 columns/);
+    // revenue: 100+200+150+250+300 = 1000, mean = 200, min = 100, max = 300
+    expect(text(r)).toMatch(/sum=1000/);
+    expect(text(r)).toMatch(/mean=200/);
+    expect(text(r)).toMatch(/min=100/);
+    expect(text(r)).toMatch(/max=300/);
+  });
+
+  it('accepts "parse" as an alias for "describe"', async () => {
+    const r = await engine.execute({operation: 'parse', csv: CSV});
+    expect(r.type).toBe('text');
+    expect(text(r)).toMatch(/5 rows x 3 columns/);
+  });
+});
+
+describe('CsvEngine.execute — column', () => {
+  const engine = new CsvEngine();
+
+  it('extracts a numeric column as an array', async () => {
+    const r = await engine.execute({operation: 'column', csv: CSV, column: 'revenue'});
+    expect(r.type).toBe('text');
+    // revenue = [100, 200, 150, 250, 300]
+    expect(text(r)).toMatch(/\[100, 200, 150, 250, 300\]/);
+  });
+
+  it('errors on a non-numeric column', async () => {
+    const r = await engine.execute({operation: 'column', csv: CSV, column: 'region'});
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/not fully numeric/);
+  });
+
+  it('errors on a missing column', async () => {
+    const r = await engine.execute({operation: 'column', csv: CSV, column: 'profit'});
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/not found/);
+  });
+});
+
+describe('CsvEngine.execute — filter', () => {
+  const engine = new CsvEngine();
+
+  it('filters rows by numeric condition', async () => {
+    // revenue > 150 → North/Beta(200), South/Beta(250), East/Alpha(300) = 3 rows
+    const r = await engine.execute({
+      operation: 'filter',
+      csv: CSV,
+      column: 'revenue',
+      op: '>',
+      value: 150,
+    });
+    expect(r.type).toBe('text');
+    expect(text(r)).toMatch(/Matched 3 of 5 rows/);
+    expect(text(r)).toMatch(/Beta/);
+    expect(text(r)).toMatch(/300/);
+  });
+
+  it('filters rows by string equality', async () => {
+    // region = North → 2 rows
+    const r = await engine.execute({
+      operation: 'filter',
+      csv: CSV,
+      column: 'region',
+      op: '=',
+      value: 'North',
+    });
+    expect(r.type).toBe('text');
+    expect(text(r)).toMatch(/Matched 2 of 5 rows/);
+  });
+});
+
+describe('CsvEngine.execute — aggregate', () => {
+  const engine = new CsvEngine();
+
+  it('groups by region and sums revenue', async () => {
+    // East: 300, North: 100+200=300, South: 150+250=400
+    const r = await engine.execute({
+      operation: 'aggregate',
+      csv: CSV,
+      group_by: 'region',
+      column: 'revenue',
+      func: 'sum',
+    });
+    expect(r.type).toBe('text');
+    expect(text(r)).toMatch(/East: sum=300/);
+    expect(text(r)).toMatch(/North: sum=300/);
+    expect(text(r)).toMatch(/South: sum=400/);
+  });
+
+  it('groups by region and computes mean revenue', async () => {
+    // East: 300/1=300, North: 300/2=150, South: 400/2=200
+    const r = await engine.execute({
+      operation: 'aggregate',
+      csv: CSV,
+      group_by: 'region',
+      column: 'revenue',
+      func: 'mean',
+    });
+    expect(r.type).toBe('text');
+    expect(text(r)).toMatch(/East: mean=300/);
+    expect(text(r)).toMatch(/North: mean=150/);
+    expect(text(r)).toMatch(/South: mean=200/);
+  });
+
+  it('groups by product and counts', async () => {
+    // Alpha: 3, Beta: 2
+    const r = await engine.execute({
+      operation: 'aggregate',
+      csv: CSV,
+      group_by: 'product',
+      column: 'revenue',
+      func: 'count',
+    });
+    expect(r.type).toBe('text');
+    expect(text(r)).toMatch(/Alpha: count=3/);
+    expect(text(r)).toMatch(/Beta: count=2/);
+  });
+});
+
+describe('CsvEngine.execute — reductions', () => {
+  const engine = new CsvEngine();
+
+  it('computes sum of revenue: 100+200+150+250+300 = 1000', async () => {
+    const r = await engine.execute({operation: 'sum', csv: CSV, column: 'revenue'});
+    expect(text(r)).toMatch(/1000/);
+  });
+
+  it('computes mean of revenue: 1000/5 = 200', async () => {
+    const r = await engine.execute({operation: 'mean', csv: CSV, column: 'revenue'});
+    expect(text(r)).toMatch(/200/);
+  });
+
+  it('computes min of revenue: 100', async () => {
+    const r = await engine.execute({operation: 'min', csv: CSV, column: 'revenue'});
+    expect(text(r)).toMatch(/100/);
+  });
+
+  it('computes max of revenue: 300', async () => {
+    const r = await engine.execute({operation: 'max', csv: CSV, column: 'revenue'});
+    expect(text(r)).toMatch(/300/);
+  });
+
+  it('computes count of non-empty cells in region: 5', async () => {
+    const r = await engine.execute({operation: 'count', csv: CSV, column: 'region'});
+    expect(text(r)).toMatch(/5 of 5/);
+  });
+});
+
+// ---------------------------------------------------------------------------
+// Validation errors
+// ---------------------------------------------------------------------------
+
+describe('CsvEngine.execute — validation', () => {
+  const engine = new CsvEngine();
+
+  it('rejects an unknown operation', async () => {
+    const r = await engine.execute({operation: 'pivot', csv: CSV});
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/unknown operation/);
+  });
+
+  it('rejects missing csv text', async () => {
+    const r = await engine.execute({operation: 'describe'});
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/csv.*required/i);
+  });
+
+  it('rejects empty csv text', async () => {
+    const r = await engine.execute({operation: 'describe', csv: ''});
+    expect(r.type).toBe('error');
+  });
+
+  it('rejects sum on a missing column', async () => {
+    const r = await engine.execute({operation: 'sum', csv: CSV, column: 'profit'});
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/not found/);
+  });
+
+  it('rejects sum on a non-numeric column', async () => {
+    const r = await engine.execute({operation: 'sum', csv: CSV, column: 'region'});
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/not fully numeric/);
+  });
+
+  it('rejects filter with a bad op', async () => {
+    const r = await engine.execute({
+      operation: 'filter',
+      csv: CSV,
+      column: 'revenue',
+      op: 'like',
+      value: 100,
+    });
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/bad op/);
+  });
+
+  it('rejects aggregate with a bad func', async () => {
+    const r = await engine.execute({
+      operation: 'aggregate',
+      csv: CSV,
+      group_by: 'region',
+      column: 'revenue',
+      func: 'median',
+    });
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/bad func/);
+  });
+});
+
+// ---------------------------------------------------------------------------
+// Contract: name, tool schema, system prompt
+// ---------------------------------------------------------------------------
+
+describe('CsvEngine contract', () => {
+  const engine = new CsvEngine();
+
+  it('is named "csv"', () => {
+    expect(engine.name).toBe('csv');
+  });
+
+  it('advertises the correct operation enum in its tool schema', () => {
+    const def = engine.toToolDefinition();
+    expect(def.type).toBe('function');
+    expect(def.function.name).toBe('csv');
+    expect(def.function.parameters.properties.operation.enum).toEqual([
+      'parse', 'describe', 'column', 'filter', 'aggregate',
+      'sum', 'mean', 'min', 'max', 'count',
+    ]);
+    expect(def.function.parameters.required).toEqual(['operation', 'csv']);
+  });
+
+  it('contributes a system-prompt fragment mandating tool use for tabular data', () => {
+    const fragment = engine.systemPromptFragment?.({
+      now: new Date(),
+      maxToolTurns: 5,
+      activeTalents: new Set(['csv']),
+    });
+    expect(fragment).toBeTruthy();
+    expect(fragment).toMatch(/MUST call the csv tool/);
+    expect(fragment).toMatch(/\.xlsx/i);
+  });
+});
