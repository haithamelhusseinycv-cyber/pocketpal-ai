@@ -0,0 +1,549 @@
+import {TalentEngine, TalentResult, ToolDefinition, SystemPromptContext} from './types';
+
+/**
+ * GpxRouteEngine — offline route planning + GPX generation.
+ *
+ * All maths is closed-form and deterministic. No external dependencies.
+ * Planning constants (average speeds) are documented and adjustable via speed_kmh.
+ */
+
+const R_EARTH = 6371008.8; // mean earth radius in metres
+
+/** Default average speeds in km/h — planning constants, adjustable via speed_kmh input. */
+const DEFAULT_SPEEDS: Record<string, number> = {
+  hike: 4.2,
+  bike: 15,
+  sail: 9,
+  drive: 60,
+};
+
+interface RoutePoint {
+  name?: string;
+  lat: number;
+  lon: number;
+  ele?: number;
+}
+
+function toRad(d: number): number {
+  return (d * Math.PI) / 180;
+}
+function haversine(lat1: number, lon1: number, lat2: number, lon2: number): number {
+  const dLat = toRad(lat2 - lat1);
+  const dLon = toRad(lon2 - lon1);
+  const a =
+    Math.sin(dLat / 2) ** 2 +
+    Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
+  return 2 * R_EARTH * Math.asin(Math.sqrt(a));
+}
+
+function validatePoint(p: any, idx: number): RoutePoint {
+  if (typeof p !== 'object' || p === null) {
+    throw new Error(`point[${idx}] must be an object`);
+  }
+  const lat = typeof p.lat === 'number' ? p.lat : parseFloat(String(p.lat));
+  const lon = typeof p.lon === 'number' ? p.lon : parseFloat(String(p.lon));
+  if (!Number.isFinite(lat) || lat < -90 || lat > 90) {
+    throw new Error(`point[${idx}].lat must be a number in [-90, 90]`);
+  }
+  if (!Number.isFinite(lon) || lon < -180 || lon > 180) {
+    throw new Error(`point[${idx}].lon must be a number in [-180, 180]`);
+  }
+  const pt: RoutePoint = {lat, lon};
+  if (p.name != null) pt.name = String(p.name);
+  if (p.ele != null) {
+    const ele = typeof p.ele === 'number' ? p.ele : parseFloat(String(p.ele));
+    if (!Number.isFinite(ele)) {
+      throw new Error(`point[${idx}].ele must be a finite number`);
+    }
+    pt.ele = ele;
+  }
+  return pt;
+}
+
+function validatePoints(raw: unknown): RoutePoint[] {
+  if (!Array.isArray(raw) || raw.length < 2) {
+    throw new Error('points must be an array of at least 2 waypoints');
+  }
+  return raw.map((p, i) => validatePoint(p, i));
+}
+
+function validateType(t: unknown): string {
+  if (typeof t !== 'string' || !DEFAULT_SPEEDS[t]) {
+    throw new Error(`type must be one of: ${Object.keys(DEFAULT_SPEEDS).join(', ')}`);
+  }
+  return t;
+}
+
+function computeStats(points: RoutePoint[]) {
+  let totalDist = 0;
+  let totalAscent = 0;
+  let totalDescent = 0;
+  let maxLeg = 0;
+  const legs: number[] = [];
+
+  for (let i = 1; i < points.length; i++) {
+    const d = haversine(points[i - 1].lat, points[i - 1].lon, points[i].lat, points[i].lon);
+    legs.push(d);
+    totalDist += d;
+    if (d > maxLeg) maxLeg = d;
+
+    if (points[i - 1].ele != null && points[i].ele != null) {
+      const diff = points[i].ele! - points[i - 1].ele!;
+      if (diff > 0) totalAscent += diff;
+      else totalDescent += Math.abs(diff);
+    }
+  }
+
+  return {totalDist, totalAscent, totalDescent, maxLeg, legs};
+}
+
+function escapeXml(s: string): string {
+  return s
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&apos;');
+}
+
+function buildGpx(name: string, points: RoutePoint[], type: string): string {
+  const now = new Date().toISOString();
+  const lines: string[] = [];
+  lines.push(`<?xml version="1.0" encoding="UTF-8"?>`);
+  lines.push(`<gpx xmlns="http://www.topografix.com/GPX/1/1" version="1.1" creator="ray-gpx-route">`);
+  lines.push(`  <metadata>`);
+  lines.push(`    <name>${escapeXml(name)}</name>`);
+  lines.push(`    <time>${now}</time>`);
+  lines.push(`  </metadata>`);
+
+  // Waypoints for named points
+  for (const p of points) {
+    if (p.name) {
+      lines.push(`  <wpt lat="${p.lat}" lon="${p.lon}">`);
+      if (p.ele != null) lines.push(`    <ele>${p.ele}</ele>`);
+      lines.push(`    <name>${escapeXml(p.name)}</name>`);
+      lines.push(`  </wpt>`);
+    }
+  }
+
+  // Track
+  lines.push(`  <trk>`);
+  lines.push(`    <name>${escapeXml(name)}</name>`);
+  lines.push(`    <type>${escapeXml(type)}</type>`);
+  lines.push(`    <trkseg>`);
+  for (const p of points) {
+    let trkpt = `      <trkpt lat="${p.lat}" lon="${p.lon}">`;
+    if (p.ele != null) {
+      lines.push(trkpt);
+      lines.push(`        <ele>${p.ele}</ele>`);
+      lines.push(`      </trkpt>`);
+    } else {
+      lines.push(trkpt + `</trkpt>`);
+    }
+  }
+  lines.push(`    </trkseg>`);
+  lines.push(`  </trk>`);
+  lines.push(`</gpx>`);
+  return lines.join('\n');
+}
+
+function formatDuration(hours: number): string {
+  const h = Math.floor(hours);
+  const m = Math.round((hours - h) * 60);
+  return `${h}h ${m}m`;
+}
+
+function formatTime(d: Date): string {
+  return d.toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
+}
+
+/** Minimal GPX XML parser — handles the subset we generate. */
+function parseGpx(xml: string): {points: RoutePoint[]; trackPoints: RoutePoint[]; name: string} {
+  const nameMatch = xml.match(/<metadata>\s*<name>([^<]*)<\/name>/);
+  const name = nameMatch ? nameMatch[1] : '';
+
+  const waypoints: RoutePoint[] = [];
+  const wptRe = /<wpt\s+lat="([^"]+)"\s+lon="([^"]+)"[^>]*>([\s\S]*?)<\/wpt>/g;
+  let m: RegExpExecArray | null;
+  while ((m = wptRe.exec(xml)) !== null) {
+    const lat = parseFloat(m[1]);
+    const lon = parseFloat(m[2]);
+    const body = m[3];
+    const eleMatch = body.match(/<ele>([^<]+)<\/ele>/);
+    const nameMatch2 = body.match(/<name>([^<]+)<\/name>/);
+    const pt: RoutePoint = {lat, lon};
+    if (eleMatch) pt.ele = parseFloat(eleMatch[1]);
+    if (nameMatch2) pt.name = nameMatch2[1];
+    waypoints.push(pt);
+  }
+
+  const trackPoints: RoutePoint[] = [];
+  const trkptRe = /<trkpt\s+lat="([^"]+)"\s+lon="([^"]+)"[^>]*>([\s\S]*?)<\/trkpt>/g;
+  while ((m = trkptRe.exec(xml)) !== null) {
+    const lat = parseFloat(m[1]);
+    const lon = parseFloat(m[2]);
+    const body = m[3];
+    const eleMatch = body.match(/<ele>([^<]+)<\/ele>/);
+    const pt: RoutePoint = {lat, lon};
+    if (eleMatch) pt.ele = parseFloat(eleMatch[1]);
+    trackPoints.push(pt);
+  }
+
+  return {points: waypoints, trackPoints, name};
+}
+
+function err(summary: string, errorMessage: string): TalentResult {
+  return {type: 'error', summary, errorMessage};
+}
+
+export class GpxRouteEngine implements TalentEngine {
+  readonly name = 'gpx_route';
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const operation = typeof args.operation === 'string' ? args.operation.toLowerCase() : '';
+
+    switch (operation) {
+      case 'generate':
+        return this.generate(args);
+      case 'plan_day':
+        return this.planDay(args);
+      case 'import':
+        return this.importGpx(args);
+      case 'profile':
+        return this.profile(args);
+      default:
+        return err(
+          `gpx_route: unknown operation "${operation || '(missing)'}"`,
+          'operation must be one of: generate, plan_day, import, profile',
+        );
+    }
+  }
+
+  private generate(args: Record<string, any>): TalentResult {
+    try {
+      const name = typeof args.name === 'string' ? args.name : 'Route';
+      const points = validatePoints(args.points);
+      const type = validateType(args.type);
+      const speedKmh = typeof args.speed_kmh === 'number' && args.speed_kmh > 0
+        ? args.speed_kmh
+        : DEFAULT_SPEEDS[type];
+
+      const stats = computeStats(points);
+      const totalDistKm = stats.totalDist / 1000;
+      const maxLegKm = stats.maxLeg / 1000;
+      const durationHours = totalDistKm / speedKmh;
+
+      const gpx = buildGpx(name, points, type);
+
+      let summary = `GPX route generated: "${name}" (${type})\n`;
+      summary += `Waypoints: ${points.length}\n`;
+      summary += `Total distance: ${totalDistKm.toFixed(2)} km (haversine, R=${R_EARTH}m)\n`;
+      summary += `Max leg: ${maxLegKm.toFixed(2)} km\n`;
+      if (points.some(p => p.ele != null)) {
+        summary += `Cumulative ascent: ${stats.totalAscent.toFixed(1)} m\n`;
+        summary += `Cumulative descent: ${stats.totalDescent.toFixed(1)} m\n`;
+      }
+      summary += `Estimated duration: ${formatDuration(durationHours)} (at ${speedKmh} km/h)\n`;
+      summary += `Planning constant: default ${type} speed = ${DEFAULT_SPEEDS[type]} km/h`;
+      if (args.speed_kmh != null) {
+        summary += ` (overridden to ${speedKmh} km/h)`;
+      }
+      summary += '\n\nGPX 1.1 XML:\n' + gpx;
+      summary += `\n\nInputs: ${points.length} points, type=${type}`;
+      if (args.speed_kmh != null) summary += `, speed_kmh=${speedKmh}`;
+
+      return {type: 'text', summary};
+    } catch (e) {
+      const msg = e instanceof Error ? e.message : String(e);
+      return err(`gpx_route.generate: ${msg}`, msg);
+    }
+  }
+
+  private planDay(args: Record<string, any>): TalentResult {
+    try {
+      const points = validatePoints(args.points);
+      const type = validateType(args.type);
+      const speedKmh = typeof args.speed_kmh === 'number' && args.speed_kmh > 0
+        ? args.speed_kmh
+        : DEFAULT_SPEEDS[type];
+
+      const startTime = args.start_time
+        ? new Date(args.start_time)
+        : new Date('2026-01-01T08:00:00Z');
+      if (isNaN(startTime.getTime())) {
+        throw new Error('start_time must be a valid ISO date string');
+      }
+
+      const breakMinutes = typeof args.break_minutes === 'number' ? args.break_minutes : 10;
+      const stats = computeStats(points);
+
+      let currentTime = new Date(startTime);
+      const itinerary: string[] = [];
+      itinerary.push(`Itinerary for "${type}" route (${points.length} waypoints)`);
+      itinerary.push(`Start: ${formatTime(currentTime)}`);
+      itinerary.push(`Speed: ${speedKmh} km/h, break: ${breakMinutes} min per stop\n`);
+
+      let movingMinutes = 0;
+      let lastBreakTime = new Date(startTime);
+
+      for (let i = 0; i < points.length; i++) {
+        const ptName = points[i].name || `Waypoint ${i + 1}`;
+        itinerary.push(`  ${formatTime(currentTime)} — ${ptName} (${points[i].lat.toFixed(4)}, ${points[i].lon.toFixed(4)})`);
+
+        if (i < points.length - 1) {
+          const legKm = stats.legs[i] / 1000;
+          const legMinutes = (legKm / speedKmh) * 60;
+          movingMinutes += legMinutes;
+
+          currentTime = new Date(currentTime.getTime() + legMinutes * 60000);
+
+          // Suggest water/food stops every 2h for hike/bike
+          const minutesSinceBreak = (currentTime.getTime() - lastBreakTime.getTime()) / 60000;
+          if ((type === 'hike' || type === 'bike') && minutesSinceBreak >= 120) {
+            itinerary.push(`    → Suggested break: water/food stop (${breakMinutes} min)`);
+            currentTime = new Date(currentTime.getTime() + breakMinutes * 60000);
+            lastBreakTime = new Date(currentTime);
+          }
+        }
+      }
+
+      const totalHours = movingMinutes / 60;
+      itinerary.push(`\nTotal moving time: ${formatDuration(totalHours)}`);
+      itinerary.push(`Finish: ${formatTime(currentTime)}`);
+      itinerary.push(`\nInputs: ${points.length} points, type=${type}, speed=${speedKmh} km/h`);
+
+      return {type: 'text', summary: itinerary.join('\n')};
+    } catch (e) {
+      const msg = e instanceof Error ? e.message : String(e);
+      return err(`gpx_route.plan_day: ${msg}`, msg);
+    }
+  }
+
+  private importGpx(args: Record<string, any>): TalentResult {
+    try {
+      const gpxXml = typeof args.gpx_xml_string === 'string' ? args.gpx_xml_string : '';
+      if (!gpxXml) {
+        throw new Error('gpx_xml_string is required');
+      }
+      if (!gpxXml.includes('<gpx')) {
+        throw new Error('input does not appear to be valid GPX XML (no <gpx> element)');
+      }
+
+      const parsed = parseGpx(gpxXml);
+      const tp = parsed.trackPoints;
+
+      if (tp.length < 2) {
+        throw new Error(`GPX contains only ${tp.length} trackpoints, need at least 2`);
+      }
+
+      const stats = computeStats(tp);
+      const totalDistKm = stats.totalDist / 1000;
+      const maxLegKm = stats.maxLeg / 1000;
+
+      let summary = `GPX imported: "${parsed.name}"\n`;
+      summary += `Waypoints (named): ${parsed.points.length}\n`;
+      summary += `Trackpoints: ${tp.length}\n`;
+      summary += `Total distance: ${totalDistKm.toFixed(2)} km (haversine, R=${R_EARTH}m)\n`;
+      summary += `Max leg: ${maxLegKm.toFixed(2)} km\n`;
+      if (tp.some(p => p.ele != null)) {
+        summary += `Cumulative ascent: ${stats.totalAscent.toFixed(1)} m\n`;
+        summary += `Cumulative descent: ${stats.totalDescent.toFixed(1)} m\n`;
+      }
+
+      summary += `\nWaypoints:\n`;
+      for (const w of parsed.points) {
+        summary += `  ${w.name || '(unnamed)'}: (${w.lat}, ${w.lon})${w.ele != null ? ` ele=${w.ele}m` : ''}\n`;
+      }
+
+      summary += `\nInputs: GPX XML string (${gpxXml.length} chars)`;
+      return {type: 'text', summary};
+    } catch (e) {
+      const msg = e instanceof Error ? e.message : String(e);
+      return err(`gpx_route.import: ${msg}`, msg);
+    }
+  }
+
+  private profile(args: Record<string, any>): TalentResult {
+    try {
+      const points = validatePoints(args.points);
+      const stats = computeStats(points);
+
+      // Check if we have elevation data
+      const withEle = points.filter(p => p.ele != null);
+      if (withEle.length < 2) {
+        throw new Error('profile requires at least 2 points with elevation data');
+      }
+
+      // Compute cumulative distance for each point
+      const cumDist: number[] = [0];
+      for (let i = 1; i < points.length; i++) {
+        const d = haversine(points[i - 1].lat, points[i - 1].lon, points[i].lat, points[i].lon);
+        cumDist.push(cumDist[i - 1] + d);
+      }
+
+      const totalDist = cumDist[cumDist.length - 1];
+
+      // Sample to max 60 columns
+      const maxCols = 60;
+      const numSamples = Math.min(maxCols, points.length);
+      const sampledEle: number[] = [];
+      const sampledDist: number[] = [];
+
+      for (let c = 0; c < numSamples; c++) {
+        const targetDist = (c / (numSamples - 1)) * totalDist;
+        // Find the segment containing targetDist
+        let segIdx = 0;
+        for (let i = 1; i < cumDist.length; i++) {
+          if (cumDist[i] >= targetDist) {
+            segIdx = i - 1;
+            break;
+          }
+        }
+        const segLen = cumDist[segIdx + 1] - cumDist[segIdx];
+        const frac = segLen > 0 ? (targetDist - cumDist[segIdx]) / segLen : 0;
+        const ele1 = points[segIdx].ele ?? 0;
+        const ele2 = points[segIdx + 1].ele ?? 0;
+        sampledEle.push(ele1 + frac * (ele2 - ele1));
+        sampledDist.push(targetDist / 1000); // km
+      }
+
+      // Grade stats
+      let maxGrade = -Infinity;
+      let totalGrade = 0;
+      let gradeCount = 0;
+      for (let i = 1; i < points.length; i++) {
+        if (points[i].ele != null && points[i - 1].ele != null) {
+          const horizM = stats.legs[i - 1]; // metres
+          if (horizM > 0) {
+            const grade = ((points[i].ele! - points[i - 1].ele!) / horizM) * 100;
+            if (Math.abs(grade) > Math.abs(maxGrade)) maxGrade = grade;
+            totalGrade += Math.abs(grade);
+            gradeCount++;
+          }
+        }
+      }
+      const avgGrade = gradeCount > 0 ? totalGrade / gradeCount : 0;
+
+      // ASCII profile
+      const minEle = Math.min(...sampledEle);
+      const maxEle = Math.max(...sampledEle);
+      const eleRange = maxEle - minEle || 1;
+      const profileHeight = 12;
+
+      const grid: string[][] = [];
+      for (let r = 0; r < profileHeight; r++) {
+        grid.push(new Array(numSamples).fill(' '));
+      }
+
+      for (let c = 0; c < numSamples; c++) {
+        const normalized = (sampledEle[c] - minEle) / eleRange;
+        const row = Math.round(normalized * (profileHeight - 1));
+        const plotRow = profileHeight - 1 - row;
+        grid[plotRow][c] = '█';
+        // Fill below
+        for (let r = plotRow + 1; r < profileHeight; r++) {
+          grid[r][c] = '▓';
+        }
+      }
+
+      let profileStr = '';
+      for (let r = 0; r < profileHeight; r++) {
+        const eleLabel = maxEle - (r / (profileHeight - 1)) * eleRange;
+        profileStr += `${eleLabel.toFixed(0).padStart(6)}m |${grid[r].join('')}|\n`;
+      }
+      profileStr += `        +${'-'.repeat(numSamples)}+\n`;
+      profileStr += `         0km${' '.repeat(Math.max(0, numSamples - 8))}${(totalDist / 1000).toFixed(1)}km\n`;
+
+      let summary = `Elevation profile (${points.length} points, ${numSamples} sampled)\n\n`;
+      summary += profileStr + '\n';
+      summary += `Grade stats:\n`;
+      summary += `  Max grade: ${maxGrade.toFixed(1)}%\n`;
+      summary += `  Avg absolute grade: ${avgGrade.toFixed(1)}%\n`;
+      summary += `  Elevation range: ${minEle.toFixed(0)}m – ${maxEle.toFixed(0)}m (${eleRange.toFixed(0)}m)\n`;
+      summary += `\nInputs: ${points.length} points with elevation data`;
+
+      return {type: 'text', summary};
+    } catch (e) {
+      const msg = e instanceof Error ? e.message : String(e);
+      return err(`gpx_route.profile: ${msg}`, msg);
+    }
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: 'gpx_route',
+        description:
+          'Offline route planning and GPX 1.1 generation for hikes, bikes, sails, and drives. ' +
+          'Generates valid GPX XML with waypoints, tracks, metadata; computes haversine distances, ' +
+          'ascent/descent, estimated duration. Also: day itinerary planning, GPX import/parse, ' +
+          'and ASCII elevation profiles. All distances via haversine (R=6371008.8m). ' +
+          'Default speeds: hike 4.2 km/h, bike 15 km/h, sail 9 km/h, drive 60 km/h (adjustable via speed_kmh).',
+        parameters: {
+          type: 'object',
+          properties: {
+            operation: {
+              type: 'string',
+              enum: ['generate', 'plan_day', 'import', 'profile'],
+              description: 'Which operation to run.',
+            },
+            name: {
+              type: 'string',
+              description: 'Route name (for generate).',
+            },
+            points: {
