+import {XlsxEngine} from '../XlsxEngine';
+import type {TalentResult} from '../types';
+
+const text = (r: TalentResult): string =>
+  r.type === 'text' || r.type === 'error' ? r.summary : '';
+
+describe('XlsxEngine contract', () => {
+  const engine = new XlsxEngine();
+
+  it('is named "xlsx"', () => {
+    expect(engine.name).toBe('xlsx');
+  });
+
+  it('advertises an OpenAI function-calling schema with required operation', () => {
+    const def = engine.toToolDefinition();
+    expect(def.type).toBe('function');
+    expect(def.function.name).toBe('xlsx');
+    expect(def.function.parameters.required).toEqual(['operation']);
+    expect(def.function.parameters.properties.operation.enum).toEqual([
+      'create',
+      'read',
+      'convert',
+      'sheet_summary',
+    ]);
+  });
+
+  it('contributes a system-prompt fragment', () => {
+    const fragment = engine.systemPromptFragment?.();
+    expect(fragment).toBeTruthy();
+    expect(fragment).toMatch(/XLSX/);
+  });
+});
+
+describe('XlsxEngine.execute validation', () => {
+  const engine = new XlsxEngine();
+
+  it('rejects an unknown operation', async () => {
+    const r = await engine.execute({operation: 'invalid'});
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/unknown operation/);
+  });
+
+  it('rejects missing operation', async () => {
+    const r = await engine.execute({});
+    expect(r.type).toBe('error');
+  });
+
+  it('rejects create without sheets', async () => {
+    const r = await engine.execute({operation: 'create'});
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/sheets.*required/);
+  });
+
+  it('rejects create with empty sheets array', async () => {
+    const r = await engine.execute({operation: 'create', sheets: []});
+    expect(r.type).toBe('error');
+  });
+
+  it('rejects create with sheet missing rows', async () => {
+    const r = await engine.execute({
+      operation: 'create',
+      sheets: [{name: 'Test'}],
+    });
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/rows.*required/);
+  });
+
