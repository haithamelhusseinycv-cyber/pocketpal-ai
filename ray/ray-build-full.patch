+
+function buildReport(input: ReportInput): string {
+  const builder = new PdfBuilder();
+  const uWidth = usableWidth(builder);
+  const uHeight = usableHeight(builder);
+
+  // Font objects
+  const fontHelveticaId = builder.addObject(
+    '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>'
+  );
+  const fontBoldId = builder.addObject(
+    '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>'
+  );
+
+  // Resources dict
+  const resourcesId = builder.addObject(
+    `<< /Font << /F1 ${fontHelveticaId} 0 R /F2 ${fontBoldId} 0 R >> >>`
+  );
+
+  // We need to paginate content. Build pages with content streams.
+  const pages: {contentStream: string; annotations?: string}[] = [];
+  let currentStream = '';
+  let y = builder.pageHeight - MARGIN_TOP;
+  let pageNum = 0;
+  const fontSize = 10;
+  const headingSize = 14;
+  const titleSize = 20;
+  const lineHeight = fontSize * 1.5;
+  const headingLineHeight = headingSize * 1.5;
