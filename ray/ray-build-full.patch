index 0000000..2208b46
--- /dev/null
+++ b/src/services/tts/voiceLanguage.ts
@@ -0,0 +1,145 @@
+/**
+ * Bilingual voice resolution for RAY ("a voice that matches the language").
+ *
+ * RAY is natively bilingual: New York American English and contemporary
+ * Egyptian street Arabic. When he speaks a reply aloud, the voice must match
+ * the language of that reply — an American voice cannot pronounce Arabic and
+ * the OS Arabic voice sounds wrong on English.
+ *
+ * This module is pure and deterministic (no native calls) so it can be unit
+ * tested in the build sandbox:
+ *   - detectReplyLanguage(text): 'ar' | 'en' | 'mixed' by Unicode block scan.
+ *   - pickVoiceForText(text, voices): choose the best available voice.
+ *
+ * Voice catalog reality (do not "fix" without checking):
+ *   - kokoro has NO Arabic voices (its catalog is en/en-GB/es/fr/hi/it/ja/pt/zh).
+ *     So Arabic TTS MUST route through the `system` (OS native) engine, which
+ *     returns whatever Arabic voice is installed on the phone with its real
+ *     BCP-47 `language` tag (e.g. 'ar-EG', 'ar').
+ *   - For English we prefer a kokoro American male voice (the NY register) and
+ *     fall back to any American English voice, then any English voice.
+ *
+ * If no Arabic voice is installed, pickVoiceForText returns null for Arabic
+ * rather than mis-pronouncing it with an English voice — the caller should
+ * then skip speech for that message (silence beats butchery).
+ */
+
+import type {Voice} from './types';
+
+export type ReplyLanguage = 'ar' | 'en' | 'mixed';
+
+/**
+ * Preferred kokoro American-male voices for the NY English register, in order.
+ * Any of these is acceptable; we pick the first the catalog actually contains.
+ */
+const PREFERRED_EN_VOICE_IDS = [
+  'am_michael',
+  'am_adam',
+  'am_liam',
+  'am_echo',
+  'am_eric',
+  'am_onyx',
+  'am_fenrir',
+];
+
+/**
+ * Classify a string by script. Counts Arabic-script vs Latin-letter code
+ * points and returns the dominant one (or 'mixed' if both are substantial).
+ * Ignores digits, punctuation, and whitespace.
+ */
+export function detectReplyLanguage(text: string): ReplyLanguage {
+  let arabic = 0;
+  let latin = 0;
+  for (const ch of text) {
+    const cp = ch.codePointAt(0)!;
+    if (
+      (cp >= 0x0600 && cp <= 0x06ff) || // Arabic
+      (cp >= 0x0750 && cp <= 0x077f) || // Arabic Supplement
+      (cp >= 0x08a0 && cp <= 0x08ff) || // Arabic Extended-A
+      (cp >= 0xfb50 && cp <= 0xfdff) || // Arabic Presentation Forms-A
+      (cp >= 0xfe70 && cp <= 0xfeff) // Arabic Presentation Forms-B
+    ) {
+      arabic++;
+    } else if (
+      (cp >= 0x41 && cp <= 0x5a) || // A-Z
+      (cp >= 0x61 && cp <= 0x7a) // a-z
+    ) {
+      latin++;
+    }
+  }
+  const total = arabic + latin;
+  if (total === 0) {
+    // No letters at all (digits/punct) — default to English, harmless.
+    return 'en';
+  }
+  const arabicFraction = arabic / total;
+  if (arabicFraction >= 0.7) {
+    return 'ar';
+  }
+  if (arabicFraction <= 0.3) {
+    return 'en';
+  }
+  return 'mixed';
+}
+
+function isArabicLanguageTag(lang?: string): boolean {
+  return !!lang && /^ar\b/i.test(lang.trim());
+}
+
+function isEnglishLanguageTag(lang?: string): boolean {
+  return !!lang && /^en\b/i.test(lang.trim());
+}
+
+function isAmericanEnglish(v: Voice): boolean {
+  // 'en' (kokoro American) or 'en-US' (system). Treat bare 'en' as American
+  // because kokoro's 'en' catalog entry is American English; 'en-GB' is not.
+  const lang = (v.language ?? '').trim();
+  return lang === 'en' || /^en-us$/i.test(lang);
+}
+
+/**
+ * Choose the best available voice for `text`.
+ *
+ * @param text   the reply to be spoken
+ * @param voices the full available voice catalog (all engines)
+ * @returns a Voice, or null when the language cannot be spoken with what's
+ *          installed (caller should stay silent rather than mispronounce).
+ *
+ * For 'mixed' text we prefer Arabic only if the text is Arabic-dominant by
+ * weight; otherwise English, because an English voice at least handles the
+ * embedded Latin. Callers can override by detecting per-segment.
+ */
+export function pickVoiceForText(
+  text: string,
+  voices: Voice[],
+): Voice | null {
+  const lang = detectReplyLanguage(text);
+  const wantsArabic = lang === 'ar';
+
+  if (wantsArabic) {
+    // Arabic must come from an OS voice tagged ar*. Prefer ar-EG, then any ar.
+    const arabicVoices = voices.filter(v => isArabicLanguageTag(v.language));
+    const egypt = arabicVoices.find(v => /^ar-eg$/i.test((v.language ?? '').trim()));
