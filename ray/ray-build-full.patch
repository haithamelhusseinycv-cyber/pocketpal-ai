+
+  private profitability(args: Record<string, any>): TalentResult {
+    const revenue = num(args.revenue);
+    const grossProfit = num(args.gross_profit);
+    const cogs = num(args.cogs);
+    const ebitda = num(args.ebitda);
+    const netIncome = num(args.net_income);
+    const ta = num(args.total_assets);
+    const te = num(args.total_equity);
+
+    // Derive gross_profit from cogs if needed
+    let effectiveGP = grossProfit;
+    let gpDerivationNote = '';
+    if (effectiveGP === null && revenue !== null && cogs !== null) {
+      effectiveGP = revenue - cogs;
+      gpDerivationNote = `gross_profit derived: revenue (${money(revenue)}) − cogs (${money(cogs)}) = ${money(effectiveGP)}`;
+    }
+
+    const inputLines: string[] = [];
+    if (revenue !== null) inputLines.push(`revenue = ${money(revenue)}`);
+    if (grossProfit !== null) inputLines.push(`gross_profit = ${money(grossProfit)}`);
+    if (cogs !== null) inputLines.push(`cogs = ${money(cogs)}`);
+    if (effectiveGP !== null && grossProfit === null) inputLines.push(`gross_profit (derived) = ${money(effectiveGP)}`);
+    if (ebitda !== null) inputLines.push(`ebitda = ${money(ebitda)}`);
+    if (netIncome !== null) inputLines.push(`net_income = ${money(netIncome)}`);
+    if (ta !== null) inputLines.push(`total_assets = ${money(ta)}`);
+    if (te !== null) inputLines.push(`total_equity = ${money(te)}`);
+
+    const lines: string[] = ['Profitability ratios (rules-of-thumb, not hard thresholds):'];
+    const missing: string[] = [];
+
+    // gross_margin = gross_profit / revenue
+    if (effectiveGP === null || revenue === null) {
+      const needed: string[] = [];
+      if (effectiveGP === null) needed.push('gross_profit (or revenue + cogs to derive)');
+      if (revenue === null) needed.push('revenue');
+      lines.push(`gross_margin: not computable — missing ${needed.join(', ')}`);
+      missing.push('gross_margin');
+    } else {
+      const val = safeDiv(effectiveGP, revenue);
+      if (val === null) {
+        lines.push('gross_margin: n/a (denominator zero — revenue = 0)');
+      } else {
+        lines.push(`gross_margin = ${pct(val)}`);
+      }
+    }
+
+    // ebitda_margin = ebitda / revenue
+    if (ebitda === null || revenue === null) {
+      const needed: string[] = [];
+      if (ebitda === null) needed.push('ebitda');
+      if (revenue === null) needed.push('revenue');
+      lines.push(`ebitda_margin: not computable — missing ${needed.join(', ')}`);
+      missing.push('ebitda_margin');
+    } else {
+      const val = safeDiv(ebitda, revenue);
+      if (val === null) {
+        lines.push('ebitda_margin: n/a (denominator zero — revenue = 0)');
+      } else {
+        lines.push(`ebitda_margin = ${pct(val)}`);
+      }
+    }
+
+    // net_margin = net_income / revenue
+    if (netIncome === null || revenue === null) {
+      const needed: string[] = [];
+      if (netIncome === null) needed.push('net_income');
+      if (revenue === null) needed.push('revenue');
+      lines.push(`net_margin: not computable — missing ${needed.join(', ')}`);
+      missing.push('net_margin');
+    } else {
+      const val = safeDiv(netIncome, revenue);
+      if (val === null) {
+        lines.push('net_margin: n/a (denominator zero — revenue = 0)');
+      } else {
+        lines.push(`net_margin = ${pct(val)}`);
+      }
+    }
+
+    // roa = net_income / total_assets
+    if (netIncome === null || ta === null) {
+      const needed: string[] = [];
+      if (netIncome === null) needed.push('net_income');
+      if (ta === null) needed.push('total_assets');
+      lines.push(`roa: not computable — missing ${needed.join(', ')}`);
+      missing.push('roa');
+    } else {
+      const val = safeDiv(netIncome, ta);
+      if (val === null) {
+        lines.push('roa: n/a (denominator zero — total_assets = 0)');
+      } else {
+        lines.push(`roa = ${pct(val)}`);
+      }
+    }
+
+    // roe = net_income / total_equity
+    if (netIncome === null || te === null) {
+      const needed: string[] = [];
+      if (netIncome === null) needed.push('net_income');
+      if (te === null) needed.push('total_equity');
+      lines.push(`roe: not computable — missing ${needed.join(', ')}`);
+      missing.push('roe');
+    } else {
+      const val = safeDiv(netIncome, te);
+      if (val === null) {
+        lines.push('roe: n/a (denominator zero — total_equity = 0)');
+      } else {
+        lines.push(`roe = ${pct(val)}`);
+      }
+    }
+
+    if (missing.length > 0) {
+      lines.push(`\nNote: ${missing.join(', ')} omitted due to missing inputs — no figures were estimated.`);
+    }
+
+    if (gpDerivationNote) {
+      lines.push(`\n${gpDerivationNote}`);
+    }
+    lines.push(`\nInputs used: ${inputLines.join(', ')}`);
+
+    return {type: 'text', summary: lines.join('\n')};
+  }
