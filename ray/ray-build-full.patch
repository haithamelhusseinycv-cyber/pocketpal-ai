+import {DeepSearchEngine} from '../DeepSearchEngine';
+import type {DeepSearchAccess} from '../DeepSearchEngine';
+import type {SearchProvider, SearchHit} from '../../search/types';
+
+const hit = (overrides: Partial<SearchHit> = {}): SearchHit => ({
+  title: 'Title',
+  url: 'https://example.com/a',
+  snippet: 'A snippet.',
+  ...overrides,
+});
+
+const makeProvider = (
+  id: 'brave' | 'tavily' | 'exa' | 'parallel',
+  hits: SearchHit[],
+  shouldFail = false,
+): SearchProvider => ({
+  id,
+  search: jest.fn().mockImplementation(() =>
+    shouldFail
+      ? Promise.reject(new Error(`${id} failed`))
+      : Promise.resolve(hits),
+  ),
+});
+
+const makeAccess = (
+  overrides: Partial<DeepSearchAccess> = {},
+): DeepSearchAccess => ({
+  getAvailableProviders: () => [
+    makeProvider('brave', [hit({title: 'Brave Hit', url: 'https://b.com/1'})]),
+  ],
+  canSearch: () => true,
