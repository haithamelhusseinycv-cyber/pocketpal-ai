--- /dev/null
+++ b/src/services/talents/MemoryEngine.ts
@@ -0,0 +1,538 @@
+/**
+ * Memory — persistent, structured client/credit context across sessions.
+ *
+ * Scratchpad is a throwaway KV scratch for chaining numbers within a job. This
+ * is different: it is RAY's long-term book — durable records of clients,
+ * deals, and free-form facts that survive app restarts and let RAY recall
+ * "what do I know about this counterparty" without the user re-typing it.
+ *
+ * Design rules (same discipline as every RAY talent):
+ *   - Persistence mirrors ScratchpadEngine: AsyncStorage on device, an
+ *     in-memory backend in tests/SSR. No new npm dependency.
+ *   - Structured, not a blob. Each record is an entity with a stable id, a
+ *     kind (client | deal | note), tags, and fields. Retrieval is by id, by
+ *     kind, or by tag/substring search — not "dump everything".
+ *   - Never fabricates. `recall` returns exactly what was stored; if nothing
+ *     matches it says so plainly. RAY must not present a guess as a memory.
+ *   - Bounded. Hard caps on record count and per-record size so the store can
+ *     not grow without limit and blow the context budget on recall.
+ *   - Auditable. Every record carries created_at / updated_at (epoch ms) and
+ *     `remember` echoes back what it stored.
+ */
+
+import {
+  TalentEngine,
+  TalentResult,
+  ToolDefinition,
+  SystemPromptContext,
+} from './types';
+
+// ---------------------------------------------------------------------------
+// Storage abstraction — identical pattern to ScratchpadEngine
+// ---------------------------------------------------------------------------
+
+interface StorageBackend {
+  getItem(key: string): Promise<string | null>;
+  setItem(key: string, value: string): Promise<void>;
+  removeItem(key: string): Promise<void>;
+}
+
+const STORAGE_KEY = '@ray_memory';
+const MAX_RECORDS = 500;
+const MAX_FIELD_SIZE = 8 * 1024; // 8KB per record's serialized fields
+
+/** In-memory storage for environments without AsyncStorage (tests, SSR). */
+class MemoryStorage implements StorageBackend {
+  private store = new Map<string, string>();
+  async getItem(key: string): Promise<string | null> {
+    return this.store.get(key) ?? null;
+  }
+  async setItem(key: string, value: string): Promise<void> {
+    this.store.set(key, value);
+  }
+  async removeItem(key: string): Promise<void> {
+    this.store.delete(key);
+  }
+}
+
+/** Try to load AsyncStorage; fall back to memory. */
+function createStorage(): StorageBackend {
+  try {
+    const AsyncStorage = require('@react-native-async-storage/async-storage')
+      .default;
+    if (AsyncStorage && typeof AsyncStorage.getItem === 'function') {
+      return AsyncStorage as StorageBackend;
+    }
+  } catch {
+    // Fall through to memory
+  }
+  return new MemoryStorage();
+}
+
+// ---------------------------------------------------------------------------
+// Data model
+// ---------------------------------------------------------------------------
+
+export type MemoryKind = 'client' | 'deal' | 'note';
+
+const KINDS: MemoryKind[] = ['client', 'deal', 'note'];
+
+export interface MemoryRecord {
+  /** Stable id. User-supplied or generated from kind+title. */
+  id: string;
+  kind: MemoryKind;
+  /** Human label — client name, deal name, or note title. */
+  title: string;
+  /** Free-form structured fields (e.g. sector, exposure, rating, terms). */
+  fields: Record<string, string>;
+  /** Lower-cased tags for retrieval. */
+  tags: string[];
+  created_at: number; // epoch ms
+  updated_at: number; // epoch ms
+}
+
+interface MemoryData {
+  records: Record<string, MemoryRecord>;
+}
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+function slugId(kind: string, title: string): string {
+  const base = title
+    .toLowerCase()
+    .replace(/[^a-z0-9\u0600-\u06FF]+/gi, '_')
+    .replace(/^_+|_+$/g, '')
+    .slice(0, 48);
+  return `${kind}:${base || 'untitled'}`;
+}
+
+function coerceFields(raw: unknown): Record<string, string> {
+  const out: Record<string, string> = {};
+  if (raw && typeof raw === 'object' && !Array.isArray(raw)) {
+    for (const [k, v] of Object.entries(raw as Record<string, unknown>)) {
+      if (k === '__proto__' || k === 'constructor' || k === 'prototype') {
+        continue;
+      }
+      out[String(k)] = typeof v === 'string' ? v : JSON.stringify(v);
+    }
+  }
+  return out;
+}
+
+function coerceTags(raw: unknown): string[] {
+  if (Array.isArray(raw)) {
+    return Array.from(
+      new Set(
+        raw
+          .map(t => String(t).trim().toLowerCase())
+          .filter(Boolean)
+          .slice(0, 12),
+      ),
+    );
+  }
+  if (typeof raw === 'string') {
+    return Array.from(
+      new Set(
+        raw
+          .split(/[,\s]+/)
+          .map(t => t.trim().toLowerCase())
+          .filter(Boolean)
+          .slice(0, 12),
+      ),
+    );
+  }
+  return [];
+}
+
+function recordSize(rec: MemoryRecord): number {
+  return JSON.stringify(rec.fields).length + rec.title.length;
+}
+
+function formatRecord(rec: MemoryRecord): string {
+  const lines: string[] = [`### ${rec.title}  \`${rec.id}\` (${rec.kind})`];
+  const keys = Object.keys(rec.fields).sort();
+  for (const k of keys) {
+    lines.push(`- **${k}**: ${rec.fields[k]}`);
+  }
+  if (rec.tags.length) {
+    lines.push(`- _tags_: ${rec.tags.join(', ')}`);
+  }
+  lines.push(
+    `- _updated_: ${new Date(rec.updated_at).toISOString().slice(0, 10)}`,
+  );
+  return lines.join('\n');
+}
+
+// ---------------------------------------------------------------------------
+// Engine
+// ---------------------------------------------------------------------------
+
+export class MemoryEngine implements TalentEngine {
+  readonly name = 'memory';
+  // Recall returns multiple records; give it a little more room than scratch.
+  readonly recommendedContextTokens = 1200;
+
+  private storage: StorageBackend;
+  /** Test seam: allow injecting a backend (e.g. a fresh MemoryStorage). */
+  constructor(storage?: StorageBackend) {
+    this.storage = storage ?? createStorage();
+  }
+
+  private async load(): Promise<MemoryData> {
+    try {
+      const raw = await this.storage.getItem(STORAGE_KEY);
+      if (!raw) {
+        return {records: {}};
+      }
+      const parsed = JSON.parse(raw) as Partial<MemoryData>;
+      if (!parsed || typeof parsed !== 'object' || !parsed.records) {
+        return {records: {}};
+      }
+      // Drop any prototype-pollution keys defensively.
+      const records: Record<string, MemoryRecord> = {};
+      for (const [id, rec] of Object.entries(parsed.records)) {
+        if (id === '__proto__' || id === 'constructor' || id === 'prototype') {
+          continue;
+        }
+        if (rec && typeof rec === 'object' && typeof rec.id === 'string') {
+          records[id] = rec;
+        }
+      }
+      return {records};
+    } catch {
+      return {records: {}};
+    }
+  }
+
+  private async save(data: MemoryData): Promise<void> {
+    await this.storage.setItem(STORAGE_KEY, JSON.stringify(data));
+  }
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const op = typeof args.op === 'string' ? args.op.trim() : '';
+
+    switch (op) {
+      case 'remember':
+        return this.remember(args);
+      case 'recall':
+        return this.recall(args);
+      case 'update':
+        return this.update(args);
+      case 'forget':
+        return this.forget(args);
+      case 'list':
+        return this.list(args);
+      default:
+        return {
+          type: 'error',
+          summary: `memory: unknown op "${op}"`,
+          errorMessage:
+            'op must be one of: remember, recall, update, forget, list',
+        };
+    }
+  }
+
+  // ── remember: create a new record ─────────────────────────────────────
+  private async remember(args: Record<string, any>): Promise<TalentResult> {
+    const kind = (String(args.kind ?? '').trim().toLowerCase() ||
+      'note') as MemoryKind;
+    if (!KINDS.includes(kind)) {
+      return {
+        type: 'error',
+        summary: `memory.remember: invalid kind "${args.kind}"`,
+        errorMessage: `kind must be one of: ${KINDS.join(', ')}`,
+      };
+    }
+    const title = typeof args.title === 'string' ? args.title.trim() : '';
+    if (!title) {
+      return {
+        type: 'error',
+        summary: 'memory.remember: missing "title"',
+        errorMessage: 'title is required (client name, deal name, or note title)',
+      };
+    }
+    const fields = coerceFields(args.fields);
+    const tags = coerceTags(args.tags);
+
+    const data = await this.load();
+    const id =
+      typeof args.id === 'string' && args.id.trim()
+        ? args.id.trim()
+        : slugId(kind, title);
+
+    if (data.records[id]) {
+      return {
+        type: 'error',
+        summary: `memory.remember: id "${id}" already exists — use op:"update"`,
+        errorMessage: `A record with id "${id}" already exists. Use op:"update" to change it, or op:"remember" with a different id/title.`,
+      };
+    }
+    if (Object.keys(data.records).length >= MAX_RECORDS) {
+      return {
+        type: 'error',
+        summary: `memory.remember: store full (${MAX_RECORDS} records)`,
+        errorMessage: `Memory is at its cap of ${MAX_RECORDS} records. Forget something first.`,
+      };
+    }
+
+    const now = Date.now();
+    const rec: MemoryRecord = {
+      id,
+      kind,
+      title: title.slice(0, 200),
+      fields,
+      tags,
+      created_at: now,
+      updated_at: now,
+    };
+    if (recordSize(rec) > MAX_FIELD_SIZE) {
+      return {
+        type: 'error',
+        summary: 'memory.remember: record too large',
+        errorMessage: `Serialized fields exceed ${MAX_FIELD_SIZE} bytes. Split into multiple records or trim.`,
+      };
+    }
+    data.records[id] = rec;
+    await this.save(data);
+
+    return {
+      type: 'text',
+      summary: `Stored ${kind} "${rec.title}" as \`${id}\`.\n\n${formatRecord(rec)}`,
+    };
+  }
+
+  // ── recall: fetch by id, or search by kind/tag/query ──────────────────
+  private async recall(args: Record<string, any>): Promise<TalentResult> {
+    const data = await this.load();
+    const all = Object.values(data.records);
+
+    // Direct id hit.
+    if (typeof args.id === 'string' && args.id.trim()) {
+      const rec = data.records[args.id.trim()];
+      if (!rec) {
+        return {
+          type: 'text',
+          summary: `memory.recall: no record with id "${args.id.trim()}". Stored nothing matches — say so plainly, do not guess.`,
+        };
+      }
+      return {type: 'text', summary: formatRecord(rec)};
+    }
+
+    let pool = all;
+    const kind = String(args.kind ?? '').trim().toLowerCase();
+    if (kind && KINDS.includes(kind as MemoryKind)) {
+      pool = pool.filter(r => r.kind === kind);
+    }
+    const tag = String(args.tag ?? '').trim().toLowerCase();
+    if (tag) {
+      pool = pool.filter(r => r.tags.includes(tag));
+    }
+    const q = String(args.query ?? '').trim().toLowerCase();
+    if (q) {
+      pool = pool.filter(r => {
+        const hay = (
+          r.title +
+          ' ' +
+          r.tags.join(' ') +
+          ' ' +
+          Object.values(r.fields).join(' ')
+        ).toLowerCase();
+        return hay.includes(q);
+      });
+    }
+
+    // Most recently updated first.
+    pool.sort((a, b) => b.updated_at - a.updated_at);
+    const limit = Math.min(
+      Math.max(1, Number(args.limit) || 8),
+      20,
+    );
+    pool = pool.slice(0, limit);
+
+    if (pool.length === 0) {
+      const filters = [kind && `kind=${kind}`, tag && `tag=${tag}`, q && `query="${q}"`]
+        .filter(Boolean)
+        .join(', ');
+      return {
+        type: 'text',
+        summary: `memory.recall: no records match${filters ? ` (${filters})` : ''}. Nothing stored — report this honestly, do not invent context.`,
+      };
+    }
+
+    return {
+      type: 'text',
+      summary: `## Recalled ${pool.length} record(s)\n\n${pool.map(formatRecord).join('\n\n')}`,
+    };
+  }
+
+  // ── update: merge fields/tags into an existing record ─────────────────
+  private async update(args: Record<string, any>): Promise<TalentResult> {
+    const id = typeof args.id === 'string' ? args.id.trim() : '';
+    if (!id) {
+      return {
+        type: 'error',
+        summary: 'memory.update: missing "id"',
+        errorMessage: 'id is required to update a record',
+      };
+    }
+    const data = await this.load();
+    const rec = data.records[id];
+    if (!rec) {
+      return {
+        type: 'error',
+        summary: `memory.update: no record with id "${id}"`,
+        errorMessage: `No record "${id}". Use op:"remember" to create it.`,
+      };
+    }
+    if (args.fields) {
+      Object.assign(rec.fields, coerceFields(args.fields));
+    }
+    if (args.tags !== undefined) {
+      const merged = new Set([...rec.tags, ...coerceTags(args.tags)]);
+      rec.tags = Array.from(merged).slice(0, 12);
+    }
+    if (typeof args.title === 'string' && args.title.trim()) {
+      rec.title = args.title.trim().slice(0, 200);
+    }
+    if (recordSize(rec) > MAX_FIELD_SIZE) {
+      return {
+        type: 'error',
+        summary: 'memory.update: record would exceed size cap',
+        errorMessage: `Serialized fields exceed ${MAX_FIELD_SIZE} bytes after merge.`,
+      };
+    }
+    rec.updated_at = Date.now();
+    await this.save(data);
+    return {
+      type: 'text',
+      summary: `Updated \`${id}\`.\n\n${formatRecord(rec)}`,
+    };
+  }
+
+  // ── forget: delete a record ───────────────────────────────────────────
+  private async forget(args: Record<string, any>): Promise<TalentResult> {
+    const id = typeof args.id === 'string' ? args.id.trim() : '';
+    if (!id) {
+      return {
+        type: 'error',
+        summary: 'memory.forget: missing "id"',
+        errorMessage: 'id is required to delete a record',
+      };
+    }
+    const data = await this.load();
+    if (!data.records[id]) {
+      return {
+        type: 'error',
+        summary: `memory.forget: no record with id "${id}"`,
+        errorMessage: `Nothing to forget — no record "${id}".`,
+      };
+    }
+    const title = data.records[id].title;
+    delete data.records[id];
+    await this.save(data);
+    return {type: 'text', summary: `Forgot \`${id}\` ("${title}").`};
+  }
+
+  // ── list: index of records (ids + titles), cheap overview ─────────────
+  private async list(args: Record<string, any>): Promise<TalentResult> {
+    const data = await this.load();
+    let all = Object.values(data.records);
+    const kind = String(args.kind ?? '').trim().toLowerCase();
+    if (kind && KINDS.includes(kind as MemoryKind)) {
+      all = all.filter(r => r.kind === kind);
+    }
+    all.sort((a, b) => b.updated_at - a.updated_at);
+    if (all.length === 0) {
+      return {
+        type: 'text',
+        summary: `memory.list: store is empty${kind ? ` for kind=${kind}` : ''}. No client/deal/note context saved yet.`,
+      };
+    }
+    const counts = KINDS.map(
+      k => `${k}: ${all.filter(r => r.kind === k).length}`,
+    ).join('  ·  ');
+    const index = all
+      .slice(0, 50)
+      .map(r => `- \`${r.id}\` — ${r.title} (${r.kind})`)
+      .join('\n');
+    return {
+      type: 'text',
+      summary: `## Memory index (${all.length} record${all.length === 1 ? '' : 's'}; ${counts})\n\n${index}`,
+    };
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: this.name,
+        description:
+          'Persistent, structured long-term memory for client, deal, and credit context that survives across sessions. Use remember to store a counterparty or deal, recall to retrieve what is known (by id, kind, tag, or free-text query), update to merge new facts into an existing record, forget to delete, and list for a cheap index. This is RAY\'s book — it returns exactly what was stored and never invents context. Distinct from scratchpad (throwaway numbers for one job).',
+        parameters: {
+          type: 'object',
+          properties: {
+            op: {
+              type: 'string',
+              enum: ['remember', 'recall', 'update', 'forget', 'list'],
+              description: 'The memory operation to perform.',
+            },
+            id: {
+              type: 'string',
+              description:
+                'Record id. For recall/update/forget: the target. For remember: optional (auto-derived from kind+title if omitted).',
+            },
+            kind: {
+              type: 'string',
+              enum: ['client', 'deal', 'note'],
+              description:
+                'Record type for remember; optional filter for recall/list.',
+            },
+            title: {
+              type: 'string',
+              description:
+                'Human label for remember/update (client name, deal name, note title).',
+            },
+            fields: {
+              type: 'object',
+              description:
+                'Structured key/value facts for remember/update (e.g. {sector, exposure_egp, rating, tenor, terms}). update merges into existing fields.',
+              additionalProperties: {type: 'string'},
+            },
+            tags: {
+              type: 'array',
+              items: {type: 'string'},
+              description: 'Lower-cased retrieval tags for remember/update.',
+            },
+            tag: {
+              type: 'string',
+              description: 'Filter recall to records carrying this tag.',
+            },
+            query: {
+              type: 'string',
+              description:
+                'Free-text substring for recall — matches title, tags, and field values.',
+            },
+            limit: {
+              type: 'number',
+              description: 'Max records for recall (default 8, cap 20).',
+            },
+          },
+          required: ['op'],
+        },
+      },
+    };
+  }
+
+  systemPromptFragment(_ctx: SystemPromptContext): string | null {
+    return [
+      '## Memory (persistent client/credit context)',
+      'You keep a durable book of clients, deals, and notes via the `memory` tool — it survives across sessions, unlike `scratchpad` (which is throwaway numbers for a single job).',
+      '- When the user gives you lasting facts about a counterparty or a deal (sector, exposure, rating, tenor, terms, relationship history), `remember` it rather than letting it vanish with the conversation.',
+      '- Before analysing a client or deal, `recall` what you already know and build on it; do not ask the user to repeat stored context.',
+      '- `recall` returns ONLY what was stored. If nothing matches, say so plainly — never present an inferred or guessed fact as a memory.',
+      '- Keep records factual and auditable; `update` to merge new facts, `forget` to remove stale ones.',
+    ].join('\n');
+  }
+}
