+++ b/src/store/RouteStore.ts
@@ -0,0 +1,188 @@
+import {makeAutoObservable, runInAction} from 'mobx';
+import AsyncStorage from '@react-native-async-storage/async-storage';
+import {makePersistable} from 'mobx-persist-store';
+
+import {
+  DEFAULT_ROUTE_POLICY,
+  RouteMode,
+  RoutePolicy,
+} from '../api/hybridEngine';
+import {isMeteredConnection} from '../api/networkInfo';
+
+const VALID_MODES: RouteMode[] = ['local', 'cloud', 'auto', 'cloud-fallback'];
+
+/**
+ * How the metered/wifi state is determined.
+ *
+ *  - 'auto' (default): read live from @react-native-community/netinfo. Until it
+ *    reports, the connection is treated as metered (privacy-safe).
+ *  - 'wifi' / 'cellular' / 'unknown': user-declared override, for when OS
+ *    detection is wrong (e.g. a metered "wifi" hotspot) or unavailable.
+ *
+ * 'unknown' as an override still counts as metered, so it can never silently
+ * enable cloud routing over a paid connection.
+ */
+export type ConnectionMode = 'auto' | 'unknown' | 'wifi' | 'cellular';
+const VALID_CONNECTIONS: ConnectionMode[] = [
+  'auto',
+  'unknown',
+  'wifi',
+  'cellular',
+];
+
+/**
+ * Persisted hybrid-routing configuration.
+ *
+ * Follows the SearchProviderStore shape: makeAutoObservable + makePersistable,
+ * with a post-hydation normalise so stale or malformed persisted values cannot
+ * survive a reload. Defaults are privacy-preserving — mode 'local' means
+ * nothing leaves the device until the user opts in.
+ */
+class RouteStore {
+  mode: RouteMode = 'local';
+  policy: RoutePolicy = {...DEFAULT_ROUTE_POLICY};
+  /** Set when the user has acknowledged cloud routing sends prompts off-device. */
+  cloudRoutingAcknowledged = false;
+  /**
+   * ServerConfig id used as the cloud backend, plus the remote model to send to
+   * it. The router does not guess which configured server is "the cloud" — the
+   * user designates it. Empty means no cloud backend is bound, so every mode
+   * degrades to local.
+   */
+  cloudServerId: string | null = null;
+  cloudRemoteModelId: string | null = null;
+  /**
+   * How the connection is determined. Defaults to 'auto' (live netinfo), which
+   * is treated as metered until netinfo reports — see ConnectionMode.
+   */
+  connection: ConnectionMode = 'auto';
+
+  constructor() {
+    makeAutoObservable(this);
+
+    makePersistable(this, {
+      name: 'RouteStore',
+      properties: ['mode', 'policy', 'cloudRoutingAcknowledged', 'cloudServerId', 'cloudRemoteModelId', 'connection'],
+      storage: AsyncStorage,
+    }).then(() => this.normalizeHydratedPrefs());
+  }
+
+  /** Re-validate after hydration; persisted stores bypass the setters. */
+  normalizeHydratedPrefs(): void {
+    const mode = VALID_MODES.includes(this.mode) ? this.mode : 'local';
+    const policy: RoutePolicy = {...DEFAULT_ROUTE_POLICY};
+    const raw = this.policy ?? ({} as Partial<RoutePolicy>);
+
+    if (typeof raw.heavyPromptChars === 'number' && raw.heavyPromptChars > 0) {
+      policy.heavyPromptChars = raw.heavyPromptChars;
+    }
+    if (
+      typeof raw.heavyMessageCount === 'number' &&
+      raw.heavyMessageCount > 0
+    ) {
+      policy.heavyMessageCount = raw.heavyMessageCount;
+    }
+    policy.preferCloudForTools = raw.preferCloudForTools !== false;
+    policy.preferCloudForImages = raw.preferCloudForImages !== false;
+    policy.wifiOnly = raw.wifiOnly !== false;
+
+    const ack = (this.cloudRoutingAcknowledged as unknown) === true;
+    const connection = VALID_CONNECTIONS.includes(this.connection)
+      ? this.connection
+      : 'auto';
+
+    runInAction(() => {
+      this.mode = mode;
+      this.policy = policy;
+      this.cloudRoutingAcknowledged = ack;
+      this.connection = connection;
+    });
+  }
+
+  /**
+   * Switch routing mode. Any mode that can use the cloud requires explicit
+   * acknowledgement first, so a stray write cannot start sending prompts
+   * off-device.
+   */
+  setMode(next: RouteMode): boolean {
+    if (!VALID_MODES.includes(next)) {
+      return false;
+    }
+    const usesCloud = next === 'cloud' || next === 'auto' || next === 'cloud-fallback';
+    if (usesCloud && !this.cloudRoutingAcknowledged) {
+      return false;
+    }
+    runInAction(() => {
+      this.mode = next;
+    });
+    return true;
+  }
+
+  acknowledgeCloudRouting(): void {
+    runInAction(() => {
+      this.cloudRoutingAcknowledged = true;
+    });
+  }
+
+  setPolicy(patch: Partial<RoutePolicy>): void {
+    runInAction(() => {
+      this.policy = {...this.policy, ...patch};
+    });
+    this.normalizeHydratedPrefs();
+  }
+
+  /** True when the current mode can send a request to the cloud backend. */
+  get canUseCloud(): boolean {
+    return (
+      this.cloudRoutingAcknowledged &&
+      this.hasCloudBackend &&
+      (this.mode === 'cloud' ||
+        this.mode === 'auto' ||
+        this.mode === 'cloud-fallback')
+    );
+  }
+
+  /** A cloud backend is only usable when both the server and model are bound. */
+  get hasCloudBackend(): boolean {
+    return !!this.cloudServerId && !!this.cloudRemoteModelId;
+  }
+
+  /**
+   * Designate which configured server + remote model acts as the cloud backend.
+   * Passing nulls clears the binding, which forces every mode back to local.
+   */
+  bindCloudBackend(serverId: string | null, remoteModelId: string | null): void {
+    runInAction(() => {
+      this.cloudServerId = serverId;
+      this.cloudRemoteModelId = remoteModelId;
+    });
+  }
+
+  /** Declare the current connection. Drives the wifiOnly cellular gate. */
+  setConnection(connection: ConnectionMode): void {
+    if (!VALID_CONNECTIONS.includes(connection)) {
+      return;
+    }
+    runInAction(() => {
+      this.connection = connection;
+    });
+  }
+
+  /**
+   * True when routing should treat the connection as metered.
+   *
+   * 'auto' defers to live netinfo (which itself defaults to metered until it has
+   * a reading). The manual overrides map directly: only 'wifi' is unmetered;
+   * 'cellular' and 'unknown' both count as metered — the privacy-safe direction,
+   * since an unaffirmed connection must not silently send prompts to a paid
+   * cloud endpoint over cellular.
+   */
+  get onCellular(): boolean {
+    if (this.connection === 'auto') {
+      return isMeteredConnection();
+    }
+    return this.connection !== 'wifi';
+  }
+}
+
+export const routeStore = new RouteStore();
