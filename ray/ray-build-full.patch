+// ---------------------------------------------------------------------------
+
+/**
+ * Clean PDF builder that pre-allocates object IDs.
+ */
+function generateReportPdf(input: ReportInput): string {
+  const landscape = false;
+  const pageW = landscape ? 841.89 : 595.28;
+  const pageH = landscape ? 595.28 : 841.89;
+  const uWidth = pageW - MARGIN_LEFT - MARGIN_RIGHT;
+
+  const fontSize = 10;
+  const headingSize = 14;
+  const titleSize = 20;
+  const lineHeight = fontSize * 1.5;
+  const headingLineHeight = headingSize * 1.5;
