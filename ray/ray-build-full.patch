@@ -0,0 +1,37 @@
+/**
+ * Standalone Node harness for testing GpxRouteEngine and AstroEngine
+ * Uses esbuild to bundle TypeScript, then executes the tests
+ */
+
+import { build } from '/usr/local/node/lib/node_modules/tsx/node_modules/esbuild/lib/main.js';
+import { writeFileSync, unlinkSync } from 'fs';
+import { execSync } from 'child_process';
+
+console.log('=== BUILDING TEST HARNESS ===\n');
+
+// Bundle the test harness
+const result = await build({
+  entryPoints: ['/data/pocketpal-ai/test-harness.ts'],
+  bundle: true,
+  platform: 'node',
+  format: 'esm',
+  outfile: '/tmp/test-harness-bundled.mjs',
+  external: [],
+  write: true,
+  logLevel: 'info'
+});
+
+console.log('✓ Build complete\n');
+console.log('=== RUNNING TESTS ===\n');
+
+// Execute the bundled test
+try {
+  execSync('node /tmp/test-harness-bundled.mjs', {
+    stdio: 'inherit',
+    cwd: '/data/pocketpal-ai'
+  });
+  console.log('\n✅ Test harness completed successfully');
+} catch (error) {
+  console.error('\n❌ Test harness failed');
+  process.exit(1);
+}
diff --git a/src/api/__tests__/hybridEngine.test.ts b/src/api/__tests__/hybridEngine.test.ts
new file mode 100644
index 0000000..76286bf
--- /dev/null
+++ b/src/api/__tests__/hybridEngine.test.ts
@@ -0,0 +1,211 @@
+/**
+ * HybridCompletionEngine + decideRoute tests.
+ *
+ * Fakes implement the CompletionEngine surface directly so no native module
+ * (llama.rn) or network is touched. The fallback tests are the important ones:
+ * they pin the rule that a stream already visible to the user is never retried,
+ * because retrying would duplicate text on screen.
+ */
+import {
+  decideRoute,
+  HybridCompletionEngine,
+  DEFAULT_ROUTE_POLICY,
+  RouteSignals,
+} from '../hybridEngine';
+import type {
+  ApiCompletionParams,
+  CompletionEngine,
+  CompletionResult,
+  CompletionStreamData,
+} from '../../utils/completionTypes';
+
+type Behaviour = 'ok' | 'fail-immediately' | 'stream-then-fail';
+
+class FakeEngine implements CompletionEngine {
+  stopped = 0;
+  calls = 0;
+  constructor(private id: string, private behaviour: Behaviour = 'ok') {}
+
+  async completion(
+    _params: ApiCompletionParams,
+    cb?: (data: CompletionStreamData) => void,
+  ): Promise<CompletionResult> {
+    this.calls++;
+    if (this.behaviour === 'stream-then-fail') {
+      cb?.({token: `partial-${this.id}`});
+      throw new Error(`${this.id}: failed mid-stream`);
+    }
+    if (this.behaviour === 'fail-immediately') {
+      throw new Error(`${this.id}: down`);
+    }
+    cb?.({token: `tok-${this.id}`});
+    return {text: `from-${this.id}`, content: `from-${this.id}`};
+  }
+
+  async stopCompletion(): Promise<void> {
+    this.stopped++;
+  }
+}
+
+const params = (over: Partial<ApiCompletionParams> = {}): ApiCompletionParams =>
+  ({messages: [{role: 'user', content: 'hi'}], ...over} as ApiCompletionParams);
+
+const signals = (over: Partial<RouteSignals> = {}): RouteSignals => ({
+  userText: 'hi',
+  messageCount: 2,
+  hasTools: false,
+  hasImages: false,
+  onCellular: false,
+  localAvailable: true,
+  ...over,
+});
+
+describe('decideRoute', () => {
+  it('keeps a light request on-device', () => {
+    expect(decideRoute(signals()).useCloud).toBe(false);
+  });
+
+  it('routes tool-using turns to cloud', () => {
+    expect(decideRoute(signals({hasTools: true})).useCloud).toBe(true);
+  });
+
+  it('routes multimodal turns to cloud', () => {
+    expect(decideRoute(signals({hasImages: true})).useCloud).toBe(true);
+  });
+
+  it('routes a heavy prompt to cloud at the threshold', () => {
+    const at = 'x'.repeat(DEFAULT_ROUTE_POLICY.heavyPromptChars);
+    expect(decideRoute(signals({userText: at})).useCloud).toBe(true);
+    const under = 'x'.repeat(DEFAULT_ROUTE_POLICY.heavyPromptChars - 1);
+    expect(decideRoute(signals({userText: under})).useCloud).toBe(false);
+  });
+
+  it('routes a heavy context to cloud at the threshold', () => {
+    expect(
+      decideRoute(signals({messageCount: DEFAULT_ROUTE_POLICY.heavyMessageCount}))
+        .useCloud,
+    ).toBe(true);
+  });
+
+  it('sends to cloud when no local engine exists', () => {
+    expect(decideRoute(signals({localAvailable: false})).useCloud).toBe(true);
+  });
+
+  describe('privacy: the cellular gate beats every prefer-cloud signal', () => {
+    it.each([
+      ['tools', {hasTools: true}],
+      ['images', {hasImages: true}],
+      ['heavy prompt', {userText: 'x'.repeat(99999)}],
+      ['heavy context', {messageCount: 9999}],
+    ])('stays local for %s on cellular', (_label, over) => {
+      expect(decideRoute(signals({onCellular: true, ...over})).useCloud).toBe(
+        false,
+      );
+    });
+
+    it('still goes cloud on cellular when there is no local engine', () => {
+      expect(
+        decideRoute(signals({onCellular: true, localAvailable: false})).useCloud,
+      ).toBe(true);
+    });
+
+    it('lets tools route on cellular when wifiOnly is disabled', () => {
+      expect(
+        decideRoute(signals({onCellular: true, hasTools: true}), {
+          ...DEFAULT_ROUTE_POLICY,
+          wifiOnly: false,
+        }).useCloud,
+      ).toBe(true);
+    });
+  });
+});
+
+describe('HybridCompletionEngine', () => {
+  it('uses the primary engine when it succeeds', async () => {
+    const local = new FakeEngine('local');
+    const cloud = new FakeEngine('cloud');
+    const eng = new HybridCompletionEngine(local, cloud, 'local');
+    const r = await eng.completion(params());
+    expect(r.content).toBe('from-local');
+    expect(cloud.calls).toBe(0);
+  });
+
+  it('falls back to the secondary on a pre-stream failure', async () => {
+    const local = new FakeEngine('local', 'fail-immediately');
+    const cloud = new FakeEngine('cloud');
+    const eng = new HybridCompletionEngine(local, cloud, 'cloud-fallback');
+    const r = await eng.completion(params());
+    expect(r.content).toBe('from-cloud');
+  });
+
+  it('does NOT retry after tokens reached the UI (would duplicate text)', async () => {
+    const local = new FakeEngine('local', 'stream-then-fail');
+    const cloud = new FakeEngine('cloud');
+    const eng = new HybridCompletionEngine(local, cloud, 'cloud-fallback');
+    const seen: string[] = [];
+    await expect(
+      eng.completion(params(), d => seen.push(d.token!)),
+    ).rejects.toThrow();
+    expect(cloud.calls).toBe(0);
+    expect(seen).toEqual(['partial-local']);
+  });
+
+  it('returns an interrupted result when no engine is available', async () => {
+    const eng = new HybridCompletionEngine(null, null, 'auto');
+    const r = await eng.completion(params());
+    expect(r.interrupted).toBe(true);
+  });
+
+  it('propagates the error when there is no secondary to fall back to', async () => {
+    const local = new FakeEngine('local', 'fail-immediately');
+    const eng = new HybridCompletionEngine(local, null, 'local');
+    await expect(eng.completion(params())).rejects.toThrow();
+  });
+
+  it('forwards stopCompletion to the running engine', async () => {
+    const local = new FakeEngine('local', 'ok');
+    const cloud = new FakeEngine('cloud');
+    const eng = new HybridCompletionEngine(local, cloud, 'local');
+    await eng.completion(params());
+    // After settle activeEngine is cleared, so a stop is a no-op that must not
+    // throw. This pins that stopCompletion is safe to call at any time.
+    await expect(eng.stopCompletion()).resolves.toBeUndefined();
+  });
+
+  it('routes by policy in auto mode when a signal provider is supplied', async () => {
+    const local = new FakeEngine('local');
+    const cloud = new FakeEngine('cloud');
+    const eng = new HybridCompletionEngine(
+      local,
+      cloud,
+      'auto',
+      DEFAULT_ROUTE_POLICY,
+      () => ({
+        userText: 'hi',
+        messageCount: 2,
+        hasTools: true, // heavy signal -> cloud
+        hasImages: false,
+        onCellular: false,
+      }),
+    );
+    const r = await eng.completion(params());
+    expect(r.content).toBe('from-cloud');
+    expect(eng.lastDecision.useCloud).toBe(true);
+  });
+
+  it('degrades to local in auto mode when no cloud engine is set', async () => {
+    const local = new FakeEngine('local');
+    const eng = new HybridCompletionEngine(local, null, 'auto');
+    const r = await eng.completion(params());
+    expect(r.content).toBe('from-local');
+  });
+
+  it('reports isHybrid only when both engines exist', () => {
+    expect(
+      new HybridCompletionEngine(new FakeEngine('l'), new FakeEngine('c')).isHybrid,
+    ).toBe(true);
+    expect(new HybridCompletionEngine(new FakeEngine('l'), null).isHybrid).toBe(
+      false,
+    );
+  });
+});
