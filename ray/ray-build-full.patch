+import {TalentEngine, TalentResult, ToolDefinition} from './types';
+
+/**
+ * code_edit — apply exact, reviewable edits to source text the user provides.
+ *
+ * Deliberate scope: this operates ONLY on text passed in the call. It does no
+ * file I/O, never touches the filesystem, and never executes anything. That
+ * keeps a phone-based agent useful for code work (precise edits, diffs, reviews)
+ * without giving it a write primitive it could aim at the wrong place. If you
+ * want it to edit real files, that is a separate, explicitly-gated feature with
+ * a confirmed target path and a user approval step — not this tool.
+ *
+ * Every operation is exact-match and reversible-by-inspection: search strings
+ * must match verbatim (no fuzzy matching, no regex by default), the tool refuses
+ * ambiguous or missing matches instead of guessing, and it returns a unified
+ * diff so the user sees precisely what changed before applying it anywhere.
+ */
+
+interface Edit {
+  search: string;
+  replace: string;
+  /** Apply to all occurrences (default false — exactly one match required). */
+  replace_all?: boolean;
+}
+
+/** Minimal line-based unified diff (no dependency). Deterministic and readable. */
+function unifiedDiff(before: string, after: string): string {
+  const a = before.split('\n');
+  const b = after.split('\n');
+
+  // Longest common subsequence to anchor unchanged runs.
+  const n = a.length;
+  const m = b.length;
+  const dp: number[][] = Array.from({length: n + 1}, () =>
+    new Array(m + 1).fill(0),
+  );
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      dp[i][j] =
+        a[i] === b[j]
+          ? dp[i + 1][j + 1] + 1
+          : Math.max(dp[i + 1][j], dp[i][j + 1]);
+    }
+  }
+
+  const lines: string[] = [];
+  let i = 0;
+  let j = 0;
+  let contextRun: string[] = [];
+  let inHunk = false;
+  let hunkLines: string[] = [];
+
+  const flushHunk = () => {
+    if (hunkLines.length) {
+      lines.push(...hunkLines);
+      hunkLines = [];
+    }
+    inHunk = false;
+  };
+
+  const pushContext = (line: string) => {
+    if (inHunk) {
+      hunkLines.push(' ' + line);
+    } else {
+      contextRun.push(' ' + line);
+      // Keep only the last 3 context lines before a change.
+      if (contextRun.length > 3) {
+        contextRun.shift();
+      }
+    }
+  };
+
+  while (i < n && j < m) {
+    if (a[i] === b[j]) {
+      pushContext(a[i]);
+      i++;
+      j++;
+      continue;
+    }
+    if (!inHunk) {
+      if (contextRun.length) {
+        lines.push('@@ change @@');
+      }
+      lines.push(...contextRun);
+      contextRun = [];
+      inHunk = true;
+    }
+    if (dp[i + 1][j] >= dp[i][j + 1]) {
+      hunkLines.push('-' + a[i]);
+      i++;
+    } else {
+      hunkLines.push('+' + b[j]);
+      j++;
+    }
+  }
+  while (i < n) {
+    if (!inHunk) {
+      lines.push('@@ change @@');
+      lines.push(...contextRun);
+      contextRun = [];
+      inHunk = true;
+    }
+    hunkLines.push('-' + a[i]);
+    i++;
+  }
+  while (j < m) {
+    if (!inHunk) {
+      lines.push('@@ change @@');
+      lines.push(...contextRun);
+      contextRun = [];
+      inHunk = true;
+    }
+    hunkLines.push('+' + b[j]);
+    j++;
+  }
+  flushHunk();
+
+  return lines.length ? lines.join('\n') : '(no changes)';
+}
+
+function countOccurrences(haystack: string, needle: string): number {
+  if (needle === '') {
+    return 0;
+  }
+  let count = 0;
+  let idx = haystack.indexOf(needle);
+  while (idx !== -1) {
+    count++;
+    idx = haystack.indexOf(needle, idx + needle.length);
+  }
+  return count;
+}
+
+export class CodeEditEngine implements TalentEngine {
+  readonly name = 'code_edit';
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const source = typeof args.source === 'string' ? args.source : null;
+    if (source === null) {
+      return {
+        type: 'error',
+        summary: 'code_edit: missing "source" string',
+        errorMessage:
+          'source is required — pass the exact current text to edit. This tool does not read files.',
+      };
+    }
+
+    const operation = typeof args.operation === 'string' ? args.operation : '';
+    const lang = typeof args.language === 'string' ? args.language : '';
+
+    if (operation === 'review') {
+      return this.review(source, lang);
+    }
+
+    if (operation !== 'apply_edits') {
+      return {
+        type: 'error',
+        summary: 'code_edit: operation must be "apply_edits" or "review"',
+        errorMessage: `unknown operation "${operation}"`,
+      };
+    }
+
+    const rawEdits = args.edits;
+    if (!Array.isArray(rawEdits) || rawEdits.length === 0) {
+      return {
+        type: 'error',
+        summary: 'code_edit: "edits" must be a non-empty array',
+        errorMessage: 'edits is required for apply_edits',
+      };
+    }
+
+    let result = source;
+    const appliedNotes: string[] = [];
+
+    for (let k = 0; k < rawEdits.length; k++) {
+      const e = rawEdits[k] as Edit;
+      if (!e || typeof e.search !== 'string' || typeof e.replace !== 'string') {
+        return {
+          type: 'error',
+          summary: `code_edit: edit #${k + 1} needs string "search" and "replace"`,
+          errorMessage: 'each edit must have search and replace strings',
+        };
+      }
+      if (e.search === '') {
+        return {
+          type: 'error',
+          summary: `code_edit: edit #${k + 1} has an empty "search"`,
+          errorMessage: 'empty search would match everywhere; refused',
+        };
+      }
+
+      const occurrences = countOccurrences(result, e.search);
+      if (occurrences === 0) {
+        return {
+          type: 'error',
+          summary: `code_edit: edit #${k + 1} search text not found`,
+          errorMessage:
+            'no exact match for the search text. Pass the verbatim current text — this tool does not fuzzy-match. Nothing was changed.',
+        };
+      }
+      if (occurrences > 1 && e.replace_all !== true) {
+        return {
+          type: 'error',
+          summary: `code_edit: edit #${k + 1} matches ${occurrences} places`,
+          errorMessage:
+            'ambiguous match. Widen the search text to make it unique, or set replace_all=true to change every occurrence. Nothing was changed.',
+        };
+      }
+
+      const before = result;
+      result = e.replace_all
+        ? before.split(e.search).join(e.replace)
+        : before.replace(e.search, e.replace);
+
+      const changed = e.replace_all ? occurrences : 1;
+      appliedNotes.push(
+        `edit #${k + 1}: replaced ${changed} occurrence${changed === 1 ? '' : 's'}`,
+      );
+    }
+
+    const diff = unifiedDiff(source, result);
+    const summary = [
+      `code_edit: applied ${rawEdits.length} edit(s)`,
+      ...appliedNotes.map(note => `  - ${note}`),
+      '',
+      'Unified diff:',
+      diff,
+      '',
+      'Edited source:',
+      result,
+    ].join('\n');
+
+    return {type: 'text', summary};
+  }
+
+  /** Read-only structural review: bounded, deterministic, no invented findings. */
+  private review(source: string, lang: string): TalentResult {
+    const lines = source.split('\n');
+    const findings: string[] = [];
+
+    // Bracket balance (ignores strings/comments crudely — this is a nudge, not
+    // a parser; the summary says so).
+    const pairs: Record<string, string> = {'(': ')', '[': ']', '{': '}'};
+    const closers = new Set([')', ']', '}']);
+    const stack: string[] = [];
+    let inLineComment = false;
+    let inBlockComment = false;
+    let inString: string | null = null;
+    for (const line of lines) {
+      inLineComment = false;
+      for (let i = 0; i < line.length; i++) {
+        const c = line[i];
+        const next = line[i + 1];
+        if (inLineComment) {
+          break;
+        }
+        if (inBlockComment) {
+          if (c === '*' && next === '/') {
+            inBlockComment = false;
+            i++;
+          }
+          continue;
+        }
+        if (inString) {
+          if (c === '\\') {
+            i++;
+            continue;
+          }
+          if (c === inString) {
+            inString = null;
+          }
+          continue;
+        }
+        if (c === '/' && next === '/') {
+          inLineComment = true;
+          break;
+        }
+        if (c === '/' && next === '*') {
+          inBlockComment = true;
+          i++;
+          continue;
+        }
+        if (c === '"' || c === "'" || c === '`') {
+          inString = c;
+          continue;
+        }
+        if (c in pairs) {
+          stack.push(pairs[c]);
+        } else if (closers.has(c)) {
+          const expected = stack.pop();
+          if (expected !== c) {
+            findings.push(
+              `Unbalanced "${c}" near line ${
+                lines.indexOf(line) + 1
+              } (expected "${expected ?? 'nothing'}")`,
+            );
+          }
+        }
+      }
+    }
+    if (stack.length) {
+      findings.push(
+        `${stack.length} unclosed bracket(s): expected ${stack.join(', ')}`,
+      );
+    }
+
+    // TODO/FIXME markers.
+    lines.forEach((line, idx) => {
+      if (/\b(TODO|FIXME|XXX|HACK)\b/.test(line)) {
+        findings.push(`Line ${idx + 1}: ${line.trim().slice(0, 80)}`);
+      }
+    });
+
+    // Very long lines (readability nudge).
+    const long = lines
+      .map((line, idx) => ({idx, len: line.length}))
+      .filter(l => l.len > 120);
+    if (long.length) {
+      findings.push(
+        `${long.length} line(s) exceed 120 chars (e.g. line ${long[0].idx + 1})`,
+      );
+    }
+
+    const header = `code_edit review${lang ? ` (${lang})` : ''}: ${lines.length} lines`;
+    if (!findings.length) {
+      return {
+        type: 'text',
+        summary: `${header}\nNo mechanical issues found. This is a structural nudge (bracket balance, TODOs, line length), not a semantic review — judge logic yourself.`,
+      };
+    }
+    return {
+      type: 'text',
+      summary: [
+        header,
+        'Mechanical findings (structural nudge, not a semantic review):',
+        ...findings.map(f => `  - ${f}`),
+      ].join('\n'),
+    };
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: 'code_edit',
+        description:
+          'Apply exact search/replace edits to source text the user provides, or run a structural review. Operates only on the text passed in — it does NOT read or write files. Search must match verbatim; ambiguous or missing matches are refused rather than guessed. Returns a unified diff plus the edited source so changes are reviewable before use.',
+        parameters: {
+          type: 'object',
+          properties: {
+            operation: {
+              type: 'string',
+              enum: ['apply_edits', 'review'],
+              description:
+                'apply_edits = perform the given edits; review = read-only structural check (brackets, TODOs, long lines).',
+            },
+            source: {
+              type: 'string',
+              description:
+                'The exact current source text to edit or review. Required. This tool never reads from disk.',
+            },
+            language: {
+              type: 'string',
+              description: 'Optional language hint for the review label.',
+            },
+            edits: {
+              type: 'array',
+              description: 'For apply_edits: the ordered list of edits.',
+              items: {
+                type: 'object',
+                properties: {
+                  search: {
+                    type: 'string',
+                    description:
+                      'Verbatim text to find. Must be unique unless replace_all is true.',
+                  },
+                  replace: {
+                    type: 'string',
+                    description: 'Text to substitute in its place.',
+                  },
+                  replace_all: {
+                    type: 'boolean',
+                    description:
+                      'Replace every occurrence (default false, which requires exactly one match).',
+                  },
+                },
+                required: ['search', 'replace'],
+              },
+            },
+          },
+          required: ['operation', 'source'],
+        },
+      },
+    };
+  }
+
+  systemPromptFragment(): string {
+    return [
+      'CODE_EDIT TOOL POLICY:',
+      '- Use code_edit for precise changes to code the user pastes. It edits only the text you pass; it cannot read or write files on the device.',
+      '- Search strings must be verbatim. If a match is ambiguous or missing the tool refuses and changes nothing — widen the search rather than retrying blindly.',
+      '- Always show the user the returned diff. Never claim an edit was applied to a file; you only produced edited text for the user to place.',
+      '- review is a structural nudge (brackets, TODOs, line length), not a semantic judgement — reason about logic yourself.',
+    ].join('\n');
+  }
+}
