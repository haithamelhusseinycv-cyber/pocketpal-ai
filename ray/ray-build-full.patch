@@ -0,0 +1,279 @@
+import React from 'react';
+import {View} from 'react-native';
+import {observer} from 'mobx-react-lite';
+import {
+  Card,
+  Text,
+  Switch,
+  SegmentedButtons,
+  Button,
+} from 'react-native-paper';
+
+import {Selector, Divider} from '../../components';
+import {useTheme} from '../../hooks';
+import {routeStore} from '../../store/RouteStore';
+import type {ConnectionMode} from '../../store/RouteStore';
+import {serverStore} from '../../store/ServerStore';
+import {modelStore} from '../../store/ModelStore';
+import type {RouteMode} from '../../api/hybridEngine';
+
+import {createStyles} from './styles';
+
+/**
+ * Routing settings card — makes hybrid local↔cloud routing user-facing.
+ *
+ * Self-contained on purpose: it reads/writes routeStore directly and can be
+ * dropped into SettingsScreen with one import and one <RoutingSettingsCard />
+ * line, rather than editing the 1500-line screen's internals.
+ *
+ * Gating order mirrors the store's own guards, so the UI can never present a
+ * control that the store would reject:
+ *   acknowledge privacy notice → bind a cloud backend → choose a mode.
+ * Until all three exist the mode selector stays disabled and routing is local.
+ */
+
+const MODE_OPTIONS: {value: RouteMode; label: string}[] = [
+  {value: 'local', label: 'Local'},
+  {value: 'auto', label: 'Auto'},
+  {value: 'cloud-fallback', label: 'Fallback'},
+  {value: 'cloud', label: 'Cloud'},
+];
+
+const CONNECTION_OPTIONS: {value: ConnectionMode; label: string}[] = [
+  {value: 'auto', label: 'Auto'},
+  {value: 'wifi', label: 'Wi-Fi'},
+  {value: 'cellular', label: 'Cellular'},
+  {value: 'unknown', label: 'Unknown'},
+];
+
+export const RoutingSettingsCard = observer(() => {
+  const theme = useTheme();
+  const styles = createStyles(theme);
+
+  const {mode, policy, cloudRoutingAcknowledged} = routeStore;
+  const servers = serverStore.servers;
+  const hasCloudBackend = routeStore.hasCloudBackend;
+
+  // Model options for the currently bound cloud server. Empty until a server is
+  // chosen; serverStore.serverModels is populated by its own fetch cycle.
+  const modelOptions = (
+    routeStore.cloudServerId
+      ? serverStore.serverModels.get(routeStore.cloudServerId) ?? []
+      : []
+  ).map(m => ({value: m.id, label: m.id}));
+
+  const serverOptions = [
+    {value: '', label: 'None (local only)'},
+    ...servers.map(s => ({value: s.id, label: s.name || s.url})),
+  ];
+
+  const handleServerChange = (serverId: string) => {
+    // Changing server invalidates the previously bound model — clear both.
+    routeStore.bindCloudBackend(serverId || null, null);
+    // Best-effort: ensure the new server's model list is fetched.
+    if (serverId) {
+      serverStore.fetchAllRemoteModels?.().catch(() => {});
+    }
+  };
+
+  const handleModelChange = (remoteModelId: string) => {
+    routeStore.bindCloudBackend(routeStore.cloudServerId, remoteModelId || null);
+  };
+
+  const handleModeChange = async (next: RouteMode) => {
+    const ok = routeStore.setMode(next);
+    if (ok) {
+      // Rebuild the engine so the change takes effect on the next turn.
+      await modelStore.refreshHybridEngine().catch(() => {});
+    }
+  };
+
+  const handleAcknowledge = async () => {
+    routeStore.acknowledgeCloudRouting();
+    await modelStore.refreshHybridEngine().catch(() => {});
+  };
+
+  return (
+    <Card elevation={0} style={styles.card} testID="routing-settings-card">
+      <Card.Title title="Inference routing (RAY)" />
+      <Card.Content>
+        {/* Privacy acknowledgement gate */}
+        <View style={styles.settingItemContainer}>
+          <View style={styles.switchContainer}>
+            <View style={styles.textContainer}>
+              <Text variant="titleMedium" style={styles.textLabel}>
+                Allow cloud routing
+              </Text>
+              <Text variant="labelSmall" style={styles.textDescription}>
+                When on, some prompts may be sent to a cloud server you choose.
+                When off, everything stays on-device. Off by default.
+              </Text>
+            </View>
+            <Switch
+              testID="routing-acknowledge-switch"
+              value={cloudRoutingAcknowledged}
+              onValueChange={v => (v ? handleAcknowledge() : routeStore.setMode('local'))}
+              disabled={cloudRoutingAcknowledged && mode !== 'local'}
+            />
+          </View>
+          {cloudRoutingAcknowledged && (
+            <Text variant="labelSmall" style={styles.textDescription}>
+              To turn cloud routing off again, switch the mode to Local below.
+            </Text>
+          )}
+        </View>
+        <Divider />
+
+        {/* Cloud backend binding */}
+        <View style={styles.settingItemContainer}>
+          <Text variant="titleMedium" style={styles.textLabel}>
+            Cloud backend
+          </Text>
+          <Text variant="labelSmall" style={styles.textDescription}>
+            Which configured server acts as the cloud model. Requires a server
+            added under API settings.
+          </Text>
+          <Selector
+            testID="routing-server-selector"
+            label="Server"
+            options={serverOptions}
+            value={routeStore.cloudServerId ?? ''}
+            onChange={handleServerChange}
+            disabled={!cloudRoutingAcknowledged}
+          />
+          {routeStore.cloudServerId && (
+            <Selector
+              testID="routing-model-selector"
+              label="Remote model"
+              options={modelOptions}
+              value={routeStore.cloudRemoteModelId ?? ''}
+              onChange={handleModelChange}
+              placeholder={modelOptions.length ? 'Select model' : 'Fetching models…'}
+            />
+          )}
+        </View>
+        <Divider />
+
+        {/* Mode */}
+        <View style={styles.settingItemContainer}>
+          <Text variant="titleMedium" style={styles.textLabel}>
+            Routing mode
+          </Text>
+          <Text variant="labelSmall" style={styles.textDescription}>
+            Local = always on-device. Auto = route heavy/tool/multimodal turns to
+            cloud. Fallback = local first, cloud on failure. Cloud = always
+            remote.
+          </Text>
+          <SegmentedButtons
+            testID="routing-mode-buttons"
+            value={mode}
+            onValueChange={v => handleModeChange(v as RouteMode)}
+            density="medium"
+            disabled={!cloudRoutingAcknowledged || (mode !== 'local' && !hasCloudBackend)}
+            buttons={MODE_OPTIONS.map(o => ({
+              value: o.value,
+              label: o.label,
+              labelStyle: {fontSize: 10},
+              testID: `routing-mode-${o.value}`,
+            }))}
+            style={styles.segmentedButtons}
+          />
+        </View>
+        <Divider />
+
+        {/* Policy toggles */}
+        <View style={styles.settingItemContainer}>
+          <Text variant="titleMedium" style={styles.textLabel}>
+            Auto-routing policy
+          </Text>
+
+          <View style={styles.switchContainer}>
+            <View style={styles.textContainer}>
+              <Text variant="labelSmall" style={styles.textDescription}>
+                Send tool-using turns to cloud (stronger function calling)
+              </Text>
+            </View>
+            <Switch
+              testID="routing-policy-tools"
+              value={policy.preferCloudForTools}
+              onValueChange={v => routeStore.setPolicy({preferCloudForTools: v})}
+            />
+          </View>
+
+          <View style={styles.switchContainer}>
+            <View style={styles.textContainer}>
+              <Text variant="labelSmall" style={styles.textDescription}>
+                Send image/multimodal turns to cloud
+              </Text>
+            </View>
+            <Switch
+              testID="routing-policy-images"
+              value={policy.preferCloudForImages}
+              onValueChange={v => routeStore.setPolicy({preferCloudForImages: v})}
+            />
+          </View>
+
+          <View style={styles.switchContainer}>
+            <View style={styles.textContainer}>
+              <Text variant="labelSmall" style={styles.textDescription}>
+                Cloud only on Wi-Fi (never send over cellular). With this on,
+                cloud routing only happens while your connection below is set to
+                Wi-Fi.
+              </Text>
+            </View>
+            <Switch
+              testID="routing-policy-wifi"
+              value={policy.wifiOnly}
+              onValueChange={v => routeStore.setPolicy({wifiOnly: v})}
+            />
+          </View>
+
+          <Text variant="labelSmall" style={styles.textDescription}>
+            Connection. 'Auto' reads the live network state (metered until the OS
+            reports otherwise). Override to Wi-Fi / Cellular / Unknown if
+            detection is wrong (e.g. a metered hotspot). 'Unknown' is treated as
+            metered, so nothing leaves the device until Wi-Fi is confirmed.
+          </Text>
+          <SegmentedButtons
+            testID="routing-connection-buttons"
+            value={routeStore.connection}
+            onValueChange={v =>
+              routeStore.setConnection(v as ConnectionMode)
+            }
+            density="medium"
+            buttons={CONNECTION_OPTIONS.map(o => ({
+              value: o.value,
+              label: o.label,
+              labelStyle: {fontSize: 10},
+              testID: `routing-connection-${o.value}`,
+            }))}
+            style={styles.segmentedButtons}
+          />
+        </View>
+
+        {/* Live status */}
+        <View style={styles.settingItemContainer}>
+          <Text variant="labelSmall" style={styles.textDescription}>
+            Status:{' '}
+            {modelStore.hybridEngine
+              ? `hybrid active (mode ${mode})`
+              : `single engine (mode ${mode}${hasCloudBackend ? '' : ', no cloud backend'})`}
+          </Text>
+          {modelStore.hybridEngine?.lastDecision && (
+            <Text variant="labelSmall" style={styles.textDescription}>
+              Last route: {modelStore.hybridEngine.lastDecision.reason}
+            </Text>
+          )}
+        </View>
+
+        <Button
+          testID="routing-apply-button"
+          mode="outlined"
+          onPress={() => modelStore.refreshHybridEngine().catch(() => {})}
+        >
+          Apply now
+        </Button>
+      </Card.Content>
+    </Card>
+  );
+});
