--- /dev/null
+++ b/src/services/talents/DictationEngine.ts
@@ -0,0 +1,519 @@
+import {TalentEngine, TalentResult, ToolDefinition, SystemPromptContext} from './types';
+
+const MAX_OUTPUT = 50_000;
+
+function truncate(s: string): string {
+  if (s.length <= MAX_OUTPUT) return s;
+  return s.slice(0, MAX_OUTPUT) + `\n… [truncated, ${s.length - MAX_OUTPUT} chars omitted]`;
+}
+
+// Arabic Unicode blocks
+const ARABIC_RANGES: [number, number][] = [
+  [0x0600, 0x06ff],
+  [0x0750, 0x077f],
+  [0xfb50, 0xfdff],
+  [0xfe70, 0xfeff],
+];
+
+function isArabicCodePoint(cp: number): boolean {
+  for (const [lo, hi] of ARABIC_RANGES) {
+    if (cp >= lo && cp <= hi) return true;
+  }
+  return false;
+}
+
+function isLatinLetter(cp: number): boolean {
+  return (cp >= 0x41 && cp <= 0x5a) || (cp >= 0x61 && cp <= 0x7a);
+}
+
+// Egyptian dialect markers
+const EGYPTIAN_MARKERS = [
+  'ايه', 'ازاي', 'علشان', 'عشان', 'حاجة', 'كده',
+  'عايز', 'عايزة', 'مش', 'بتاع', 'دلوقتي',
+];
+
+// English fillers (whole-word, case-insensitive matching)
+const EN_FILLERS = ['um', 'uh', 'er', 'you know', 'like'];
+
+// Arabic fillers
+const AR_FILLERS = ['يعني', 'بقى', 'اه', 'امم', 'طيب'];
+
+function detectLanguage(text: string): {
+  language: 'ar' | 'en' | 'mixed';
+  arabic_fraction: number;
+  latin_fraction: number;
+  is_rtl: boolean;
+  dialect_hint?: 'egyptian';
+} {
+  let arabicCount = 0;
+  let latinCount = 0;
+  let totalLetters = 0;
+
+  for (const ch of text) {
+    const cp = ch.codePointAt(0)!;
+    if (isArabicCodePoint(cp)) {
+      arabicCount++;
+      totalLetters++;
+    } else if (isLatinLetter(cp)) {
+      latinCount++;
+      totalLetters++;
+    }
+  }
+
+  const arabic_fraction = totalLetters > 0 ? Math.round((arabicCount / totalLetters) * 1000) / 1000 : 0;
+  const latin_fraction = totalLetters > 0 ? Math.round((latinCount / totalLetters) * 1000) / 1000 : 0;
+
+  let language: 'ar' | 'en' | 'mixed';
+  if (arabic_fraction > 0.5 && latin_fraction < 0.2) {
+    language = 'ar';
+  } else if (latin_fraction > 0.5 && arabic_fraction < 0.2) {
+    language = 'en';
+  } else {
+    language = 'mixed';
+  }
+
+  const is_rtl = arabic_fraction > latin_fraction;
+
+  const result: {
+    language: 'ar' | 'en' | 'mixed';
+    arabic_fraction: number;
+    latin_fraction: number;
+    is_rtl: boolean;
+    dialect_hint?: 'egyptian';
+  } = {language, arabic_fraction, latin_fraction, is_rtl};
+
+  // Check Egyptian dialect markers
+  for (const marker of EGYPTIAN_MARKERS) {
+    if (text.includes(marker)) {
+      result.dialect_hint = 'egyptian';
+      break;
+    }
+  }
+
+  return result;
+}
+
+function removeDuplicateWords(text: string): string {
+  // Collapse consecutive repeated words: "the the" -> "the"
+  // Match word boundary, a word, whitespace, then the same word again
+  let prev = text;
+  let result = text;
+  do {
+    prev = result;
+    result = result.replace(/\b(\S+)\s+\1\b/gi, '$1');
+  } while (result !== prev);
+  return result;
+}
+
+function removeEnglishFillers(text: string): {text: string; removed: string[]} {
+  const removed: string[] = [];
+
+  // Remove "you know" as filler (when surrounded by punctuation/whitespace boundaries)
+  let working = text;
+
+  // "you know" - only when it appears as an isolated filler between commas or at sentence boundaries
+  const youKnowPattern = /,\s*you know\s*,/gi;
+  if (youKnowPattern.test(working)) {
+    working = working.replace(youKnowPattern, ',');
+    removed.push('you know');
+  }
+
+  // Standalone fillers: um, uh, er, like (as filler)
+  // Match when surrounded by whitespace, at start/end, or between commas
+  const fillerPattern = /\b(um|uh|er)\b/gi;
+  let match;
+  const tempText = working;
+  const fillerRegex = /\b(um|uh|er)\b/gi;
+  while ((match = fillerRegex.exec(tempText)) !== null) {
+    removed.push(match[1].toLowerCase());
+  }
+  working = working.replace(/\s*\b(um|uh|er)\b\s*/gi, ' ');
+
+  // "like" as filler - only when it appears between commas or as isolated filler
+  // Be conservative: only remove "like" when it's clearly a filler (between commas or after "um/uh")
+  const likeFillerPattern = /,\s*like\s*,/gi;
+  if (likeFillerPattern.test(working)) {
+    working = working.replace(likeFillerPattern, ',');
+    removed.push('like');
+  }
+
+  return {text: working, removed};
+}
+
+function removeArabicFillers(text: string): {text: string; removed: string[]} {
+  const removed: string[] = [];
+  let working = text;
+
+  for (const filler of AR_FILLERS) {
+    // Remove filler when it appears as an isolated word (at start, end, or between whitespace)
+    const pattern = new RegExp(`(^|\\s)${filler}(\\s|$)`, 'g');
+    let prev = '';
+    while (prev !== working) {
+      prev = working;
+      const matches = working.match(pattern);
+      if (matches) {
+        for (const m of matches) {
+          removed.push(filler);
+        }
+        working = working.replace(pattern, ' ');
+      }
+    }
+  }
+
+  return {text: working, removed};
+}
+
+function normalizeWhitespace(text: string): string {
+  return text.replace(/\s+/g, ' ').trim();
+}
+
+function fixDoubledPunctuation(text: string): string {
+  return text.replace(/([.,!?;:])\1+/g, '$1');
+}
+
+function capitalizeEnglishSentences(text: string): string {
+  // Capitalize first letter after sentence-ending punctuation + space, and first letter of string
+  return text.replace(/(?:^|[.!?]\s+)([a-z])/g, (match, letter) => {
+    return match.slice(0, -1) + letter.toUpperCase();
+  });
+}
+
+function cleanText(text: string, lang: 'ar' | 'en' | 'mixed'): {
+  cleaned_text: string;
+  removed: string[];
+  changes_made: number;
+} {
+  const allRemoved: string[] = [];
+  let changes = 0;
+  let working = text;
+
+  // Always normalize whitespace and fix doubled punctuation
+  const beforeWs = working;
+  working = normalizeWhitespace(working);
+  if (working !== beforeWs) changes++;
+
+  const beforePunct = working;
+  working = fixDoubledPunctuation(working);
+  if (working !== beforePunct) changes++;
+
+  // Remove duplicate words (language-agnostic)
+  const beforeDup = working;
+  working = removeDuplicateWords(working);
+  if (working !== beforeDup) changes++;
+
+  if (lang === 'en' || lang === 'mixed') {
+    const enResult = removeEnglishFillers(working);
+    working = enResult.text;
+    allRemoved.push(...enResult.removed);
+  }
+
+  if (lang === 'ar' || lang === 'mixed') {
+    const arResult = removeArabicFillers(working);
+    working = arResult.text;
+    allRemoved.push(...arResult.removed);
+  }
+
+  // Normalize whitespace again after filler removal
+  const beforeFinalWs = working;
+  working = normalizeWhitespace(working);
+  if (working !== beforeFinalWs) changes++;
+
+  // Run duplicate removal again (filler removal may have created new adjacent duplicates)
+  const beforeDup2 = working;
+  working = removeDuplicateWords(working);
+  if (working !== beforeDup2) changes++;
+
+  // Capitalize English sentences
+  if (lang === 'en' || lang === 'mixed') {
+    const beforeCap = working;
+    working = capitalizeEnglishSentences(working);
+    if (working !== beforeCap) changes++;
+  }
+
+  // Also capitalize first character for English
+  if ((lang === 'en' || lang === 'mixed') && working.length > 0) {
+    const first = working[0];
+    if (/[a-z]/.test(first)) {
+      working = first.toUpperCase() + working.slice(1);
+      changes++;
+    }
+  }
+
+  changes += allRemoved.length;
+
+  return {cleaned_text: working, removed: allRemoved, changes_made: changes};
+}
+
+function deriveSubjectFromFirstWords(text: string): string {
+  // Take first 6 words, make a neutral subject
+  const words = text.split(/\s+/).slice(0, 6).join(' ');
+  // Capitalize first letter
+  const subject = words.length > 0 ? words[0].toUpperCase() + words.slice(1) : words;
+  return `[auto-drafted] ${subject}${words.split(/\s+/).length >= 6 ? '...' : ''}`;
+}
+
+function paragraphBody(text: string): string {
+  // Split on existing blank lines or sentence boundaries
+  // If text already has paragraph breaks, preserve them
+  if (text.includes('\n\n')) {
+    return text;
+  }
+
+  // Split into sentences and group into paragraphs of ~2-3 sentences
+  const sentences = text.split(/(?<=[.!?])\s+/);
+  if (sentences.length <= 2) {
+    return text;
+  }
+
+  const paragraphs: string[] = [];
+  for (let i = 0; i < sentences.length; i += 3) {
+    paragraphs.push(sentences.slice(i, i + 3).join(' '));
+  }
+  return paragraphs.join('\n\n');
+}
+
+function wordCount(text: string): number {
+  return text.split(/\s+/).filter(w => w.length > 0).length;
+}
+
+type DictationOperation = 'detect' | 'clean' | 'email' | 'message';
+
+const OPERATIONS: DictationOperation[] = ['detect', 'clean', 'email', 'message'];
+
+export class DictationEngine implements TalentEngine {
+  readonly name = 'dictation';
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const operation = args.operation as string | undefined;
+    if (!operation || !OPERATIONS.includes(operation as DictationOperation)) {
+      return {
+        type: 'error',
+        summary: `dictation: unknown or missing operation "${operation}". Valid: ${OPERATIONS.join(', ')}`,
+        errorMessage: `operation must be one of: ${OPERATIONS.join(', ')}`,
+      };
+    }
+
+    const text = typeof args.text === 'string' ? args.text : '';
+    if (!text) {
+      return {
+        type: 'error',
+        summary: `dictation: missing or empty "text" argument for ${operation}`,
+        errorMessage: 'text argument is required and must be a non-empty string',
+      };
+    }
+
+    try {
+      switch (operation) {
+        case 'detect':
+          return this.detect(text);
+        case 'clean':
+          return this.clean(text);
+        case 'email':
+          return this.email(text, args);
+        case 'message':
+          return this.message(text, args);
+        default:
+          return {
+            type: 'error',
+            summary: `dictation: unhandled operation "${operation}"`,
+            errorMessage: 'unhandled operation',
+          };
+      }
+    } catch (e) {
+      const errMsg = e instanceof Error ? e.message : String(e);
+      return {
+        type: 'error',
+        summary: `dictation: ${operation} failed — ${errMsg}`,
+        errorMessage: errMsg,
+      };
+    }
+  }
+
+  private detect(text: string): TalentResult {
+    const info = detectLanguage(text);
+    const parts: string[] = [
+      `language: ${info.language}`,
+      `arabic_fraction: ${info.arabic_fraction}`,
+      `latin_fraction: ${info.latin_fraction}`,
+      `is_rtl: ${info.is_rtl}`,
+    ];
+    if (info.dialect_hint) {
+      parts.push(`dialect_hint: ${info.dialect_hint}`);
+    }
+    return {
+      type: 'text',
+      summary: truncate(parts.join('\n')),
+    };
+  }
+
+  private clean(text: string): TalentResult {
+    const info = detectLanguage(text);
+    const result = cleanText(text, info.language);
+
+    const parts = [
+      `cleaned_text: ${result.cleaned_text}`,
+      `language: ${info.language}`,
+      `removed: [${result.removed.join(', ')}]`,
+      `changes_made: ${result.changes_made}`,
+    ];
+    return {
+      type: 'text',
+      summary: truncate(parts.join('\n')),
+    };
+  }
+
+  private email(text: string, args: Record<string, any>): TalentResult {
+    const info = detectLanguage(text);
+    const lang = args.language as string | undefined || info.language;
+    const tone = (args.tone as 'formal' | 'neutral' | 'warm') || 'neutral';
+    const to = args.to as string | undefined;
+    const subjectArg = args.subject as string | undefined;
+
+    const cleanResult = cleanText(text, info.language);
+    const body = paragraphBody(cleanResult.cleaned_text);
+    const wc = wordCount(body);
+
+    const isArabic = lang === 'ar' || (lang === 'mixed' && info.arabic_fraction > info.latin_fraction);
+
+    // Subject
+    const subject = subjectArg || deriveSubjectFromFirstWords(cleanResult.cleaned_text);
+
+    // Greeting
+    let greeting: string;
+    if (isArabic) {
+      if (tone === 'formal') {
+        greeting = to
+          ? `السادة ${to} المحترم،`
+          : 'تحية طيبة وبعد،';
+      } else {
+        greeting = to
+          ? `أهلاً ${to}،`
+          : 'مرحبا،';
+      }
+    } else {
+      const recipientName = to || '[RECIPIENT_NAME]';
+      if (tone === 'formal') {
+        greeting = `Dear ${recipientName},`;
+      } else if (tone === 'warm') {
+        greeting = `Hi ${recipientName},`;
+      } else {
+        greeting = `Hi ${recipientName},`;
+      }
+    }
+
+    // Closing
+    let closing: string;
+    if (isArabic) {
+      closing = tone === 'formal'
+        ? 'وتفضلوا بقبول فائق الاحترام،'
+        : 'مع خالص التحية،';
+    } else {
+      if (tone === 'formal') {
+        closing = 'Sincerely,';
+      } else if (tone === 'warm') {
+        closing = 'Best regards,';
+      } else {
+        closing = 'Kind regards,';
+      }
+    }
+
+    const signaturePlaceholder = '[SIGNATURE]';
+
+    const emailText = [
+      `Subject: ${subject}`,
+      '',
+      greeting,
+      '',
+      body,
+      '',
+      closing,
+      signaturePlaceholder,
+    ].join('\n');
+
+    const parts = [
+      emailText,
+      '',
+      `---`,
+      `language: ${lang}`,
+      `tone: ${tone}`,
+      `word_count: ${wc}`,
+    ];
+
+    return {
+      type: 'text',
+      summary: truncate(parts.join('\n')),
+    };
+  }
+
+  private message(text: string, args: Record<string, any>): TalentResult {
+    const info = detectLanguage(text);
+    const cleanResult = cleanText(text, info.language);
+
+    // For messages: just cleaned text with light paragraph handling
+    let msgText = cleanResult.cleaned_text;
+
+    // Trim trailing punctuation artifacts
+    msgText = normalizeWhitespace(msgText);
+
+    const parts = [
+      `message: ${msgText}`,
+      `language: ${info.language}`,
+      `word_count: ${wordCount(msgText)}`,
+    ];
+
+    return {
+      type: 'text',
+      summary: truncate(parts.join('\n')),
+    };
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: 'dictation',
+        description:
+          'Process raw voice-dictation transcripts: detect language/dialect, clean disfluencies (fillers, repeated words, doubled punctuation), scaffold into email or short-message form. Does NOT translate, transliterate, or convert dialect to MSA — that is the model\'s job after cleaning.',
+        parameters: {
+          type: 'object',
+          properties: {
+            operation: {
+              type: 'string',
+              enum: OPERATIONS,
+              description:
+                '"detect" identifies language/dialect; "clean" removes disfluencies; "email" scaffolds into email format; "message" produces short-message form.',
+            },
+            text: {
+              type: 'string',
+              description: 'The raw voice transcript to process.',
+            },
+            to: {
+              type: 'string',
+              description: 'Recipient name (for email operation).',
+            },
+            subject: {
+              type: 'string',
+              description: 'Email subject line. If omitted, auto-drafted from first words.',
+            },
+            tone: {
+              type: 'string',
+              enum: ['formal', 'neutral', 'warm'],
+              description: 'Tone for email/message scaffolding. Default "neutral".',
+            },
+            language: {
+              type: 'string',
+              description: 'Override detected language ("ar", "en"). Usually auto-detected.',
+            },
+          },
+          required: ['operation', 'text'],
+        },
+      },
+    };
+  }
+
+  systemPromptFragment(_ctx: SystemPromptContext): string | null {
+    return `When the user dictates a message or email (using the OS keyboard dictation), call the "dictation" talent with the raw transcript. Use operation "clean" to strip disfluencies, or "email" to scaffold into an email structure. The dictation tool only cleans and scaffolds — it never invents content.
+
+IMPORTANT: When the user dictates in Egyptian street Arabic (عامية) and asks for an email or formal message, YOU (the model) must produce the formal Arabic (فصحى / MSA) version as the body after the tool returns the cleaned text. The tool preserves the user's dialect verbatim (minus fillers); converting عامية to فصحى and polishing register for business/network clients is YOUR responsibility, not the tool's. Never fabricate content the user did not dictate — you may clean, structure, and adjust register, but do not add facts, figures, or commitments the user did not state.`;
+  }
+}
