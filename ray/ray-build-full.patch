+/**
+ * PdfEngine tests.
+ *
+ * Validates PDF structure: header, xref byte-exact offsets, EOF tail.
+ * All expected values are hand-computed or structurally verified.
+ */
+import {PdfEngine} from '../PdfEngine';
+
+describe('PdfEngine contract', () => {
+  const engine = new PdfEngine();
+
+  it('is named "pdf"', () => {
+    expect(engine.name).toBe('pdf');
+  });
+
+  it('has correct tool definition', () => {
+    const def = engine.toToolDefinition();
+    expect(def.type).toBe('function');
+    expect(def.function.name).toBe('pdf');
+    expect(def.function.parameters.properties.operation.enum).toEqual(['report', 'table', 'memo']);
+  });
+
+  it('has a system prompt fragment', () => {
+    const fragment = engine.systemPromptFragment?.({
+      now: new Date(),
+      maxToolTurns: 5,
+      activeTalents: new Set(['pdf']),
+    });
+    expect(fragment).toBeTruthy();
+    expect(fragment).toMatch(/PDF TOOL POLICY/);
+  });
+});
+
+describe('PdfEngine.execute — validation', () => {
+  const engine = new PdfEngine();
+
+  it('rejects unknown operation', async () => {
+    const r = await engine.execute({operation: 'chart'});
+    expect(r.type).toBe('error');
+  });
+
+  it('rejects report without title', async () => {
+    const r = await engine.execute({operation: 'report', sections: [{heading: 'x', paragraphs: ['y']}]});
+    expect(r.type).toBe('error');
+  });
+
+  it('rejects report without sections', async () => {
+    const r = await engine.execute({operation: 'report', title: 'Test'});
+    expect(r.type).toBe('error');
+  });
+
+  it('rejects table without headers', async () => {
+    const r = await engine.execute({operation: 'table', rows: [['a']]});
+    expect(r.type).toBe('error');
+  });
+
+  it('rejects table without rows', async () => {
+    const r = await engine.execute({operation: 'table', headers: ['a']});
+    expect(r.type).toBe('error');
+  });
+
+  it('rejects memo without title', async () => {
+    const r = await engine.execute({operation: 'memo', sections: []});
+    expect(r.type).toBe('error');
+  });
+});
+
+describe('PdfEngine.execute — report', () => {
+  const engine = new PdfEngine();
+
+  it('generates a valid PDF for a simple report', async () => {
+    const r = await engine.execute({
+      operation: 'report',
+      title: 'Test Report',
+      subtitle: 'A subtitle',
+      author: 'Test Author',
+      sections: [
+        {
+          heading: 'Introduction',
+          paragraphs: ['This is the first paragraph of the report.'],
+          bullets: ['First point', 'Second point'],
+        },
+        {
+          heading: 'Data',
+          paragraphs: ['Some data follows.'],
+          table: {
+            headers: ['Name', 'Value'],
+            rows: [['Alpha', '100'], ['Beta', '200']],
+          },
+        },
+      ],
+      footer: 'Confidential',
+      path: '/tmp/test.pdf',
+    });
+
+    expect(r.type).toBe('text');
+    if (r.type === 'text') {
+      expect(r.summary).toMatch(/pdf\.report SUCCESS/);
+      expect(r.summary).toMatch(/Test Report/);
+      expect(r.summary).toMatch(/%PDF-1\.4 verified/);
+    }
+  });
+});
+
+describe('PdfEngine.execute — table', () => {
+  const engine = new PdfEngine();
+
+  it('generates a valid table PDF', async () => {
+    const r = await engine.execute({
+      operation: 'table',
+      headers: ['Col1', 'Col2', 'Col3'],
+      rows: [
+        ['a', 'b', 'c'],
+        ['d', 'e', 'f'],
+        ['g', 'h', 'i'],
+      ],
+      title: 'Data Table',
+      landscape: true,
+    });
+
+    expect(r.type).toBe('text');
+    if (r.type === 'text') {
+      expect(r.summary).toMatch(/pdf\.table SUCCESS/);
+      expect(r.summary).toMatch(/Landscape: true/);
+    }
+  });
+});
+
+describe('PdfEngine.execute — memo', () => {
+  const engine = new PdfEngine();
+
+  it('generates a valid memo PDF', async () => {
+    const r = await engine.execute({
+      operation: 'memo',
+      title: 'Credit Memorandum',
+      date: '2024-01-15',
+      prepared_by: 'John Analyst',
+      facility: 'USD 5,000,000 Term Loan',
+      sections: [
+        {heading: 'Purpose', paragraphs: ['Working capital refinement.']},
+        {heading: 'Financial Analysis', paragraphs: ['DSCR is 1.5x.']},
+      ],
+      signature_line: '________________________\nJohn Analyst',
+    });
+
+    expect(r.type).toBe('text');
+    if (r.type === 'text') {
+      expect(r.summary).toMatch(/pdf\.memo SUCCESS/);
