+import {TalentEngine, TalentResult, ToolDefinition, SystemPromptContext} from './types';
+
+/**
+ * AstroEngine — deterministic real astronomy.
+ *
+ * All computations are closed-form / truncated series. No external dependencies.
+ * The math is real; the interpretation is the persona's fun.
+ *
+ * References:
+ * - Meeus, "Astronomical Algorithms" (2nd ed.) for solar/lunar positions
+ * - NOAA Solar Calculator for sunrise/sunset
+ * - JPL approximate Keplerian elements for planets (1800-2050)
+ * - Synodic month = 29.530588853 days
+ * - Known new moon epoch: 2000-01-06 18:14 UTC (J2000.0 cycle)
+ */
+
+const DEG = Math.PI / 180;
+const RAD = 180 / Math.PI;
+
+function norm360(x: number): number {
+  return ((x % 360) + 360) % 360;
+}
+
+/** Julian Day Number from a UTC Date. */
+function dateToJD(d: Date): number {
+  const y = d.getUTCFullYear();
+  const m = d.getUTCMonth() + 1;
+  const day = d.getUTCDate() + d.getUTCHours() / 24 + d.getUTCMinutes() / 1440 + d.getUTCSeconds() / 86400;
+  let yr = y;
+  let mo = m;
+  if (mo <= 2) { yr--; mo += 12; }
+  const A = Math.floor(yr / 100);
+  const B = 2 - A + Math.floor(A / 4);
+  return Math.floor(365.25 * (yr + 4716)) + Math.floor(30.6001 * (mo + 1)) + day + B - 1524.5;
+}
+
+function jdToDate(jd: number): Date {
+  const z = Math.floor(jd + 0.5);
+  const f = jd + 0.5 - z;
+  let A: number;
+  if (z < 2299161) { A = z; }
+  else {
+    const alpha = Math.floor((z - 1867216.25) / 36524.25);
+    A = z + 1 + alpha - Math.floor(alpha / 4);
+  }
+  const B = A + 1524;
+  const C = Math.floor((B - 122.1) / 365.25);
+  const D = Math.floor(365.25 * C);
+  const E = Math.floor((B - D) / 30.6001);
+  const dayFrac = B - D - Math.floor(30.6001 * E) + f;
+  const month = E < 14 ? E - 1 : E - 13;
+  const year = month > 2 ? C - 4716 : C - 4715;
+  const dayInt = Math.floor(dayFrac);
+  const remainder = (dayFrac - dayInt);
+  const hours = Math.floor(remainder * 24);
+  const mins = Math.floor((remainder * 24 - hours) * 60);
+  const secs = Math.round(((remainder * 24 - hours) * 60 - mins) * 60);
+  return new Date(Date.UTC(year, month - 1, dayInt, hours, mins, secs));
+}
+
+/** Julian centuries from J2000.0 */
+function jcFromJD(jd: number): number {
+  return (jd - 2451545.0) / 36525.0;
+}
+
+// ─── Moon Phase ─────────────────────────────────────────────────────────────
+
+const SYNODIC_MONTH = 29.530588853; // days
+// Known new moon: 2000-01-06 18:14 UTC = JD 2451550.2597
+const KNOWN_NEW_MOON_JD = 2451550.2597;
+
+const MOON_PHASES = [
+  'New Moon',
+  'Waxing Crescent',
+  'First Quarter',
+  'Waxing Gibbous',
+  'Full Moon',
+  'Waning Gibbous',
+  'Last Quarter',
+  'Waning Crescent',
+];
+
+function moonAge(jd: number): number {
+  const diff = jd - KNOWN_NEW_MOON_JD;
+  const cycles = diff / SYNODIC_MONTH;
+  const age = (cycles - Math.floor(cycles)) * SYNODIC_MONTH;
+  return age;
+}
+
+function moonPhaseName(age: number): string {
+  const phase = age / SYNODIC_MONTH;
+  const idx = Math.floor(phase * 8) % 8;
+  return MOON_PHASES[idx];
+}
+
+function moonIllumination(age: number): number {
+  // Closed-form illumination from phase angle
+  const phaseAngle = (age / SYNODIC_MONTH) * 2 * Math.PI;
+  return (1 - Math.cos(phaseAngle)) / 2 * 100;
+}
+
+function nextNewMoon(jd: number): Date {
+  const age = moonAge(jd);
+  const daysToNew = SYNODIC_MONTH - age;
+  return jdToDate(jd + daysToNew);
+}
+
+function nextFullMoon(jd: number): Date {
+  const age = moonAge(jd);
+  const halfCycle = SYNODIC_MONTH / 2;
+  let daysToFull: number;
+  if (age < halfCycle) {
+    daysToFull = halfCycle - age;
+  } else {
+    daysToFull = SYNODIC_MONTH - age + halfCycle;
+  }
+  return jdToDate(jd + daysToFull);
+}
+
+// ─── Sun Position (NOAA) ────────────────────────────────────────────────────
+
+/** Solar declination (degrees) from Julian century. */
+function sunDeclination(T: number): number {
+  // Low-precision: mean obliquity + sun's equation of center
+  const L0 = norm360(280.46646 + 36000.76983 * T + 0.0003032 * T * T);
+  const M = 357.52911 + 35999.05029 * T - 0.0001537 * T * T;
+  const Mrad = M * DEG;
+  const C = (1.914602 - 0.004817 * T - 0.000014 * T * T) * Math.sin(Mrad)
+    + (0.019993 - 0.000101 * T) * Math.sin(2 * Mrad)
+    + 0.000289 * Math.sin(3 * Mrad);
+  const sunLon = L0 + C;
+  const obliquity = 23.439291 - 0.013004 * T;
+  return Math.asin(Math.sin(obliquity * DEG) * Math.sin(sunLon * DEG)) * RAD;
+}
+
+/** Sun ecliptic longitude (degrees). */
+function sunEclipticLon(T: number): number {
+  const L0 = norm360(280.46646 + 36000.76983 * T + 0.0003032 * T * T);
+  const M = 357.52911 + 35999.05029 * T - 0.0001537 * T * T;
+  const Mrad = M * DEG;
+  const C = (1.914602 - 0.004817 * T - 0.000014 * T * T) * Math.sin(Mrad)
+    + (0.019993 - 0.000101 * T) * Math.sin(2 * Mrad)
+    + 0.000289 * Math.sin(3 * Mrad);
+  return norm360(L0 + C);
+}
+
+/** Equation of time in minutes. */
+function equationOfTime(T: number): number {
+  const L0 = norm360(280.46646 + 36000.76983 * T + 0.0003032 * T * T) * DEG;
+  const M = (357.52911 + 35999.05029 * T - 0.0001537 * T * T) * DEG;
+  const e = 0.016708634 - 0.000042037 * T;
+  const eps = (23.439291 - 0.013004 * T) * DEG;
+
+  const y = Math.tan(eps / 2) ** 2;
+  const EqT = y * Math.sin(2 * L0)
+    - 2 * e * Math.sin(M)
+    + 4 * e * y * Math.sin(M) * Math.cos(2 * L0)
+    - 0.5 * y * y * Math.sin(4 * L0)
+    - 1.25 * e * e * Math.sin(2 * M);
+  return EqT * RAD * 4; // convert to minutes (× 180/π × 4 min/deg)
+}
+
+/** Sunrise/sunset calculation (NOAA algorithm). Returns times as fractional hours UTC, or null for polar cases. */
+function sunriseSet(jd: number, lat: number, lon: number): {
+  sunrise: number | null;
+  sunset: number | null;
+  solarNoon: number;
+  dayLength: number | null;
+  declination: number;
+} {
+  const T = jcFromJD(jd);
+  const eqTime = equationOfTime(T);
+  const decl = sunDeclination(T);
+
+  const zenith = 90.833; // standard refraction-corrected zenith
+  const latRad = lat * DEG;
+  const declRad = decl * DEG;
+
+  const cosHA = (Math.cos(zenith * DEG) - Math.sin(latRad) * Math.sin(declRad))
+    / (Math.cos(latRad) * Math.cos(declRad));
+
+  const solarNoon = (720 - 4 * lon - eqTime) / 1440; // fraction of day UTC
+
+  if (cosHA > 1) {
+    // Sun never rises (polar night)
+    return {sunrise: null, sunset: null, solarNoon, dayLength: null, declination: decl};
+  }
+  if (cosHA < -1) {
+    // Sun never sets (midnight sun)
+    return {sunrise: null, sunset: null, solarNoon, dayLength: null, declination: decl};
+  }
+
+  const HA = Math.acos(cosHA) * RAD; // degrees
+  const sunrise = (720 - 4 * (lon + HA) - eqTime) / 1440; // fraction of day UTC
+  const sunset = (720 - 4 * (lon - HA) - eqTime) / 1440;
+  const dayLength = (2 * HA) / 15; // hours
+
+  return {sunrise, sunset, solarNoon, dayLength, declination: decl};
+}
+
+function fracHoursToHHMM(frac: number): string {
+  const totalMin = Math.round(frac * 1440);
+  const h = Math.floor(totalMin / 60) % 24;
+  const m = totalMin % 60;
+  return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
+}
