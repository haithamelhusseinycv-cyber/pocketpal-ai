+        maxToolTurns: 10,
+        activeTalents: new Set<string>(),
+      };
+      const fragment = engine.systemPromptFragment!(ctx);
+      expect(fragment).toContain('logcat');
+      expect(fragment).toContain('triage');
+    });
+  });
+});
diff --git a/src/services/talents/__tests__/MicrosoftGraphEngine.test.ts b/src/services/talents/__tests__/MicrosoftGraphEngine.test.ts
new file mode 100644
index 0000000..d169638
--- /dev/null
+++ b/src/services/talents/__tests__/MicrosoftGraphEngine.test.ts
@@ -0,0 +1,290 @@
+/**
+ * Tests for MicrosoftGraphEngine — offline-testable parts only.
+ *
+ * Tests:
+ * - PKCE helpers (RFC 7636 test vector)
+ * - Config constants
+ * - URL builders
+ * - Error-code mapping
+ * - Talent's not_configured/not_authenticated error paths
+ *
+ * Live Graph calls are UNTESTABLE in the sandbox.
+ */
+
+import {MicrosoftGraphEngine} from '../MicrosoftGraphEngine';
+import {
+  generateCodeVerifier,
+  codeChallengeFromVerifier,
+  GRAPH_BASE,
+  LOGIN_BASE,
+  DEFAULT_SCOPES,
+} from '../../graph/config';
+import {buildAuthorizationUrlWithClientId} from '../../graph/auth';
+import {GraphError} from '../../graph/types';
+
+describe('MicrosoftGraphEngine', () => {
+  describe('PKCE helpers (RFC 7636)', () => {
+    it('generates a code verifier of correct length', () => {
+      const verifier = generateCodeVerifier();
+      expect(verifier.length).toBe(64);
+      // Should only contain unreserved characters
+      expect(verifier).toMatch(/^[A-Za-z0-9-._~]+$/);
+    });
+
+    it('produces the correct code challenge from the RFC 7636 test vector', () => {
+      // RFC 7636 Appendix B test vector
+      const verifier = 'dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk';
+      const expectedChallenge = 'E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM';
+
+      const challenge = codeChallengeFromVerifier(verifier);
+      expect(challenge).toBe(expectedChallenge);
+    });
+
+    it('produces different challenges for different verifiers', () => {
+      const verifier1 = 'test-verifier-1';
+      const verifier2 = 'test-verifier-2';
+
+      const challenge1 = codeChallengeFromVerifier(verifier1);
+      const challenge2 = codeChallengeFromVerifier(verifier2);
+
+      expect(challenge1).not.toBe(challenge2);
+    });
+  });
+
+  describe('Config constants', () => {
+    it('has correct Graph base URL', () => {
+      expect(GRAPH_BASE).toBe('https://graph.microsoft.com/v1.0');
+    });
+
+    it('has correct login base URL', () => {
+      expect(LOGIN_BASE).toBe('https://login.microsoftonline.com');
+    });
+
+    it('has the expected default scopes', () => {
+      expect(DEFAULT_SCOPES).toContain('offline_access');
+      expect(DEFAULT_SCOPES).toContain('User.Read');
+      expect(DEFAULT_SCOPES).toContain('Mail.Read');
+      expect(DEFAULT_SCOPES).toContain('Mail.Send');
+      expect(DEFAULT_SCOPES).toContain('Calendars.Read');
+      expect(DEFAULT_SCOPES).toContain('Calendars.ReadWrite');
+      expect(DEFAULT_SCOPES).toContain('Files.Read');
+    });
+  });
+
+  describe('URL builders', () => {
+    it('builds a correct authorization URL with PKCE parameters', () => {
+      const clientId = 'test-client-id';
+      const state = 'test-state';
+      const codeChallenge = 'test-challenge';
+      const redirectUri = 'msauth.com.test://auth';
+
+      const url = buildAuthorizationUrlWithClientId(
+        clientId,
+        state,
+        codeChallenge,
+        redirectUri,
+      );
+
+      expect(url).toContain('https://login.microsoftonline.com/common/oauth2/v2.0/authorize');
+      expect(url).toContain('client_id=test-client-id');
+      expect(url).toContain('response_type=code');
+      expect(url).toContain('redirect_uri=');
+      expect(url).toContain('state=test-state');
+      expect(url).toContain('code_challenge=test-challenge');
+      expect(url).toContain('code_challenge_method=S256');
+      expect(url).toContain('scope=');
+    });
+  });
+
+  describe('Error mapping', () => {
+    it('creates GraphError with correct code and message', () => {
+      const error = new GraphError('not_configured', 'Test message');
+      expect(error.code).toBe('not_configured');
+      expect(error.message).toBe('Test message');
+      expect(error.name).toBe('GraphError');
+    });
+
+    it('includes status when provided', () => {
+      const error = new GraphError('permission_denied', 'Forbidden', 403);
+      expect(error.code).toBe('permission_denied');
+      expect(error.status).toBe(403);
+    });
+  });
+
+  describe('Talent schema', () => {
+    it('exposes the microsoft_graph tool definition with required op param', () => {
+      const engine = new MicrosoftGraphEngine();
+      const def = engine.toToolDefinition();
+
+      expect(def.function.name).toBe('microsoft_graph');
+      expect(def.function.parameters.required).toEqual(['op']);
+      expect(def.function.parameters.properties.op.enum).toContain('status');
+      expect(def.function.parameters.properties.op.enum).toContain('mail_list');
+      expect(def.function.parameters.properties.op.enum).toContain('calendar_list');
+      expect(def.function.parameters.properties.op.enum).toContain('files_list');
+    });
+
+    it('has the correct talent name', () => {
+      const engine = new MicrosoftGraphEngine();
+      expect(engine.name).toBe('microsoft_graph');
+    });
+
+    it('has recommendedContextTokens set', () => {
+      const engine = new MicrosoftGraphEngine();
+      expect(engine.recommendedContextTokens).toBe(1200);
+    });
+  });
+
+  describe('Honest error paths', () => {
+    it('returns not_configured error when no client-id is set', async () => {
+      const engine = new MicrosoftGraphEngine();
+
+      // In test environment, no client-id is configured
+      const result = await engine.execute({op: 'mail_list'});
+
+      expect(result.type).toBe('error');
+      if (result.type === 'error') {
+        expect(result.summary).toMatch(/not configured/i);
+        expect(result.errorMessage).toMatch(/not configured/i);
+      }
+    });
+
+    it('returns status honestly when not configured', async () => {
+      const engine = new MicrosoftGraphEngine();
+
+      const result = await engine.execute({op: 'status'});
+
+      expect(result.type).toBe('text');
+      if (result.type === 'text') {
+        expect(result.summary).toContain('not_configured');
+        expect(result.summary).toContain('Activation required');
+      }
+    });
+
+    it('returns error for unknown operation', async () => {
+      const engine = new MicrosoftGraphEngine();
+
+      const result = await engine.execute({op: 'unknown_op'});
+
+      expect(result.type).toBe('error');
+      if (result.type === 'error') {
+        expect(result.summary).toMatch(/unknown or missing operation/i);
+      }
+    });
+
+    it('returns error for missing operation', async () => {
+      const engine = new MicrosoftGraphEngine();
+
+      const result = await engine.execute({});
+
+      expect(result.type).toBe('error');
+      if (result.type === 'error') {
+        expect(result.summary).toMatch(/unknown or missing operation/i);
+      }
+    });
+  });
+
+  describe('System prompt fragment', () => {
+    it('returns a non-null fragment', () => {
+      const engine = new MicrosoftGraphEngine();
+      const ctx = {
+        now: new Date(),
+        maxToolTurns: 10,
+        activeTalents: new Set(['microsoft_graph']),
+      };
+
+      const fragment = engine.systemPromptFragment!(ctx);
+
+      expect(fragment).not.toBeNull();
+      expect(fragment).toContain('microsoft_graph');
+      expect(fragment).toContain('ONLINE');
+      expect(fragment).toContain('NEVER invent or fabricate');
+    });
+  });
+});
+
+// ─── Standalone harness ──────────────────────────────────────────────────────
+
+/**
+ * Standalone test runner for PKCE and config tests.
+ * This can be bundled with esbuild and run in Node.
+ */
+export async function runStandaloneTests() {
+  console.log('\n=== Microsoft Graph Standalone Tests ===\n');
+
+  let passed = 0;
+  let failed = 0;
+
+  function test(name: string, fn: () => void | Promise<void>) {
+    return Promise.resolve()
+      .then(() => fn())
+      .then(() => {
+        console.log(`✓ ${name}`);
+        passed++;
+      })
+      .catch((error) => {
+        console.error(`✗ ${name}`);
+        console.error(`  ${error.message}`);
+        failed++;
+      });
+  }
+
+  // PKCE test vector
+  await test('PKCE RFC 7636 test vector', () => {
+    const verifier = 'dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk';
+    const expected = 'E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM';
+    const actual = codeChallengeFromVerifier(verifier);
+    if (actual !== expected) {
+      throw new Error(`Expected ${expected}, got ${actual}`);
+    }
+  });
+
+  // Config constants
+  await test('Config constants', () => {
+    if (GRAPH_BASE !== 'https://graph.microsoft.com/v1.0') {
+      throw new Error('GRAPH_BASE mismatch');
+    }
+    if (LOGIN_BASE !== 'https://login.microsoftonline.com') {
+      throw new Error('LOGIN_BASE mismatch');
+    }
+    if (!DEFAULT_SCOPES.includes('User.Read')) {
+      throw new Error('DEFAULT_SCOPES missing User.Read');
+    }
+  });
+
+  // URL builder
+  await test('Authorization URL builder', () => {
+    const url = buildAuthorizationUrlWithClientId(
+      'test-client',
+      'test-state',
+      'test-challenge',
+      'msauth.test://auth',
+    );
+    if (!url.includes('login.microsoftonline.com')) {
+      throw new Error('URL missing login base');
+    }
+    if (!url.includes('code_challenge_method=S256')) {
+      throw new Error('URL missing code_challenge_method');
+    }
+  });
+
+  // Talent not_configured
+  await test('Talent returns not_configured honestly', async () => {
+    const engine = new MicrosoftGraphEngine();
+    const result = await engine.execute({op: 'mail_list'});
+    if (result.type !== 'error') {
+      throw new Error('Expected error result');
+    }
+    if (!result.summary.includes('not configured')) {
+      throw new Error('Expected not_configured message');
+    }
+  });
+
+  console.log(`\n=== Summary ===`);
+  console.log(`Passed: ${passed}`);
+  console.log(`Failed: ${failed}`);
+
+  if (failed > 0) {
+    process.exit(1);
+  }
+}
