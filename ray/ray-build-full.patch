+      // s1 = (w[i-2] rotr 19) xor (w[i-2] rotr 61) xor (w[i-2] shr 6)
+      const [r19h, r19l] = rotr64(w[i - 2][0], w[i - 2][1], 19);
+      const [r61h, r61l] = rotr64(w[i - 2][0], w[i - 2][1], 61);
+      const [s6h, s6l] = shr64(w[i - 2][0], w[i - 2][1], 6);
+      const [x2h, x2l] = xor64(r19h, r19l, r61h, r61l);
+      const [s1h, s1l] = xor64(x2h, x2l, s6h, s6l);
+
+      // w[i] = w[i-16] + s0 + w[i-7] + s1
+      const [t1h, t1l] = add64(w[i - 16][0], w[i - 16][1], s0h, s0l);
+      const [t2h, t2l] = add64(t1h, t1l, w[i - 7][0], w[i - 7][1]);
+      const [wh, wl] = add64(t2h, t2l, s1h, s1l);
+      w[i] = [wh, wl];
+    }
+
+    let [ah, al] = H[0];
+    let [bh, bl] = H[1];
+    let [ch, cl] = H[2];
+    let [dh, dl] = H[3];
+    let [eh, el] = H[4];
+    let [fh, fl] = H[5];
+    let [gh, gl] = H[6];
+    let [hh, hl] = H[7];
+
+    for (let i = 0; i < 80; i++) {
+      // S1 = (e rotr 14) xor (e rotr 18) xor (e rotr 41)
+      const [r14h, r14l] = rotr64(eh, el, 14);
+      const [r18h, r18l] = rotr64(eh, el, 18);
+      const [r41h, r41l] = rotr64(eh, el, 41);
+      const [x1h, x1l] = xor64(r14h, r14l, r18h, r18l);
+      const [S1h, S1l] = xor64(x1h, x1l, r41h, r41l);
+
+      // ch = (e and f) xor (not e and g)
+      const [afh, afl] = and64(eh, el, fh, fl);
+      const [neh, nel] = not64(eh, el);
+      const [angh, angl] = and64(neh, nel, gh, gl);
+      const [chh, chl] = xor64(afh, afl, angh, angl);
+
+      // temp1 = h + S1 + ch + K[i] + w[i]
+      const [t1h, t1l] = add64(hh, hl, S1h, S1l);
+      const [t2h, t2l] = add64(t1h, t1l, chh, chl);
+      const [t3h, t3l] = add64(t2h, t2l, K[i][0], K[i][1]);
+      const [temp1h, temp1l] = add64(t3h, t3l, w[i][0], w[i][1]);
+
+      // S0 = (a rotr 28) xor (a rotr 34) xor (a rotr 39)
+      const [r28h, r28l] = rotr64(ah, al, 28);
+      const [r34h, r34l] = rotr64(ah, al, 34);
+      const [r39h, r39l] = rotr64(ah, al, 39);
+      const [x2h, x2l] = xor64(r28h, r28l, r34h, r34l);
+      const [S0h, S0l] = xor64(x2h, x2l, r39h, r39l);
+
+      // maj = (a and b) xor (a and c) xor (b and c)
+      const [abh, abl] = and64(ah, al, bh, bl);
+      const [ach, acl] = and64(ah, al, ch, cl);
+      const [bch, bcl] = and64(bh, bl, ch, cl);
+      const [x3h, x3l] = xor64(abh, abl, ach, acl);
+      const [majh, majl] = xor64(x3h, x3l, bch, bcl);
+
+      // temp2 = S0 + maj
+      const [temp2h, temp2l] = add64(S0h, S0l, majh, majl);
+
+      hh = gh; hl = gl;
+      gh = fh; gl = fl;
+      fh = eh; fl = el;
+      [eh, el] = add64(dh, dl, temp1h, temp1l);
+      dh = ch; dl = cl;
+      ch = bh; cl = bl;
+      bh = ah; bl = al;
+      [ah, al] = add64(temp1h, temp1l, temp2h, temp2l);
+    }
+
+    [H[0][0], H[0][1]] = add64(H[0][0], H[0][1], ah, al);
+    [H[1][0], H[1][1]] = add64(H[1][0], H[1][1], bh, bl);
+    [H[2][0], H[2][1]] = add64(H[2][0], H[2][1], ch, cl);
+    [H[3][0], H[3][1]] = add64(H[3][0], H[3][1], dh, dl);
+    [H[4][0], H[4][1]] = add64(H[4][0], H[4][1], eh, el);
+    [H[5][0], H[5][1]] = add64(H[5][0], H[5][1], fh, fl);
+    [H[6][0], H[6][1]] = add64(H[6][0], H[6][1], gh, gl);
+    [H[7][0], H[7][1]] = add64(H[7][0], H[7][1], hh, hl);
+  }
+
+  // Output as big-endian hex
+  const result = new Uint8Array(64);
+  const resView = new DataView(result.buffer);
+  for (let i = 0; i < 8; i++) {
+    resView.setUint32(i * 8, H[i][0], false);
+    resView.setUint32(i * 8 + 4, H[i][1], false);
+  }
+  return bytesToHex(result);
+}
+
+// ============================================================================
+// CRC32
+// ============================================================================
+
+function crc32(data: Uint8Array): string {
+  // Build CRC table
+  const table = new Uint32Array(256);
+  for (let i = 0; i < 256; i++) {
+    let c = i;
+    for (let j = 0; j < 8; j++) {
+      c = (c & 1) ? (0xedb88320 ^ (c >>> 1)) : (c >>> 1);
+    }
+    table[i] = c >>> 0;
+  }
+
+  let crc = 0xffffffff >>> 0;
+  for (let i = 0; i < data.length; i++) {
+    crc = (table[(crc ^ data[i]) & 0xff] ^ (crc >>> 8)) >>> 0;
+  }
+  crc = (crc ^ 0xffffffff) >>> 0;
+
+  return crc.toString(16).padStart(8, '0');
+}
+
+// ============================================================================
+// HashEngine
+// ============================================================================
+
+export class HashEngine implements TalentEngine {
+  readonly name = 'hash_checksum';
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const algorithm = typeof args.algorithm === 'string' ? args.algorithm.toLowerCase() : '';
+    const data = typeof args.data === 'string' ? args.data : '';
+    const encoding = (typeof args.encoding === 'string' ? args.encoding : 'auto') as InputEncoding;
+
+    if (!algorithm) {
+      return {
+        type: 'error',
+        summary: 'hash_checksum: missing or empty "algorithm" argument',
+        errorMessage: 'algorithm argument is required (md5, sha1, sha256, sha512, crc32)',
+      };
+    }
+
+    if (!['md5', 'sha1', 'sha256', 'sha512', 'crc32'].includes(algorithm)) {
+      return {
+        type: 'error',
+        summary: `hash_checksum: unknown algorithm "${algorithm}"`,
+        errorMessage: 'algorithm must be one of: md5, sha1, sha256, sha512, crc32',
+      };
+    }
+
+    let bytes: Uint8Array;
+    try {
+      bytes = decodeInput(data, encoding);
+    } catch (e) {
+      const errMsg = e instanceof Error ? e.message : String(e);
+      return {
+        type: 'error',
+        summary: 'hash_checksum: failed to decode input data',
+        errorMessage: errMsg,
+      };
+    }
+
+    let digest: string;
+    try {
+      switch (algorithm) {
+        case 'md5':
+          digest = md5(bytes);
+          break;
+        case 'sha1':
+          digest = sha1(bytes);
+          break;
+        case 'sha256':
+          digest = sha256(bytes);
+          break;
+        case 'sha512':
+          digest = sha512(bytes);
+          break;
+        case 'crc32':
+          digest = crc32(bytes);
+          break;
+        default:
+          return {
+            type: 'error',
+            summary: `hash_checksum: algorithm "${algorithm}" not implemented`,
+            errorMessage: 'unreachable',
+          };
+      }
+    } catch (e) {
+      const errMsg = e instanceof Error ? e.message : String(e);
+      return {
+        type: 'error',
+        summary: `hash_checksum: failed to compute ${algorithm}`,
+        errorMessage: errMsg,
+      };
+    }
+
+    return {
+      type: 'text',
+      summary: `${algorithm}(${bytes.length} bytes) = ${digest}`,
+    };
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: 'hash_checksum',
+        description:
+          'Compute a cryptographic hash or checksum (MD5, SHA-1, SHA-256, SHA-512, CRC32) over in-memory bytes. Use for file-integrity verification and known-file identification.',
+        parameters: {
+          type: 'object',
+          properties: {
+            algorithm: {
+              type: 'string',
+              enum: ['md5', 'sha1', 'sha256', 'sha512', 'crc32'],
+              description: 'Hash algorithm to use.',
+            },
+            data: {
+              type: 'string',
+              description: 'Input data as a string (hex, base64, or UTF-8 depending on encoding).',
+            },
+            encoding: {
+              type: 'string',
+              enum: ['auto', 'hex', 'base64', 'utf8'],
+              description: 'How to interpret the data string. Default: auto (hex if valid even-length hex, else base64).',
+            },
+          },
+          required: ['algorithm', 'data'],
+        },
+      },
+    };
+  }
+
+  systemPromptFragment(ctx: SystemPromptContext): string {
+    return (
+      'Use hash_checksum to compute MD5, SHA-1, SHA-256, SHA-512, or CRC32 digests over in-memory bytes. ' +
+      'Do NOT invent or guess digests — always compute them over the exact bytes given. ' +
+      'Digests are only meaningful over the exact byte sequence; specify the encoding (hex, base64, utf8) if the data format is known.'
+    );
+  }
+}
