--- /dev/null
+++ b/src/services/talents/LogcatEngine.ts
@@ -0,0 +1,581 @@
+import {
+  TalentEngine,
+  TalentResult,
+  ToolDefinition,
+  SystemPromptContext,
+} from './types';
+
+// ── Constants ────────────────────────────────────────────────────────────────
+
+const LEVELS = ['V', 'D', 'I', 'W', 'E', 'F'] as const;
+type Level = (typeof LEVELS)[number];
+const LEVEL_RANK: Record<Level, number> = {V: 0, D: 1, I: 2, W: 3, E: 4, F: 5};
+
+const OPERATIONS = [
+  'summary',
+  'errors',
+  'crash',
+  'anr',
+  'filter',
+  'dedupe',
+] as const;
+type Operation = (typeof OPERATIONS)[number];
+
+/** Hard caps so a 100k-line dump can't blow the context window. */
+const MAX_OUTPUT_LINES = 500;
+const MAX_SUMMARY_TAGS = 20;
+const MAX_ERROR_BLOCKS = 50;
+
+// ── Parsed line ──────────────────────────────────────────────────────────────
+
+interface ParsedLine {
+  level: Level;
+  tag: string;
+  message: string;
+  timestamp?: string;
+  pid?: string;
+  raw: string;
+}
+
+// ── Regexes ──────────────────────────────────────────────────────────────────
+
+// threadtime: "09-21 14:32:01.234  1234  5678 E MyTag: some message"
+const RE_THREADTIME =
+  /^(\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}\.\d{3})\s+(\d+)\s+(\d+)\s+([VDIWEF])\s+(\S+?)\s*:\s?(.*)$/;
+
+// brief: "E/MyTag( 1234): some message"
+const RE_BRIEF = /^([VDIWEF])\/(\S+?)\(\s*(\d+)\)\s*:\s?(.*)$/;
+
+// Java/Kotlin exception header
+const RE_EXCEPTION =
+  /^(?:.*(?:Exception|Error|Throwable|FATAL\s+EXCEPTION|AndroidRuntime|Caused by|at\s+\S+\.\w+\())\s*[:]/;
+const RE_EXCEPTION_LINE =
+  /^(?:[\w.]+(?:Exception|Error|Throwable))\s*[:]/;
+const RE_FATAL = /FATAL EXCEPTION/i;
+const RE_ANR = /ANR\s+in\s+/i;
+const RE_STACK_FRAME = /^\s+at\s+/;
+const RE_CONTINUATION = /^\s+\.\.\.\s*(?:\d+\s+more)?$/;
+const RE_JAVA_STACK = /^\s+at\s+[\w.$]+\(/;
+
+// ── Parsing ──────────────────────────────────────────────────────────────────
+
+function parseLine(raw: string): ParsedLine | null {
+  const m1 = RE_THREADTIME.exec(raw);
+  if (m1) {
+    return {
+      timestamp: m1[1],
+      pid: m1[2],
+      level: m1[4] as Level,
+      tag: m1[5],
+      message: m1[6],
+      raw,
+    };
+  }
+  const m2 = RE_BRIEF.exec(raw);
+  if (m2) {
+    return {
+      level: m2[1] as Level,
+      tag: m2[2],
+      pid: m2[3],
+      message: m2[4],
+      raw,
+    };
+  }
+  return null;
+}
+
+function parseAll(text: string): {parsed: ParsedLine[]; unparsed: number; lines: string[]} {
+  const rawLines = text.split(/\r?\n/);
+  const parsed: ParsedLine[] = [];
+  let unparsed = 0;
+  for (const raw of rawLines) {
+    if (raw.trim() === '') {
+      continue;
+    }
+    const p = parseLine(raw);
+    if (p) {
+      parsed.push(p);
+    } else {
+      unparsed++;
+    }
+  }
+  return {parsed, unparsed, lines: rawLines};
+}
+
+// ── Operations ───────────────────────────────────────────────────────────────
+
+function opSummary(text: string): string {
+  const {parsed, unparsed} = parseAll(text);
+  const total = parsed.length + unparsed;
+
+  // Level counts
+  const levelCounts: Record<string, number> = {};
+  for (const l of LEVELS) {
+    levelCounts[l] = 0;
+  }
+  for (const p of parsed) {
+    levelCounts[p.level] = (levelCounts[p.level] || 0) + 1;
+  }
+
+  // Tag counts
+  const tagCounts = new Map<string, number>();
+  for (const p of parsed) {
+    tagCounts.set(p.tag, (tagCounts.get(p.tag) || 0) + 1);
+  }
+  const topTags = [...tagCounts.entries()]
+    .sort((a, b) => b[1] - a[1])
+    .slice(0, MAX_SUMMARY_TAGS);
+
+  // Time span
+  const timestamps = parsed.map(p => p.timestamp).filter(Boolean) as string[];
+  let timeSpan = 'n/a';
+  if (timestamps.length >= 2) {
+    timeSpan = `${timestamps[0]} → ${timestamps[timestamps.length - 1]}`;
+  } else if (timestamps.length === 1) {
+    timeSpan = timestamps[0];
+  }
+
+  const parts: string[] = [];
+  parts.push(`## Logcat Summary`);
+  parts.push(`Total lines: ${total} (parsed: ${parsed.length}, unparsed: ${unparsed})`);
+  parts.push(`Time span: ${timeSpan}`);
+  parts.push('');
+  parts.push('### By level');
+  for (const l of LEVELS) {
+    parts.push(`  ${l}: ${levelCounts[l]}`);
+  }
+  parts.push('');
+  parts.push(`### Top tags (up to ${MAX_SUMMARY_TAGS})`);
+  for (const [tag, count] of topTags) {
+    parts.push(`  ${tag}: ${count}`);
+  }
+  if (tagCounts.size > MAX_SUMMARY_TAGS) {
+    parts.push(`  … and ${tagCounts.size - MAX_SUMMARY_TAGS} more tags`);
+  }
+  return parts.join('\n');
+}
+
+function findExceptionBlocks(lines: string[]): string[][] {
+  const blocks: string[][] = [];
+  let i = 0;
+  while (i < lines.length) {
+    const line = lines[i];
+    const isExceptionStart =
+      RE_FATAL.test(line) ||
+      RE_ANR.test(line) ||
+      RE_EXCEPTION_LINE.test(line) ||
+      (RE_EXCEPTION.test(line) && !RE_STACK_FRAME.test(line));
+    if (isExceptionStart) {
+      const block: string[] = [line];
+      let j = i + 1;
+      while (j < lines.length) {
+        const next = lines[j];
+        if (RE_STACK_FRAME.test(next) || RE_CONTINUATION.test(next) || RE_JAVA_STACK.test(next)) {
+          block.push(next);
+          j++;
+        } else if (/^Caused by:/i.test(next.trim())) {
+          block.push(next);
+          j++;
+        } else {
+          break;
+        }
+      }
+      blocks.push(block);
+      i = j;
+    } else {
+      i++;
+    }
+  }
+  return blocks;
+}
+
+function opErrors(text: string): string {
+  const {parsed, unparsed, lines} = parseAll(text);
+  const parts: string[] = [];
+  parts.push('## Errors & Exceptions');
+
+  // E/F level lines
+  const errorLines = parsed.filter(p => p.level === 'E' || p.level === 'F');
+  // Exception blocks
+  const exceptionBlocks = findExceptionBlocks(lines);
+
+  let totalBlocks = errorLines.length + exceptionBlocks.length;
+  let shownBlocks = 0;
+  let dropped = 0;
+
+  for (const el of errorLines) {
+    if (shownBlocks >= MAX_ERROR_BLOCKS) {
+      dropped++;
+      continue;
+    }
+    parts.push('');
+    parts.push(`[${el.level}] ${el.tag}: ${el.message}`);
+    shownBlocks++;
+  }
+
+  for (const block of exceptionBlocks) {
+    if (shownBlocks >= MAX_ERROR_BLOCKS) {
+      dropped++;
+      continue;
+    }
+    parts.push('');
+    for (const line of block) {
+      parts.push(line);
+    }
+    shownBlocks++;
+  }
+
+  if (dropped > 0) {
+    parts.push('');
+    parts.push(`… ${dropped} more error/exception block(s) dropped (cap: ${MAX_ERROR_BLOCKS})`);
+  }
+  parts.push('');
+  parts.push(`Total: ${totalBlocks} error/exception items (${errorLines.length} E/F lines, ${exceptionBlocks.length} exception blocks), ${unparsed} unparsed lines skipped.`);
+  return parts.join('\n');
+}
+
+function opCrash(text: string): string {
+  const lines = text.split(/\r?\n/);
+  const parts: string[] = [];
+  parts.push('## Crash Analysis');
+
+  // Look for FATAL EXCEPTION block first
+  let crashStart = -1;
+  for (let i = 0; i < lines.length; i++) {
+    if (RE_FATAL.test(lines[i])) {
+      crashStart = i;
+      break;
+    }
+  }
+
+  if (crashStart === -1) {
+    // Look for first exception block
+    const blocks = findExceptionBlocks(lines);
+    if (blocks.length === 0) {
+      parts.push('No fatal exception or crash block found in the log.');
+      return parts.join('\n');
+    }
+    const block = blocks[0];
+    parts.push('');
+    for (const line of block) {
+      parts.push(line);
+    }
+    parts.push('');
+    parts.push(`(First exception block — no FATAL EXCEPTION header found)`);
+    return parts.join('\n');
+  }
+
+  // Collect the FATAL EXCEPTION block
+  const block: string[] = [lines[crashStart]];
+  let j = crashStart + 1;
+  while (j < lines.length) {
+    const next = lines[j];
+    const isStackFrame =
+      RE_STACK_FRAME.test(next) ||
+      RE_CONTINUATION.test(next) ||
+      RE_JAVA_STACK.test(next);
+    const isCausedBy = /^Caused by:/i.test(next.trim());
+    // AndroidRuntime continuation lines (e.g. "Process: …", "PID: …")
+    const isAndroidRuntimeCont =
+      /^\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}\.\d{3}\s+\d+\s+\d+\s+E\s+AndroidRuntime:\s/.test(next);
+    // Un-tagged exception header (e.g. "java.lang.RuntimeException: …")
+    const isExceptionHeader = RE_EXCEPTION_LINE.test(next);
+    if (isStackFrame || isCausedBy || isAndroidRuntimeCont || isExceptionHeader) {
+      block.push(next);
+      j++;
+    } else if (next.trim() === '') {
+      // Include blank lines within the stack but stop at two consecutive blanks
+      if (
+        j + 1 < lines.length &&
+        !RE_STACK_FRAME.test(lines[j + 1]) &&
+        !RE_JAVA_STACK.test(lines[j + 1]) &&
+        !/^Caused by:/i.test(lines[j + 1].trim()) &&
+        !RE_EXCEPTION_LINE.test(lines[j + 1]) &&
+        !/^\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}\.\d{3}\s+\d+\s+\d+\s+E\s+AndroidRuntime:\s/.test(lines[j + 1])
+      ) {
+        break;
+      }
+      block.push(next);
+      j++;
+    } else {
+      break;
+    }
+  }
+
+  parts.push('');
+  for (const line of block) {
+    parts.push(line);
+  }
+  parts.push('');
+  const stackFrames = block.filter(l => RE_JAVA_STACK.test(l) || RE_STACK_FRAME.test(l));
+  parts.push(`Stack frames: ${stackFrames.length}`);
+
+  // Look for "Caused by" to find root cause
+  const causedBy = block.filter(l => /^Caused by:/i.test(l.trim()));
+  if (causedBy.length > 0) {
+    parts.push(`Root cause chain:`);
+    for (const cb of causedBy) {
+      parts.push(`  ${cb.trim()}`);
+    }
+  }
+  return parts.join('\n');
+}
+
+function opAnr(text: string): string {
+  const lines = text.split(/\r?\n/);
+  const parts: string[] = [];
+  parts.push('## ANR (Application Not Responding)');
+
+  const anrLines: string[] = [];
+  for (let i = 0; i < lines.length; i++) {
+    if (RE_ANR.test(lines[i])) {
+      // Collect the ANR block: the ANR line plus following context lines
+      const block: string[] = [lines[i]];
+      let j = i + 1;
+      // Grab "Reason:" and "Load:" lines that typically follow.
+      // Match against the parsed message text, since in threadtime format the
+      // raw line begins with a timestamp/PID/tag prefix.
+      while (j < lines.length && j <= i + 5) {
+        const parsed = parseLine(lines[j]);
+        const next = (parsed ? parsed.message : lines[j]).trim();
+        if (/^(Reason|Load|CPU usage|Subject|VM TR)/i.test(next)) {
+          block.push(lines[j]);
+          j++;
+        } else {
+          break;
+        }
+      }
+      anrLines.push(block.join('\n'));
+      i = j - 1;
+    }
+  }
+
+  if (anrLines.length === 0) {
+    parts.push('No ANR events found in the log.');
+  } else {
+    parts.push(`Found ${anrLines.length} ANR event(s):`);
+    for (const block of anrLines) {
+      parts.push('');
+      parts.push(block);
+    }
+  }
+  return parts.join('\n');
+}
+
+function opFilter(
+  text: string,
+  tag?: string,
+  minLevel?: string,
+  contains?: string,
+): string {
+  const {parsed, unparsed} = parseAll(text);
+  const parts: string[] = [];
+  parts.push('## Filtered Log');
+
+  const minRank =
+    minLevel && LEVEL_RANK[minLevel.toUpperCase() as Level] !== undefined
+      ? LEVEL_RANK[minLevel.toUpperCase() as Level]
+      : -1;
+  const tagLower = tag?.toLowerCase();
+  const containsLower = contains?.toLowerCase();
+
+  const matches: ParsedLine[] = [];
+  for (const p of parsed) {
+    if (tagLower && !p.tag.toLowerCase().includes(tagLower)) {
+      continue;
+    }
+    if (minRank >= 0 && LEVEL_RANK[p.level] < minRank) {
+      continue;
+    }
+    if (containsLower && !p.message.toLowerCase().includes(containsLower)) {
+      continue;
+    }
+    matches.push(p);
+  }
+
+  let truncated = 0;
+  const shown = matches.slice(0, MAX_OUTPUT_LINES);
+  if (matches.length > MAX_OUTPUT_LINES) {
+    truncated = matches.length - MAX_OUTPUT_LINES;
+  }
+
+  for (const m of shown) {
+    parts.push(`[${m.level}] ${m.tag}: ${m.message}`);
+  }
+
+  parts.push('');
+  parts.push(
+    `Matched ${matches.length} of ${parsed.length} parsed lines` +
+      (truncated > 0 ? ` (showing first ${MAX_OUTPUT_LINES}, ${truncated} dropped)` : '') +
+      `, ${unparsed} unparsed lines skipped.`,
+  );
+  return parts.join('\n');
+}
+
+function opDedupe(text: string): string {
+  const {parsed, unparsed} = parseAll(text);
+  const parts: string[] = [];
+  parts.push('## Deduplicated Log');
+
+  // Group by tag+message, preserving first-seen order
+  const seen = new Map<string, {line: ParsedLine; count: number}>();
+  const order: string[] = [];
+  for (const p of parsed) {
+    const key = `${p.level}|${p.tag}|${p.message}`;
+    const existing = seen.get(key);
+    if (existing) {
+      existing.count++;
+    } else {
+      seen.set(key, {line: p, count: 1});
+      order.push(key);
+    }
+  }
+
+  let truncated = 0;
+  let shown = 0;
+  for (const key of order) {
+    if (shown >= MAX_OUTPUT_LINES) {
+      truncated += 1;
+      continue;
+    }
+    const entry = seen.get(key)!;
+    const suffix = entry.count > 1 ? `  [×${entry.count}]` : '';
+    parts.push(`[${entry.line.level}] ${entry.line.tag}: ${entry.line.message}${suffix}`);
+    shown++;
+  }
+
+  const uniqueCount = order.length;
+  const collapsedCount = parsed.length - uniqueCount;
+  parts.push('');
+  parts.push(
+    `${parsed.length} lines → ${uniqueCount} unique` +
+      (collapsedCount > 0 ? ` (${collapsedCount} collapsed)` : '') +
+      (truncated > 0 ? ` (output truncated at ${MAX_OUTPUT_LINES}, ${truncated} more unique entries dropped)` : '') +
+      `, ${unparsed} unparsed lines skipped.`,
+  );
+  return parts.join('\n');
+}
+
+// ── Engine ───────────────────────────────────────────────────────────────────
+
+export class LogcatEngine implements TalentEngine {
+  readonly name = 'logcat';
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const log = typeof args.log === 'string' ? args.log : '';
+    if (!log) {
+      return {
+        type: 'error',
+        summary: 'logcat: missing or empty "log" argument',
+        errorMessage:
+          'log argument is required and must be a non-empty string containing the raw logcat text',
+      };
+    }
+
+    const operation =
+      typeof args.operation === 'string' ? args.operation : 'summary';
+    if (!OPERATIONS.includes(operation as Operation)) {
+      return {
+        type: 'error',
+        summary: `logcat: unknown operation "${operation}"`,
+        errorMessage: `operation must be one of: ${OPERATIONS.join(', ')}`,
+      };
+    }
+
+    try {
+      let summary: string;
+      switch (operation as Operation) {
+        case 'summary':
+          summary = opSummary(log);
+          break;
+        case 'errors':
+          summary = opErrors(log);
+          break;
+        case 'crash':
+          summary = opCrash(log);
+          break;
+        case 'anr':
+          summary = opAnr(log);
+          break;
+        case 'filter': {
+          const tag = typeof args.tag === 'string' ? args.tag : undefined;
+          const minLevel =
+            typeof args.min_level === 'string' ? args.min_level : undefined;
+          const contains =
+            typeof args.contains === 'string' ? args.contains : undefined;
+          summary = opFilter(log, tag, minLevel, contains);
+          break;
+        }
+        case 'dedupe':
+          summary = opDedupe(log);
+          break;
+        default:
+          summary = opSummary(log);
+      }
+      return {type: 'text', summary};
+    } catch (e) {
+      const errMsg = e instanceof Error ? e.message : String(e);
+      return {
+        type: 'error',
+        summary: `logcat: failed to process "${operation}"`,
+        errorMessage: errMsg,
+      };
+    }
+  }
+
+  systemPromptFragment(_ctx: SystemPromptContext): string {
+    return (
+      'You have a logcat talent that triages Android logcat text dumps. ' +
+      'When the user pastes a large logcat or crash dump, pass the raw text to the logcat tool ' +
+      '(operation "summary" first, then "crash" or "errors" as needed) and quote its structured ' +
+      'findings rather than trying to eyeball thousands of lines. The tool is a text triage aid — ' +
+      'it highlights what matters but is not a substitute for reading the actual crash context.'
+    );
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: 'logcat',
+        description:
+          'Parse and triage Android logcat / crash-dump text. Pass the raw log text and an operation. ' +
+          'Use "summary" for an overview, "errors" for E/F lines and exception blocks, ' +
+          '"crash" for the first FATAL EXCEPTION, "anr" for ANR events, ' +
+          '"filter" to narrow by tag/level/substring, "dedupe" to collapse repeated messages.',
+        parameters: {
+          type: 'object',
+          properties: {
+            log: {
+              type: 'string',
+              description: 'The raw logcat text to parse.',
+            },
+            operation: {
+              type: 'string',
+              enum: ['summary', 'errors', 'crash', 'anr', 'filter', 'dedupe'],
+              description:
+                'What to do with the log. Default: "summary".',
+            },
+            tag: {
+              type: 'string',
+              description:
+                '(filter only) Substring to match against tag names (case-insensitive).',
+            },
+            min_level: {
+              type: 'string',
+              enum: ['V', 'D', 'I', 'W', 'E', 'F'],
+              description:
+                '(filter only) Minimum log level to include. V<D<I<W<E<F.',
+            },
+            contains: {
+              type: 'string',
+              description:
+                '(filter only) Substring to match against message text (case-insensitive).',
+            },
+          },
+          required: ['log'],
+        },
+      },
+    };
+  }
+}
