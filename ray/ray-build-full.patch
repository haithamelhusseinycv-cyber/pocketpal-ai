+  // Catalog
+  const catalogId = builder.addObject(
+    `<< /Type /Catalog /Pages ${pagesObjId} 0 R >>`
+  );
+
+  // Fix root reference - catalog should be object 1 for our trailer
+  // Actually let's rebuild with catalog as a known object
+  // The trailer says /Root 1 0 R, so we need to ensure catalog is obj 1.
+  // Let's restructure: we'll rebuild the builder approach.
+
+  return builder.build();
+}
