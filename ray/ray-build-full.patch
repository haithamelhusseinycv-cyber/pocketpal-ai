index 0000000..57d7152
--- /dev/null
+++ b/src/services/talents/TravelBudgetEngine.ts
@@ -0,0 +1,474 @@
+/**
+ * TravelBudgetEngine — multi-currency trip budgeting.
+ *
+ * Deterministic arithmetic for trip/safari/regatta pricing with FX conversion.
+ * All computations are closed-form, no dependencies, no eval.
+ *
+ * Rounding: money values rounded to 2dp for display. Intermediate math stays
+ * full precision. safeDiv returns "n/a" for zero denominators.
+ */
+
+import {TalentEngine, TalentResult, ToolDefinition, SystemPromptContext} from './types';
+
+// ─── Helpers ─────────────────────────────────────────────────────────────────
+function round2(value: number): number {
+  if (!Number.isFinite(value)) return NaN;
+  return Math.round((value + Number.EPSILON) * 100) / 100;
+}
+
+function money(value: number): string {
+  if (!Number.isFinite(value)) return 'n/a';
+  return round2(value).toLocaleString('en-US', {
+    minimumFractionDigits: 2,
+    maximumFractionDigits: 2,
+  });
+}
+
+function safeDiv(a: number, b: number): number | null {
+  if (b === 0 || !Number.isFinite(a) || !Number.isFinite(b)) return null;
+  return a / b;
+}
+
+function num(value: unknown): number | null {
+  const n = typeof value === 'number' ? value : parseFloat(String(value));
+  return Number.isFinite(n) ? n : null;
+}
+
+function convertToBase(amount: number, currency: string, fxRates: Record<string, number>, baseCurrency: string): number | null {
+  if (currency === baseCurrency) return amount;
+  const rate = fxRates[currency];
+  if (rate === undefined || rate <= 0) return null;
+  return amount * rate;
+}
+
+function err(summary: string, errorMessage: string): TalentResult {
+  return {type: 'error', summary, errorMessage};
+}
+
+// ─── Engine ──────────────────────────────────────────────────────────────────
+export class TravelBudgetEngine implements TalentEngine {
+  readonly name = 'travel_budget';
+
+  // Anchor for The Road's context recommendation. The shared RAY persona grew
+  // (~3.1k tokens) and rides in every face, so The Road's resident load
+  // (persona + overlay + 13 tool schemas ≈ 8k) no longer leaves room to
+  // converse at an 8k window. The load hint fires on the MAX
+  // recommendedContextTokens across a Pal's talents; travel_budget is
+  // Road-exclusive (The Desk does not carry it), so 16384 here prompts The Road
+  // for a 16k window without affecting The Desk.
+  readonly recommendedContextTokens = 16384;
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const operation = typeof args.operation === 'string' ? args.operation.toLowerCase() : '';
+
+    switch (operation) {
+      case 'budget':
+        return this.budgetOp(args);
+      case 'pace':
+        return this.paceOp(args);
+      case 'compare':
+        return this.compareOp(args);
+      default:
+        return err(
+          `travel_budget: unknown or missing operation "${operation || '(none)'}"`,
+          'operation must be one of: budget, pace, compare',
+        );
+    }
+  }
+
+  private budgetOp(args: Record<string, any>): TalentResult {
+    const tripName = typeof args.trip_name === 'string' ? args.trip_name : '(unnamed)';
+    const days = num(args.days);
+    const travelers = num(args.travelers);
+    const baseCurrency = typeof args.base_currency === 'string' ? args.base_currency.toUpperCase() : 'EGP';
+    const fxRates = args.fx_rates as Record<string, number> | undefined;
+    const categories = Array.isArray(args.categories) ? args.categories : [];
+
+    if (days === null || days <= 0) {
+      return err('travel_budget.budget: "days" must be a positive number', 'days is required');
+    }
+    if (travelers === null || travelers <= 0) {
+      return err('travel_budget.budget: "travelers" must be a positive number', 'travelers is required');
+    }
+    if (!fxRates || typeof fxRates !== 'object') {
+      return err('travel_budget.budget: "fx_rates" must be an object', 'fx_rates maps currency codes to their rate in base_currency units, e.g. {EGP:1, USD:48.5}');
+    }
+    if (categories.length === 0) {
+      return err('travel_budget.budget: "categories" must be a non-empty array', 'each category has name, amount, currency, per (total|day|person)');
+    }
+
+    // Validate FX rates
+    for (const cat of categories) {
+      const cur = typeof cat.currency === 'string' ? cat.currency.toUpperCase() : baseCurrency;
+      if (cur !== baseCurrency && (fxRates[cur] === undefined || fxRates[cur] <= 0)) {
+        return err(
+          `travel_budget.budget: missing or invalid FX rate for "${cur}"`,
+          `fx_rates must include a positive rate for every currency used. Got fx_rates=${JSON.stringify(fxRates)}`,
+        );
+      }
+    }
+
+    // Compute per-category totals
+    interface CatResult {
+      name: string;
+      rawAmount: number;
+      rawCurrency: string;
+      per: string;
+      totalInBase: number;
+      pctOfTotal: number;
+    }
+
+    const results: CatResult[] = [];
+    let grandTotal = 0;
+
+    for (const cat of categories) {
+      const name = typeof cat.name === 'string' ? cat.name : '(unnamed)';
+      const amount = num(cat.amount);
+      const currency = typeof cat.currency === 'string' ? cat.currency.toUpperCase() : baseCurrency;
+      const per = typeof cat.per === 'string' ? cat.per.toLowerCase() : 'total';
+
+      if (amount === null || amount < 0) {
+        return err(
+          `travel_budget.budget: category "${name}" has invalid amount`,
+          `amount must be a non-negative number, got "${cat.amount}"`,
+        );
+      }
+
+      if (!['total', 'day', 'person'].includes(per)) {
+        return err(
+          `travel_budget.budget: category "${name}" has invalid per value "${per}"`,
+          'per must be one of: total, day, person',
+        );
+      }
+
+      // Expand to total trip cost
+      let expanded = amount;
+      if (per === 'day') expanded = amount * days;
+      else if (per === 'person') expanded = amount * travelers;
+
+      const totalInBase = convertToBase(expanded, currency, fxRates, baseCurrency);
+      if (totalInBase === null) {
+        return err(
+          `travel_budget.budget: cannot convert "${currency}" to "${baseCurrency}"`,
+          `FX rate for ${currency} is missing or zero`,
+        );
+      }
+
+      results.push({name, rawAmount: amount, rawCurrency: currency, per, totalInBase, pctOfTotal: 0});
+      grandTotal += totalInBase;
+    }
+
+    // Compute percentages
+    for (const r of results) {
+      r.pctOfTotal = grandTotal > 0 ? (r.totalInBase / grandTotal) * 100 : 0;
+    }
+
+    // Sort by totalInBase descending for top-3
+    const sorted = [...results].sort((a, b) => b.totalInBase - a.totalInBase);
+    const top3 = sorted.slice(0, 3);
+
+    const perDay = safeDiv(grandTotal, days);
+    const perPerson = safeDiv(grandTotal, travelers);
+    const perPersonPerDay = safeDiv(grandTotal, days * travelers);
+
+    // Build output
+    const lines: string[] = [];
+    lines.push(`Trip Budget: ${tripName}`);
+    lines.push(`  Days: ${days}, Travelers: ${travelers}, Base currency: ${baseCurrency}`);
+    lines.push(`  FX rates: ${JSON.stringify(fxRates)}`);
+    lines.push('');
+    lines.push('Category breakdown:');
+    lines.push('  name | amount | currency | per | total (base) | % of total');
+    lines.push('  ---|---|---|---|---|---');
+    for (const r of results) {
+      lines.push(`  ${r.name} | ${money(r.rawAmount)} | ${r.rawCurrency} | ${r.per} | ${money(r.totalInBase)} ${baseCurrency} | ${round2(r.pctOfTotal)}%`);
+    }
+    lines.push('');
+    lines.push(`Grand total: ${money(grandTotal)} ${baseCurrency}`);
+    lines.push(`Per day: ${perDay !== null ? money(perDay) + ' ' + baseCurrency : 'n/a'}`);
+    lines.push(`Per person: ${perPerson !== null ? money(perPerson) + ' ' + baseCurrency : 'n/a'}`);
+    lines.push(`Per person per day: ${perPersonPerDay !== null ? money(perPersonPerDay) + ' ' + baseCurrency : 'n/a'}`);
+    lines.push('');
+    lines.push('Top 3 cost drivers:');
+    for (let i = 0; i < top3.length; i++) {
+      lines.push(`  ${i + 1}. ${top3[i].name}: ${money(top3[i].totalInBase)} ${baseCurrency} (${round2(top3[i].pctOfTotal)}%)`);
+    }
+
+    return {type: 'text', summary: lines.join('\n')};
+  }
+
+  private paceOp(args: Record<string, any>): TalentResult {
+    const totalBudget = num(args.total_budget);
+    const baseCurrency = typeof args.base_currency === 'string' ? args.base_currency.toUpperCase() : 'EGP';
+    const days = num(args.days);
+    const dailyCosts = Array.isArray(args.daily_costs) ? args.daily_costs : [];
+    const fxRates = (args.fx_rates as Record<string, number>) || {};
+
+    if (totalBudget === null || totalBudget <= 0) {
+      return err('travel_budget.pace: "total_budget" must be a positive number', 'total_budget is the overall budget in base_currency');
+    }
+    if (days === null || days <= 0) {
+      return err('travel_budget.pace: "days" must be a positive number', 'days is required');
+    }
+    if (dailyCosts.length === 0) {
+      return err('travel_budget.pace: "daily_costs" must be a non-empty array', 'each entry is {amount, currency} or a plain number (assumed base_currency)');
+    }
+
+    // Convert daily costs to base currency
+    const convertedDaily: number[] = [];
+    for (let i = 0; i < dailyCosts.length; i++) {
+      const entry = dailyCosts[i];
+      let amount: number | null;
+      let currency = baseCurrency;
+
+      if (typeof entry === 'number') {
+        amount = entry;
+      } else if (typeof entry === 'object' && entry !== null) {
+        amount = num(entry.amount);
+        currency = typeof entry.currency === 'string' ? entry.currency.toUpperCase() : baseCurrency;
+      } else {
+        amount = num(entry);
+      }
+
+      if (amount === null) {
+        return err(
+          `travel_budget.pace: daily_costs[${i}] has invalid amount`,
+          `got "${JSON.stringify(entry)}"`,
+        );
+      }
+
+      const converted = convertToBase(amount, currency, fxRates, baseCurrency);
+      if (converted === null) {
+        return err(
+          `travel_budget.pace: cannot convert daily_costs[${i}] from "${currency}" to "${baseCurrency}"`,
+          `FX rate for ${currency} is missing or zero`,
+        );
+      }
+      convertedDaily.push(converted);
+    }
+
+    // Day-by-day cumulative burn
+    const lines: string[] = [];
+    lines.push(`Budget Pace: ${money(totalBudget)} ${baseCurrency} over ${days} days`);
+    lines.push(`Expected daily pace: ${money(totalBudget / days)} ${baseCurrency}/day`);
+    lines.push('');
+    lines.push('Day | spent (day) | cumulative | budget | surplus/deficit');
+    lines.push('---|---|---|---|---');
+
+    let cumulative = 0;
+    let firstBreachDay: number | null = null;
+    const expectedPace = totalBudget / days;
+
+    for (let d = 0; d < convertedDaily.length; d++) {
+      const day = d + 1;
+      cumulative += convertedDaily[d];
+      const expectedCumulative = expectedPace * day;
+      const diff = totalBudget - cumulative;
+      const status = diff >= 0 ? `+${money(diff)}` : `-${money(Math.abs(diff))}`;
+
+      lines.push(`  ${day} | ${money(convertedDaily[d])} | ${money(cumulative)} | ${money(totalBudget)} | ${status}`);
+
+      if (firstBreachDay === null && cumulative > totalBudget) {
+        firstBreachDay = day;
+      }
+    }
+
+    lines.push('');
+
+    const totalSpent = cumulative;
+    const diff = totalBudget - totalSpent;
+    const projectedDays = convertedDaily.length;
+
+    if (diff >= 0) {
+      lines.push(`Result: SURPLUS of ${money(diff)} ${baseCurrency} after ${projectedDays} days`);
+    } else {
+      lines.push(`Result: OVERRUN of ${money(Math.abs(diff))} ${baseCurrency} after ${projectedDays} days`);
+    }
+
+    if (firstBreachDay !== null) {
+      lines.push(`First budget breach: day ${firstBreachDay}`);
+    } else {
+      lines.push('Budget never breached.');
+    }
+
+    // Project final overrun if more days remain
+    if (projectedDays < days) {
+      const avgDaily = totalSpent / projectedDays;
+      const projectedTotal = avgDaily * days;
+      const projectedDiff = totalBudget - projectedTotal;
+      lines.push('');
+      lines.push(`Projection at current pace (${money(avgDaily)}/day over ${days} days):`);
+      lines.push(`  Projected total: ${money(projectedTotal)} ${baseCurrency}`);
+      if (projectedDiff >= 0) {
+        lines.push(`  Projected surplus: ${money(projectedDiff)} ${baseCurrency}`);
+      } else {
+        lines.push(`  Projected overrun: ${money(Math.abs(projectedDiff))} ${baseCurrency}`);
+      }
+    }
+
+    return {type: 'text', summary: lines.join('\n')};
+  }
+
+  private compareOp(args: Record<string, any>): TalentResult {
+    const options = Array.isArray(args.options) ? args.options : [];
+    const baseCurrency = typeof args.base_currency === 'string' ? args.base_currency.toUpperCase() : 'EGP';
+    const fxRates = (args.fx_rates as Record<string, number>) || {};
+
+    if (options.length < 2) {
+      return err('travel_budget.compare: "options" must have at least 2 entries', 'each option has name and items array');
+    }
+
+    interface OptionResult {
+      name: string;
+      totalInBase: number;
+      items: {desc: string; amount: number; currency: string; converted: number}[];
+    }
+
+    const results: OptionResult[] = [];
+
+    for (const opt of options) {
+      const name = typeof opt.name === 'string' ? opt.name : '(unnamed)';
+      const items = Array.isArray(opt.items) ? opt.items : [];
+
+      const convertedItems: OptionResult['items'] = [];
+      let total = 0;
+
+      for (const item of items) {
+        const desc = typeof item.desc === 'string' ? item.desc : '(no desc)';
+        const amount = num(item.amount);
+        const currency = typeof item.currency === 'string' ? item.currency.toUpperCase() : baseCurrency;
+
+        if (amount === null) {
+          return err(
+            `travel_budget.compare: option "${name}" item "${desc}" has invalid amount`,
+            `got "${item.amount}"`,
+          );
+        }
+
+        const converted = convertToBase(amount, currency, fxRates, baseCurrency);
+        if (converted === null) {
+          return err(
+            `travel_budget.compare: cannot convert "${currency}" to "${baseCurrency}" for option "${name}"`,
+            `FX rate for ${currency} is missing or zero`,
+          );
+        }
+
+        convertedItems.push({desc, amount, currency, converted});
+        total += converted;
+      }
+
+      results.push({name, totalInBase: total, items: convertedItems});
+    }
+
+    // Find cheapest
+    let cheapestIdx = 0;
+    for (let i = 1; i < results.length; i++) {
+      if (results[i].totalInBase < results[cheapestIdx].totalInBase) {
+        cheapestIdx = i;
+      }
+    }
+
+    const lines: string[] = [];
+    lines.push(`Option Comparison (base: ${baseCurrency}):`);
+    lines.push(`  FX rates: ${JSON.stringify(fxRates)}`);
+    lines.push('');
+
+    for (let i = 0; i < results.length; i++) {
+      const r = results[i];
+      const isCheapest = i === cheapestIdx;
+      lines.push(`Option: ${r.name}${isCheapest ? ' ★ CHEAPEST' : ''}`);
+      lines.push(`  Item | amount | currency | converted`);
+      for (const item of r.items) {
+        lines.push(`  ${item.desc} | ${money(item.amount)} | ${item.currency} | ${money(item.converted)} ${baseCurrency}`);
+      }
+      lines.push(`  TOTAL: ${money(r.totalInBase)} ${baseCurrency}`);
+      if (!isCheapest) {
+        const diff = r.totalInBase - results[cheapestIdx].totalInBase;
+        lines.push(`  vs cheapest: +${money(diff)} ${baseCurrency}`);
+      }
+      lines.push('');
+    }
+
+    lines.push(`Cheapest option: ${results[cheapestIdx].name} at ${money(results[cheapestIdx].totalInBase)} ${baseCurrency}`);
+
+    return {type: 'text', summary: lines.join('\n')};
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: 'travel_budget',
+        description:
+          'Multi-currency trip budgeting. Operations: "budget" computes per-category converted totals, grand total, per-day/per-person pacing, top-3 cost drivers, and % of total; "pace" tracks day-by-day cumulative burn vs budget with overrun/surplus and first breach day; "compare" does side-by-side converted totals for trip options with cheapest flag. All arithmetic is deterministic, money rounded to 2dp.',
+        parameters: {
+          type: 'object',
+          properties: {
+            operation: {
+              type: 'string',
+              enum: ['budget', 'pace', 'compare'],
+              description: 'Which budgeting operation to perform.',
+            },
+            trip_name: {
+              type: 'string',
+              description: 'For "budget": name of the trip.',
+            },
+            days: {
+              type: 'number',
+              description: 'Number of trip days.',
+            },
+            travelers: {
+              type: 'number',
+              description: 'For "budget": number of travelers.',
+            },
+            base_currency: {
+              type: 'string',
+              description: 'Base currency code (default: EGP).',
+            },
+            fx_rates: {
+              type: 'object',
+              description: 'FX rates mapping currency codes to their value in base_currency units. E.g. {EGP:1, USD:48.5, EUR:52.3} means 1 USD = 48.5 EGP.',
+            },
+            categories: {
+              type: 'array',
+              items: {
+                type: 'object',
+                properties: {
+                  name: {type: 'string'},
+                  amount: {type: 'number'},
+                  currency: {type: 'string'},
+                  per: {type: 'string', enum: ['total', 'day', 'person']},
+                },
+                required: ['name', 'amount', 'currency', 'per'],
+              },
+              description: 'For "budget": spending categories.',
+            },
+            total_budget: {
+              type: 'number',
+              description: 'For "pace": total budget in base_currency.',
+            },
+            daily_costs: {
+              type: 'array',
+              description: 'For "pace": per-day costs as numbers (base currency) or {amount, currency} objects.',
+            },
+            options: {
+              type: 'array',
+              description: 'For "compare": array of {name, items:[{desc, amount, currency}]} option objects.',
+            },
+          },
+          required: ['operation'],
+        },
+      },
+    };
+  }
+
+  systemPromptFragment(_ctx: SystemPromptContext): string | null {
+    return [
+      '## travel_budget talent',
+      'For any trip, safari, regatta, or multi-currency pricing question, use the "travel_budget" talent.',
+      'Always state the FX rates used in the output. Never assume or fabricate exchange rates — require the user to supply them.',
+      'Operations: "budget" for trip budgeting with categories, "pace" for day-by-day burn tracking, "compare" for side-by-side option comparison.',
+      'All arithmetic is deterministic. Money is rounded to 2 decimal places. Division by zero returns "n/a".',
+    ].join('\n');
+  }
+}
