+            },
+            basis: {
+              type: 'string',
+              description: 'For common_size. Label for the basis: "revenue" or "total_assets". Default "revenue".',
+            },
+            // Trend args
+            series: {
+              type: 'object',
+              description: 'For trend. Map of metric name→array of numbers across periods, e.g. {revenue: [100, 120, 150]}.',
+            },
+          },
+          required: ['operation'],
+        },
+      },
+    };
+  }
+
+  systemPromptFragment(): string {
+    return [
+      'FINANCIAL STATEMENTS TOOL POLICY:',
+      '- Any financial ratio (liquidity, leverage, coverage, profitability, efficiency, DuPont, common-size, trend) you report MUST come from the financial_statements tool computed off the user\'s ACTUAL statement line items — never estimated, never recalled from memory, never invented.',
+      '- Extract the real line items from the user\'s financial statements and pass them as named numeric args. If a line item is missing from the statements, ask the user for it or report the ratio as "not computable" rather than assuming zero or substituting an industry average.',
+      '- The tool echoes the inputs it used. When you report a result, keep the inputs visible so the figure is auditable by a credit committee.',
+      '- Interpretation bands (e.g. "current_ratio < 1.0 = short-term obligations exceed short-term assets") are RULES-OF-THUMB, not hard thresholds. Present them as guidance, not law.',
+      '- If a ratio is "not computable" due to missing inputs, say so explicitly and ask for the missing line item. Never silently substitute a plausible number.',
+      '- For DuPont, verify the identity (product = direct ROE) using the tool\'s output — this catches arithmetic errors before they reach the committee.',
+    ].join('\n');
+  }
