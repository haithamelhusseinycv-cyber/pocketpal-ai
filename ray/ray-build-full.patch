+// ---------------------------------------------------------------------------
+// PDF building primitives
+// ---------------------------------------------------------------------------
+
+interface PdfObject {
+  id: number;
+  content: string;
+}
+
+class PdfBuilder {
+  private objects: PdfObject[] = [];
+  private nextId = 1;
+  private landscape: boolean;
+
+  // A4 dimensions in points (1pt = 1/72 inch)
+  readonly pageWidth: number;
+  readonly pageHeight: number;
+
+  constructor(landscape = false) {
+    this.landscape = landscape;
+    // A4: 595.28 x 841.89 pt
+    this.pageWidth = landscape ? 841.89 : 595.28;
+    this.pageHeight = landscape ? 595.28 : 841.89;
+  }
+
+  addObject(content: string): number {
+    const id = this.nextId++;
+    this.objects.push({id, content});
+    return id;
+  }
+
+  /** Build the complete PDF bytes as a string (binary-safe for our use). */
+  build(): string {
+    let pdf = '%PDF-1.4\n';
+    // Binary comment to signal binary content
+    pdf += '%\xe2\xe3\xcf\xd3\n';
+
+    const offsets: number[] = [];
+
+    for (const obj of this.objects) {
+      offsets[obj.id] = pdf.length;
+      pdf += `${obj.id} 0 obj\n${obj.content}\nendobj\n`;
+    }
+
+    const xrefOffset = pdf.length;
+    const totalObjects = this.nextId;
+
+    pdf += 'xref\n';
+    pdf += `0 ${totalObjects}\n`;
+    pdf += '0000000000 65535 f \n';
+
+    for (let i = 1; i < totalObjects; i++) {
+      const offset = offsets[i] || 0;
+      pdf += offset.toString().padStart(10, '0') + ' 00000 n \n';
+    }
+
+    pdf += 'trailer\n';
+    pdf += `<< /Size ${totalObjects} /Root 1 0 R >>\n`;
+    pdf += 'startxref\n';
+    pdf += `${xrefOffset}\n`;
+    pdf += '%%EOF\n';
+
+    return pdf;
+  }
+}
