+import {TalentEngine, TalentResult, ToolDefinition} from './types';
+
+/**
+ * Financial statements spread and credit-ratio engine.
+ *
+ * The point of this talent is that every ratio reported to a credit committee
+ * comes out of arithmetic on the user's ACTUAL statement line items — never
+ * estimated, never recalled, never invented. RAY's "never invent a figure"
+ * policy is structurally enforced here: the engine takes named numeric args
+ * (the model extracts them from the user's statements), computes closed-form
+ * ratios, and echoes the inputs used so the result is auditable.
+ *
+ * Honesty rules:
+ * - Missing input → omit that specific ratio with "not computable — missing X".
+ *   Partial results are fine; fabrication is not.
+ * - Division by zero → "n/a (denominator zero)", never Infinity, never throw.
+ * - Interpretation bands are RULES-OF-THUMB — labelled as such.
+ * - Every summary echoes the exact inputs used.
+ *
+ * Deliberately dependency-free: no new npm packages, no eval.
+ */
+
+/** Round for display without corrupting the underlying value. */
+function round(value: number, decimals = 2): number {
+  if (!Number.isFinite(value)) {
+    return NaN;
+  }
+  const factor = Math.pow(10, decimals);
+  return Math.round((value + Number.EPSILON) * factor) / factor;
+}
+
+/** Percent formatter: 0.0891 -> "8.91%". */
+function pct(value: number, decimals = 2): string {
+  return Number.isFinite(value) ? `${round(value * 100, decimals)}%` : 'n/a';
+}
+
+/** Money formatter with thousands separators, no currency symbol assumed. */
+function money(value: number, decimals = 2): string {
+  if (!Number.isFinite(value)) {
+    return 'n/a';
+  }
+  return value.toLocaleString('en-US', {
+    minimumFractionDigits: decimals,
+    maximumFractionDigits: decimals,
+  });
+}
+
+/** Coerce an unknown arg to a finite number, or null if unusable. */
+function num(value: unknown): number | null {
+  if (value === undefined || value === null) {
+    return null;
+  }
+  const n = typeof value === 'number' ? value : parseFloat(String(value));
+  return Number.isFinite(n) ? n : null;
+}
+
+/** Coerce an unknown arg to an array of finite numbers, or null. */
+function numArray(value: unknown): number[] | null {
+  if (!Array.isArray(value) || value.length === 0) {
+    return null;
+  }
+  const parsed: number[] = [];
+  for (const item of value) {
+    const n = num(item);
+    if (n === null) {
+      return null;
+    }
+    parsed.push(n);
+  }
+  return parsed;
+}
+
+/** Coerce an unknown arg to a Record<string, number>, or null. */
+function numMap(value: unknown): Record<string, number> | null {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+    return null;
+  }
+  const result: Record<string, number> = {};
+  for (const [k, v] of Object.entries(value as Record<string, unknown>)) {
+    const n = num(v);
+    if (n === null) {
+      return null;
+    }
+    result[k] = n;
+  }
+  return result;
+}
+
+/** Coerce an unknown arg to a Record<string, number[]>, or null. */
+function numSeriesMap(value: unknown): Record<string, number[]> | null {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+    return null;
+  }
+  const result: Record<string, number[]> = {};
+  for (const [k, v] of Object.entries(value as Record<string, unknown>)) {
+    const arr = numArray(v);
+    if (arr === null) {
+      return null;
+    }
+    result[k] = arr;
+  }
+  return result;
+}
+
+function err(summary: string, errorMessage: string): TalentResult {
+  return {type: 'error', summary, errorMessage};
+}
+
+/** Safe division: returns null when denominator is zero. */
+function safeDiv(numerator: number, denominator: number): number | null {
+  if (denominator === 0) {
+    return null;
+  }
+  const result = numerator / denominator;
+  return Number.isFinite(result) ? result : null;
+}
+
+/** Format a ratio that might be missing (null) or zero-denominator. */
+function fmtRatio(value: number | null, missingMsg: string, decimals = 2): string {
+  if (value === null) {
+    return missingMsg;
+  }
+  return String(round(value, decimals));
+}
+
+const OPERATIONS = [
+  'liquidity',
+  'leverage',
+  'coverage',
+  'profitability',
+  'efficiency',
+  'common_size',
+  'trend',
+  'dupont',
