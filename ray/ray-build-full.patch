@@ -0,0 +1,156 @@
+import {CodeEditEngine} from '../CodeEditEngine';
+
+/**
+ * code_edit tests. The engine is pure (no file I/O), so these run the real
+ * execute() and assert on the returned summary/diff. Expected edit results are
+ * worked out by hand below.
+ */
+const text = (r: any): string => (r && typeof r.summary === 'string' ? r.summary : '');
+
+describe('CodeEditEngine', () => {
+  const engine = new CodeEditEngine();
+
+  it('is named code_edit', () => {
+    expect(engine.name).toBe('code_edit');
+  });
+
+  it('applies a single unique exact edit and returns the edited source', async () => {
+    // "const a = 1;" → "const a = 2;" (one occurrence)
+    const r = await engine.execute({
+      operation: 'apply_edits',
+      source: 'const a = 1;\nconst b = 2;',
+      edits: [{search: 'const a = 1;', replace: 'const a = 2;'}],
+    });
+    expect(r.type).toBe('text');
+    expect(text(r)).toContain('const a = 2;');
+    expect(text(r)).toContain('const b = 2;');
+  });
+
+  it('refuses an ambiguous match unless replace_all is set', async () => {
+    const r = await engine.execute({
+      operation: 'apply_edits',
+      source: 'x\nx\nx',
+      edits: [{search: 'x', replace: 'y'}],
+    });
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/matches 3 places/);
+  });
+
+  it('replaces every occurrence with replace_all', async () => {
+    // 3 occurrences of "x" → "y"
+    const r = await engine.execute({
+      operation: 'apply_edits',
+      source: 'x\nx\nx',
+      edits: [{search: 'x', replace: 'y', replace_all: true}],
+    });
+    expect(r.type).toBe('text');
+    expect(text(r)).toContain('replaced 3 occurrences');
+    expect(text(r)).toContain('y\ny\ny');
+  });
+
+  it('refuses a missing match and changes nothing', async () => {
+    const r = await engine.execute({
+      operation: 'apply_edits',
+      source: 'const a = 1;',
+      edits: [{search: 'const z = 9;', replace: 'nope'}],
+    });
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/not found/);
+  });
+
+  it('refuses an empty search string', async () => {
+    const r = await engine.execute({
+      operation: 'apply_edits',
+      source: 'abc',
+      edits: [{search: '', replace: 'x'}],
+    });
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/empty "search"/);
+  });
+
+  it('applies edits in order', async () => {
+    // a→b then b→c on "a" yields "c" (second edit sees the first's output).
+    const r = await engine.execute({
+      operation: 'apply_edits',
+      source: 'a',
+      edits: [
+        {search: 'a', replace: 'b'},
+        {search: 'b', replace: 'c'},
+      ],
+    });
+    expect(r.type).toBe('text');
+    expect(text(r)).toContain('Edited source:\nc');
+  });
+
+  it('errors when edits is missing for apply_edits', async () => {
+    const r = await engine.execute({operation: 'apply_edits', source: 'abc'});
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/non-empty array/);
+  });
+
+  it('errors when source is missing', async () => {
+    const r = await engine.execute({operation: 'review'});
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/missing "source"/);
+  });
+
+  it('errors on an unknown operation', async () => {
+    const r = await engine.execute({operation: 'delete_everything', source: 'x'});
+    expect(r.type).toBe('error');
+    expect(text(r)).toMatch(/must be "apply_edits" or "review"/);
+  });
+
+  it('review flags an unclosed bracket', async () => {
+    const r = await engine.execute({
+      operation: 'review',
+      source: 'function f() {\n  return 1;\n',
+    });
+    expect(r.type).toBe('text');
+    expect(text(r)).toMatch(/unclosed bracket/);
+  });
+
+  it('review reports clean code as having no mechanical issues', async () => {
+    const r = await engine.execute({
+      operation: 'review',
+      source: 'function f() {\n  return 1;\n}',
+    });
+    expect(r.type).toBe('text');
+    expect(text(r)).toMatch(/No mechanical issues/);
+  });
+
+  it('review flags a TODO marker', async () => {
+    const r = await engine.execute({
+      operation: 'review',
+      source: '// TODO: fix this\nconst a = 1;',
+    });
+    expect(text(r)).toMatch(/TODO: fix this/);
+  });
+
+  it('does not count brackets inside strings during review', async () => {
+    const r = await engine.execute({
+      operation: 'review',
+      source: 'const s = "unbalanced ( bracket";',
+    });
+    expect(text(r)).toMatch(/No mechanical issues/);
+  });
+
+  it('advertises a function tool schema with apply_edits/review', () => {
+    const def = engine.toToolDefinition();
+    expect(def.type).toBe('function');
+    expect(def.function.name).toBe('code_edit');
+    expect(def.function.parameters.properties.operation.enum).toEqual([
+      'apply_edits',
+      'review',
+    ]);
+    expect(def.function.parameters.required).toEqual(['operation', 'source']);
+  });
+
+  it('contributes a system prompt fragment forbidding file-write claims', () => {
+    const frag = engine.systemPromptFragment?.({
+      now: new Date(0),
+      maxToolTurns: 5,
+      activeTalents: new Set(['code_edit']),
+    });
+    expect(frag).toMatch(/cannot read or write files/);
+  });
+});
