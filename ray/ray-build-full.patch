diff --git a/src/services/talents/EncodingEngine.ts b/src/services/talents/EncodingEngine.ts
new file mode 100644
index 0000000..484df7b
--- /dev/null
+++ b/src/services/talents/EncodingEngine.ts
@@ -0,0 +1,320 @@
+import {
+  bytesToBase64,
+  base64ToBytes,
+  bytesToHex,
+  hexToBytes,
+  stringToUtf8Bytes,
+  utf8BytesToString,
+  decodeInput,
+  InputEncoding,
+} from './byteUtils';
+
+import {TalentEngine, TalentResult, ToolDefinition} from './types';
+
+const MAX_OUTPUT = 50_000;
+
+function truncate(s: string): string {
+  if (s.length <= MAX_OUTPUT) return s;
+  return s.slice(0, MAX_OUTPUT) + `\n… [truncated, ${s.length - MAX_OUTPUT} chars omitted]`;
+}
+
+type EncodingOperation =
+  | 'to_base64'
+  | 'from_base64'
+  | 'to_hex'
+  | 'from_hex'
+  | 'to_utf8'
+  | 'from_utf8'
+  | 'url_encode'
+  | 'url_decode'
+  | 'jwt_decode'
+  | 'auto';
+
+const OPERATIONS: EncodingOperation[] = [
+  'to_base64',
+  'from_base64',
+  'to_hex',
+  'from_hex',
+  'to_utf8',
+  'from_utf8',
+  'url_encode',
+  'url_decode',
+  'jwt_decode',
+  'auto',
+];
+
+export class EncodingEngine implements TalentEngine {
+  readonly name = 'encoding';
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const operation = args.operation as string | undefined;
+    if (!operation || !OPERATIONS.includes(operation as EncodingOperation)) {
+      return {
+        type: 'error',
+        summary: `encoding: unknown or missing operation "${operation}". Valid: ${OPERATIONS.join(', ')}`,
+        errorMessage: `operation must be one of: ${OPERATIONS.join(', ')}`,
+      };
+    }
+
+    const data = typeof args.data === 'string' ? args.data : '';
+    if (!data && operation !== 'jwt_decode') {
+      return {
+        type: 'error',
+        summary: `encoding: missing or empty "data" argument for ${operation}`,
+        errorMessage: 'data argument is required and must be a non-empty string',
+      };
+    }
+
+    try {
+      switch (operation) {
+        case 'to_base64':
+          return this.toBase64(data, args);
+        case 'from_base64':
+          return this.fromBase64(data);
+        case 'to_hex':
+          return this.toHex(data, args);
+        case 'from_hex':
+          return this.fromHex(data);
+        case 'to_utf8':
+          return this.toUtf8(data, args);
+        case 'from_utf8':
+          return this.fromUtf8(data);
+        case 'url_encode':
+          return this.urlEncode(data);
+        case 'url_decode':
+          return this.urlDecode(data);
+        case 'jwt_decode':
+          return this.jwtDecode(data);
+        case 'auto':
+          return this.autoConvert(data, args);
+        default:
+          return {
+            type: 'error',
+            summary: `encoding: unhandled operation "${operation}"`,
+            errorMessage: 'unhandled operation',
+          };
+      }
+    } catch (e) {
+      const errMsg = e instanceof Error ? e.message : String(e);
+      return {
+        type: 'error',
+        summary: `encoding: ${operation} failed — ${errMsg}`,
+        errorMessage: errMsg,
+      };
+    }
+  }
+
+  private toBase64(data: string, args: Record<string, any>): TalentResult {
+    const fromEnc = (args.from as InputEncoding) || 'utf8';
+    const bytes = decodeInput(data, fromEnc);
+    const urlSafe = args.url_safe === true;
+    const result = bytesToBase64(bytes, urlSafe);
+    return {
+      type: 'text',
+      summary: truncate(`base64${urlSafe ? 'url' : ''}(${fromEnc}:${data}) = ${result}`),
+    };
+  }
+
+  private fromBase64(data: string): TalentResult {
+    const bytes = base64ToBytes(data);
+    const hex = bytesToHex(bytes);
+    const text = utf8BytesToString(bytes);
+    return {
+      type: 'text',
+      summary: truncate(`from_base64("${data}") → hex: ${hex}\nutf8: ${text}`),
+    };
+  }
+
+  private toHex(data: string, args: Record<string, any>): TalentResult {
+    const fromEnc = (args.from as InputEncoding) || 'utf8';
+    const bytes = decodeInput(data, fromEnc);
+    const result = bytesToHex(bytes);
+    return {
+      type: 'text',
+      summary: truncate(`hex(${fromEnc}:${data}) = ${result}`),
+    };
+  }
+
+  private fromHex(data: string): TalentResult {
+    const bytes = hexToBytes(data);
+    const text = utf8BytesToString(bytes);
+    const b64 = bytesToBase64(bytes);
+    return {
+      type: 'text',
+      summary: truncate(`from_hex("${data}") → utf8: ${text}\nbase64: ${b64}`),
+    };
+  }
+
+  private toUtf8(data: string, args: Record<string, any>): TalentResult {
+    const fromEnc = (args.from as InputEncoding) || 'auto';
+    const bytes = decodeInput(data, fromEnc);
+    const result = utf8BytesToString(bytes);
+    return {
+      type: 'text',
+      summary: truncate(`utf8(${fromEnc}:${data}) = ${result}`),
+    };
+  }
+
+  private fromUtf8(data: string): TalentResult {
+    const bytes = stringToUtf8Bytes(data);
+    const hex = bytesToHex(bytes);
+    const b64 = bytesToBase64(bytes);
+    return {
+      type: 'text',
+      summary: truncate(`from_utf8("${data}") → hex: ${hex}\nbase64: ${b64}`),
+    };
+  }
+
+  private urlEncode(data: string): TalentResult {
+    const result = encodeURIComponent(data);
+    return {
+      type: 'text',
+      summary: truncate(`url_encode("${data}") = ${result}`),
+    };
+  }
+
+  private urlDecode(data: string): TalentResult {
+    try {
+      const result = decodeURIComponent(data);
+      return {
+        type: 'text',
+        summary: truncate(`url_decode("${data}") = ${result}`),
+      };
+    } catch (e) {
+      const errMsg = e instanceof Error ? e.message : String(e);
+      return {
+        type: 'error',
+        summary: `encoding: url_decode failed — ${errMsg}`,
+        errorMessage: errMsg,
+      };
+    }
+  }
+
+  private jwtDecode(data: string): TalentResult {
+    const parts = data.trim().split('.');
+    if (parts.length !== 3) {
+      return {
+        type: 'error',
+        summary: `encoding: jwt_decode failed — expected 3 dot-separated segments, got ${parts.length}`,
+        errorMessage: 'JWT must have exactly 3 dot-separated parts (header.payload.signature)',
+      };
+    }
+
+    let header: any;
+    let payload: any;
+
+    try {
+      const headerBytes = base64ToBytes(parts[0]);
+      const headerStr = utf8BytesToString(headerBytes);
+      header = JSON.parse(headerStr);
+    } catch (e) {
+      const errMsg = e instanceof Error ? e.message : String(e);
+      return {
+        type: 'error',
+        summary: `encoding: jwt_decode failed — invalid header: ${errMsg}`,
+        errorMessage: errMsg,
+      };
+    }
+
+    try {
+      const payloadBytes = base64ToBytes(parts[1]);
+      const payloadStr = utf8BytesToString(payloadBytes);
+      payload = JSON.parse(payloadStr);
+    } catch (e) {
+      const errMsg = e instanceof Error ? e.message : String(e);
+      return {
+        type: 'error',
+        summary: `encoding: jwt_decode failed — invalid payload: ${errMsg}`,
+        errorMessage: errMsg,
+      };
+    }
+
+    const headerJson = JSON.stringify(header);
+    const payloadJson = JSON.stringify(payload);
+    return {
+      type: 'text',
+      summary: truncate(
+        `JWT decoded (signature NOT verified):\nheader: ${headerJson}\npayload: ${payloadJson}`,
+      ),
+    };
+  }
+
+  private autoConvert(data: string, args: Record<string, any>): TalentResult {
+    const from = (args.from as InputEncoding) || 'auto';
+    const to = (args.to as string) || 'utf8';
+    const bytes = decodeInput(data, from);
+
+    let result: string;
+    switch (to) {
+      case 'hex':
+        result = bytesToHex(bytes);
+        break;
+      case 'base64':
+        result = bytesToBase64(bytes);
+        break;
+      case 'utf8':
+      case 'text':
+        result = utf8BytesToString(bytes);
+        break;
+      default:
+        return {
+          type: 'error',
+          summary: `encoding: auto — unsupported target "${to}"`,
+          errorMessage: `to must be one of: hex, base64, utf8`,
+        };
+    }
+
+    return {
+      type: 'text',
+      summary: truncate(`auto(${from}→${to}: "${data}") = ${result}`),
+    };
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: 'encoding',
+        description:
+          'Encode/decode data between hex, base64, base64url, URL-encoding, and UTF-8 text. Also decodes JWTs (header+payload only; signature is NOT verified).',
+        parameters: {
+          type: 'object',
+          properties: {
+            operation: {
+              type: 'string',
+              enum: OPERATIONS,
+              description:
+                'The encoding operation to perform. "auto" detects input format and converts to the requested target.',
+            },
+            data: {
+              type: 'string',
+              description: 'The input data to encode/decode.',
+            },
+            from: {
+              type: 'string',
+              enum: ['auto', 'hex', 'base64', 'utf8'],
+              description:
+                'Input encoding. Default "auto" (hex if even-length hex-only, else base64).',
+            },
+            to: {
+              type: 'string',
+              enum: ['hex', 'base64', 'utf8'],
+              description:
+                'Target encoding for "auto" operation. Default "utf8".',
+            },
+            url_safe: {
+              type: 'boolean',
+              description:
+                'Use base64url alphabet (no padding) for to_base64. Default false.',
+            },
+          },
+          required: ['operation', 'data'],
+        },
+      },
+    };
+  }
+
+  systemPromptFragment(): string | null {
+    return `When you need to convert between hex, base64, base64url, URL-encoding (percent-encoding), and UTF-8 text, or decode a JWT, use the "encoding" talent rather than attempting the conversion by eye. The model must NOT try to base64/hex decode in its head — always call the tool. For JWT decoding, the tool decodes header and payload but does NOT verify the signature (no key is available).`;
+  }
+}
