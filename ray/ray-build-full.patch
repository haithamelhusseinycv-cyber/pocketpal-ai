+const movingTimeMatch = itineraryResult.summary.match(/Moving time: ([\d.]+) hours/);
+const breakTimeMatch = itineraryResult.summary.match(/Break time: ([\d.]+) hours/);
+const finishMatch = itineraryResult.summary.match(/Finish time: (.+)/);
+
+const totalDuration = totalDurMatch ? parseFloat(totalDurMatch[1]) : 0;
+const movingTime = movingTimeMatch ? parseFloat(movingTimeMatch[1]) : 0;
+const breakTime = breakTimeMatch ? parseFloat(breakTimeMatch[1]) : 0;
+const finishTime = finishMatch ? finishMatch[1] : '';
