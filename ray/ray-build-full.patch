+const newMoonResult = await astroEngine.execute({
+  operation: 'moon',
+  date: '2026-01-29'
+});
+console.log('✓ Calculated moon phase');
+
+const phaseMatch = newMoonResult.summary.match(/Phase: (.+)/);
+const ageMatch = newMoonResult.summary.match(/Age: ([\d.]+) days/);
+const illumMatch = newMoonResult.summary.match(/Illumination: ([\d.]+)%/);
