+    const r = await engine.execute({
+      operation: 'natal',
+      datetime: '2026-03-20T12:00:00Z',
+      lat: 0,
+      lon: 0,
+    });
+    expect(r.type).toBe('text');
+    const summary = text(r);
+    const sunMatch = summary.match(/Sun:.*ecliptic lon ([\d.]+)°/);
+    expect(sunMatch).toBeTruthy();
+    const sunLon = parseFloat(sunMatch![1]);
+    // Should be within 0.5° of 0°
+    expect(sunLon).toBeLessThan(0.5);
+  });
+
+  it('natal Sun longitude for autumnal equinox ≈ 180°', async () => {
+    // 2026-09-23 00:00 UTC (autumnal equinox)
+    const r = await engine.execute({
+      operation: 'natal',
+      datetime: '2026-09-23T00:00:00Z',
+      lat: 0,
+      lon: 0,
+    });
+    expect(r.type).toBe('text');
+    const summary = text(r);
+    const sunMatch = summary.match(/Sun:.*ecliptic lon ([\d.]+)°/);
