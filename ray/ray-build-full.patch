+import NetInfoMock from '../../../__mocks__/external/@react-native-community/netinfo';
+import {
+  isMeteredConnection,
+  startNetworkWatch,
+  __resetNetworkWatch,
+} from '../networkInfo';
+
+/**
+ * networkInfo tests. Uses the jest moduleNameMapper mock for netinfo. The mock's
+ * addEventListener calls the listener synchronously with the current state, so
+ * setting state then reading is deterministic.
+ */
+describe('networkInfo.isMeteredConnection', () => {
+  beforeEach(() => {
+    __resetNetworkWatch();
+    NetInfoMock.__reset();
+  });
+
+  it('treats a not-yet-reported connection as metered (privacy-safe)', () => {
+    // No reading pushed yet: latest stays null on the very first synchronous
+    // path. Subscribe, then assert metered before any state arrives.
+    expect(isMeteredConnection()).toBe(true);
+  });
+
+  it('reports wifi as unmetered', () => {
+    startNetworkWatch();
+    NetInfoMock.__setState({type: 'wifi', isConnected: true, details: {isConnectionExpensive: false}});
+    expect(isMeteredConnection()).toBe(false);
+  });
+
+  it('reports cellular as metered', () => {
+    startNetworkWatch();
+    NetInfoMock.__setState({type: 'cellular', isConnected: true, details: {isConnectionExpensive: true}});
+    expect(isMeteredConnection()).toBe(true);
+  });
+
+  it('reports an expensive connection as metered even when type is wifi', () => {
+    startNetworkWatch();
+    NetInfoMock.__setState({type: 'wifi', isConnected: true, details: {isConnectionExpensive: true}});
+    expect(isMeteredConnection()).toBe(true);
+  });
+
+  it('reports an offline connection as metered (gates cloud off)', () => {
+    startNetworkWatch();
+    NetInfoMock.__setState({type: 'none', isConnected: false, details: null});
+    expect(isMeteredConnection()).toBe(true);
+  });
+
+  it('reports an unknown type as metered', () => {
+    startNetworkWatch();
+    NetInfoMock.__setState({type: 'bluetooth', isConnected: true, details: {}});
+    expect(isMeteredConnection()).toBe(true);
+  });
+});
