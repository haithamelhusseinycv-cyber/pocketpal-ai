+/**
+ * STT service entry point ("RAY's ears").
+ *
+ * Re-exports the engine-agnostic seam. The shipped native engine reports
+ * `isAvailable() === false` until activated on-device — see ./README.md.
+ */
+
+export type {
+  STTEngine,
+  STTEngineId,
+  STTLanguage,
+  STTStartOptions,
+  RecognitionResult,
+  RecognitionSession,
+  STTError,
+  STTErrorCode,
+} from './types';
+
+export {
+  getSTTEngine,
+  getAllSTTEngines,
+  getAvailableSTTEngine,
+} from './engineRegistry';
+
+export {NativeRecognizerEngine} from './engines/native';
diff --git a/src/services/stt/types.ts b/src/services/stt/types.ts
new file mode 100644
index 0000000..85e278d
--- /dev/null
+++ b/src/services/stt/types.ts
@@ -0,0 +1,118 @@
+/**
+ * STT (speech-to-text) service types — "RAY's ears".
+ *
+ * This mirrors the TTS service architecture (src/services/tts) deliberately:
+ * an engine-agnostic `STTEngine` interface, a registry, and a runtime, so the
+ * rest of the app never touches a specific recognizer package directly.
+ *
+ * STATUS — READ THIS:
+ * The bundled `@pocketpalai/react-native-speech` is SPEAK-ONLY (its API is
+ * initialize / speak / stop / getAvailableVoices / createSpeechStream). It has
+ * NO recognition surface. So the recognizer engine below ships in a
+ * "not activated" state: the seam, types, registry, and lifecycle are real and
+ * tested, but actual microphone capture requires wiring a native Android
+ * speech recognizer (e.g. the OS RecognizerIntent / a native module) at
+ * activation time on-device. See src/services/stt/README.md for the activation
+ * checklist. Nothing here fabricates a transcript.
+ *
+ * The pipeline RAY actually needs is:
+ *   [native mic capture] -> raw transcript (often street Egyptian, with
+ *   disfluencies) -> `dictation` talent cleans it + tags language ->
+ *   model renders formal Arabic / email form (dialect->MSA is the model's job,
+ *   guided by persona directives) -> optionally TTS speaks the result back.
+ *
+ * This file defines the capture seam. The cleanup/format seam is the
+ * `dictation` talent. The dialect->MSA intelligence is the model + persona.
+ */
+
+/** Recognizer backends. Only `native` is planned for v1; the enum leaves room. */
+export type STTEngineId = 'native';
+
+/** Language the recognizer should bias toward, BCP-47. */
+export type STTLanguage =
+  | 'en-US' // American English (the user's NY voice)
+  | 'ar-EG' // Egyptian Arabic — street/colloquial input
+  | 'auto'; // let the recognizer decide (often poor for dialect)
+
+export interface STTStartOptions {
+  /** Recognition language hint. Defaults to 'auto'. */
+  language?: STTLanguage;
+  /**
+   * Emit partial (interim) transcripts as the user speaks, for live display.
+   * A recognizer that can't do partials should ignore this and only emit final.
+   */
+  partialResults?: boolean;
+  /**
+   * Stop automatically after a trailing-silence timeout instead of waiting for
+   * an explicit stop(). Good for hands-free "speak then send" dictation.
+   */
+  autoStopOnSilence?: boolean;
+}
+
+/**
+ * One recognition result. `text` is the RAW transcript — street dialect and
+ * all, disfluencies ("um", "uh", repeated words) intact. Cleaning and
+ * formatting are deliberately NOT done here; that is the `dictation` talent's
+ * job so the capture layer stays a faithful, lossless seam.
+ */
+export interface RecognitionResult {
+  /** Raw transcript text, unedited. */
+  text: string;
+  /** True once the recognizer considers this segment final (not interim). */
+  isFinal: boolean;
+  /** Language the recognizer believes it heard, if it reports one. */
+  language?: string;
+  /** Confidence 0..1 if the recognizer provides it; undefined otherwise. */
+  confidence?: number;
+}
+
+/**
+ * Live recognition session, returned by STTEngine.start(). Mirrors the TTS
+ * StreamingHandle shape: the caller subscribes to results and controls
+ * lifecycle. Implementations must be idempotent after stop()/cancel().
+ */
+export interface RecognitionSession {
+  /** Register a listener for results (partial and final). Returns unsubscribe. */
+  onResult(cb: (result: RecognitionResult) => void): () => void;
+  /** Register a listener for errors (permission denied, no recognizer, ...). */
+  onError(cb: (error: STTError) => void): () => void;
+  /** Stop capture and finalize. Resolves with the last final transcript. */
+  stop(): Promise<string>;
+  /** Discard the session without producing a transcript. */
+  cancel(): Promise<void>;
+}
+
+export type STTErrorCode =
+  | 'not_activated' // recognizer not wired yet (the default v1 state)
+  | 'unavailable' // device has no speech recognizer installed
+  | 'permission_denied' // RECORD_AUDIO not granted
+  | 'no_match' // recognizer heard nothing intelligible
+  | 'busy' // another session is active
+  | 'unknown';
+
+export interface STTError {
+  code: STTErrorCode;
+  message: string;
+}
+
+/**
+ * A speech recognizer backend. Implement this for the native Android
+ * recognizer at activation time; the registry and runtime already speak it.
+ */
+export interface STTEngine {
+  readonly id: STTEngineId;
+  /**
+   * Whether this engine can actually capture speech right now. Returns false
+   * for the shipped placeholder so callers degrade gracefully (e.g. hide the
+   * mic button) instead of pretending to listen.
+   */
+  isAvailable(): Promise<boolean>;
+  /** Whether RECORD_AUDIO permission is currently granted. */
+  hasPermission(): Promise<boolean>;
+  /** Request RECORD_AUDIO permission. Returns granted state. */
+  requestPermission(): Promise<boolean>;
+  /** Begin a recognition session. Rejects with an STTError on failure. */
+  start(options?: STTStartOptions): Promise<RecognitionSession>;
+  /** List the recognition languages this backend supports. */
+  supportedLanguages(): Promise<STTLanguage[]>;
+}
diff --git a/src/services/talents/ApkInspectEngine.ts b/src/services/talents/ApkInspectEngine.ts
new file mode 100644
index 0000000..dcc1ac9
--- /dev/null
+++ b/src/services/talents/ApkInspectEngine.ts
@@ -0,0 +1,632 @@
+/**
+ * ApkInspectEngine — static, read-only inspection of Android APK bytes.
+ *
+ * Defensive app-auditing tool: lists ZIP entries, detects signing scheme
+ * presence (v1 JAR artifacts, APK Sig Block v2/v3 magic), and decodes the
+ * binary AndroidManifest.xml (AXML) enough to extract package name,
+ * permissions, and exported components.
+ *
+ * HARD SAFETY BOUNDARY: this engine only READS and REPORTS structure. It
+ * does NOT verify, strip, forge, re-sign, patch, or bypass any signature,
+ * and refuses to help tamper with an app. All operations are read-only over
+ * the provided bytes.
+ */
+
+import {TalentEngine, TalentResult, ToolDefinition, SystemPromptContext} from './types';
+import {decodeInput, readU16LE, readU32LE, utf8BytesToString, InputEncoding} from './byteUtils';
+
+// ─── ZIP constants ───────────────────────────────────────────────────────────
+const ZIP_LOCAL_SIG = 0x04034b50;
+const ZIP_CENTRAL_SIG = 0x02014b50;
+const ZIP_EOCD_SIG = 0x06054b50;
+const MAX_ENTRIES = 300;
+
+// ─── AXML chunk types ────────────────────────────────────────────────────────
+const AXML_STRING_POOL = 0x0001;
+const AXML_RESOURCE_MAP = 0x0180;
+const AXML_ELEMENT_START = 0x0102;
+
+// ─── APK Sig Block magic ─────────────────────────────────────────────────────
+const APK_SIG_MAGIC = new Uint8Array([
+  0x41, 0x50, 0x4b, 0x20, 0x53, 0x69, 0x67, 0x20,
+  0x42, 0x6c, 0x6f, 0x63, 0x6b, 0x20, 0x34, 0x32,
+]);
+
+// ─── Types ───────────────────────────────────────────────────────────────────
+interface ZipEntry {
+  name: string;
+  method: number;
+  compressedSize: number;
+  uncompressedSize: number;
+  localHeaderOffset: number;
+}
+
+interface ParsedManifest {
+  packageName: string | null;
+  permissions: string[];
+  components: {type: string; name: string; exported: string | null}[];
+}
+
+// ─── ZIP helpers ─────────────────────────────────────────────────────────────
+function findEOCD(bytes: Uint8Array): number | null {
+  const minEOCD = 22;
+  if (bytes.length < minEOCD) return null;
+  const maxScan = Math.min(bytes.length, 65557);
+  for (let i = bytes.length - minEOCD; i >= bytes.length - maxScan && i >= 0; i--) {
+    if (readU32LE(bytes, i) === ZIP_EOCD_SIG) {
+      return i;
+    }
+  }
+  return null;
+}
+
+function parseEOCD(bytes: Uint8Array, offset: number): {entryCount: number; cdOffset: number; cdSize: number} | null {
+  if (offset + 22 > bytes.length) return null;
+  const totalEntries = readU16LE(bytes, offset + 10);
+  const cdSize = readU32LE(bytes, offset + 12);
+  const cdOffset = readU32LE(bytes, offset + 16);
+  return {entryCount: totalEntries, cdOffset, cdSize};
+}
+
+function parseCentralDirectory(bytes: Uint8Array, cdOffset: number, entryCount: number): {entries: ZipEntry[]; truncated: boolean} {
+  const entries: ZipEntry[] = [];
+  let pos = cdOffset;
+  let truncated = false;
+  for (let i = 0; i < entryCount; i++) {
+    if (i >= MAX_ENTRIES) {truncated = true; break;}
+    if (pos + 46 > bytes.length) {truncated = true; break;}
+    const sig = readU32LE(bytes, pos);
+    if (sig !== ZIP_CENTRAL_SIG) {truncated = true; break;}
+    const method = readU16LE(bytes, pos + 10);
+    const compressedSize = readU32LE(bytes, pos + 20);
+    const uncompressedSize = readU32LE(bytes, pos + 24);
+    const nameLen = readU16LE(bytes, pos + 28);
+    const extraLen = readU16LE(bytes, pos + 30);
+    const commentLen = readU16LE(bytes, pos + 32);
+    const localHeaderOffset = readU32LE(bytes, pos + 42);
+    if (pos + 46 + nameLen > bytes.length) {truncated = true; break;}
+    const nameBytes = bytes.subarray(pos + 46, pos + 46 + nameLen);
+    const name = utf8BytesToString(nameBytes);
+    entries.push({name, method, compressedSize, uncompressedSize, localHeaderOffset});
+    pos += 46 + nameLen + extraLen + commentLen;
+  }
+  return {entries, truncated};
+}
+
+function scanLocalHeaders(bytes: Uint8Array): {entries: ZipEntry[]; truncated: boolean} {
+  const entries: ZipEntry[] = [];
+  let pos = 0;
+  let truncated = false;
+  while (pos + 30 <= bytes.length) {
+    const sig = readU32LE(bytes, pos);
+    if (sig !== ZIP_LOCAL_SIG) break;
+    const method = readU16LE(bytes, pos + 8);
+    const compressedSize = readU32LE(bytes, pos + 18);
+    const uncompressedSize = readU32LE(bytes, pos + 22);
+    const nameLen = readU16LE(bytes, pos + 26);
+    const extraLen = readU16LE(bytes, pos + 28);
+    if (pos + 30 + nameLen > bytes.length) {truncated = true; break;}
+    const nameBytes = bytes.subarray(pos + 30, pos + 30 + nameLen);
+    const name = utf8BytesToString(nameBytes);
+    entries.push({name, method, compressedSize, uncompressedSize, localHeaderOffset: pos});
+    pos += 30 + nameLen + extraLen + compressedSize;
+    if (entries.length >= MAX_ENTRIES) {truncated = true; break;}
+  }
+  return {entries, truncated};
+}
+
+function readLocalFileData(bytes: Uint8Array, localOffset: number): Uint8Array | null {
+  if (localOffset + 30 > bytes.length) return null;
+  const sig = readU32LE(bytes, localOffset);
+  if (sig !== ZIP_LOCAL_SIG) return null;
+  const nameLen = readU16LE(bytes, localOffset + 26);
+  const extraLen = readU16LE(bytes, localOffset + 28);
+  const dataStart = localOffset + 30 + nameLen + extraLen;
+  const compressedSize = readU32LE(bytes, localOffset + 18);
+  if (dataStart + compressedSize > bytes.length) return null;
+  return bytes.subarray(dataStart, dataStart + compressedSize);
+}
+
+// ─── AXML decoder ────────────────────────────────────────────────────────────
+
+/**
+ * Decode a string pool chunk. `chunk` is the FULL chunk starting at the chunk
+ * header (type at 0, headerSize at 2, size at 4, then pool-specific fields).
+ *
+ * String pool layout (from chunk start):
+ *   0: type (u16) = 0x0001
+ *   2: headerSize (u16) = 28
+ *   4: size (u32)
+ *   8: stringCount (u32)
+ *  12: styleCount (u32)
+ *  16: flags (u32) — bit 0x100 = UTF-8
+ *  20: stringsStart (u32) — offset from chunk start to string data
+ *  24: stylesStart (u32)
+ *  28: string offsets (stringCount * u32)
+ *  28 + 4*N: style offsets (styleCount * u32)
+ *  stringsStart: string data
+ */
+function decodeStringPool(chunk: Uint8Array): {strings: string[]; error: string | null} {
+  if (chunk.length < 28) return {strings: [], error: 'string pool chunk too small'};
+  const stringCount = readU32LE(chunk, 8);
+  const _styleCount = readU32LE(chunk, 12);
+  const flags = readU32LE(chunk, 16);
+  const stringsStart = readU32LE(chunk, 20);
+  const isUTF8 = (flags & 0x100) !== 0;
+
+  const offsetsStart = 28;
+  if (offsetsStart + stringCount * 4 > chunk.length) {
+    return {strings: [], error: 'string pool offsets out of bounds'};
+  }
+
+  const strings: string[] = [];
+
+  for (let i = 0; i < stringCount; i++) {
+    const strOffset = readU32LE(chunk, offsetsStart + i * 4);
+    const absPos = stringsStart + strOffset;
+
+    if (isUTF8) {
+      if (absPos >= chunk.length) {
+        return {strings: [], error: `UTF-8 string ${i} offset out of bounds`};
+      }
+      let pos = absPos;
+      // char count: if high bit of first byte set, it's a 2-byte value
+      if (chunk[pos] & 0x80) {
+        if (pos + 2 > chunk.length) return {strings: [], error: `UTF-8 string ${i} truncated char count`};
+        pos += 2;
+      } else {
+        pos += 1;
+      }
+      // byte count
+      if (pos >= chunk.length) return {strings: [], error: `UTF-8 string ${i} truncated byte count`};
+      let byteCount: number;
+      if (chunk[pos] & 0x80) {
+        if (pos + 2 > chunk.length) return {strings: [], error: `UTF-8 string ${i} truncated byte count 2`};
+        byteCount = ((chunk[pos] & 0x7f) << 8) | chunk[pos + 1];
+        pos += 2;
+      } else {
+        byteCount = chunk[pos];
+        pos += 1;
+      }
+      if (pos + byteCount > chunk.length) {
+        return {strings: [], error: `UTF-8 string ${i} data out of bounds`};
+      }
+      const strBytes = chunk.subarray(pos, pos + byteCount);
+      strings.push(utf8BytesToString(strBytes));
+    } else {
+      // UTF-16LE
+      if (absPos + 2 > chunk.length) {
+        return {strings: [], error: `UTF-16 string ${i} offset out of bounds`};
+      }
+      let pos = absPos;
+      let charCount: number;
+      const first = readU16LE(chunk, pos);
+      if (first & 0x8000) {
+        if (pos + 4 > chunk.length) return {strings: [], error: `UTF-16 string ${i} truncated char count`};
+        charCount = ((first & 0x7fff) << 16) | readU16LE(chunk, pos + 2);
+        pos += 4;
+      } else {
+        charCount = first;
+        pos += 2;
+      }
+      if (pos + charCount * 2 > chunk.length) {
+        return {strings: [], error: `UTF-16 string ${i} data out of bounds`};
+      }
+      let str = '';
+      for (let j = 0; j < charCount; j++) {
+        str += String.fromCharCode(readU16LE(chunk, pos + j * 2));
+      }
+      strings.push(str);
+    }
+  }
+  return {strings, error: null};
+}
+
+/**
+ * Decode a binary AXML (AndroidManifest.xml). The AXML file format:
+ *
+ * Top-level: magic 0x00080003 (u32) + fileSize (u32)
+ * Then chunks:
+ *   String pool (type 0x0001)
+ *   Optional resource map (type 0x0180)
+ *   XML namespace/element chunks
+ *
+ * Each chunk: type(u16) + headerSize(u16) + size(u32) + data
+ *
+ * Element start (type 0x0102), headerSize=16:
+ *   8: lineNumber (u32)
+ *  12: comment (u32)
+ *  16: ns index (u32)
+ *  20: name index (u32)
+ *  24: attrStart (u16) — usually 0x0014 = 20
+ *  26: attrSize (u16) — usually 0x0014 = 20
+ *  28: attrCount (u16)
+ *  30: idIndex (u16)
+ *  32: classIndex (u16)
+ *  34: styleIndex (u16)
+ *  36: attributes (each attrSize bytes: ns(u32), name(u32), rawValue(u32), typedValue(8))
+ */
+function decodeAXML(data: Uint8Array): {manifest: ParsedManifest; error: string | null} {
+  const result: ParsedManifest = {packageName: null, permissions: [], components: []};
+
+  if (data.length < 8) return {manifest: result, error: 'AXML too small'};
+
+  const magic = readU32LE(data, 0);
+  if (magic !== 0x00080003) {
+    return {manifest: result, error: `not a binary AXML (magic=0x${magic.toString(16)})`};
+  }
+
+  let pos = 8;
+  let stringPool: string[] | null = null;
+
+  while (pos + 8 <= data.length) {
+    const chunkType = readU16LE(data, pos);
+    const chunkHeaderSize = readU16LE(data, pos + 2);
+    const chunkSize = readU32LE(data, pos + 4);
+    if (chunkSize < 8 || pos + chunkSize > data.length) {
+      return {manifest: result, error: `chunk at ${pos} has invalid size ${chunkSize}`};
+    }
+
+    if (chunkType === AXML_STRING_POOL) {
+      // Pass the full chunk (from pos) to decodeStringPool
+      const chunk = data.subarray(pos, pos + chunkSize);
+      const {strings, error} = decodeStringPool(chunk);
+      if (error) return {manifest: result, error: `string pool: ${error}`};
+      stringPool = strings;
+    } else if (chunkType === AXML_ELEMENT_START && stringPool) {
+      // Element start: read fields from the chunk at correct offsets
+      if (chunkSize < 36) {
+        pos += chunkSize;
+        continue;
+      }
+      // lineNumber at 8, comment at 12 — skip
+      const nsIdx = readU32LE(data, pos + 16);
+      const nameIdx = readU32LE(data, pos + 20);
+      const _attrStart = readU16LE(data, pos + 24);
+      const attrSize = readU16LE(data, pos + 26);
+      const attrCount = readU16LE(data, pos + 28);
+      // idIndex(30), classIndex(32), styleIndex(34) — skip
+
+      const elemName = nameIdx < stringPool.length ? stringPool[nameIdx] : '';
+
+      // Parse attributes starting at offset 36 in the chunk
+      const attrBase = pos + 36;
+      const attrs: {ns: number; name: number; rawValue: number}[] = [];
+      for (let a = 0; a < attrCount; a++) {
+        const aStart = attrBase + a * attrSize;
+        if (aStart + 20 > data.length) break;
+        const aNs = readU32LE(data, aStart);
+        const aName = readU32LE(data, aStart + 4);
+        const aRawValue = readU32LE(data, aStart + 8);
+        attrs.push({ns: aNs, name: aName, rawValue: aRawValue});
+      }
+
+      const getAttrByName = (targetName: string): string | null => {
+        for (const attr of attrs) {
+          if (attr.name < stringPool!.length && stringPool![attr.name] === targetName) {
+            if (attr.rawValue === 0xFFFFFFFF) return null;
+            if (attr.rawValue < stringPool!.length) return stringPool![attr.rawValue];
+            return String(attr.rawValue);
+          }
+        }
+        return null;
+      };
+
+      const getAttrByNsName = (targetNs: string, targetName: string): string | null => {
+        for (const attr of attrs) {
+          const nsStr = attr.ns < stringPool!.length ? stringPool![attr.ns] : '';
+          const nameStr = attr.name < stringPool!.length ? stringPool![attr.name] : '';
+          if (nsStr === targetNs && nameStr === targetName) {
+            if (attr.rawValue === 0xFFFFFFFF) return null;
+            if (attr.rawValue < stringPool!.length) return stringPool![attr.rawValue];
+            return String(attr.rawValue);
+          }
+        }
+        return null;
+      };
+
+      if (elemName === 'manifest') {
+        const pkg = getAttrByName('package');
+        if (pkg) result.packageName = pkg;
+      } else if (elemName === 'uses-permission') {
+        const permName = getAttrByNsName('http://schemas.android.com/apk/res/android', 'name');
+        if (permName) result.permissions.push(permName);
+      } else if (elemName === 'activity' || elemName === 'service' || elemName === 'receiver' || elemName === 'provider') {
+        const compName = getAttrByNsName('http://schemas.android.com/apk/res/android', 'name');
+        const exported = getAttrByNsName('http://schemas.android.com/apk/res/android', 'exported');
+        if (compName) {
+          result.components.push({type: elemName, name: compName, exported});
+        }
+      }
+    }
+    // Skip RESOURCE_MAP, NAMESPACE_START/END, ELEMENT_END, etc.
+
+    pos += chunkSize;
+  }
+
+  if (!stringPool) {
+    return {manifest: result, error: 'AXML missing string pool'};
+  }
+
+  return {manifest: result, error: null};
+}
+
+// ─── Signing detection ───────────────────────────────────────────────────────
+function detectSigning(entries: ZipEntry[], apkBytes: Uint8Array): {
+  v1ManifestMF: boolean;
+  sfFiles: string[];
+  certFiles: string[];
+  apkSigBlock: boolean;
+} {
+  let v1ManifestMF = false;
+  const sfFiles: string[] = [];
+  const certFiles: string[] = [];
+
+  for (const e of entries) {
+    const upper = e.name.toUpperCase();
+    if (upper === 'META-INF/MANIFEST.MF') v1ManifestMF = true;
+    if (upper.startsWith('META-INF/') && upper.endsWith('.SF')) sfFiles.push(e.name);
+    if (upper.startsWith('META-INF/') && (upper.endsWith('.RSA') || upper.endsWith('.DSA') || upper.endsWith('.EC'))) {
+      certFiles.push(e.name);
+    }
+  }
+
+  let apkSigBlock = false;
+  for (let i = 0; i <= apkBytes.length - APK_SIG_MAGIC.length; i++) {
+    let match = true;
+    for (let j = 0; j < APK_SIG_MAGIC.length; j++) {
+      if (apkBytes[i + j] !== APK_SIG_MAGIC[j]) {match = false; break;}
+    }
+    if (match) {apkSigBlock = true; break;}
+  }
+
+  return {v1ManifestMF, sfFiles, certFiles, apkSigBlock};
+}
+
+// ─── Engine ──────────────────────────────────────────────────────────────────
+export class ApkInspectEngine implements TalentEngine {
+  readonly name = 'apk_inspect';
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const data = typeof args.data === 'string' ? args.data : '';
+    const encoding = (args.encoding as InputEncoding) || 'auto';
+    const operation = typeof args.operation === 'string' ? args.operation : 'summary';
+
+    if (!data) {
+      return {type: 'error', summary: 'apk_inspect: missing or empty "data" argument', errorMessage: 'data argument is required'};
+    }
+
+    let bytes: Uint8Array;
+    try {
+      bytes = decodeInput(data, encoding);
+    } catch (e) {
+      return {type: 'error', summary: `apk_inspect: failed to decode input: ${e instanceof Error ? e.message : String(e)}`, errorMessage: 'decode failed'};
+    }
+
+    if (operation === 'axml') {
+      const {manifest, error} = decodeAXML(bytes);
+      if (error) {
+        return {type: 'error', summary: `apk_inspect: AXML decode error: ${error}`, errorMessage: error};
+      }
+      return {type: 'text', summary: formatManifest(manifest)};
+    }
+
+    // ZIP operations
+    let entries: ZipEntry[];
+    let parseMethod: string;
+    let truncated = false;
+
+    const eocdOffset = findEOCD(bytes);
+    if (eocdOffset !== null) {
+      const eocd = parseEOCD(bytes, eocdOffset);
+      if (eocd) {
+        const result = parseCentralDirectory(bytes, eocd.cdOffset, eocd.entryCount);
+        entries = result.entries;
+        truncated = result.truncated;
+        parseMethod = 'EOCD+central-directory';
+      } else {
+        return {type: 'error', summary: 'apk_inspect: EOCD found but unparseable', errorMessage: 'EOCD parse failed'};
+      }
+    } else {
+      const result = scanLocalHeaders(bytes);
+      if (result.entries.length === 0) {
+        return {type: 'error', summary: 'apk_inspect: not a valid ZIP/APK (no EOCD and no local file headers found)', errorMessage: 'not a ZIP'};
+      }
+      entries = result.entries;
+      truncated = result.truncated;
+      parseMethod = 'local-header-scan (partial view — no EOCD found)';
+    }
+
+    switch (operation) {
+      case 'entries':
+        return {type: 'text', summary: formatEntries(entries, parseMethod, truncated)};
+
+      case 'manifest': {
+        const manifestEntry = entries.find(e => e.name === 'AndroidManifest.xml');
+        if (!manifestEntry) {
+          return {type: 'error', summary: 'apk_inspect: AndroidManifest.xml not found in APK', errorMessage: 'no manifest'};
+        }
+        if (manifestEntry.method !== 0) {
+          return {
+            type: 'error',
+            summary: `apk_inspect: AndroidManifest.xml is compressed (method ${manifestEntry.method}, likely DEFLATE). This tool cannot decompress without a dependency. Use operation "axml" with the raw, already-inflated AndroidManifest.xml bytes instead, or rebuild the APK with the manifest stored uncompressed.`,
+            errorMessage: 'manifest is compressed',
+          };
+        }
+        const manifestData = readLocalFileData(bytes, manifestEntry.localHeaderOffset);
+        if (!manifestData) {
+          return {type: 'error', summary: 'apk_inspect: could not read manifest data from local header', errorMessage: 'read failed'};
+        }
+        const {manifest, error} = decodeAXML(manifestData);
+        if (error) {
+          return {type: 'error', summary: `apk_inspect: AXML decode error: ${error}`, errorMessage: error};
+        }
+        return {type: 'text', summary: formatManifest(manifest)};
+      }
+
+      case 'signing': {
+        const sig = detectSigning(entries, bytes);
+        return {type: 'text', summary: formatSigning(sig)};
+      }
+
+      case 'summary':
+      default: {
+        const dexCount = entries.filter(e => e.name.endsWith('.dex') && /^classes\d*\.dex$/.test(e.name)).length;
+        const soCount = entries.filter(e => e.name.endsWith('.so')).length;
+        const sig = detectSigning(entries, bytes);
+
+        let manifestPkg: string | null = null;
+        let permCount = 0;
+        const manifestEntry = entries.find(e => e.name === 'AndroidManifest.xml');
+        if (manifestEntry && manifestEntry.method === 0) {
+          const manifestData = readLocalFileData(bytes, manifestEntry.localHeaderOffset);
+          if (manifestData) {
+            const {manifest, error} = decodeAXML(manifestData);
+            if (!error) {
+              manifestPkg = manifest.packageName;
+              permCount = manifest.permissions.length;
+            }
+          }
+        }
+
+        return {
+          type: 'text',
+          summary: formatSummary(entries, parseMethod, truncated, manifestPkg, permCount, sig, dexCount, soCount),
+        };
+      }
+    }
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: 'apk_inspect',
+        description:
+          'Static read-only inspection of an Android APK. Lists ZIP entries, detects signing scheme presence (v1 JAR, APK Sig Block v2/v3), and decodes the binary AndroidManifest.xml to extract package name, permissions, and exported components. Does NOT verify, strip, forge, or modify signatures.',
+        parameters: {
+          type: 'object',
+          properties: {
+            data: {
+              type: 'string',
+              description: 'APK bytes as hex or base64 string. For operation "axml", pass the raw AndroidManifest.xml bytes instead.',
+            },
+            encoding: {
+              type: 'string',
+              enum: ['auto', 'hex', 'base64'],
+              description: 'Input encoding (default: auto-detect hex vs base64).',
+            },
+            operation: {
+              type: 'string',
+              enum: ['entries', 'manifest', 'axml', 'signing', 'summary'],
+              description:
+                'entries: list ZIP entries; manifest: decode AndroidManifest.xml from APK; axml: decode raw AXML bytes; signing: detect signing artifacts; summary: compact overview.',
+            },
+          },
+          required: ['data'],
+        },
+      },
+    };
+  }
+
+  systemPromptFragment(_ctx: SystemPromptContext): string | null {
+    return [
+      '## apk_inspect talent',
+      'This is a READ-ONLY static inspection tool for legitimate defensive app auditing (inspecting your own builds or public APKs).',
+      'It lists ZIP structure, reports signing artifact PRESENCE (v1 JAR files, APK Sig Block v2/v3 magic), and decodes binary AndroidManifest.xml.',
+      'It does NOT verify, strip, forge, re-sign, patch, or bypass any signature. It refuses to help tamper with an app.',
+      'If the manifest is DEFLATE-compressed (method 8), the tool cannot decompress it — instruct the user to use operation "axml" with the raw inflated manifest bytes.',
+      'All operations are purely read-only over the provided bytes.',
+    ].join('\n');
+  }
+}
+
+// ─── Formatters ──────────────────────────────────────────────────────────────
+function methodLabel(m: number): string {
+  return m === 0 ? 'STORED' : m === 8 ? 'DEFLATE' : `method(${m})`;
+}
+
+function formatEntries(entries: ZipEntry[], parseMethod: string, truncated: boolean): string {
+  const lines: string[] = [`ZIP entries (parsed via ${parseMethod}):`, ''];
+
+  let dexCount = 0;
+  let soCount = 0;
+  let metaCount = 0;
+
+  for (const e of entries) {
+    if (e.name.endsWith('.dex') && /^classes\d*\.dex$/.test(e.name)) dexCount++;
+    if (e.name.endsWith('.so')) soCount++;
+    if (e.name.startsWith('META-INF/')) metaCount++;
+  }
+
+  for (const e of entries) {
+    const flags: string[] = [];
+    if (e.name === 'AndroidManifest.xml' || e.name === 'resources.arsc') flags.push('★');
+    if (e.name.endsWith('.dex')) flags.push('DEX');
+    if (e.name.endsWith('.so')) flags.push('NATIVE');
+    if (e.name.startsWith('META-INF/')) flags.push('META');
+    const flagStr = flags.length ? ` [${flags.join(',')}]` : '';
+    lines.push(`  ${e.name}  ${methodLabel(e.method)}  compressed=${e.compressedSize}  uncompressed=${e.uncompressedSize}${flagStr}`);
+  }
+
+  lines.push('');
+  lines.push(`Total: ${entries.length} entries (dex=${dexCount}, native_libs=${soCount}, meta=${metaCount})`);
+  if (truncated) lines.push(`(list truncated at ${MAX_ENTRIES} entries)`);
+  return lines.join('\n');
+}
+
+function formatManifest(m: ParsedManifest): string {
+  const lines: string[] = ['AndroidManifest.xml decode:', ''];
+  lines.push(`  package: ${m.packageName ?? '(not found)'}`);
+  lines.push('');
+  lines.push(`  permissions (${m.permissions.length}):`);
+  for (const p of m.permissions) lines.push(`    - ${p}`);
+  lines.push('');
+  lines.push(`  components (${m.components.length}):`);
+  for (const c of m.components) {
+    lines.push(`    - <${c.type}> name="${c.name}" exported=${c.exported ?? '(not set)'}`);
+  }
+  return lines.join('\n');
+}
+
+function formatSigning(sig: ReturnType<typeof detectSigning>): string {
+  const lines: string[] = ['Signing scheme detection (PRESENCE ONLY — signatures NOT verified):', ''];
+
+  const hasV1 = sig.v1ManifestMF || sig.sfFiles.length > 0 || sig.certFiles.length > 0;
+  lines.push(`  v1 (JAR signing): ${hasV1 ? 'PRESENT' : 'not detected'}`);
+  if (sig.v1ManifestMF) lines.push('    - META-INF/MANIFEST.MF found');
+  for (const sf of sig.sfFiles) lines.push(`    - ${sf}`);
+  for (const cf of sig.certFiles) lines.push(`    - ${cf}`);
+
+  lines.push('');
+  lines.push(`  v2/v3 (APK Sig Block): ${sig.apkSigBlock ? 'PRESENT ("APK Sig Block 42" magic found)' : 'not detected'}`);
+  lines.push('');
+  lines.push('NOTE: This tool only reports the PRESENCE of signing artifacts. It does NOT verify, validate, strip, forge, or modify any signature.');
+  return lines.join('\n');
+}
+
+function formatSummary(
+  entries: ZipEntry[],
+  parseMethod: string,
+  truncated: boolean,
+  manifestPkg: string | null,
+  permCount: number,
+  sig: ReturnType<typeof detectSigning>,
+  dexCount: number,
+  soCount: number,
+): string {
+  const hasV1 = sig.v1ManifestMF || sig.sfFiles.length > 0 || sig.certFiles.length > 0;
+  const lines: string[] = [
+    'APK Summary:',
+    `  entries: ${entries.length}${truncated ? ` (truncated at ${MAX_ENTRIES})` : ''} (via ${parseMethod})`,
+    `  package: ${manifestPkg ?? '(not decodable)'}`,
+    `  permissions: ${permCount}`,
+    `  dex files: ${dexCount}`,
+    `  native libs: ${soCount}`,
+    `  v1 signing: ${hasV1 ? 'present' : 'not detected'}`,
+    `  v2/v3 sig block: ${sig.apkSigBlock ? 'present' : 'not detected'}`,
+    '',
+    'NOTE: Read-only inspection. Signatures NOT verified.',
+  ];
+  return lines.join('\n');
+}
