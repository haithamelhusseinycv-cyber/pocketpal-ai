+console.log('  Phase:', phase);
+console.log('  Age:', age.toFixed(2), 'days');
+console.log('  Illumination:', illumination.toFixed(2), '%');
+
+// New moon should be age 0 ± 0.6 days
+if (Math.abs(age) <= 0.6 || Math.abs(age - 29.53) <= 0.6) {
+  console.log('✓ New moon age within ±0.6 days');
+} else {
