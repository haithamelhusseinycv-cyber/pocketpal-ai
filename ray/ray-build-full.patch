+function getSunSign(month: number, day: number): SignRange {
+  // Handle Capricorn wrapping (Dec 22 - Jan 19)
+  for (const sign of SIGNS) {
+    if (sign.startMonth <= sign.endMonth) {
+      if ((month > sign.startMonth || (month === sign.startMonth && day >= sign.startDay)) &&
+          (month < sign.endMonth || (month === sign.endMonth && day <= sign.endDay))) {
+        return sign;
+      }
+    } else {
