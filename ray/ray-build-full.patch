+import {DictationEngine} from '../DictationEngine';
+
+describe('DictationEngine', () => {
+  let engine: DictationEngine;
+
+  beforeEach(() => {
+    engine = new DictationEngine();
+  });
+
+  it('has name "dictation"', () => {
+    expect(engine.name).toBe('dictation');
+  });
+
+  // ─── detect ────────────────────────────────────────────────────────────
+
+  it('detect: Arabic text returns language "ar" and is_rtl true', async () => {
+    const r = await engine.execute({operation: 'detect', text: 'ايه الاخبار يا صاحبي علشان عايز اعرف'});
+    expect(r.type).toBe('text');
+    expect(r.summary).toContain('language: ar');
+    expect(r.summary).toContain('is_rtl: true');
+  });
+
+  it('detect: Arabic text with Egyptian markers returns dialect_hint "egyptian"', async () => {
+    const r = await engine.execute({operation: 'detect', text: 'ايه الاخبار يا صاحبي علشان عايز اعرف'});
+    expect(r.summary).toContain('dialect_hint: egyptian');
+  });
+
+  it('detect: English text returns language "en"', async () => {
+    const r = await engine.execute({operation: 'detect', text: 'Hey can you um send the file like today'});
+    expect(r.type).toBe('text');
+    expect(r.summary).toContain('language: en');
+  });
+
+  it('detect: mixed text returns language "mixed"', async () => {
+    const r = await engine.execute({operation: 'detect', text: 'Hello مرحبا world'});
+    expect(r.type).toBe('text');
+    expect(r.summary).toContain('language: mixed');
+  });
+
+  // ─── clean ─────────────────────────────────────────────────────────────
+
+  it('clean: removes duplicate words and English fillers', async () => {
+    const r = await engine.execute({operation: 'clean', text: 'I um I need the the report by by Friday'});
+    expect(r.type).toBe('text');
+    expect(r.summary).toContain('cleaned_text: I need the report by Friday');
+  });
+
+  it('clean: Arabic text removes leading filler "يعني" but preserves content', async () => {
+    const r = await engine.execute({operation: 'clean', text: 'يعني انا عايز الملف ده النهاردة'});
+    expect(r.type).toBe('text');
+    // Should not contain the filler "يعني"
+    const summary = r.summary;
+    // The cleaned text should preserve "عايز الملف ده النهاردة"
+    expect(summary).toContain('عايز الملف ده النهاردة');
+  });
+
+  it('clean: does not transliterate Arabic', async () => {
+    const r = await engine.execute({operation: 'clean', text: 'يعني انا عايز الملف ده النهاردة'});
+    expect(r.type).toBe('text');
+    // Should still contain Arabic characters
+    expect(r.summary).toMatch(/[\u0600-\u06FF]/);
+  });
+
+  it('clean: fixes doubled punctuation', async () => {
+    const r = await engine.execute({operation: 'clean', text: 'Hello world!! How are you??'});
+    expect(r.type).toBe('text');
+    expect(r.summary).toContain('Hello world! How are you?');
+  });
+
+  // ─── email ─────────────────────────────────────────────────────────────
+
+  it('email: produces email structure with subject, greeting, body, closing', async () => {
+    const r = await engine.execute({
+      operation: 'email',
+      text: 'Hi Ahmed, um please find the the leasing schedule attached. Best, RAY',
+      to: 'Ahmed',
+      tone: 'formal',
+    });
+    expect(r.type).toBe('text');
+    expect(r.summary).toContain('Subject:');
+    expect(r.summary).toContain('Dear Ahmed,');
+    expect(r.summary).toContain('Sincerely,');
+    expect(r.summary).toContain('[SIGNATURE]');
+  });
+
+  it('email: body does not contain fillers or duplicates', async () => {
+    const r = await engine.execute({
+      operation: 'email',
+      text: 'Hi Ahmed, um please find the the leasing schedule attached. Best, RAY',
+      to: 'Ahmed',
+      tone: 'formal',
+    });
+    expect(r.type).toBe('text');
+    // Body should not have "um" or "the the"
+    const summary = r.summary;
+    // Check that "um" is not in the body (it might appear in metadata, but not in the email body)
+    const emailBody = summary.split('---')[0];
+    expect(emailBody).not.toContain(' um ');
+    expect(emailBody).not.toContain('the the');
+  });
+
+  it('email: includes word_count metadata', async () => {
+    const r = await engine.execute({
+      operation: 'email',
+      text: 'Please send the report',
+      to: 'Bob',
+      tone: 'neutral',
+    });
+    expect(r.type).toBe('text');
+    expect(r.summary).toContain('word_count:');
+  });
+
+  it('email: auto-drafted subject is marked', async () => {
+    const r = await engine.execute({
+      operation: 'email',
+      text: 'Please send the report by Friday',
+      to: 'Bob',
+    });
+    expect(r.type).toBe('text');
+    expect(r.summary).toContain('[auto-drafted]');
+  });
+
+  // ─── message ───────────────────────────────────────────────────────────
+
+  it('message: returns cleaned text suitable for WhatsApp/SMS', async () => {
+    const r = await engine.execute({
+      operation: 'message',
+      text: 'Hey um can you send the the file',
+    });
+    expect(r.type).toBe('text');
+    expect(r.summary).toContain('message:');
+    expect(r.summary).toContain('word_count:');
+  });
+
+  // ─── error cases ───────────────────────────────────────────────────────
+
+  it('unknown operation returns error', async () => {
+    const r = await engine.execute({operation: 'bogus', text: 'hello'});
+    expect(r.type).toBe('error');
+  });
+
+  it('missing text returns error', async () => {
+    const r = await engine.execute({operation: 'clean'});
+    expect(r.type).toBe('error');
+  });
+
+  // ─── tool definition / prompt ──────────────────────────────────────────
+
+  it('toToolDefinition returns valid schema', () => {
+    const def = engine.toToolDefinition();
+    expect(def.type).toBe('function');
+    expect(def.function.name).toBe('dictation');
+    expect(def.function.parameters.properties.operation.enum).toContain('detect');
+    expect(def.function.parameters.properties.operation.enum).toContain('clean');
+    expect(def.function.parameters.properties.operation.enum).toContain('email');
+    expect(def.function.parameters.properties.operation.enum).toContain('message');
+    expect(def.function.parameters.required).toContain('operation');
+    expect(def.function.parameters.required).toContain('text');
+  });
+
+  it('systemPromptFragment mentions dialect conversion is model responsibility', () => {
+    const frag = engine.systemPromptFragment!({
+      now: new Date(),
+      maxToolTurns: 10,
+      activeTalents: new Set(['dictation']),
+    });
+    expect(frag).toBeTruthy();
+    expect(frag).toContain('فصحى');
+    expect(frag).toContain('عامية');
+  });
+});
