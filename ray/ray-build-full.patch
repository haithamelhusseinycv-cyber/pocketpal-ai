+// ---------------------------------------------------------------------------
+// Operation: report
+// ---------------------------------------------------------------------------
+
+interface ReportSection {
+  heading: string;
+  paragraphs: string[];
+  table?: {headers: string[]; rows: string[][]};
+  bullets?: string[];
