+const gpxXml = gpxXmlMatch ? gpxXmlMatch[1] : '';
+const importResult = await gpxEngine.execute({
+  operation: 'import',
+  gpx_xml: gpxXml
+});
+console.log('✓ Imported GPX XML');
+
+const importDistanceMatch = importResult.summary.match(/Total distance: ([\d.]+) km/);
+const importDistance = importDistanceMatch ? parseFloat(importDistanceMatch[1]) : 0;
+console.log('  Distance:', importDistance.toFixed(2), 'km');
+
+if (Math.abs(importDistance - totalDistance) < 0.01) {
+  console.log('✓ Round-trip distance matches (within 0.01 km)');
+} else {
+  console.log('✗ Round-trip distance mismatch');
+}
+
+// Test 3: Itinerary times add up
+console.log('\nTest 3: Itinerary time calculation');
+const itineraryResult = await gpxEngine.execute({
+  operation: 'itinerary',
+  name: 'Cairo-Alexandria Day Trip',
+  points: cairoAlexRoute.points,
