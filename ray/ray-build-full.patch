+/**
+ * FinanceEngine tests.
+ *
+ * Every expected value here is independently hand-computed or cross-checked
+ * against a closed-form identity, so the suite catches real maths regressions
+ * rather than merely pinning whatever the implementation currently returns.
+ */
+import {
+  FinanceEngine,
+  computeNpv,
+  computeIrr,
+  computeDscr,
+  computeAmortisation,
+} from '../FinanceEngine';
+import type {TalentResult} from '../types';
+
+const text = (r: TalentResult): string =>
+  r.type === 'text' || r.type === 'error' ? r.summary : '';
+
+describe('computeNpv', () => {
+  it('matches the hand-computed present value of each flow', () => {
+    // -1000 + 500/1.1 + 400/1.21 + 300/1.331
+    const expected = -1000 + 500 / 1.1 + 400 / 1.21 + 300 / 1.331;
+    expect(computeNpv([-1000, 500, 400, 300], 0.1)).toBeCloseTo(expected, 9);
+  });
+
+  it('reduces to a plain annuity at a known closed-form value', () => {
+    // 100 per year for 5 years at 10% = 100 * (1 - 1.1^-5) / 0.1 = 379.0787
+    const annuity = computeNpv([0, 100, 100, 100, 100, 100], 0.1);
+    expect(annuity).toBeCloseTo(379.0787, 3);
+    expect(annuity).toBeCloseTo((100 * (1 - Math.pow(1.1, -5))) / 0.1, 9);
+  });
+
+  it('equals the undiscounted sum at a zero rate', () => {
+    expect(computeNpv([-500, 200, 200, 200], 0)).toBe(100);
+  });
+
+  it('returns NaN for a rate at or below -100%', () => {
+    expect(Number.isNaN(computeNpv([100, 100], -1))).toBe(true);
+    expect(Number.isNaN(computeNpv([100, 100], -1.5))).toBe(true);
+  });
+});
+
+describe('computeIrr', () => {
+  it('solves the exact 10% case', () => {
+    const irr = computeIrr([-100, 110]);
+    expect(irr).not.toBeNull();
+    expect(irr!).toBeCloseTo(0.1, 5);
+  });
+
+  it('returns a rate at which NPV is zero', () => {
+    const flows = [-1000, 500, 400, 300];
+    const irr = computeIrr(flows)!;
+    expect(irr).not.toBeNull();
+    // Bisection converges on the RATE, so assert the residual is negligible
+    // relative to flow magnitude rather than absolutely zero.
+    const residual = Math.abs(computeNpv(flows, irr));
+    expect(residual / 1000).toBeLessThan(1e-5);
+  });
+
+  it('returns null when all flows share one sign', () => {
+    expect(computeIrr([100, 200, 300])).toBeNull();
+    expect(computeIrr([-100, -200])).toBeNull();
+  });
+});
+
+describe('computeAmortisation', () => {
+  it('produces the closed-form level payment', () => {
+    // 12000 at 1% for 12 periods
+    const expected = (12000 * 0.01) / (1 - Math.pow(1.01, -12));
+    expect(computeAmortisation(12000, 0.01, 12).payment).toBeCloseTo(
+      expected,
+      6,
+    );
+    expect(computeAmortisation(12000, 0.01, 12).payment).toBeCloseTo(
+      1066.185,
+      2,
+    );
+  });
+
+  it('charges exactly balance x rate as first-period interest', () => {
+    const {rows} = computeAmortisation(12000, 0.01, 12);
+    expect(rows[0].interest).toBeCloseTo(120, 9);
+  });
+
+  it('closes the schedule at exactly zero balance', () => {
+    const {rows} = computeAmortisation(12000, 0.01, 12);
+    expect(rows[rows.length - 1].balance).toBe(0);
+  });
+
+  it('conserves money: total payments = principal + total interest', () => {
+    const {rows, totalInterest} = computeAmortisation(12000, 0.01, 12);
+    const paid = rows.reduce((sum, r) => sum + r.payment, 0);
+    expect(paid).toBeCloseTo(12000 + totalInterest, 6);
+  });
+
+  it('splits principal with no interest at a zero rate', () => {
+    const {payment, rows, totalInterest} = computeAmortisation(12000, 0, 12);
+    expect(payment).toBeCloseTo(1000, 9);
+    expect(totalInterest).toBe(0);
+    expect(rows.every(r => r.interest === 0)).toBe(true);
+  });
+
+  it('rejects non-positive or non-integer inputs', () => {
+    expect(Number.isNaN(computeAmortisation(0, 0.01, 12).payment)).toBe(true);
+    expect(Number.isNaN(computeAmortisation(-100, 0.01, 12).payment)).toBe(
+      true,
+    );
+    expect(Number.isNaN(computeAmortisation(1000, 0.01, 12.5).payment)).toBe(
+      true,
+    );
+    expect(Number.isNaN(computeAmortisation(1000, 0.01, 0).payment)).toBe(true);
+  });
+});
+
+describe('computeDscr', () => {
+  it('uses a supplied CFADS directly', () => {
+    expect(computeDscr({cashFlow: 9300000, debtService: 7500000}).dscr).toBeCloseTo(
+      1.24,
+      2,
+    );
+  });
+
+  it('derives CFADS as EBITDA less tax, capex and working capital', () => {
+    const {cfads, dscr} = computeDscr({
+      ebitda: 18_000_000,
