+        const x = MARGIN_LEFT + c * colWidth + cellPad;
+        currentStream += `BT /F2 ${fontSize} Tf ${x} ${y + cellPad} Td (${pdfEscape(headers[c])}) Tj ET\n`;
+      }
+      // Header bottom border
+      currentStream += `q 0.3 G\n0.5 w\n${MARGIN_LEFT} ${y} m ${MARGIN_LEFT + uWidth} ${y} l S\nQ\n`;
