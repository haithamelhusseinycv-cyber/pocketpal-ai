@@ -0,0 +1,33 @@
+import {NativeRecognizerEngine} from './engines/native';
+import type {STTEngine, STTEngineId} from './types';
+
+const nativeEngine = new NativeRecognizerEngine();
+
+const engines: Record<STTEngineId, STTEngine> = {
+  native: nativeEngine,
+};
+
+export const getSTTEngine = (id: STTEngineId): STTEngine => {
+  const engine = engines[id];
+  if (!engine) {
+    throw new Error(`[stt] Unknown engine id: ${String(id)}`);
+  }
+  return engine;
+};
+
+/** All registered recognizer engines. v1 ships the native (not-activated) one. */
+export const getAllSTTEngines = (): STTEngine[] => [nativeEngine];
+
+/**
+ * The first engine that can actually capture speech right now, or null if none
+ * can. The mic UI gates on this: null means "no ears in this build" and the
+ * button stays hidden/disabled rather than failing on tap.
+ */
+export const getAvailableSTTEngine = async (): Promise<STTEngine | null> => {
+  for (const engine of getAllSTTEngines()) {
+    if (await engine.isAvailable()) {
+      return engine;
+    }
+  }
+  return null;
+};
diff --git a/src/services/stt/engines/native/index.ts b/src/services/stt/engines/native/index.ts
new file mode 100644
index 0000000..f89526b
--- /dev/null
+++ b/src/services/stt/engines/native/index.ts
@@ -0,0 +1,108 @@
+/**
+ * NativeRecognizerEngine — the on-device speech recognizer backend ("ears").
+ *
+ * SHIPPED STATE: NOT ACTIVATED. This is a real, typed seam — not a stub that
+ * fakes success. `isAvailable()` returns false and `start()` rejects with a
+ * `not_activated` STTError until a native Android recognizer is wired in.
+ * Callers (the mic button) check `isAvailable()` and stay hidden/disabled, so
+ * the app never pretends to listen.
+ *
+ * ACTIVATION (on-device, cannot be done or verified from the build sandbox):
+ *   1. Add RECORD_AUDIO to android/app/src/main/AndroidManifest.xml.
+ *   2. Implement start() against the Android SpeechRecognizer /
+ *      RecognizerIntent (a small native module, or a vetted RN package).
+ *      Map its callbacks onto RecognitionSession.onResult/onError and honour
+ *      partialResults / autoStopOnSilence.
+ *   3. Implement hasPermission/requestPermission via PermissionsAndroid
+ *      (RECORD_AUDIO) — see src/utils/androidPermission.ts for the pattern.
+ *   4. Flip isAvailable() to reflect a real recognizer presence check
+ *      (SpeechRecognizer.isRecognitionAvailable).
+ *   5. Return the languages the chosen recognizer actually supports from
+ *      supportedLanguages() — do NOT advertise ar-EG unless the recognizer
+ *      genuinely handles Egyptian colloquial; OS recognizers are often
+ *      stronger on en-US and formal ar than on street dialect. Be honest here.
+ *   6. Test on the OnePlus 13 with real street-Arabic dictation; tune.
+ *
+ * See src/services/stt/README.md for the full checklist and the dialect
+ * caveat. Nothing in this file fabricates a transcript.
+ */
+
+import {PermissionsAndroid, Platform} from 'react-native';
+
+import type {
+  RecognitionSession,
+  STTEngine,
+  STTError,
+  STTLanguage,
+  STTStartOptions,
+} from '../../types';
+
+const NOT_ACTIVATED: STTError = {
+  code: 'not_activated',
+  message:
+    'Speech recognition is not activated in this build. The capture seam is present but no native Android recognizer is wired yet. See src/services/stt/README.md.',
+};
+
+export class NativeRecognizerEngine implements STTEngine {
+  readonly id = 'native' as const;
+
+  /**
+   * False until a real native recognizer is implemented at activation time.
+   * Keeping this honest is the whole point: the UI gates on it.
+   */
+  async isAvailable(): Promise<boolean> {
+    return false;
+  }
+
+  async hasPermission(): Promise<boolean> {
+    if (Platform.OS !== 'android') {
+      return false;
+    }
+    try {
+      const granted = await PermissionsAndroid.check(
+        PermissionsAndroid.PERMISSIONS.RECORD_AUDIO,
+      );
+      return granted === true;
+    } catch {
+      return false;
+    }
+  }
+
+  async requestPermission(): Promise<boolean> {
+    if (Platform.OS !== 'android') {
+      return false;
+    }
+    try {
+      const result = await PermissionsAndroid.request(
+        PermissionsAndroid.PERMISSIONS.RECORD_AUDIO,
+        {
+          title: 'Microphone access',
+          message:
+            'RAY needs the microphone to transcribe your voice into messages and emails.',
+          buttonPositive: 'Allow',
+          buttonNegative: 'Deny',
+        },
+      );
+      return result === PermissionsAndroid.RESULTS.GRANTED;
+    } catch {
+      return false;
+    }
+  }
+
+  /**
+   * Begin capture. In the shipped state this always rejects with
+   * `not_activated` — it never returns a fake session or empty transcript.
+   */
+  async start(_options?: STTStartOptions): Promise<RecognitionSession> {
+    throw NOT_ACTIVATED;
+  }
+
+  /**
+   * Languages this backend would target once activated. Declared for UI wiring
+   * now; at activation, narrow this to what the real recognizer supports.
+   * The user's two are American English and Egyptian colloquial Arabic.
+   */
+  async supportedLanguages(): Promise<STTLanguage[]> {
+    return ['en-US', 'ar-EG', 'auto'];
+  }
+}
