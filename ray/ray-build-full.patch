+import {TalentEngine, TalentResult, SystemPromptContext, ToolDefinition} from './types';
+
+const VALID_FLAGS = new Set(['g', 'i', 'm', 's', 'u', 'y']);
+const MAX_SUBJECT_LEN = 100_000;
+const MAX_MATCHES = 500;
+const MAX_SPLIT_PARTS = 1_000;
+const MAX_REPLACE_LEN = 100_000;
+
+type Operation = 'test' | 'match' | 'groups' | 'replace' | 'explain' | 'split';
+
+const OPERATIONS: ReadonlySet<string> = new Set([
+  'test',
+  'match',
+  'groups',
+  'replace',
+  'explain',
+  'split',
+]);
+
+function validateFlags(flags: string): string | null {
+  for (const ch of flags) {
+    if (!VALID_FLAGS.has(ch)) {
+      return `Invalid flag "${ch}". Allowed flags: g, i, m, s, u, y.`;
+    }
+  }
+  return null;
+}
+
+function buildRegex(pattern: string, flags: string): {regex: RegExp} | {error: string} {
+  const flagErr = validateFlags(flags);
+  if (flagErr) {
+    return {error: flagErr};
+  }
+  try {
+    return {regex: new RegExp(pattern, flags)};
+  } catch (e) {
+    const msg = e instanceof Error ? e.message : String(e);
+    return {error: `Invalid regex pattern: ${msg}`};
+  }
+}
+
+function truncateSubject(subject: string): string {
+  if (subject.length > MAX_SUBJECT_LEN) {
+    return subject.slice(0, MAX_SUBJECT_LEN);
+  }
+  return subject;
+}
+
+interface MatchEntry {
+  fullMatch: string;
+  index: number;
+  groups: Record<string, string | undefined>;
+  numberedGroups: (string | undefined)[];
+}
+
+function collectMatches(regex: RegExp, subject: string): MatchEntry[] {
+  const results: MatchEntry[] = [];
+  if (!regex.global) {
+    const m = regex.exec(subject);
+    if (m) {
+      results.push(entryFromExec(m));
+    }
+    return results;
+  }
+  let m: RegExpExecArray | null;
+  let count = 0;
+  // Reset lastIndex for safety
+  regex.lastIndex = 0;
+  while ((m = regex.exec(subject)) !== null) {
+    results.push(entryFromExec(m));
+    count++;
+    if (count >= MAX_MATCHES) {
+      break;
+    }
+    // Guard against zero-length match infinite loop
+    if (m[0].length === 0) {
+      regex.lastIndex++;
+    }
+  }
+  return results;
+}
+
+function entryFromExec(m: RegExpExecArray): MatchEntry {
+  const numbered: (string | undefined)[] = [];
+  for (let i = 1; i < m.length; i++) {
+    numbered.push(m[i]);
+  }
+  const named: Record<string, string | undefined> = {};
+  if (m.groups) {
+    for (const [k, v] of Object.entries(m.groups)) {
+      named[k] = v;
+    }
+  }
+  return {
+    fullMatch: m[0],
+    index: m.index,
+    groups: named,
+    numberedGroups: numbered,
+  };
+}
+
+function explainPattern(pattern: string): string {
+  const lines: string[] = [];
+  let i = 0;
+  const len = pattern.length;
+
+  while (i < len) {
+    const ch = pattern[i];
+
+    if (ch === '\\') {
+      if (i + 1 < len) {
+        const next = pattern[i + 1];
+        const escapes: Record<string, string> = {
+          d: 'digit [0-9]',
+          D: 'non-digit [^0-9]',
+          w: 'word character [a-zA-Z0-9_]',
+          W: 'non-word character',
+          s: 'whitespace',
+          S: 'non-whitespace',
+          b: 'word boundary',
+          B: 'non-word boundary',
+          n: 'newline',
+          t: 'tab',
+          r: 'carriage return',
+          '.': 'literal dot',
+          '\\': 'literal backslash',
+        };
+        if (escapes[next]) {
+          lines.push(`\\${next} → ${escapes[next]}`);
+        } else {
+          lines.push(`\\${next} → escaped literal "${next}"`);
+        }
+        i += 2;
+      } else {
+        lines.push('trailing backslash');
+        i++;
+      }
+      continue;
+    }
+
+    if (ch === '[') {
+      let j = i + 1;
+      let classContent = '';
+      if (j < len && pattern[j] === '^') {
+        classContent = '^';
+        j++;
+      }
+      while (j < len && pattern[j] !== ']') {
+        if (pattern[j] === '\\' && j + 1 < len) {
+          classContent += pattern[j] + pattern[j + 1];
+          j += 2;
+        } else {
+          classContent += pattern[j];
+          j++;
+        }
+      }
+      if (j < len) {
+        const negated = classContent.startsWith('^');
+        lines.push(
+          `character class [${classContent}]${negated ? ' (negated)' : ''}`,
+        );
+        i = j + 1;
+      } else {
+        lines.push('unclosed character class [...]');
+        i = j;
+      }
+      continue;
+    }
+
+    if (ch === '(') {
+      if (i + 1 < len && pattern[i + 1] === '?') {
+        if (i + 2 < len && pattern[i + 2] === ':') {
+          lines.push('non-capturing group (?:...)');
+          i += 3;
+        } else if (
+          i + 2 < len &&
+          pattern[i + 2] === '<' &&
+          pattern[i + 3] !== undefined
+        ) {
+          // named group
+          let nameEnd = i + 3;
+          while (nameEnd < len && pattern[nameEnd] !== '>') {
+            nameEnd++;
+          }
+          const name = pattern.slice(i + 3, nameEnd);
+          lines.push(`named capture group (?<${name}>...)`);
+          i = nameEnd + 1;
+        } else if (i + 2 < len && pattern[i + 2] === '=') {
+          lines.push('positive lookahead (?=...)');
+          i += 3;
+        } else if (i + 2 < len && pattern[i + 2] === '!') {
+          lines.push('negative lookahead (?!...)');
+          i += 3;
+        } else {
+          lines.push('group (...)');
+          i += 2;
+        }
+      } else {
+        lines.push('capturing group (...)');
+        i++;
+      }
+      continue;
+    }
+
+    if (ch === ')') {
+      lines.push('end of group )');
+      i++;
+      continue;
+    }
+
+    if (ch === '|') {
+      lines.push('alternation |');
+      i++;
+      continue;
+    }
+
+    if (ch === '^') {
+      lines.push('^ → start of string/line anchor');
+      i++;
+      continue;
+    }
+
+    if (ch === '$') {
+      lines.push('$ → end of string/line anchor');
+      i++;
+      continue;
+    }
+
+    if (ch === '.') {
+      lines.push('. → any character (except newline by default)');
+      i++;
+      continue;
+    }
+
+    if (ch === '*' || ch === '+' || ch === '?') {
+      let lazy = '';
+      if (i + 1 < len && pattern[i + 1] === '?') {
+        lazy = ' (lazy)';
+        i++;
+      }
+      const quantDesc: Record<string, string> = {
+        '*': 'zero or more',
+        '+': 'one or more',
+        '?': 'zero or one',
+      };
+      lines.push(`${ch} → ${quantDesc[ch]}${lazy}`);
+      i++;
+      continue;
+    }
+
+    if (ch === '{') {
+      let j = i + 1;
+      while (j < len && pattern[j] !== '}') {
+        j++;
+      }
+      if (j < len) {
+        const inner = pattern.slice(i + 1, j);
+        lines.push(`{${inner}} → quantifier`);
+        i = j + 1;
+      } else {
+        lines.push('literal {');
+        i++;
+      }
+      continue;
+    }
+
+    // Literal character
+    if (/[a-zA-Z0-9 ]/.test(ch)) {
+      lines.push(`literal "${ch}"`);
+    } else {
+      lines.push(`literal "${ch}"`);
+    }
+    i++;
+  }
+
+  return lines.join('\n');
+}
+
+export class RegexEngine implements TalentEngine {
+  readonly name = 'regex';
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const pattern = typeof args.pattern === 'string' ? args.pattern : '';
+    if (!pattern) {
+      return {
+        type: 'error',
+        summary: 'regex: missing or empty "pattern" argument',
+        errorMessage: 'pattern argument is required and must be a non-empty string',
+      };
+    }
+
+    const operation = typeof args.operation === 'string' ? args.operation : 'match';
+    if (!OPERATIONS.has(operation)) {
+      return {
+        type: 'error',
+        summary: `regex: unknown operation "${operation}"`,
+        errorMessage: `operation must be one of: test, match, groups, replace, explain, split`,
+      };
+    }
+
+    const flags = typeof args.flags === 'string' ? args.flags : '';
+    const subject = typeof args.subject === 'string' ? args.subject : undefined;
+
+    // "explain" doesn't need subject
+    if (operation === 'explain') {
+      const explanation = explainPattern(pattern);
+      return {
+        type: 'text',
+        summary: `Pattern /${pattern}/${flags}:\n${explanation}`,
+      };
+    }
+
+    // All other operations require subject
+    if (subject === undefined) {
+      return {
+        type: 'error',
+        summary: 'regex: missing "subject" argument (required for this operation)',
+        errorMessage: 'subject argument is required for test/match/groups/replace/split operations',
+      };
+    }
+
+    const result = buildRegex(pattern, flags);
+    if ('error' in result) {
+      return {
+        type: 'error',
+        summary: `regex: failed to compile pattern /${pattern}/${flags}`,
+        errorMessage: result.error,
+      };
+    }
+    const {regex} = result;
+
+    const safeSubject = truncateSubject(subject);
+    const truncated = safeSubject.length < subject.length;
+
+    switch (operation) {
+      case 'test': {
+        const m = regex.exec(safeSubject);
+        if (m) {
+          return {
+            type: 'text',
+            summary: `Pattern /${pattern}/${flags} matches at index ${m.index} in subject${truncated ? ' (subject truncated to ' + MAX_SUBJECT_LEN + ' chars)' : ''}.`,
+          };
+        }
+        return {
+          type: 'text',
+          summary: `Pattern /${pattern}/${flags} does NOT match the subject${truncated ? ' (subject truncated to ' + MAX_SUBJECT_LEN + ' chars)' : ''}.`,
+        };
+      }
+
+      case 'match': {
+        // Ensure global flag for collecting all matches
+        const globalRegex = new RegExp(regex.source, regex.flags.includes('g') ? regex.flags : regex.flags + 'g');
+        const matches = collectMatches(globalRegex, safeSubject);
+        if (matches.length === 0) {
+          return {
+            type: 'text',
+            summary: `Pattern /${pattern}/${flags}: no matches found${truncated ? ' (subject truncated to ' + MAX_SUBJECT_LEN + ' chars)' : ''}.`,
+          };
+        }
+        const lines: string[] = [
+          `Pattern /${pattern}/${flags}: ${matches.length} match${matches.length === 1 ? '' : 'es'}${matches.length >= MAX_MATCHES ? ' (capped at ' + MAX_MATCHES + ')' : ''}${truncated ? ' (subject truncated to ' + MAX_SUBJECT_LEN + ' chars)' : ''}:`,
+        ];
+        for (let idx = 0; idx < matches.length; idx++) {
+          const me = matches[idx];
+          lines.push(`  [${idx}] "${me.fullMatch}" at index ${me.index}`);
+          if (me.numberedGroups.length > 0) {
+            for (let g = 0; g < me.numberedGroups.length; g++) {
+              const val = me.numberedGroups[g];
+              lines.push(`      $${g + 1} = ${val === undefined ? '(undefined)' : '"' + val + '"'}`);
+            }
+          }
+          const namedKeys = Object.keys(me.groups);
+          if (namedKeys.length > 0) {
+            for (const k of namedKeys) {
+              const val = me.groups[k];
+              lines.push(`      ${k} = ${val === undefined ? '(undefined)' : '"' + val + '"'}`);
+            }
+          }
+        }
+        return {type: 'text', summary: lines.join('\n')};
+      }
+
+      case 'groups': {
+        const m = regex.exec(safeSubject);
+        if (!m) {
+          return {
+            type: 'text',
+            summary: `Pattern /${pattern}/${flags}: no match found, no groups to show.`,
+          };
+        }
+        const lines: string[] = [
+          `First match of /${pattern}/${flags}: "${m[0]}" at index ${m.index}`,
+        ];
+        for (let g = 1; g < m.length; g++) {
+          lines.push(`  $${g} = ${m[g] === undefined ? '(undefined)' : '"' + m[g] + '"'}`);
+        }
+        if (m.groups) {
+          for (const [k, v] of Object.entries(m.groups)) {
+            lines.push(`  ${k} = ${v === undefined ? '(undefined)' : '"' + v + '"'}`);
+          }
+        }
+        return {type: 'text', summary: lines.join('\n')};
+      }
+
+      case 'replace': {
+        const replacement = typeof args.replacement === 'string' ? args.replacement : '';
+        // Ensure global for replace-all behavior
+        const globalRegex = new RegExp(regex.source, regex.flags.includes('g') ? regex.flags : regex.flags + 'g');
+        const truncatedSubject = safeSubject.length > MAX_REPLACE_LEN
+          ? safeSubject.slice(0, MAX_REPLACE_LEN)
+          : safeSubject;
+        const resultStr = truncatedSubject.replace(globalRegex, replacement);
+        // Count replacements by comparing
+        const count = countReplacements(regex, safeSubject);
+        return {
+          type: 'text',
+          summary: `replace /${pattern}/${flags} with "${replacement}": ${count} replacement${count === 1 ? '' : 's'}\nResult: "${resultStr}"`,
+        };
+      }
+
+      case 'split': {
+        const parts = safeSubject.split(regex);
+        const bounded = parts.length > MAX_SPLIT_PARTS
+          ? parts.slice(0, MAX_SPLIT_PARTS)
+          : parts;
+        const capped = parts.length > MAX_SPLIT_PARTS;
+        return {
+          type: 'text',
+          summary: `split by /${pattern}/${flags}: ${parts.length} part${parts.length === 1 ? '' : 's'}${capped ? ' (capped at ' + MAX_SPLIT_PARTS + ')' : ''}\n${JSON.stringify(bounded)}`,
+        };
+      }
+
+      default:
+        return {
+          type: 'error',
+          summary: `regex: unhandled operation "${operation}"`,
+          errorMessage: 'internal error',
+        };
+    }
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: 'regex',
+        description:
+          'Build, test, and inspect regular expressions. Supports: test (does it match?), match (all matches with capture groups), groups (first match groups detail), replace (show replacement result), explain (structural description of pattern), split (split subject by pattern). Match results are bounded to 500 entries and subject input is capped at 100,000 characters to prevent ReDoS.',
+        parameters: {
+          type: 'object',
+          properties: {
+            pattern: {
+              type: 'string',
+              description:
+                'The regular expression pattern (without delimiters).',
+            },
+            flags: {
+              type: 'string',
+              description:
+                'Regex flags: any combination of g, i, m, s, u, y. Default: none.',
+            },
+            subject: {
+              type: 'string',
+              description:
+                'The text to match/replace/split against. Required for all operations except "explain".',
+            },
+            operation: {
+              type: 'string',
+              enum: ['test', 'match', 'groups', 'replace', 'explain', 'split'],
+              description:
+                'Operation to perform. Default: "match". "test" checks if pattern matches and returns first match index. "match" returns all matches with capture groups. "groups" shows detailed groups for the first match. "replace" performs substitution. "explain" describes the pattern structure. "split" splits subject by pattern.',
+            },
+            replacement: {
+              type: 'string',
+              description:
+                'Replacement string for the "replace" operation. Supports standard $-substitutions ($1, $&, etc.) as per String.replace.',
+            },
+          },
+          required: ['pattern'],
+        },
+      },
+    };
+  }
+
+  systemPromptFragment(_ctx: SystemPromptContext): string | null {
+    return (
+      'When working with regular expressions, ALWAYS verify your regex using the `regex` tool ' +
+      'against real sample input before asserting it works. Use operation "match" to see all matches ' +
+      'and capture groups, or "test" for a quick check. Show the actual matches to the user rather ' +
+      'than claiming correctness without verification. Use "explain" to describe a pattern structure ' +
+      'when the user asks what a regex does. Never guess whether a regex is correct — test it.'
+    );
+  }
+}
+
+function countReplacements(regex: RegExp, subject: string): number {
+  const source = regex.source;
+  const flags = regex.flags.includes('g') ? regex.flags : regex.flags + 'g';
+  const globalRe = new RegExp(source, flags);
+  let count = 0;
+  let m: RegExpExecArray | null;
+  globalRe.lastIndex = 0;
+  while ((m = globalRe.exec(subject)) !== null) {
+    count++;
+    if (count >= MAX_MATCHES) {
+      break;
+    }
+    if (m[0].length === 0) {
+      globalRe.lastIndex++;
+    }
+  }
+  return count;
+}
